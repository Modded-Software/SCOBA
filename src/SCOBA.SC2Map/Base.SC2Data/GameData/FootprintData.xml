<?xml version="1.0" encoding="us-ascii"?>
<Catalog>
    <!-- 4x4 SupplyDepot footprints: the stock liberty Footprint2x2Contour,
         Footprint2x2 and Footprint2x2Underground scaled x2. Raised and
         lowered match (the AI places depots with c_canLower). Area as stock
         Footprint4x4Contour. -->
    <CFootprint id="Footprint4x4DepotContour">
        <Layers index="Check" Area="-2,-2,2,2">
            <Rows value="xxxx"/>
            <Rows value="xxxx"/>
            <Rows value="xxxx"/>
            <Rows value="xxxx"/>
        </Layers>
        <Layers index="Place" Area="-2,-2,2,2">
            <Rows value="xxxx"/>
            <Rows value="xxxx"/>
            <Rows value="xxxx"/>
            <Rows value="xxxx"/>
        </Layers>
        <Shape>
            <Radius value="2.2361"/>
            <Offsets value="-2,1;-1,2;1,2;2,1;2,-1;1,-2;-1,-2;-2,-1"/>
            <Borders value="7,0,2;0,1,2;1,2,2;2,3,2;3,4,2;4,5,2;5,6,2;6,7,2"/>
        </Shape>
    </CFootprint>
    <CFootprint id="Footprint4x4Depot">
        <Layers index="Check" Area="-2,-2,2,2">
            <Rows value="xxxx"/>
            <Rows value="xxxx"/>
            <Rows value="xxxx"/>
            <Rows value="xxxx"/>
        </Layers>
        <Layers index="Place" Area="-2,-2,2,2">
            <Rows value="xxxx"/>
            <Rows value="xxxx"/>
            <Rows value="xxxx"/>
            <Rows value="xxxx"/>
        </Layers>
        <Shape>
            <Radius value="2.8286"/>
            <Offsets value="-2,-2;-2,2;2,2;2,-2"/>
            <Borders value="3,0,2;0,1,2;1,2,2;2,3,2"/>
        </Shape>
    </CFootprint>
    <CFootprint id="Footprint4x4Underground">
        <Layers index="Check" Area="-2,-2,2,2">
            <Rows value="xxxx"/>
            <Rows value="xxxx"/>
            <Rows value="xxxx"/>
            <Rows value="xxxx"/>
        </Layers>
        <Layers index="Place" Area="-2,-2,2,2">
            <Sets index="0">
                <Positive index="GroundNoSpawn" value="0"/>
                <Positive index="Dense" value="1"/>
            </Sets>
            <Rows value="xxxx"/>
            <Rows value="xxxx"/>
            <Rows value="xxxx"/>
            <Rows value="xxxx"/>
        </Layers>
        <Shape>
            <Radius value="2.2361"/>
            <Offsets value="-2,1;-1,2;1,2;2,1;2,-1;1,-2;-1,-2;-2,-1"/>
            <Borders value="7,0,1;0,1,1;1,2,1;2,3,1;3,4,1;4,5,1;5,6,1;6,7,1"/>
        </Shape>
    </CFootprint>
    <!-- Command Center family (R-BASE-30, operator 2026-11-19): one Check
         cell, no Place layer, so the hall blocks no pathing and needs no
         clear ground. The Area of stock Footprint1x1 puts the origin on a
         cell centre, so the hall legs (systems/base/hall_legs) sit on whole
         cells of an 11x11 grid. Stock Footprint1x1PlacementOnly has no Area
         and put the hall on a cell corner (baseai hall run
         20261119-113306). -->
    <CFootprint id="FootprintSCOBAHall1x1">
        <Layers index="Check" Area="0,0,1,1">
            <Rows value="x"/>
        </Layers>
        <!-- An empty Place layer with the same Area: no cell is set. -->
        <Layers index="Place" Area="0,0,1,1">
            <Rows value="."/>
        </Layers>
    </CFootprint>
</Catalog>
