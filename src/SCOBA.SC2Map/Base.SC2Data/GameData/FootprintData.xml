    <!-- Command Center family (R-BASE-30, operator 2026-11-19): one Check
         cell, no Place layer, so the hall blocks no pathing and needs no
         clear ground. The Area of stock Footprint1x1 puts the origin on a
         cell centre, so the hall legs (systems/base/hall_legs) sit on whole
         cells of an 11x11 grid. Stock Footprint1x1PlacementOnly has no Area
         and put the hall on a cell corner (baseai hall run
         20261119-113306). -->
    <CFootprint id="FootprintSCOBAHall1x1">
        <Layers index="Check" Area="0,0,1,1">
            <Rows value="x"/>
        </Layers>
        <!-- An empty Place layer with the same Area: no cell is set. -->
        <Layers index="Place" Area="0,0,1,1">
            <Rows value="."/>
        </Layers>
    </CFootprint>
