<?xml version="1.0" encoding="us-ascii"?>
<Catalog>
    <CSound id="SporeCannon_AttackLaunch">
        <Volume value="-96.000000,-96.000000"/>
    </CSound>
    <!-- Intro theme (operator 2026-11-18). The build encodes
         res/audio/SCOBA_IntroTheme.wav to Assets\Sounds\SCOBA_IntroTheme.ogg.
         Played with SoundPlay per seat (systems/intro_flow). -->
    <CSound id="SCOBAIntroTheme" parent="MUSIC">
        <AssetArray File="Assets\Sounds\SCOBA_IntroTheme.ogg" FacialGroup=""/>
        <!-- Loops until touchdown (operator 2026-11-18). -->
        <LoopCount value="-1"/>
    </CSound>
    <!-- Psi Destroyer hum for intro shot S9 (operator 2026-11-18): the stock
         dome ambience loop (swarm.sc2campaign), 2D so the 42-cell dolly
         does not roll it off (stock rolloff: volume 0 at 30). -->
    <CSound id="SCOBAPsiHum" parent="PsiDecimator_Amb_Lp">
        <Mode value="2D"/>
    </CSound>
    <!-- Hero pod fall (operator 2026-11-20: the drop had no sound). The stock
         TerranDropPod actor (liberty.sc2campaign, not loaded) creates the
         TerranDropPodImpact sound on creation: Ghost_DropPodImpact0..2.
         Ghost_DropPodImpact (liberty.sc2mod) plays the same files. 2D: the
         drop camera starts 60 cells off. Played per seat (systems/hero_drop). -->
    <CSound id="SCOBAHeroPodFall" parent="Ghost_DropPodImpact">
        <Mode value="2D"/>
    </CSound>
    <!-- Hero jump touchdown sound (REQ-JUMP R-JUMP-8, operator 2026-11-20:
         "a more appropriate small dirt hit or impact"): the stock light
         physics impact on dirt. Before: QueenFootstep, stone footsteps. -->
    <CSound id="ScobaJumpLand" parent="Spell">
        <AssetArray File="Assets\Sounds\PhysicsImpactSound_Dirt_Light00.wav" FacialGroup=""/>
        <AssetArray File="Assets\Sounds\PhysicsImpactSound_Dirt_Light01.wav" FacialGroup=""/>
        <AssetArray File="Assets\Sounds\PhysicsImpactSound_Dirt_Light02.wav" FacialGroup=""/>
