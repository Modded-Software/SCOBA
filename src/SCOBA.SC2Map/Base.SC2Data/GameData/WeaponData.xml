    <!-- Ranged hero weapons reach twice as far in game as stock. The hero
         behavior UnitDirectControl adds 2 to every weapon range, so stock
         Tosh 5 + 2 = 7 becomes 12 + 2 = 14 and stock Psi Blast 4 + 2 = 6
         becomes 10 + 2 = 12. The Auto child weapons inherit the range.
         Razor Talons is melee and unchanged. -->
    <CWeaponLegacy id="QueenOfBladesPsiBlast">
        <Range value="10"/>
        <Period value="1"/>
        <Cost>
            <Cooldown Link="SCOBA/Attack" Location="Unit" TimeUse="1"/>
        </Cost>
    </CWeaponLegacy>
    <CWeaponLegacy id="RazorTalons">
        <Cost>
            <Cooldown Link="SCOBA/Attack" Location="Unit" TimeUse="1.5"/>
        </Cost>
    </CWeaponLegacy>
    <CWeaponLegacy id="Tosh">
        <Range value="12"/>
        <Effect value="SCOBAToshShot"/>
        <!-- TESTING (operator 2026-11-16): 0.1 s cooldown; was 1. -->
        <Period value="0.25"/>
        <Cost>
            <Cooldown Link="SCOBA/Attack" Location="Unit" TimeUse="0.25"/>
        </Cost>
    </CWeaponLegacy>
    <!-- Attack auto: fires outside attack orders, while moving, at any facing. -->
    <CWeaponLegacy id="QueenOfBladesPsiBlastAuto" parent="QueenOfBladesPsiBlast">
        <AllowedMovement value="Moving"/>
        <Arc value="360"/>
        <Options index="OnlyFireWhileInAttackOrder" value="0"/>
        <Options index="OnlyFireAtAttackOrderTarget" value="0"/>
    </CWeaponLegacy>
    <CWeaponLegacy id="RazorTalonsAuto" parent="RazorTalons">
        <AllowedMovement value="Moving"/>
        <Arc value="360"/>
        <Options index="OnlyFireWhileInAttackOrder" value="0"/>
        <Options index="OnlyFireAtAttackOrderTarget" value="0"/>
    </CWeaponLegacy>
    <CWeaponLegacy id="ToshAuto" parent="Tosh">
        <AllowedMovement value="Moving"/>
        <Arc value="360"/>
        <Options index="OnlyFireWhileInAttackOrder" value="0"/>
        <Options index="OnlyFireAtAttackOrderTarget" value="0"/>
    </CWeaponLegacy>
</Catalog>
