<Catalog>
    <CWeaponLegacy id="AcidSpew">
        <Range value="128"/>
        <Period value="4"/>
    </CWeaponLegacy>
    <CWeaponLegacy id="AutoTurret">
        <Period value="1"/>
    </CWeaponLegacy>
    <CWeaponLegacy id="BrakkClaws">
        <Range value="0.3"/>
    </CWeaponLegacy>
    <CWeaponLegacy id="ImpalerTentacle">
        <Period value="1.2"/>
    </CWeaponLegacy>
    <CWeaponLegacy id="KraithSpineVolley">
        <TargetFilters value="-;Missile,Stasis,Dead,Invulnerable"/>
    </CWeaponLegacy>
    <!-- Ranged hero weapons reach twice as far in game as stock. The hero
         behavior UnitDirectControl adds 2 to every weapon range, so stock
         Tosh 5 + 2 = 7 becomes 12 + 2 = 14 and stock Psi Blast 4 + 2 = 6
         becomes 10 + 2 = 12. The Auto child weapons inherit the range.
         Razor Talons is melee and unchanged. -->
    <CWeaponLegacy id="QueenOfBladesPsiBlast">
        <Range value="10"/>
        <Period value="1"/>
        <Cost>
            <Cooldown Link="SCOBA/Attack" Location="Unit" TimeUse="1"/>
        </Cost>
    </CWeaponLegacy>
    <CWeaponLegacy id="RazorTalons">
        <Cost>
            <Cooldown Link="SCOBA/Attack" Location="Unit" TimeUse="1.5"/>
        </Cost>
    </CWeaponLegacy>
    <CWeaponLegacy id="Tosh">
        <Range value="12"/>
        <Effect value="SCOBAToshShot"/>
        <!-- TESTING (operator 2026-11-16): 0.1 s cooldown; was 1. -->
        <Period value="0.25"/>
        <Cost>
            <Cooldown Link="SCOBA/Attack" Location="Unit" TimeUse="0.25"/>
        </Cost>
    </CWeaponLegacy>
    <!-- Attack auto: fires outside attack orders, while moving, at any facing. -->
    <CWeaponLegacy id="QueenOfBladesPsiBlastAuto" parent="QueenOfBladesPsiBlast">
        <AllowedMovement value="Moving"/>
        <Arc value="360"/>
        <Options index="OnlyFireWhileInAttackOrder" value="0"/>
        <Options index="OnlyFireAtAttackOrderTarget" value="0"/>
    </CWeaponLegacy>
    <CWeaponLegacy id="RazorTalonsAuto" parent="RazorTalons">
        <AllowedMovement value="Moving"/>
        <Arc value="360"/>
        <Options index="OnlyFireWhileInAttackOrder" value="0"/>
        <Options index="OnlyFireAtAttackOrderTarget" value="0"/>
    </CWeaponLegacy>
    <CWeaponLegacy id="ToshAuto" parent="Tosh">
        <AllowedMovement value="Moving"/>
        <Arc value="360"/>
        <Options index="OnlyFireWhileInAttackOrder" value="0"/>
        <Options index="OnlyFireAtAttackOrderTarget" value="0"/>
    </CWeaponLegacy>
    <!-- Air creep weapons (REQ-AIR-CREEP): air targets with User1 only, so
         a SCOBAMutalisk and a SCOBAWraith hit only each other. Stock range
         and scan range: GlaiveWurm 3 and 5 (Core default), MengskWraithA 5
         and 5 (both Core defaults). SCOBAAirGlaive is 20x (5x, then 4x:
         operator 2026-11-17). SCOBAWraithA was 20x, then cut to range 60,
         the glaive range (operator 2026-11-17). -->
    <CWeaponLegacy id="SCOBAAirGlaive" parent="GlaiveWurm">
        <TargetFilters value="Air,User1,Visible;Missile,Stasis,Dead,Hidden,Invulnerable"/>
        <Effect value="GlaiveWurm"/>
        <Range value="60"/>
        <MinScanRange value="100"/>
    </CWeaponLegacy>
    <CWeaponLegacy id="SCOBAWraithA" parent="MengskWraithA">
        <TargetFilters value="Air,User1,Visible;Missile,Stasis,Dead,Hidden,Invulnerable"/>
        <Effect value="MengskWraithAPersistent"/>
        <!-- 60, as SCOBAAirGlaive (operator 2026-11-17: down from 100). -->
        <Range value="60"/>
        <MinScanRange value="60"/>
    </CWeaponLegacy>
</Catalog>
