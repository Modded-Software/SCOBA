<Catalog>
    <CEffectDamage id="AutoTurret">
        <Amount value="25"/>
    </CEffectDamage>
    <CEffectCreatePersistent id="HeroNukePersistent">
        <FinalEffect value="HeroNukeDetonate"/>
    </CEffectCreatePersistent>
    <CEffectDamage id="ImpalerTentacleU">
        <Amount value="50"/>
    </CEffectDamage>
    <CEffectDamage id="MengskBCADamage">
        <Amount value="0.1"/>
    </CEffectDamage>
    <CEffectDamage id="MengskBCCannonsA">
        <Amount value="0.1"/>
    </CEffectDamage>
    <CEffectDamage id="MengskBCCannonsG">
        <Amount value="0.1"/>
    </CEffectDamage>
    <CEffectDamage id="MengskBCGDamage">
        <Amount value="0.1"/>
    </CEffectDamage>
    <CEffectDamage id="MitosaurusBDamage">
        <Amount value="30"/>
    </CEffectDamage>
    <CEffectDamage id="MitosaurusCDamage">
        <Amount value="15"/>
    </CEffectDamage>
    <CEffectDamage id="MitosaurusDamage">
        <Amount value="50"/>
    </CEffectDamage>
    <CEffectDamage id="PsiBlastDamage">
        <Amount value="25"/>
    </CEffectDamage>
    <CEffectDamage id="SalvageDeath">
        <Flags index="Kill" value="0"/>
        <Death value="Normal"/>
    </CEffectDamage>
    <CEffectSet id="SCOBAWeaponAttackDummy"/>
    <!-- Cooldown clock on the Weapon Attack button. Each hero weapon shot
         sets the button cooldown to the weapon period. -->
    <CEffectModifyUnit id="SCOBAAttackCooldown10">
        <ImpactUnit Value="Caster"/>
        <Cost Abil="SCOBAAutoAttackStatus,Execute" CooldownOperation="Set" CooldownTimeUse="1"/>
    </CEffectModifyUnit>
    <!-- TESTING (operator 2026-11-16): Tosh 0.25 s; his shots used SCOBAAttackCooldown10. -->
    <CEffectModifyUnit id="SCOBAAttackCooldown01">
        <ImpactUnit Value="Caster"/>
        <Cost Abil="SCOBAAutoAttackStatus,Execute" CooldownOperation="Set" CooldownTimeUse="0.25"/>
    </CEffectModifyUnit>
    <!-- Tosh shot damage 8-12 (operator 2026-11-16): Amount plus 0..Random. -->
    <CEffectDamage id="ToshU">
        <Amount value="8"/>
        <Random value="4"/>
    </CEffectDamage>
    <CEffectSet id="SCOBAToshShot">
        <EffectArray value="ToshU"/>
        <EffectArray value="SCOBAAttackCooldown01"/>
    </CEffectSet>
    <!-- TPS aim shot that ends in the air: the Tosh shot with no hit. It
         launches as ToshU does and deals nothing. Its actor
         SCOBAToshAirAttack has no impact model and no impact sound. -->
    <CEffectDamage id="SCOBAToshAirU" parent="ToshU">
        <Amount value="0"/>
        <Random value="0"/>
    </CEffectDamage>
    <CEffectSet id="SCOBAToshAirShot">
        <EffectArray value="SCOBAToshAirU"/>
        <EffectArray value="SCOBAAttackCooldown01"/>
    </CEffectSet>
    <CEffectCreatePersistent id="RazorTalonsPersistent">
        <InitialEffect value="SCOBAAttackCooldown10"/>
        <WhichLocation Value="TargetUnitOrPoint"/>
    </CEffectCreatePersistent>
    <!-- Talons swing on the TPS left click (operator 2026-11-23). The script picks the
         enemies in her front arc (gf_TalonsSwing): an engine arc search
         ignored her facing (run combat/20261123-100936). Each enemy takes
         the stock talons hits, 25 at 0 and 0.3 s. -->
    <CEffectCreatePersistent id="SCOBATalonsSwingHit">
        <WhichLocation Value="TargetUnit"/>
        <PeriodCount value="2"/>
        <PeriodicEffectArray value="RazorTalonsDamage"/>
        <PeriodicPeriodArray value="0"/>
        <PeriodicPeriodArray value="0.3"/>
    </CEffectCreatePersistent>
    <!-- Psi Blast shot (operator 2026-11-22): the stock missile beside the
         button clock, as SCOBAToshShot. PsiBlastLaunchMissile is stock: as
         its LaunchEffect the clock, an effect on the caster, sat in the
         missile's effect tree, and the missile was drawn at the shooter. -->
    <CEffectSet id="SCOBAPsiBlastShot">
        <EffectArray value="PsiBlastLaunchMissile"/>
        <EffectArray value="SCOBAAttackCooldown10"/>
    </CEffectSet>
    <!-- Glaive bounces (REQ-AIR-CREEP): air targets with User1 only, like
         SCOBAAirGlaive. These two effects belong to the stock glaive chain.
         SCOBAMutalisk is the only glaive unit on this map. -->
    <CEffectEnumArea id="GlaiveWurmE1">
        <SearchFilters value="Air,User1,Visible;Player,Ally,Neutral,Missile,Stasis,Dead,Hidden,Invulnerable"/>
    </CEffectEnumArea>
    <CEffectEnumArea id="GlaiveWurmE2">
        <SearchFilters value="Air,User1,Visible;Player,Ally,Neutral,Missile,Stasis,Dead,Hidden,Invulnerable"/>
    </CEffectEnumArea>
</Catalog>
