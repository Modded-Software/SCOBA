        </Cost>
        <Range index="0" value="20"/>
        <CalldownEffect value="HeroNukePersistent"/>
        <CmdButtonArray index="Execute" Requirements=""/>
    </CAbilEffectTarget>
    <CAbilSpecialize id="MakeVultureSpiderMines">
