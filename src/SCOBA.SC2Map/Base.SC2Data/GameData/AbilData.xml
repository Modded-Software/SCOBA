        </InfoArray>
    </CAbilSpecialize>
    <CAbilEffectInstant id="SummonCompanion">
        <EditorCategories value="AbilityorEffectType:Units"/>
        <CmdButtonArray index="Execute" DefaultButtonFace="Salvage2"/>
    </CAbilEffectInstant>
    <CAbilBehavior id="SCOBAAutoAttackToggle">
        <EditorCategories value="AbilityorEffectType:Units"/>
        <CmdButtonArray index="On" DefaultButtonFace="SCOBAAutoAttackOn">
            <Flags index="ToSelection" value="1"/>
        </CmdButtonArray>
        <CmdButtonArray index="Off" DefaultButtonFace="SCOBAAutoAttackOff">
