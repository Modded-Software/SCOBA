<?xml version="1.0" encoding="us-ascii"?>
<Catalog>
    <CButton id="Move2">
        <Icon value="Assets\Textures\btn-command-move.dds"/>
        <AlertIcon value="Assets\Textures\btn-command-move.dds"/>
        <EditorCategories value="Race:Neutral"/>
        <TintRacially value="1"/>
        <Universal value="1"/>
        <SimpleDisplayText value="SimpleDisplay/Move2"/>
    </CButton>
    <CButton id="ResearchNeosteelFrame"/>
    <CButton id="Salvage2">
        <Icon value="Assets\Textures\btn-research-zerg-predator.dds"/>
        <AlertIcon value="Assets\Textures\btn-research-zerg-predator.dds"/>
        <EditorCategories value="Race:Terran"/>
        <TintRacially value="1"/>
    </CButton>
    <CButton id="SCOBAAutoAttackOn">
        <Icon value="Assets\Textures\btn-upgrade-terran-hisecautotracking.dds"/>
        <AlertIcon value="Assets\Textures\btn-upgrade-terran-hisecautotracking.dds"/>
        <EditorCategories value="Race:Terran"/>
        <TintRacially value="1"/>
        <Name value="Auto-attack: ON"/>
        <Tooltip value="Attacks enemies in range automatically. Cancel: Ctrl+C, deselect target, or move with WASD. Click to turn off."/>
    </CButton>
    <CButton id="SCOBAAutoAttackOff">
        <Icon value="Assets\Textures\btn-command-cancel.dds"/>
        <AlertIcon value="Assets\Textures\btn-command-cancel.dds"/>
        <EditorCategories value="Race:Terran"/>
        <TintRacially value="1"/>
        <Name value="Auto-attack: OFF"/>
        <Tooltip value="Auto-attack disabled. Click to enable automatic attacks on nearby enemies."/>
    </CButton>
    <CButton id="SCOBARightClickStand">
        <Icon value="Assets\Textures\btn-command-holdposition.dds"/>
        <AlertIcon value="Assets\Textures\btn-command-holdposition.dds"/>
        <EditorCategories value="Race:Terran"/>
        <TintRacially value="1"/>
        <Name value="Chase: Stand"/>
        <Tooltip value="Hero holds position and attacks only enemies in range. Click to switch to Walk."/>
    </CButton>
    <CButton id="SCOBARightClickMove">
        <Icon value="Assets\Textures\btn-command-move.dds"/>
        <AlertIcon value="Assets\Textures\btn-command-move.dds"/>
        <EditorCategories value="Race:Terran"/>
        <TintRacially value="1"/>
        <Name value="Chase: Walk"/>
        <Tooltip value="Hero chases enemies to attack them. Click to switch to Stand."/>
    </CButton>
    <CButton id="SCOBAActionModeRPG">
        <Icon value="Assets\Textures\SCOBAModeRPG.dds"/>
        <AlertIcon value="Assets\Textures\SCOBAModeRPG.dds"/>
        <EditorCategories value="Race:Terran"/>
        <TintRacially value="1"/>
        <Name value="Controls: RPG"/>
        <Tooltip value="RPG controls: right and middle button turn the character, right click commands, left click selects. Click to switch to Actions."/>
    </CButton>
    <CButton id="SCOBAActionModeActions">
        <Icon value="Assets\Textures\SCOBAModeActions.dds"/>
        <AlertIcon value="Assets\Textures\SCOBAModeActions.dds"/>
        <EditorCategories value="Race:Terran"/>
        <TintRacially value="1"/>
        <Name value="Controls: Actions"/>
        <Tooltip value="Action controls: mouse look, right hold aims, left click attacks, Alt shows the cursor. Click to switch to RPG."/>
    </CButton>
    <CButton id="SCOBAAutoAttackStatus">
        <Icon value="Assets\Textures\btn-command-attack.dds"/>
        <AlertIcon value="Assets\Textures\btn-command-attack.dds"/>
        <EditorCategories value="Race:Terran"/>
        <TintRacially value="1"/>
        <Name value="Weapon Attack"/>
        <Tooltip value="Attack a target. The ring shows the weapon cooldown. The button is disabled while the weapon recharges."/>
    </CButton>
</Catalog>
