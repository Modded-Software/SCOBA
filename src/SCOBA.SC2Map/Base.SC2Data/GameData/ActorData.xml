        <BarOffset value="50"/>
        <NameOffset value="50"/>
        <UnitIcon value="Assets\Textures\btn-unit-terran-vikingfighter.dds"/>
        <HeroIcon value="Assets\Textures\btn-unit-terran-vikingfighter.dds"/>
        <GroupIcon>
            <Image value="Assets\Textures\Wireframe-Terran-Viking-Fighter.dds"/>
        </GroupIcon>
        <Wireframe>
            <Image value="Assets\Textures\Wireframe-Terran-Viking-Fighter.dds"/>
        </Wireframe>
        <SoundArray index="Ready" value="Viking_Ready"/>
        <SoundArray index="Help" value="Viking_Help"/>
        <SoundArray index="What" value="Viking_What"/>
        <SoundArray index="Yes" value="Viking_Yes"/>
        <SoundArray index="Attack" value="Viking_Attack"/>
        <SoundArray index="Pissed" value="Viking_Pissed"/>
        <SoundArray index="Movement" value="Viking_FighterMovement"/>
        <AbilSoundArray AbilCmd="SCOBAHeroAssaultMode,Execute" Sound="Viking_AssaultModeVO"/>
        <LifeArmorIcon value="Assets\Textures\btn-upgrade-terran-shipplatinglevel0.dds"/>
        <!-- Stock VikingFighter lines first left out of the copy. Without the
             FlyerHelper decrement the landed model floated (operator report
             2026-11-18; the engine height read 0, run 20261118-140607). -->
        <HostSiteOps Ops="SOpBankerViking"/>
        <On Terms="ActorDestruction; HasStatus FlyerHelper" Send="StatusDecrement FlyerHelper"/>
        <On Terms="UnitPortrait.*.Configure" Target="::PortraitGameSelf" Send="AnimPlay Visor Morph,Stand PlayForever 0.000000"/>
        <Aliases value="_UnitMedium"/>
    </CActorUnit>
