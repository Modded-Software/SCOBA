        <Aliases value="_UnitLarge"/>
    </CActorUnit>
    <!-- The stock landing transition model is destroyed only on MorphFrom
         VikingAssault / VikingFighter. Landing from SCOBAVikingHero left it
         behind as a static second model (operator report 2026-11-18). -->
    <CActorUnit id="AssaultMorphModel">
        <On Terms="AbilMorph.*.Finish; MorphFrom SCOBAVikingHero" Send="Destroy"/>
        <!-- Hero morph pair (SCOBAHeroAssaultMode / SCOBAHeroFighterMode). -->
        <On Terms="AbilMorph.*.Start; MorphTo SCOBAVikingHeroAssault" Send="Create"/>
        <On Terms="AbilMorph.*.Start; MorphTo SCOBAVikingHeroAssault" Send="SetScale 3.000000"/>
        <On Terms="AbilMorph.*.Start; MorphTo SCOBAVikingHeroAssault" Send="AnimPlay Start Morph,Start PlayForever"/>
        <On Terms="AbilMorph.*.Finish; MorphFrom SCOBAVikingHeroAssault" Send="Destroy"/>
    </CActorUnit>
    <CActorUnit id="FighterMorphModel">
        <On Terms="AbilMorph.*.Start; MorphTo SCOBAVikingHero" Send="Create"/>
        <On Terms="AbilMorph.*.Start; MorphTo SCOBAVikingHero" Send="SetScale 3.000000"/>
        <On Terms="AbilMorph.*.Start; MorphTo SCOBAVikingHero" Send="AnimPlay End Morph,End PlayForever,NonLooping"/>
        <On Terms="AbilMorph.*.Finish; MorphFrom SCOBAVikingHero" Send="Destroy"/>
        <On Terms="AbilMorph.*.Finish; MorphFrom SCOBAVikingHeroAssault" Send="Destroy"/>
    </CActorUnit>
    <!-- Landed hero Viking: the stock VikingAssault look at 3x scale (operator
         2026-11-18), on the GenericUnitBase template (a non-template parent
         fails to create). -->
    <CActorUnit id="SCOBAVikingHeroAssault" parent="GenericUnitBase" unitName="SCOBAVikingHeroAssault">
        <Model value="VikingAssault"/>
        <Scale value="3.000000"/>
        <DeathArray index="Normal" ModelLink="VikingAssaultDeath" SoundLink="Viking_Explode"/>
