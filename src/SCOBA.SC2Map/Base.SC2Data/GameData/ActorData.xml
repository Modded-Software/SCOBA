    <!-- Alt+4 Viking (SCOBAVikingHero): the stock VikingFighter look at 3x scale.
         Parent is the GenericUnitMorph template, as for the stock actor:
         parent="VikingFighter" (not a default="1" template) failed to create
         and drew the engine stand-in sphere (runs 20261118-125304, -125505). The
         stock VikingFighter fields are copied; the model is explicit. -->
    <CActorUnit id="SCOBAVikingHero" parent="GenericUnitMorph" unitName="SCOBAVikingHero">
        <Model value="VikingFighter"/>
        <Scale value="3.000000"/>
        <On Terms="Abil.SCOBAHeroAssaultMode.Start" Send="AnimPlay Morph Morph"/>
        <Baselines index="Walk" BlendIn="1.500000" BlendOut="2.000000"/>
