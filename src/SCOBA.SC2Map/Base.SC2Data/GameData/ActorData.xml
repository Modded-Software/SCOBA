    <!-- Terran Drop Pod (Art) ................................................................. -->
    <!--                                                                                         -->
    <!-- The stock TerranDropPod actor and model live in liberty.sc2campaign,
         which VoidStory does not load: without a parent and a model this
         actor drew the engine's stand-in sphere. The art is the
         DropPodFalling model of liberty.sc2mod (same .m3), as in the
         Liberty campaign actor. -->
    <!-- The pod art as a template (default="1"). A unit actor that names
         the concrete TerranDropPod actor as parent is not created: the
         engine logged "Scope[SCOBAHeroPod, Unit] Unable to create unit
         actor. Creating ... sphere unit." (podbirth/20261117-105245). -->
    <CActorUnit id="SCOBADropPodArt" parent="GenericUnitStandardNoAutoSoundLinks" default="1">
        <Model value="DropPodFalling"/>
        <On Terms="UnitBirth.*.Suppressed" Send="$Birth NonLooping 0.000000 0.000000"/>
        <WalkAnimMoveSpeed value="0"/>
        <UnitFlags index="ShowBlobShadow" value="0"/>
        <StatusBarFlags index="Shields" value="0"/>
        <StatusBarFlags index="Life" value="0"/>
        <StatusBarFlags index="Energy" value="0"/>
        <StatusBarFlags index="Cargo" value="0"/>
        <StatusBarFlags index="Progress" value="0"/>
        <StatusBarFlags index="Duration" value="0"/>
        <On Terms="UnitDeath" Send="AnimSetTimeScaleGlobal 0.500000"/>
        <Scale value="4.500000"/>
    </CActorUnit>
