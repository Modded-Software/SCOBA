<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<StyleFile>
    <Style name="TalentTreeButtonText" template="AICoopTitle" font="UI\Fonts\bl.ttf" height="18" vjustify="Middle" hjustify="Center" styleflags="Shadow" textcolor="255,255,255,255 - 255,192,192,192" highlightcolor="255,0,0,0" disabledcolor="255,0,0,0" hotkeycolor="255,0,0,0" hyperlinkcolor="255,0,0,0" glowcolor="255,0,0,0" shadowoffset="0" outlinewidth="1"/>
    <Style name="SCOBAFloaterText" template="TalentTreeButtonText" height="32" textcolor="255,255,255,255"/>
    <!-- Stock timer window font (TimerTitle), centred on one line. The time
         inside the line uses the stock TimerText style via an <s> tag. -->
    <Style name="SCOBAHudLine" template="TimerTitle" hjustify="Center" vjustify="Middle"/>
    <!-- Intro prompt (SPEC-INTRO 3.10): white, size 22, centred. -->
    <Style name="SCOBAIntroPrompt" template="TalentTreeButtonText" height="22" textcolor="255,255,255,255"/>
    <Style name="SCOBAOrderButton" template="TalentTreeButtonText" styleflags="Underline" textcolor="255,255,255,255" highlightcolor="255,255,255,255"/>
</StyleFile>
