void gt_AttackEvent_Init () {
    gt_AttackCooldown = TriggerCreate("gt_AttackCooldown_Func");
    TriggerAddEventUnitAttacked(gt_AttackCooldown, UnitRefFromVariable("gv_tPSUNIT[1]"));
    TriggerAddEventUnitAttacked(gt_AttackCooldown, UnitRefFromVariable("gv_tPSUNIT[2]"));
    TriggerAddEventUnitAttacked(gt_AttackCooldown, UnitRefFromVariable("gv_tPSUNIT[3]"));
    TriggerAddEventUnitAttacked(gt_AttackCooldown, UnitRefFromVariable("gv_tPSUNIT[4]"));
    TriggerAddEventUnitAttacked(gt_AttackCooldown, UnitRefFromVariable("gv_tPSUNIT[5]"));
    TriggerAddEventUnitAttacked(gt_AttackCooldown, UnitRefFromVariable("gv_tPSUNIT[6]"));
}

bool gt_AttackCooldown_Func (bool testConds, bool runActions) {
    int lv_player;
    unit lv_hero;
    fixed lv_period;

    if (!runActions) {
        return true;
    }
    lv_player = gf_HeroPlayerFromUnit(EventUnit());
    if (lv_player < 1) {
        return true;
    }
    lv_hero = gv_tPSUNIT[lv_player];
    if (!UnitIsValid(lv_hero)) {
        return true;
    }
    if (UnitBehaviorCount(lv_hero, "SCOBAAutoAttackBehavior") <= 0) {
        return true;
    }
    lv_period = UnitWeaponPeriod(lv_hero, 0);
    if (lv_period <= 0.0) {
        lv_period = 1.0;
    }
    UnitAbilityShow(lv_hero, "SCOBAAutoAttackStatus", true);
    UnitAbilityAddCooldown(lv_hero, "SCOBAAutoAttackStatus", "Abil/SCOBAAutoAttackStatus", lv_period);
    return true;
}

bool gt_AutoAttackTick_Func (bool testConds, bool runActions) {
    int lv_player;
    unit lv_hero;
    unit lv_target;
    unitgroup lv_group;
    bool lv_stand;
    bank lv_bank;

    if (!runActions) {
        return true;
    }
    for (lv_player = c_SCOBA_HERO_FIRST; lv_player <= c_SCOBA_HERO_LAST; lv_player += 1) {
        lv_hero = gv_tPSUNIT[lv_player];
        if (lv_player == 1 && UnitIsValid(lv_hero)) {
            lv_bank = BankLoad("SCOBA", 1);
            BankSectionCreate(lv_bank, "Debug");
            BankValueSetFromString(lv_bank, "Debug", "Build", c_SCOBA_BUILD_STAMP);
            BankValueSetFromInt(lv_bank, "Debug", "AutoCount", UnitBehaviorCount(lv_hero, "SCOBAAutoAttackBehavior"));
            BankValueSetFromInt(lv_bank, "Debug", "StandCount", UnitBehaviorCount(lv_hero, "SCOBARightClickStandBehavior"));
            BankValueSetFromInt(lv_bank, "Debug", "Orders", UnitOrderCount(lv_hero));
            BankValueSetFromFlag(lv_bank, "Debug", "OrderMode", gv_sCOBAOrderMode[lv_player]);
            BankSave(lv_bank);
        }
        if (!UnitIsValid(lv_hero) || !UnitIsAlive(lv_hero)) {
            gv_sCOBAAutoTarget[lv_player] = null;
            continue;
        }
        if (gv_sCOBAOrderMode[lv_player] == true || UnitBehaviorCount(lv_hero, "SCOBAAutoAttackBehavior") <= 0) {
            gv_sCOBAAutoTarget[lv_player] = null;
            continue;
        }
        lv_stand = (UnitBehaviorCount(lv_hero, "SCOBARightClickStandBehavior") > 0);
        lv_target = gv_sCOBAAutoTarget[lv_player];
        if (lv_stand) {
            if (UnitIsValid(lv_target) && UnitIsAlive(lv_target) && (libNtve_gf_PlayerIsEnemy(lv_player, UnitGetOwner(lv_target), libNtve_ge_PlayerRelation_Ally) == false) && UnitInRangeAndAbleToAttackTarget(lv_hero, lv_target)) {
                if (UnitOrderHasAbil(lv_hero, "attack") == false && UnitOrderCount(lv_hero) == 0) {
                    UnitIssueOrder(lv_hero, OrderTargetingUnit(AbilityCommand("attack", 0), lv_target), c_orderQueueReplace);
                }
                continue;
            }
            gv_sCOBAAutoTarget[lv_player] = null;
            lv_group = UnitGroupAlliance(lv_player, c_unitAllianceEnemy, RegionCircle(UnitGetPosition(lv_hero), c_SCOBA_KEEP_RADIUS), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
            if (UnitGroupCount(lv_group, c_unitCountAlive) > 0) {
                lv_target = UnitGroupClosestToPoint(lv_group, UnitGetPosition(lv_hero));
            }
            else {
                lv_target = null;
            }
            if (UnitIsValid(lv_target) && UnitInRangeAndAbleToAttackTarget(lv_hero, lv_target)) {
                if (UnitOrderHasAbil(lv_hero, "attack") == false && UnitOrderCount(lv_hero) == 0) {
                    UnitIssueOrder(lv_hero, OrderTargetingUnit(AbilityCommand("attack", 0), lv_target), c_orderQueueReplace);
                }
                gv_sCOBAAutoTarget[lv_player] = lv_target;
                continue;
            }
            if (UnitOrderCount(lv_hero) == 0) {
                UnitIssueOrder(lv_hero, Order(AbilityCommand("move", 2)), c_orderQueueReplace);
            }
            continue;
        }
        if (UnitIsValid(lv_target) && UnitIsAlive(lv_target) && (libNtve_gf_PlayerIsEnemy(lv_player, UnitGetOwner(lv_target), libNtve_ge_PlayerRelation_Ally) == false) && (DistanceBetweenPoints(UnitGetPosition(lv_hero), UnitGetPosition(lv_target)) <= c_SCOBA_KEEP_RADIUS)) {
            if (UnitOrderHasAbil(lv_hero, "attack") == false && UnitOrderCount(lv_hero) == 0) {
                UnitIssueOrder(lv_hero, OrderTargetingUnit(AbilityCommand("attack", 0), lv_target), c_orderQueueReplace);
            }
            continue;
        }
        gv_sCOBAAutoTarget[lv_player] = null;
        lv_group = UnitGroupAlliance(lv_player, c_unitAllianceEnemy, RegionCircle(UnitGetPosition(lv_hero), c_SCOBA_CHASE_RADIUS), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        if (UnitGroupCount(lv_group, c_unitCountAlive) == 0) {
            continue;
        }
        lv_target = UnitGroupClosestToPoint(lv_group, UnitGetPosition(lv_hero));
        if (!UnitIsValid(lv_target)) {
            continue;
        }
        UnitIssueOrder(lv_hero, OrderTargetingUnit(AbilityCommand("attack", 0), lv_target), c_orderQueueReplace);
        gv_sCOBAAutoTarget[lv_player] = lv_target;
    }
    return true;
}

void gt_CombatTick_Init () {
    gt_AutoAttackTick = TriggerCreate("gt_AutoAttackTick_Func");
    TriggerAddEventTimePeriodic(gt_AutoAttackTick, 0.5, c_timeGame);
}
void gf_BossBarSetup () {
    gv_sCOBABB_Panel = c_invalidDialogControlId;
    gv_sCOBABB_Icon = c_invalidDialogControlId;
    gv_sCOBABB_Name = c_invalidDialogControlId;
    gv_sCOBABB_HpImage = c_invalidDialogControlId;
    gv_sCOBABB_HpLabel = c_invalidDialogControlId;
    gv_sCOBABB_BarBg = c_invalidDialogControlId;
    gv_sCOBABB_Border = c_invalidDialogControlId;
    gv_sCOBABB_HpMaxWidth = 200;
}

void gf_BossBarEnsure () {
    if (gv_sCOBABB_Panel != c_invalidDialogControlId) {
        return;
    }
    DialogControlHookupStandard(c_triggerControlTypePanel, "UIContainer/ConsoleUIContainer/BossUnitFrame");
    gv_sCOBABB_Panel = DialogControlLastCreated();
    DialogControlHookup(gv_sCOBABB_Panel, c_triggerControlTypeImage, "IconImage");
    gv_sCOBABB_Icon = DialogControlLastCreated();
    DialogControlHookup(gv_sCOBABB_Panel, c_triggerControlTypeLabel, "NameLabel");
    gv_sCOBABB_Name = DialogControlLastCreated();
    DialogControlHookup(gv_sCOBABB_Panel, c_triggerControlTypeImage, "HealthBarImage");
    gv_sCOBABB_HpImage = DialogControlLastCreated();
    DialogControlHookup(gv_sCOBABB_Panel, c_triggerControlTypeLabel, "HealthLabel");
    gv_sCOBABB_HpLabel = DialogControlLastCreated();
    DialogControlHookup(gv_sCOBABB_Panel, c_triggerControlTypeImage, "BarBackground");
    gv_sCOBABB_BarBg = DialogControlLastCreated();
    DialogControlHookup(gv_sCOBABB_Panel, c_triggerControlTypeImage, "BorderImage");
    gv_sCOBABB_Border = DialogControlLastCreated();
    DialogControlSetPosition(gv_sCOBABB_Panel, PlayerGroupAll(), c_anchorTop, 0, 50);
    if (gv_sCOBAOrderDialog != c_invalidDialogId && gv_sCOBABB_Panel != c_invalidDialogControlId) {
DialogControlSetPosition(gv_sCOBAOrderDialog, PlayerGroupAll(), c_anchorTop, -157, 50 + DialogControlGetHeight(gv_sCOBABB_Panel, 1) + 8);
    }
    gv_sCOBABB_HpMaxWidth = DialogControlGetWidth(gv_sCOBABB_HpImage, 1);
    if (gv_sCOBABB_HpMaxWidth < 10) {
        gv_sCOBABB_HpMaxWidth = 200;
    }
}

void gf_BossBarUpdate (int lp_player) {
    unit lv_unit;
    int lv_cur;
    int lv_max;
    int lv_width;

    if (gv_sCOBABB_Panel == c_invalidDialogControlId) {
        return;
    }
    lv_unit = gv_tARGET[lp_player];
    if (!UnitIsValid(lv_unit)) {
        return;
    }
    lv_cur = FixedToInt(UnitGetPropertyFixed(lv_unit, c_unitPropLife, c_unitPropCurrent));
    lv_max = FixedToInt(UnitGetPropertyFixed(lv_unit, c_unitPropLifeMax, c_unitPropNormal));
    if (lv_max < 1) {
        lv_max = 1;
    }
    if (lv_cur < 0) {
        lv_cur = 0;
    }
    if (lv_cur > lv_max) {
        lv_cur = lv_max;
    }
    lv_width = ((gv_sCOBABB_HpMaxWidth * lv_cur) / lv_max);
    DialogControlSetSize(gv_sCOBABB_HpImage, PlayerGroupSingle(lp_player), lv_width, DialogControlGetHeight(gv_sCOBABB_HpImage, 1));
    libNtve_gf_SetDialogItemText(gv_sCOBABB_HpLabel, StringToText(IntToString(lv_cur) + "/" + IntToString(lv_max)), PlayerGroupSingle(lp_player));
}

void gf_ShowTarget (int lp_player, unit lp_unit) {
    unit lv_old;
    string lv_portrait;
    bool lv_enemy;
    int lv_bar;

    if (UnitIsValid(lp_unit) && (lp_unit == gv_tPSUNIT[lp_player])) {
        lp_unit = null;
    }
    lv_bar = ((lp_player * 10) + 4);
    lv_old = gv_tARGET[lp_player];
    if (lv_old != lp_unit) {
        UnitClearSelection(lp_player);
        if (UnitIsValid(lv_old)) {
            UnitStatusBarOverride(lv_old, -1);
            UnitSetState(lv_old, c_unitStateSelectable, false);
        }
    }
    gv_tARGET[lp_player] = lp_unit;
    DialogSetVisible(gv_sCOBAOrderDialog, PlayerGroupSingle(lp_player), (UnitIsValid(lp_unit) && (UnitGetOwner(lp_unit) == lp_player)));
    if (!UnitIsValid(lp_unit)) {
        libNtve_gf_ShowHideBossBar(false, lv_bar);
        return;
    }
    UnitStatusBarOverride(lp_unit, -1);
    lv_enemy = (libNtve_gf_PlayerIsEnemy(lp_player, UnitGetOwner(lp_unit), libNtve_ge_PlayerRelation_Ally) == false);
    lv_portrait = "";
    if (CatalogEntryIsValid(c_gameCatalogActor, UnitGetType(lp_unit))) {
        lv_portrait = CatalogFieldValueGet(c_gameCatalogActor, UnitGetType(lp_unit), "UnitIcon", lp_player);
    }
    if (lv_portrait == "") {
        lv_portrait = "Assets\\Textures\\btn-command-attack.dds";
    }
    libNtve_gf_DisplayBossBar(lv_bar, lv_portrait, UnitTypeGetName(UnitGetType(lp_unit)), 100, PlayerGroupSingle(lp_player));
    if (lv_enemy) {
        libNtve_gf_SetBossBarRace(lv_bar, libNtve_ge_BossBarRace_Zerg, true);
    }
    libNtve_gf_SetBossBarBoss(lv_bar, lp_unit, true);
    libNtve_gf_MoveBossBar(lv_bar, c_anchorTop, 0, 50);
}

bool gt_TargetClick_Func (bool testConds, bool runActions) {
    int lv_player;
    unit lv_picked;

    lv_player = EventPlayer();
    lv_picked = null;
    if (gf_IsHeroPlayer(lv_player)) {
        lv_picked = gv_sCOBAHover[lv_player];
    }

    if (!runActions) {
        return true;
    }

    if (!gf_IsHeroPlayer(lv_player)) {
        return true;
    }

    if (EventMouseClickedButton() == gv_fIRE) {
        if (gv_sCOBAOrderMode[lv_player] == true) {
            gf_OrderExecute(lv_player, EventMouseClickedPosXWorld(), EventMouseClickedPosYWorld());
        }
        else if (UnitIsValid(gv_tPSUNIT[lv_player])) {
            if (UnitIsValid(lv_picked) && (libNtve_gf_PlayerIsEnemy(lv_player, UnitGetOwner(lv_picked), libNtve_ge_PlayerRelation_Ally) == false)) {
                UnitIssueOrder(gv_tPSUNIT[lv_player], OrderTargetingUnit(AbilityCommand("attack", 0), lv_picked), c_orderQueueReplace);
                gv_sCOBAAutoTarget[lv_player] = lv_picked;
            }
            else {
                gv_sCOBAAutoTarget[lv_player] = null;
                if (UnitBehaviorCount(gv_tPSUNIT[lv_player], "SCOBARightClickStandBehavior") > 0) {
                    UnitIssueOrder(gv_tPSUNIT[lv_player], Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
                }
                else {
                    UnitIssueOrder(gv_tPSUNIT[lv_player], OrderTargetingPoint(AbilityCommand("move", 0), Point(EventMouseClickedPosXWorld(), EventMouseClickedPosYWorld())), c_orderQueueReplace);
                }
            }
            gf_ShowTarget(lv_player, null);
        }
        return true;
    }

    if (EventMouseClickedButton() == gv_mOUSECURSOR) {
        if (gv_sCOBAOrderMode[lv_player] == true) {
            gf_OrderExit(lv_player);
        }
        gf_ShowTarget(lv_player, lv_picked);
    }
    return true;
}

void gt_TargetClick_Init () {
    gt_TargetClick = TriggerCreate("gt_TargetClick_Func");
    TriggerAddEventMouseClicked(gt_TargetClick, c_playerAny, gv_mOUSECURSOR, true);
    TriggerAddEventMouseClicked(gt_TargetClick, c_playerAny, gv_fIRE, true);
}

bool gt_OrderKey_Func (bool testConds, bool runActions) {
    int lv_player;

    lv_player = EventPlayer();

    if (!runActions) {
        return true;
    }
    gf_OrderToggle(lv_player);
    libNtve_gf_SetDialogItemToggled(gv_sCOBAOrderButton, gv_sCOBAOrderMode[lv_player], PlayerGroupSingle(lv_player));
    return true;
}

