// Module: systems/controls

// Heroes: Tosh and Kerrigan. Every other controlled unit (the Alt+3 SCV,
// the Alt+4 Viking) is a regular unit.
bool gf_UnitIsHero (unit lp_unit) {
    string lv_t = UnitGetType(lp_unit);

    return lv_t == "ToshSCOBA" || lv_t == "Tosh" || lv_t == "KerriganSCOBA" || lv_t == "Kerrigan";
}

// Regular units (operator 2026-11-18): always Point & Click, never TPS; a
// right hold orbits the camera only, no facing lock, no strafe or
// backpedal; WASD turns the unit to its travel direction.
bool gf_ControlRegular (int lp_player) {
    unit lv_u = gv_tPSUNIT[lp_player];

    return UnitIsValid(lv_u) && !gf_UnitIsHero(lv_u);
}

bool gf_TpsActive (int lp_player) {
    unit lv_hero;

    if (!gf_IsHeroPlayer(lp_player)) {
        return false;
    }
    lv_hero = gv_tPSUNIT[lp_player];
    if (!UnitIsValid(lv_hero)) {
        return false;
    }
    if (gf_ControlRegular(lp_player)) {
        return false;
    }
    return UnitBehaviorCount(lv_hero, c_SCOBA_TPS_BEHAVIOR) > 0;
}

void gf_SelectionUIApply (int lp_player) {
    playergroup lv_group;

    if (!gf_IsHeroPlayer(lp_player)) {
        return;
    }
    lv_group = PlayerGroupSingle(lp_player);
    if (gv_aIMACTIVE[lp_player] && !gv_sCOBAOrderMode[lp_player]) {
        UISetSelectionTypeEnabled(lv_group, c_localSelectionTypeUnknown, false);
    }
    else {
        UISetSelectionTypeEnabled(lv_group, c_localSelectionTypeUnknown, true);
    }
}

// Mouse look and the cursor are sent to the engine only when they change.
// Operator report 2026-11-16: after some aims a TPS middle click stopped
// mouse look but left the cursor unusable. Aim start and end re-sent the
// same values every time. Cause unconfirmed (SPEC-TPS 5.3).
void gf_ControlSendRelative (int lp_player, bool lp_relative) {
    gv_cONTROLRELATIVE[lp_player] = lp_relative;
    if (gv_ctrlSentValid[lp_player] && gv_ctrlSentRelative[lp_player] == lp_relative) {
        return;
    }
    gv_ctrlSentRelative[lp_player] = lp_relative;
    gv_ctrlRelativeSends[lp_player] += 1;
    CameraSetMouseRotates(lp_player, lp_relative);
    CameraForceMouseRelative(lp_player, lp_relative);
}

void gf_ControlSendCursor (int lp_player, bool lp_visible) {
    playergroup lv_group;

    gv_controlCursor[lp_player] = lp_visible;
    if (gv_ctrlSentValid[lp_player] && gv_ctrlSentCursor[lp_player] == lp_visible) {
        return;
    }
    gv_ctrlSentCursor[lp_player] = lp_visible;
    gv_ctrlCursorSends[lp_player] += 1;
    lv_group = PlayerGroupSingle(lp_player);
    UISetCursorVisible(lv_group, lp_visible);
    UISetCursorAutoHide(lv_group, false, 0.0);
}

// The cursor rule: the TPS free-cursor state shows it (R-TPS-31), PNC
// shows it. The intro does not use it (gf_IntroMouseHide, R-INTRO-19).
bool gf_ControlCursorWanted (int lp_player) {
    return !gf_TpsActive(lp_player) || gv_mOUSEMIDDLE[lp_player];
}

// The next gf_ControlApply sends every value. Map start and mode switch.
void gf_ControlForceSend (int lp_player) {
    gv_ctrlSentValid[lp_player] = false;
}

void gf_ControlApply (int lp_player) {
    bool lv_relative;
    bool lv_force;

    if (!gf_IsHeroPlayer(lp_player)) {
        return;
    }
    if (gf_ControlRegular(lp_player)) {
        // A right hold orbits the camera as a left hold does (R-PNC-60/61).
        gv_rOTATEUNIT[lp_player] = gv_mOUSEMIDDLE[lp_player];
        gv_rOTATECAMERA[lp_player] = gv_lEFTORBIT[lp_player] || (gv_mOUSERIGHT[lp_player] && gv_rIGHTORBIT[lp_player]);
    }
    else {
        gv_rOTATEUNIT[lp_player] = (gv_mOUSERIGHT[lp_player] && gv_rIGHTORBIT[lp_player]) || gv_mOUSEMIDDLE[lp_player];
        gv_rOTATECAMERA[lp_player] = gv_lEFTORBIT[lp_player];
    }
    if (gf_TpsActive(lp_player)) {
        lv_relative = !gv_mOUSEMIDDLE[lp_player];
    }
    else {
        lv_relative = (gv_lEFTORBIT[lp_player] || (gv_mOUSERIGHT[lp_player] && gv_rIGHTORBIT[lp_player]) || gv_mOUSEMIDDLE[lp_player]);
    }
    lv_force = !gv_ctrlSentValid[lp_player];
    gf_ControlSendRelative(lp_player, lv_relative);
    gf_ControlSendCursor(lp_player, gf_ControlCursorWanted(lp_player));
    if (lv_force) {
        gv_ctrlSentValid[lp_player] = true;
    }
    gf_SelectionUIApply(lp_player);
}

void gf_PncRestore (int lp_player) {
    fixed lv_fov;

    if (gv_aIMACTIVE[lp_player]) {
        gf_AimEnd(lp_player);
    }
    lv_fov = gv_cAMERAFOV[lp_player];
    if (lv_fov <= 0.0) {
        lv_fov = c_SCOBA_REST_FOV;
    }
    CameraSetValue(lp_player, c_cameraValueFieldOfView, lv_fov, 0.2, -1, 10);
    gf_AimCameraSet(lp_player, false);
    gv_mOUSERIGHT[lp_player] = false;
    gv_mOUSEMIDDLE[lp_player] = false;
    gv_mOUSELEFT[lp_player] = false;
    gv_lEFTORBIT[lp_player] = false;
    gv_rIGHTORBIT[lp_player] = false;
    gv_mOUSEFORWARD[lp_player] = false;
    gf_TpsStatusHover(lp_player, null);
    gf_TpsShotClear(lp_player);
    gf_TpsProxyRemove(lp_player);
    gf_UiFloaterHide(lp_player);
    gf_ControlApply(lp_player);
}

void gf_ControlModeApply (int lp_player) {
    unit lv_hero;

    if (!gf_IsHeroPlayer(lp_player)) {
        return;
    }
    lv_hero = gv_tPSUNIT[lp_player];
    if (!UnitIsValid(lv_hero)) {
        return;
    }
    gv_tpsPressed[lp_player] = false;
    gv_mOUSERIGHTCANCEL[lp_player] = false;
    gv_mOUSELEFTCANCEL[lp_player] = false;
    gv_mOUSERIGHT[lp_player] = false;
    gv_mOUSELEFT[lp_player] = false;
    gv_lEFTORBIT[lp_player] = false;
    gv_rIGHTORBIT[lp_player] = false;
    gv_mOUSEMIDDLE[lp_player] = false;
    gv_tpsMiddleDown[lp_player] = false;
    // A mode switch ends the two-button walk; the WASD keys stay (R-PNC-72).
    gv_mOUSEFORWARD[lp_player] = false;
    gf_ControlForceSend(lp_player);
    gf_TpsStatusHover(lp_player, null);
    gf_AnimReset(lp_player);
    if (gf_TpsActive(lp_player)) {
        gf_ControlApply(lp_player);
    }
    else {
        gf_PncRestore(lp_player);
    }
    gf_MoveKeysChanged(lp_player);
    gf_HudModeIconUpdate(lp_player);
}

void gf_PncEnsure (int lp_player) {
    unit lv_hero;

    if (!gf_IsHeroPlayer(lp_player)) {
        return;
    }
    lv_hero = gv_tPSUNIT[lp_player];
    if (!UnitIsValid(lv_hero)) {
        return;
    }
    UnitBehaviorRemove(lv_hero, c_SCOBA_TPS_BEHAVIOR, 1);
    gf_ControlModeApply(lp_player);
}

// TPS mouse buttons. A middle click toggles the free-cursor state: cursor
// shown, mouse look off (R-TPS-30 to 35). In TPS gv_mOUSEMIDDLE holds that
// state, not the button. The state changes on the release of a press seen
// in TPS, so no mouse button is down when the mouse mode changes. A right
// hold aims, except in that state.
void gf_TpsMouseDown (int lp_player, int lp_button) {
    if (lp_button == gv_aBILITYCAMERA) {
        gv_tpsMiddleDown[lp_player] = true;
    }
    else if ((lp_button == gv_fIRE) && !gv_mOUSEMIDDLE[lp_player]) {
        gf_AimBegin(lp_player);
    }
}

void gf_TpsMouseUp (int lp_player, int lp_button) {
    if (lp_button == gv_aBILITYCAMERA) {
        if (!gv_tpsMiddleDown[lp_player]) {
            return;
        }
        gv_tpsMiddleDown[lp_player] = false;
        gv_mOUSEMIDDLE[lp_player] = !gv_mOUSEMIDDLE[lp_player];
        if (gv_aIMACTIVE[lp_player]) {
            gf_AimEnd(lp_player);
        }
        // Each toggle sends mouse look and the cursor to the engine, cache or
        // not (operator 2026-11-21: cursor still hidden after the click).
        gf_ControlForceSend(lp_player);
        gf_ControlApply(lp_player);
    }
    else if (lp_button == gv_fIRE) {
        gf_AimEnd(lp_player);
    }
}

bool gt_TpsOn_Func (bool testConds, bool runActions) {
    int lv_player;

    if (!runActions) {
        return true;
    }
    // Input hold of this player (systems/input_hold).
    if (gf_InputHeld(UnitGetOwner(EventUnit()))) {
        return true;
    }
    lv_player = EventPlayer();
    if (gf_ControlRegular(lv_player)) {
        // No TPS for a regular unit: undo the toggle.
        gv_tpsRefused[lv_player] += 1;
        gf_PncEnsure(lv_player);
        return true;
    }
    gf_ControlModeApply(lv_player);
    return true;
}

bool gt_TpsOff_Func (bool testConds, bool runActions) {
    int lv_player;

    if (!runActions) {
        return true;
    }
    // Input hold of this player (systems/input_hold).
    if (gf_InputHeld(UnitGetOwner(EventUnit()))) {
        return true;
    }
    lv_player = EventPlayer();
    if (gv_aIMACTIVE[lv_player]) {
        gf_AimEnd(lv_player);
    }
    gf_ControlModeApply(lv_player);
    return true;
}

void gt_TpsToggle_Init () {
    gt_TpsOn = TriggerCreate("gt_TpsOn_Func");
    TriggerAddEventUnitAbility(gt_TpsOn, UnitRefFromVariable("gv_tPSUNIT[1]"), AbilityCommand("SCOBATPSToggle", 0), c_unitAbilStageComplete, false);
    TriggerAddEventUnitAbility(gt_TpsOn, UnitRefFromVariable("gv_tPSUNIT[2]"), AbilityCommand("SCOBATPSToggle", 0), c_unitAbilStageComplete, false);
    TriggerAddEventUnitAbility(gt_TpsOn, UnitRefFromVariable("gv_tPSUNIT[3]"), AbilityCommand("SCOBATPSToggle", 0), c_unitAbilStageComplete, false);
    TriggerAddEventUnitAbility(gt_TpsOn, UnitRefFromVariable("gv_tPSUNIT[4]"), AbilityCommand("SCOBATPSToggle", 0), c_unitAbilStageComplete, false);
    TriggerAddEventUnitAbility(gt_TpsOn, UnitRefFromVariable("gv_tPSUNIT[5]"), AbilityCommand("SCOBATPSToggle", 0), c_unitAbilStageComplete, false);
    TriggerAddEventUnitAbility(gt_TpsOn, UnitRefFromVariable("gv_tPSUNIT[6]"), AbilityCommand("SCOBATPSToggle", 0), c_unitAbilStageComplete, false);

    gt_TpsOff = TriggerCreate("gt_TpsOff_Func");
    TriggerAddEventUnitAbility(gt_TpsOff, UnitRefFromVariable("gv_tPSUNIT[1]"), AbilityCommand("SCOBATPSToggle", 1), c_unitAbilStageComplete, false);
    TriggerAddEventUnitAbility(gt_TpsOff, UnitRefFromVariable("gv_tPSUNIT[2]"), AbilityCommand("SCOBATPSToggle", 1), c_unitAbilStageComplete, false);
    TriggerAddEventUnitAbility(gt_TpsOff, UnitRefFromVariable("gv_tPSUNIT[3]"), AbilityCommand("SCOBATPSToggle", 1), c_unitAbilStageComplete, false);
    TriggerAddEventUnitAbility(gt_TpsOff, UnitRefFromVariable("gv_tPSUNIT[4]"), AbilityCommand("SCOBATPSToggle", 1), c_unitAbilStageComplete, false);
    TriggerAddEventUnitAbility(gt_TpsOff, UnitRefFromVariable("gv_tPSUNIT[5]"), AbilityCommand("SCOBATPSToggle", 1), c_unitAbilStageComplete, false);
    TriggerAddEventUnitAbility(gt_TpsOff, UnitRefFromVariable("gv_tPSUNIT[6]"), AbilityCommand("SCOBATPSToggle", 1), c_unitAbilStageComplete, false);
}