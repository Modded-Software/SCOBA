// Module: systems/animation_bracket

int gf_AnimHeroProfile (unit lp_unit) {
    string lv_type;

    if (!UnitIsValid(lp_unit)) {
        return c_ANIM_HERO_GENERIC;
    }
    lv_type = UnitGetType(lp_unit);
    if (lv_type == "Tosh" || lv_type == "ToshSCOBA") {
        return c_ANIM_HERO_TOSH;
    }
    if (lv_type == "Kerrigan" || lv_type == "KerriganSCOBA") {
        return c_ANIM_HERO_KERRIGAN;
    }
    if (lv_type == "Firebat") {
        return c_ANIM_HERO_FIREBAT;
    }
    return c_ANIM_HERO_GENERIC;
}
void gf_AnimUpperClear (int lp_player) {
    unit lv_hero;
    actor lv_actor;

    lv_hero = gv_tPSUNIT[lp_player];
    if (!UnitIsValid(lv_hero)) {
        return;
    }
    lv_actor = libNtve_gf_MainActorofUnit(lv_hero);
    gf_AnimEvent(lp_player, "upper_stop", "", 0);
    gf_ProbeEvent(lp_player, "upper_stop", "", 0);
    if (gf_SlowWalkUpperOn(gv_animUpperState[lp_player])) {
        // Out of the slow walk arms with the slow blend (R-SLOW-20).
        ActorSend(lv_actor, "AnimClear " + c_ANIM_BRACKET_UPPER + " " + FixedToString(c_ANIM_SLOW_BLEND, 3));
        gv_slowUpperBlendMs[lp_player] = FixedToInt(c_ANIM_SLOW_BLEND * 1000.0);
        gv_animUpperClears[lp_player] += 1;
    }
    else if (gv_animUpperState[lp_player] != c_ANIM_UPPER_NONE || gv_animAimUpperOn[lp_player] || gv_animTargetPitchStep[lp_player] > 0) {
        ActorSend(lv_actor, "AnimSetPaused " + c_ANIM_BRACKET_UPPER + " 0");
        ActorSend(lv_actor, "AnimClear " + c_ANIM_BRACKET_UPPER);
        gv_slowUpperBlendMs[lp_player] = 0;
        gv_animUpperClears[lp_player] += 1;
    }
    ActorSend(lv_actor, "AnimClear " + c_ANIM_BRACKET_ATTACK);
    
    gf_AnimTargetPitchClear(lp_player);
    gv_animUpperState[lp_player] = c_ANIM_UPPER_NONE;
    gv_animUpperClipIndex[lp_player] = -1;
    gf_ProbeClearUpperClip(lp_player);
}
void gf_AnimLowerClear (int lp_player) {
    unit lv_hero;
    actor lv_actor;

    lv_hero = gv_tPSUNIT[lp_player];
    if (!UnitIsValid(lv_hero)) {
        return;
    }
    lv_actor = libNtve_gf_MainActorofUnit(lv_hero);
    gf_AnimEvent(lp_player, "lower_stop", "", 0);
    gf_ProbeEvent(lp_player, "lower_stop", "", 0);
    if (gv_animLowerState[lp_player] != c_ANIM_LOWER_NONE) {
        ActorSend(lv_actor, "AnimClear " + c_ANIM_BRACKET_LOWER);
    }
    gv_animLowerState[lp_player] = c_ANIM_LOWER_NONE;
    gv_animLowerClipIndex[lp_player] = -1;
    gf_ProbeClearLowerClip(lp_player);
}
void gf_AnimUpperSet (int lp_player, int lp_state) {
    unit lv_hero;
    actor lv_actor;
    int lv_profile;
    int lv_flags;
    fixed lv_blend;
    string lv_clip;

    if (lp_state == c_ANIM_UPPER_NONE) {
        if (gv_animUpperState[lp_player] != c_ANIM_UPPER_NONE) {
            gf_AnimUpperClear(lp_player);
        }
        return;
    }
    if (lp_state == gv_animUpperState[lp_player]) {
        return;
    }
    if (gf_SlowWalkUpperOn(lp_state)) {
        gf_SlowWalkUpperPlay(lp_player, lp_state);
        return;
    }
    if (lp_state == c_ANIM_UPPER_ATTACK || lp_state == c_ANIM_UPPER_ATTACK_SPELL) {
        // The slow walk arms share the attack priority: they leave first.
        if (gf_SlowWalkUpperOn(gv_animUpperState[lp_player])) {
            gf_AnimUpperClear(lp_player);
        }
        gf_AnimUpperAttackStart(lp_player, lp_state);
        return;
    }
    if (lp_state == c_ANIM_UPPER_READY) {
        // PNC pose hold (R-PNC-80): after an attack the pitch pose is
        // already on the bracket and stays. The caller's pitch tick sets it
        // when it is not. An aim pose is dropped first.
        if (gv_animUpperState[lp_player] != c_ANIM_UPPER_NONE && gv_animUpperState[lp_player] != c_ANIM_UPPER_ATTACK && gv_animUpperState[lp_player] != c_ANIM_UPPER_ATTACK_SPELL) {
            gf_AnimUpperClear(lp_player);
        }
        gv_animUpperState[lp_player] = c_ANIM_UPPER_READY;
        gv_animUpperClipIndex[lp_player] = c_ANIM_UPPER_READY;
        return;
    }
    lv_hero = gv_tPSUNIT[lp_player];
    if (!UnitIsValid(lv_hero)) {
        return;
    }
    lv_profile = gf_AnimHeroProfile(lv_hero);
    lv_clip = gv_animUpperClip[lv_profile][lp_state];
    if (lv_clip == "") {
        if (gv_animUpperState[lp_player] != c_ANIM_UPPER_NONE) {
            gf_AnimUpperClear(lp_player);
        }
        return;
    }
    lv_flags = c_animFlagFullMatch | c_animFlagPlayForever | c_animFlagNonLooping;
    lv_blend = gv_animUpperBlend[lv_profile][lp_state];
    if (gf_SlowWalkUpperOn(gv_animUpperState[lp_player])) {
        lv_blend = MaxF(lv_blend, c_ANIM_SLOW_BLEND);  // out of the slow arms (R-SLOW-20)
    }
    gv_slowUpperBlendMs[lp_player] = FixedToInt(lv_blend * 1000.0);
    lv_actor = libNtve_gf_MainActorofUnit(lv_hero);
    gv_animUpperStarts[lp_player] += 1;
    gf_AnimEvent(lp_player, "upper_start", lv_clip, lv_flags);
    gf_ProbeEvent(lp_player, "upper_start", lv_clip, lv_flags);
    ActorSend(lv_actor, MakeMsgAnimPlay(c_ANIM_BRACKET_UPPER, lv_clip, lv_flags, lv_blend, lv_blend, c_animTimeDefault, c_animTimeVariantAsAutomatic));
    if (gv_aIMACTIVE[lp_player]) {
        gv_animAimUpperOn[lp_player] = true;
        gv_animAimPitchTime[lp_player] = -1.0;
        gv_animAimPitchStep[lp_player] = 0;
        gf_AnimAimPitchTick(lp_player);
    }
    gv_animUpperState[lp_player] = lp_state;
    gv_animUpperClipIndex[lp_player] = lp_state;
    if (!gv_aIMACTIVE[lp_player]) {
        gf_ProbeSetUpperClip(lp_player, lv_clip);
    }
}
// The attack speed factor set at the last attack start (1 before any).
fixed gf_AnimAttackSpeedOf (int lp_player) {
    if ((gv_animAttackSpeed[lp_player] <= 0.0)) {
        return 1.0;
    }
    return gv_animAttackSpeed[lp_player];
}
void gf_AnimAimAttackStart (int lp_player, string lp_weapon) {
    unit lv_hero;
    actor lv_actor;
    int lv_profile;
    int lv_state;
    int lv_flags;
    string lv_clip;

    if (gf_AnimAimAttackActive(lp_player)) {
        return;
    }
    lv_hero = gv_tPSUNIT[lp_player];
    if (!UnitIsValid(lv_hero)) {
        return;
    }
    lv_profile = gf_AnimHeroProfile(lv_hero);
    if (lv_profile != c_ANIM_HERO_TOSH && lv_profile != c_ANIM_HERO_KERRIGAN) {
        return;
    }
    lv_state = c_ANIM_UPPER_ATTACK_AIM;
    if ((UnitGetType(lv_hero) == "Kerrigan" || UnitGetType(lv_hero) == "KerriganSCOBA") && lp_weapon == "QueenOfBladesPsiBlast") {
        lv_state = c_ANIM_UPPER_ATTACK_SPELL_AIM;
    }
    if (gf_AnimMelee(lv_hero, lp_weapon)) {
        lv_state = c_ANIM_UPPER_ATTACK_MELEE;
    }
    gv_animAimAttackState[lp_player] = lv_state;
    lv_clip = gv_animUpperClip[lv_profile][lv_state];
    if (lv_clip == "") {
        return;
    }
    lv_flags = c_animFlagFullMatch | c_animFlagNonLooping;
    lv_actor = libNtve_gf_MainActorofUnit(lv_hero);
    gv_animUpperStarts[lp_player] += 1;
    gf_AnimEvent(lp_player, "aim_attack_start", lv_clip, lv_flags);
    gf_ProbeEvent(lp_player, "aim_attack_start", lv_clip, lv_flags);
    ActorSend(lv_actor, MakeMsgAnimPlay(c_ANIM_BRACKET_AIM_ATTACK, lv_clip, lv_flags, c_ANIM_AIM_ATTACK_BLEND, c_ANIM_AIM_ATTACK_BLEND, gf_AnimAttackScale(lp_player, lv_state), c_animTimeVariantAsTimeScale));
    ActorSend(lv_actor, "AnimSetTime " + c_ANIM_BRACKET_AIM_ATTACK + " " + FixedToString(gf_AnimAttackStartTime(lv_state), c_fixedPrecisionAny) + " 0");
    
    gv_animAimAttackUntil[lp_player] = TimerGetElapsed(gv_sCOBA_Clock) + gf_AnimAttackHold(lp_player, lv_state);
    gv_animAimUpperOn[lp_player] = true;
}
void gf_AnimAimAttackClear (int lp_player) {
    unit lv_hero;
    actor lv_actor;

    if (gv_animAimAttackUntil[lp_player] >= 0.0) {
        lv_hero = gv_tPSUNIT[lp_player];
        if (UnitIsValid(lv_hero)) {
            lv_actor = libNtve_gf_MainActorofUnit(lv_hero);
            ActorSend(lv_actor, "AnimClear " + c_ANIM_BRACKET_AIM_ATTACK);
        }
    }
    gv_animAimAttackUntil[lp_player] = -1.0;
    
}
void gf_AnimUpperAttackStart (int lp_player, int lp_state) {
    unit lv_hero;
    actor lv_actor;
    int lv_profile;
    int lv_flags;
    string lv_clip;

    if (lp_state == c_ANIM_UPPER_NONE) {
        return;
    }
    lv_hero = gv_tPSUNIT[lp_player];
    if (!UnitIsValid(lv_hero)) {
        return;
    }
    lv_profile = gf_AnimHeroProfile(lv_hero);
    lv_clip = gv_animUpperClip[lv_profile][lp_state];
    if (lv_clip == "") {
        gf_AnimUpperClear(lp_player);
        return;
    }
    lv_flags = c_animFlagFullMatch | c_animFlagNonLooping;
    lv_actor = libNtve_gf_MainActorofUnit(lv_hero);
    gv_animUpperStarts[lp_player] += 1;
    gf_AnimEvent(lp_player, "upper_start", lv_clip, lv_flags);
    gf_ProbeEvent(lp_player, "upper_start", lv_clip, lv_flags);
    ActorSend(lv_actor, "AnimClear " + c_ANIM_BRACKET_ATTACK);
    ActorSend(lv_actor, MakeMsgAnimPlay(c_ANIM_BRACKET_ATTACK, lv_clip, lv_flags, 0.0, 0.0, gf_AnimAttackScale(lp_player, lp_state), c_animTimeVariantAsTimeScale));
    ActorSend(lv_actor, "AnimSetTime " + c_ANIM_BRACKET_ATTACK + " " + FixedToString(gf_AnimAttackStartTime(lp_state), c_fixedPrecisionAny) + " 0");
    
    gv_animUpperState[lp_player] = lp_state;
    gv_animUpperClipIndex[lp_player] = lp_state;
    gf_ProbeSetUpperClip(lp_player, lv_clip);
}
void gf_AnimLowerSet (int lp_player, int lp_state) {
    unit lv_hero;
    actor lv_actor;
    int lv_profile;
    int lv_flags;
    fixed lv_blend;
    fixed lv_move_speed;
    fixed lv_unit_speed;
    fixed lv_anim_scale;
    string lv_clip;

    if (lp_state == c_ANIM_LOWER_NONE) {
        if (gv_animLowerState[lp_player] != c_ANIM_LOWER_NONE) {
            gf_AnimLowerClear(lp_player);
        }
        return;
    }
    if (lp_state == gv_animLowerState[lp_player]) {
        return;
    }
    lv_hero = gv_tPSUNIT[lp_player];
    if (!UnitIsValid(lv_hero)) {
        return;
    }
    lv_profile = gf_AnimHeroProfile(lv_hero);
    lv_clip = gv_animLowerClip[lv_profile][lp_state];
    if (lv_clip == "") {
        if (gv_animLowerState[lp_player] != c_ANIM_LOWER_NONE) {
            gf_AnimLowerClear(lp_player);
        }
        return;
    }
    lv_flags = c_animFlagFullMatch;
    if (gv_animLowerLoop[lv_profile][lp_state]) {
        lv_flags = lv_flags | c_animFlagPlayForever;
    }
    lv_blend = gv_animLowerBlend[lv_profile][lp_state];
    lv_move_speed = gv_animLowerMoveSpeed[lv_profile][lp_state];
    lv_anim_scale = 1.0;
    if (lv_move_speed > 0.0) {
        lv_unit_speed = UnitGetPropertyFixed(lv_hero, c_unitPropMovementSpeed, c_unitPropCurrent);
        if (lv_unit_speed > 0.0) {
            lv_anim_scale = lv_move_speed / (lv_unit_speed * 100.0);
        }
    }
    lv_actor = libNtve_gf_MainActorofUnit(lv_hero);
    gv_animLowerStarts[lp_player] += 1;
    gf_AnimEvent(lp_player, "lower_start", lv_clip, lv_flags);
    gf_ProbeEvent(lp_player, "lower_start", lv_clip, lv_flags);
    ActorSend(lv_actor, MakeMsgAnimPlay(c_ANIM_BRACKET_LOWER, lv_clip, lv_flags, lv_blend, lv_blend, c_animTimeDefault, c_animTimeVariantAsAutomatic));
    gv_animLowerState[lp_player] = lp_state;
    gv_animLowerClipIndex[lp_player] = lp_state;
    gf_ProbeSetLowerClip(lp_player, lv_clip);
}
void gf_AnimFullClear (int lp_player) {
    unit lv_hero;
    actor lv_actor;

    lv_hero = gv_tPSUNIT[lp_player];
    if (!UnitIsValid(lv_hero)) {
        return;
    }
    lv_actor = libNtve_gf_MainActorofUnit(lv_hero);
    if (gf_SlowWalkState(gv_animFullState[lp_player])) {
        // Out of the slow walk legs with the slow blend (R-SLOW-20).
        ActorSend(lv_actor, "AnimClear " + c_ANIM_BRACKET_LOWER + " " + FixedToString(c_ANIM_SLOW_BLEND, 3));
        gv_slowLowerBlendMs[lp_player] = FixedToInt(c_ANIM_SLOW_BLEND * 1000.0);
    }
    else if (gv_animFullState[lp_player] != c_ANIM_LOWER_NONE || gv_animFullDir[lp_player] != -1) {
        ActorSend(lv_actor, "AnimClear " + c_ANIM_BRACKET_LOWER);
        gv_slowLowerBlendMs[lp_player] = 0;
    }
    gv_animFullState[lp_player] = c_ANIM_LOWER_NONE;
    gv_animFullDir[lp_player] = -1;
}
// Strafe walk clips play at the rate the engine gives the stock walk, times
// c_ANIM_STRAFE_RATE.
fixed gf_AnimWalkScale (unit lp_hero, int lp_state) {
    fixed lv_walk;

    // Slow walk (R-SLOW-15): feet on the ground, times the operator's
    // c_ANIM_SLOW_RATE. The speed property shows the slow buff (run
    // 20261121-162021: 1.55 of 3.10, engine travel 1.545).
    if (gf_SlowWalkState(lp_state)) {
        return c_ANIM_SLOW_RATE * UnitGetPropertyFixed(lp_hero, c_unitPropMovementSpeed, c_unitPropCurrent) / c_ANIM_SLOW_STRIDE;
    }
    if (lp_state != c_ANIM_LOWER_WALK && lp_state != c_ANIM_LOWER_WALK_BACK) {
        return 1.0;
    }
    lv_walk = gv_animWalkMoveSpeed[gf_AnimHeroProfile(lp_hero)];
    if (lv_walk <= 0.0) {
        return 1.0;
    }
    return c_ANIM_STRAFE_RATE * UnitGetPropertyFixed(lp_hero, c_unitPropMovementSpeed, c_unitPropCurrent) / lv_walk;
}
void gf_AnimFullSet (int lp_player, int lp_state) {
    unit lv_hero;
    actor lv_actor;
    int lv_profile;
    int lv_dir;
    fixed lv_scale;
    fixed lv_blend;
    string lv_clip;

    // A jump clip owns the lower bracket until landing recovery ends (REQ-JUMP).
    if (gf_JumpOwnsLower(lp_player)) {
        return;
    }
    if (lp_state == c_ANIM_LOWER_NONE) {
        gf_AnimFullClear(lp_player);
        gv_jumpReleased[lp_player] = false;  // the stock clip took over
        return;
    }
    lv_hero = gv_tPSUNIT[lp_player];
    if (!UnitIsValid(lv_hero)) {
        return;
    }
    lv_profile = gf_AnimHeroProfile(lv_hero);
    lv_dir = gv_animAimDir[lp_player];
    lv_scale = gf_AnimWalkScale(lv_hero, lp_state);
    lv_actor = libNtve_gf_MainActorofUnit(lv_hero);
    if (gv_animFullState[lp_player] == lp_state && gv_animFullDir[lp_player] == lv_dir) {
        if (AbsF(lv_scale - gv_animFullScale[lp_player]) > 0.01) {
            ActorSend(lv_actor, "AnimSetTimeScale " + c_ANIM_BRACKET_LOWER + " " + FixedToString(lv_scale, 3));
            gv_animFullScale[lp_player] = lv_scale;
            if (gf_SlowWalkState(lp_state)) {
                gf_SlowWalkGaitMark(lp_player, lv_scale, false);
            }
        }
        return;
    }
    lv_clip = gv_animAimClip[lv_profile][lp_state][lv_dir];
    if (lv_clip == "") {
        gf_AnimFullClear(lp_player);
        return;
    }
    lv_blend = 0.15;
    if (gf_SlowWalkState(lp_state) || gf_SlowWalkState(gv_animFullState[lp_player])) {
        lv_blend = c_ANIM_SLOW_BLEND;  // into or out of the slow walk (R-SLOW-20)
    }
    if (gv_jumpGaitResume[lp_player] || gv_jumpReleased[lp_player]) {
        // After a landing: a short blend, no slide (R-JUMP-22, 24).
        lv_blend = c_JUMP_RESUME_BLEND;
    }
    gv_jumpReleased[lp_player] = false;
    ActorSend(lv_actor, MakeMsgAnimPlay(c_ANIM_BRACKET_LOWER, lv_clip, c_animFlagFullMatch | c_animFlagPlayForever, lv_blend, lv_blend, lv_scale, c_animTimeVariantAsTimeScale));
    gv_slowLowerBlendMs[lp_player] = FixedToInt(lv_blend * 1000.0);
    gf_JumpGaitOnLowerPlay(lp_player, lp_state);  // walk phase after a jump (R-JUMP-18)
    if (gf_SlowWalkState(lp_state)) {
        gf_SlowWalkGaitMark(lp_player, lv_scale, true);  // slow phase for a jump (R-SLOW-18)
    }
    gv_animFullState[lp_player] = lp_state;
    gv_animFullDir[lp_player] = lv_dir;
    gv_animFullScale[lp_player] = lv_scale;
    gf_ProbeSetLowerClip(lp_player, lv_clip);
}
