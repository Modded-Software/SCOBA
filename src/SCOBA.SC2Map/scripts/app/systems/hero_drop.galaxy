// Module: systems/hero_drop
// A dead hero comes back with the next reinforcement, in its own pod
// (REQ-HERO-DROP). Death: the camera stays where the hero died. The next
// gv_sPAWNTIMER expiry: a SCOBAHeroPod drops as a stock pod: created on
// the ground, its model plays Birth untouched. The TPS camera follows the
// Birth root, replayed from the model keys (data/pod_birth). Touchdown: pod
// impact, the hero comes back at the pod (systems/hero_return), and the
// pod opens. Per seat: every played seat has its own drop (REQ-ROSTER).

// Pod part of the camera height, blended over lp_time with the pod.
void gf_HeroDropCamera (int lp_player, fixed lp_height, fixed lp_time) {
    gv_dropCamHeight[lp_player] = lp_height;
    gf_CameraHeightApply(lp_player, lp_time);
}

// Toggles and TPS mode of the living hero, every loop. The death event
// comes after the engine removed the behaviors (herodrop/20261116-225220:
// TPS read off), so the drop keeps the last values seen alive (R-DROP-6).
void gf_HeroDropTrack (int lp_player) {
    unit lv_hero = gv_tPSUNIT[lp_player];

    if (gv_dropPending[lp_player] || gv_dropRestoreLoops[lp_player] > 0 || !UnitIsValid(lv_hero) || !UnitIsAlive(lv_hero)) {
        return;
    }
    gv_dropSingle[lp_player] = UnitBehaviorCount(lv_hero, c_SCOBA_SINGLE_BEHAVIOR) > 0;
    gv_dropStand[lp_player] = UnitBehaviorCount(lv_hero, c_SCOBA_STAND_BEHAVIOR) > 0;
    gv_dropTps[lp_player] = UnitBehaviorCount(lv_hero, c_SCOBA_TPS_BEHAVIOR) > 0;
    gf_HeroStatsKeep(lp_player, lv_hero);
}

// The phase of the one drop sequence (SPEC-HERO-DROP 3a).
void gf_HeroDropPhase (int lp_player, int lp_phase) {
    gv_dropPhase[lp_player] = lp_phase;
    gv_dropPending[lp_player] = lp_phase != c_DROP_PHASE_IDLE;
    gv_dropPhaseTrace[lp_player] = gv_dropPhaseTrace[lp_player] + IntToString(lp_phase);
}

// A hero waits for its pod: the dead hero, or the hidden intro hero. The
// one drop sequence for both (R-DROP-10).
void gf_HeroDropBegin (int lp_player, unit lp_hero) {
    gf_HeroDropPhase(lp_player, c_DROP_PHASE_WAIT);
    gv_dropHero[lp_player] = lp_hero;
}

// The hero died (R-DROP-1). The camera stays at the death spot (R-DROP-2).
void gf_HeroDropDied (int lp_player, unit lp_hero) {
    gv_dropDeaths[lp_player] += 1;
    gf_HeroDropBegin(lp_player, lp_hero);
    gv_dropDeathAt[lp_player] = UnitGetPosition(lp_hero);
    gf_AimEnd(lp_player);
    gf_StrafeHoldSet(lp_player, false);
    if (gv_sCOBAOrderMode[lp_player]) {
        gf_OrderExit(lp_player);
    }
    gv_pncSingleShot[lp_player] = false;
    gv_tpsShotKind[lp_player] = c_TPS_SHOT_NONE;
    gv_tpsShotTarget[lp_player] = null;
    gf_CameraFollowStop(lp_player);
    CameraPan(lp_player, gv_dropDeathAt[lp_player], 0.0, -1, 10.0, false);
}

// The pod's Birth clip time from the engine, -1 when the pod does not play
// Birth. As the split-body probe (anim_probe_lower): length and remaining
// of the slot; time = length - remaining.
fixed gf_HeroDropClipRead (int lp_player) {
    generichandle lv_q;
    fixed lv_len;
    fixed lv_rem;

    AnimLengthQueryByName(libNtve_gf_MainActorofUnit(gv_dropPod[lp_player]), c_animNameDefault, false);
    AnimLengthQueryWait();
    lv_q = AnimLengthQueryLastCreated();
    lv_len = AnimLengthSync(lv_q);
    lv_rem = AnimLengthRemainingSync(lv_q);
    gv_dropClipLen[lp_player] = lv_len;
    if (AbsF(lv_len - c_POD_BIRTH_LENGTH) > c_DROP_CLIP_LEN_TOL) {
        gv_dropClipMisses[lp_player] += 1;
        gv_dropClipAt[lp_player] = -1.0;
        return -1.0;
    }
    gv_dropClipReads[lp_player] += 1;
    gv_dropClipAt[lp_player] = lv_len - lv_rem;
    return gv_dropClipAt[lp_player];
}

// Birth root offset from the pod at lp_t seconds into the clip, model
// units (data/pod_birth): linear between the keys, held after the last.
fixed gf_PodBirthAxis (fixed lp_t, int lp_axis) {
    int lv_i = c_POD_BIRTH_KEYS - 1;
    fixed lv_u = 0.0;
    fixed lv_a;
    fixed lv_b;

    if (lp_t <= gv_podBirthT[0]) {
        lv_i = 0;
    }
    else {
        while (lv_i > 0 && lp_t < gv_podBirthT[lv_i]) {
            lv_i -= 1;
        }
        if (lv_i < c_POD_BIRTH_KEYS - 1) {
            lv_u = (lp_t - gv_podBirthT[lv_i]) / (gv_podBirthT[lv_i + 1] - gv_podBirthT[lv_i]);
        }
    }
    if (lp_axis == 0) { lv_a = gv_podBirthX[lv_i]; }
    else if (lp_axis == 1) { lv_a = gv_podBirthY[lv_i]; }
    else { lv_a = gv_podBirthZ[lv_i]; }
    if (lv_u <= 0.0) {
        return lv_a;
    }
    if (lp_axis == 0) { lv_b = gv_podBirthX[lv_i + 1]; }
    else if (lp_axis == 1) { lv_b = gv_podBirthY[lv_i + 1]; }
    else { lv_b = gv_podBirthZ[lv_i + 1]; }
    return lv_a + (lv_b - lv_a) * lv_u;
}

// The Birth root at clip time lp_t in the world: pod + 4.5 x Rz(facing +
// 90) x key (start offset -44.42, +42.52, +85.64 in model axes).
void gf_HeroDropRoot (int lp_player, fixed lp_t) {
    fixed lv_x = gf_PodBirthAxis(lp_t, 0) * c_POD_BIRTH_SCALE * c_POD_BIRTH_MODEL_X;
    fixed lv_y = gf_PodBirthAxis(lp_t, 1) * c_POD_BIRTH_SCALE;
    fixed lv_a = gv_dropFacing[lp_player] + c_POD_BIRTH_MODEL_YAW;
    point lv_at = gv_dropAt[lp_player];

    gv_dropRootAt[lp_player] = Point(PointGetX(lv_at) + lv_x * Cos(lv_a) - lv_y * Sin(lv_a), PointGetY(lv_at) + lv_x * Sin(lv_a) + lv_y * Cos(lv_a));
    gv_dropRootZ[lp_player] = MaxF(gf_PodBirthAxis(lp_t, 2) * c_POD_BIRTH_SCALE, 0.0);
}

// Aim through the pod with no height offset (the engine has no getter for
// it, so it cannot be tested). The look ray through the root at height z,
// pitch p, meets the ground z / tan(p) further along the yaw: that is the
// target. The arm grows by z / sin(p), so the eye stays c_DROP_POD_ARM
// behind the pod on its own line. Then the side arm moves the whole camera
// c_DROP_CAM_SIDE to the right of the travel (yaw - 90). Target, yaw,
// pitch, distance: all read back by the engine getters.
point gf_HeroDropSide (point lp_at, fixed lp_yaw) {
    return PointWithOffsetPolar(lp_at, c_DROP_CAM_SIDE, lp_yaw - 90.0);
}

// The aim at the current root, no camera write.
void gf_HeroDropAimCalc (int lp_player) {
    fixed lv_z = gv_dropRootZ[lp_player];
    fixed lv_p = c_POD_BIRTH_PITCH;
    point lv_t = PointWithOffsetPolar(gv_dropRootAt[lp_player], lv_z * Cos(lv_p) / Sin(lv_p), gv_dropTravel[lp_player]);

    gv_dropAimAt[lp_player] = gf_HeroDropSide(lv_t, gv_dropTravel[lp_player]);
    gv_dropAimDist[lp_player] = c_DROP_POD_ARM + lv_z / Sin(lv_p);
}

void gf_HeroDropAim (int lp_player, fixed lp_time) {
    gf_HeroDropAimCalc(lp_player);
    CameraPan(lp_player, gv_dropAimAt[lp_player], lp_time, 0.0, 0.0, false);
    CameraSetValue(lp_player, c_cameraValueDistance, gv_dropAimDist[lp_player], lp_time, 0.0, 0.0);
}

// The drop DOF: near and far, focus on the pod (c_DROP_POD_ARM in front of
// the eye), the intro's falloffs (operator 2026-11-17). From the zoom's
// first frame on (operator 2026-11-20: the view had no DOF at the start).
void gf_HeroDropDof (int lp_player) {
    CameraSetValue(lp_player, c_cameraValueDepthOfField, 1.0, 0.0, 0.0, 0.0);
    CameraSetValue(lp_player, c_cameraValueFocalDepth, c_DROP_POD_ARM, 0.0, 0.0, 0.0);
    CameraSetValue(lp_player, c_cameraValueFalloffStartNear, c_INTRO_DOF_NEAR_START, 0.0, 0.0, 0.0);
    CameraSetValue(lp_player, c_cameraValueFalloffEndNear, c_INTRO_DOF_NEAR_END, 0.0, 0.0, 0.0);
    CameraSetValue(lp_player, c_cameraValueFalloffStart, c_INTRO_DOF_FAR_START, 0.0, 0.0, 0.0);
    CameraSetValue(lp_player, c_cameraValueFalloffEnd, c_INTRO_DOF_FAR_END, 0.0, 0.0, 0.0);
}

// Birth clip time on the anchored clock; the script clock from the create
// when Birth was never reported.
fixed gf_HeroDropClipNow (int lp_player) {
    if (gv_dropClipBase[lp_player] >= 0.0) {
        return TimerGetElapsed(gv_sCOBA_Clock) - gv_dropClipBase[lp_player];
    }
    return TimerGetElapsed(gv_sCOBA_Clock) - gv_dropStartAt[lp_player];
}

// The crash zoom at time lp_t into it, blended over lp_time (0 at the cut).
// Crash easing: 1 - (1 - w)^3, w = t / c_DROP_ZOOM_MOVE, then held.
void gf_HeroDropZoomApply (int lp_player, fixed lp_t, fixed lp_time) {
    fixed lv_w = MinF(MaxF(lp_t / c_DROP_ZOOM_MOVE, 0.0), 1.0);
    fixed lv_e = 1.0 - (1.0 - lv_w) * (1.0 - lv_w) * (1.0 - lv_w);

    // The end: the fall camera at the clip time the zoom ends on
    // (gf_HeroDropZoomBegin), so the fall goes on from it.
    gv_dropZoomFov[lp_player] = c_DROP_ZOOM_FOV0 + (c_DROP_ZOOM_FOV1 - c_DROP_ZOOM_FOV0) * lv_e;
    gv_dropZoomDist[lp_player] = c_DROP_ZOOM_DIST + (gv_dropZoomDist1[lp_player] - c_DROP_ZOOM_DIST) * lv_e;
    CameraPan(lp_player, gv_dropZoomAt1[lp_player], lp_time, 0.0, 0.0, false);
    CameraSetValue(lp_player, c_cameraValueYaw, c_DROP_YAW, lp_time, 0.0, 0.0);
    CameraSetValue(lp_player, c_cameraValuePitch, c_DROP_ZOOM_PITCH + (c_POD_BIRTH_PITCH - c_DROP_ZOOM_PITCH) * lv_e, lp_time, 0.0, 0.0);
    CameraSetValue(lp_player, c_cameraValueDistance, gv_dropZoomDist[lp_player], lp_time, 0.0, 0.0);
    CameraSetValue(lp_player, c_cameraValueFieldOfView, gv_dropZoomFov[lp_player], lp_time, 0.0, 0.0);
    // No height offset: the arm reaches back to the pod's start.
    CameraSetValue(lp_player, c_cameraValueHeightOffset, c_SCOBA_CAMERA_HEIGHT_OFFSET, lp_time, 0.0, 0.0);
}

// The waiting hero's drop starts (R-DROP-10): the drop point in the
// seat's lane spawn region, off lp_avoidA and lp_avoidB; the scene on; the
// pod created and its Birth started. The camera is not touched here: the
// zoom starts once the engine reports Birth (gf_HeroDropArmStep; operator
// 2026-11-20). Callers: the reinforcement (systems/spawns) and the intro
// deploy. Nothing when no hero waits.
void gf_HeroDropGo (int lp_player, point lp_avoidA, point lp_avoidB) {
    unit lv_pod;

    if (gv_dropPhase[lp_player] != c_DROP_PHASE_WAIT) {
        return;
    }
    gv_dropGoAt[lp_player] = gf_DropPodPoint(gv_sPAWNLOCATIONS[gf_RosterLaneOf(lp_player)], lp_avoidA, lp_avoidB);
    gf_SceneEnter(lp_player, c_SCENE_DROP);
    // As libVCMI_gf_CreateDropPod (voidcampaignmissionlib): create, then
    // Birth on the default slot, non-looping, default time.
    // The pod's travel direction (facing + c_POD_BIRTH_TRAVEL) is the
    // camera yaw, so it falls along the view; the yaw is fixed.
    gv_dropTravel[lp_player] = c_DROP_YAW;
    UnitCreate(1, c_DROP_POD_UNIT, c_unitCreateIgnorePlacement, lp_player, gv_dropGoAt[lp_player], gv_dropTravel[lp_player] - c_POD_BIRTH_TRAVEL);
    lv_pod = UnitLastCreated();
    if (!UnitIsValid(lv_pod)) {
        // No pod: the hero waits for the next reinforcement, out of the scene.
        gf_SceneLeave(lp_player, c_SCENE_DROP);
        return;
    }
    // The escort wave (R-DROP-14): pods facing as this pod.
    gf_DropEscort(lp_player, gv_dropGoAt[lp_player], UnitGetFacing(lv_pod));
    gf_HeroDropPhase(lp_player, c_DROP_PHASE_ARM);
    libNtve_gf_PlayAnimation(libNtve_gf_MainActorofUnit(lv_pod), c_animNameDefault, c_DROP_CLIP, c_animFlagNonLooping, c_animTimeDefault);
    // The pod fall sound with the Birth start, this seat only.
    gv_dropSoundValid = CatalogEntryIsValid(c_gameCatalogSound, c_DROP_SOUND);
    SoundPlay(SoundLink(c_DROP_SOUND, c_soundIndexAny), PlayerGroupSingle(lp_player), 100.0, 0.0);
    gv_dropSounds[lp_player] += 1;
    gv_dropPods[lp_player] += 1;
    gv_dropClipReads[lp_player] = 0;
    gv_dropClipMisses[lp_player] = 0;
    gv_dropClipAt[lp_player] = -1.0;
    gv_dropArmMs[lp_player] = -1.0;
    gv_dropPod[lp_player] = lv_pod;
    gv_dropAt[lp_player] = UnitGetPosition(lv_pod);
    gv_dropFacing[lp_player] = UnitGetFacing(lv_pod);
    gv_dropStartAt[lp_player] = TimerGetElapsed(gv_sCOBA_Clock);
    gv_dropClipBase[lp_player] = -1.0;
    gv_dropLeg[lp_player] = 0;
    gv_dropLegDirty[lp_player] = true;
}

// The crash zoom starts on the birthing pod: drop DOF on, the end on the
// fall camera at the clip time the zoom ends. The intro shot stops here.
void gf_HeroDropZoomBegin (int lp_player) {
    gf_IntroCameraRelease(lp_player);
    gf_CameraFollowStop(lp_player);
    gf_HeroDropPhase(lp_player, c_DROP_PHASE_ZOOM);
    gv_dropZooms[lp_player] += 1;
    gv_dropZoomStart[lp_player] = TimerGetElapsed(gv_sCOBA_Clock);
    gv_dropZoomClip0[lp_player] = gf_HeroDropClipNow(lp_player);
    gf_HeroDropRoot(lp_player, gv_dropZoomClip0[lp_player] + c_DROP_ZOOM_LENGTH);
    gf_HeroDropAimCalc(lp_player);
    gv_dropZoomAt1[lp_player] = gv_dropAimAt[lp_player];
    gv_dropZoomDist1[lp_player] = gv_dropAimDist[lp_player];
    gf_HeroDropDof(lp_player);
    gf_HeroDropZoomApply(lp_player, 0.0, 0.0);
}

// The pod exists: wait for the engine to report Birth, then the zoom.
void gf_HeroDropArmStep (int lp_player) {
    fixed lv_t = gf_HeroDropClipRead(lp_player);
    fixed lv_age = TimerGetElapsed(gv_sCOBA_Clock) - gv_dropStartAt[lp_player];

    if (lv_t >= 0.0) {
        gv_dropClipBase[lp_player] = TimerGetElapsed(gv_sCOBA_Clock) - lv_t;
        gv_dropArmMs[lp_player] = lv_age * 1000.0;
        gf_HeroDropZoomBegin(lp_player);
        return;
    }
    if (lv_age >= c_DROP_ARM_MAX) {
        gv_dropArmLate[lp_player] += 1;
        gf_HeroDropZoomBegin(lp_player);
    }
}

// The end of the zoom: the camera on the pod's Birth root at the current
// clip time (R-DROP-3, R-DROP-4). The pod already falls.
void gf_HeroDropFall (int lp_player) {
    fixed lv_t;

    if (gv_dropPhase[lp_player] != c_DROP_PHASE_ZOOM || !UnitIsValid(gv_dropPod[lp_player])) {
        return;
    }
    gf_HeroDropPhase(lp_player, c_DROP_PHASE_FALL);
    lv_t = MinF(MaxF(gf_HeroDropClipNow(lp_player), 0.0), c_DROP_FALL);
    gv_dropLeg[lp_player] = 0;
    gv_dropLegDirty[lp_player] = true;
    // The camera targets the root, not the unit: no unit follow. Each loop
    // pans to the root's next point (gf_HeroDropStep).
    // The camera's aim is the engine point on the Birth root.
    gf_HeroDropRoot(lp_player, lv_t);
    gf_CameraFollowStop(lp_player);
    gv_cameraDistanceDesired[lp_player] = c_DROP_CAM_DISTANCE;
    // Behind the pod on its line, on the side arm: same yaw, the descent
    // pitch, no blend.
    CameraSetValue(lp_player, c_cameraValueYaw, gv_dropTravel[lp_player], 0.0, 0.0, 0.0);
    CameraSetValue(lp_player, c_cameraValuePitch, c_POD_BIRTH_PITCH, 0.0, 0.0, 0.0);
    gf_HeroDropAim(lp_player, 0.0);
    // FOV: c_DROP_FOV_START at the Birth start, c_DROP_FOV_END at
    // touchdown, one move; joined at this clip time. No engine getter for
    // the player FOV: operator check.
    CameraSetValue(lp_player, c_cameraValueFieldOfView, c_DROP_FOV_START + (c_DROP_FOV_END - c_DROP_FOV_START) * lv_t / c_DROP_FALL, 0.0, 0.0, 0.0);
    CameraSetValue(lp_player, c_cameraValueFieldOfView, c_DROP_FOV_END, MaxF(c_DROP_FALL - lv_t, c_DROP_TICK), 0.0, 0.0);
    gf_HeroDropDof(lp_player);
    gv_cAMERAFOV[lp_player] = c_SCOBA_REST_FOV;
    gf_HeroDropCamera(lp_player, 0.0, 0.0);
}

// Touchdown (R-DROP-5, R-DROP-6): the hero alive at the pod. A dead hero
// comes back as a fresh unit (systems/hero_return); the intro hero never
// died and is shown.
void gf_HeroDropLand (int lp_player) {
    unit lv_pod = gv_dropPod[lp_player];
    unit lv_hero = gv_dropHero[lp_player];
    point lv_at = gv_dropAt[lp_player];

    gv_dropRootZ[lp_player] = 0.0;
    gf_HeroDropCamera(lp_player, 0.0, 0.0);
    CameraSetValue(lp_player, c_cameraValuePitch, c_DROP_LAND_PITCH, 0.5, 0.0, 0.0);
    CameraSetValue(lp_player, c_cameraValueDistance, c_DROP_CAM_DISTANCE, 0.5, 0.0, 0.0);
    gf_PodImpactNow(lv_at);
    // Facing: the drop yaw (the camera yaw of every drop); no camera read.
    if (!UnitIsAlive(lv_hero)) {
        lv_hero = gf_HeroReturn(lp_player, lv_hero, lv_at, c_DROP_YAW);
        gv_dropHero[lp_player] = lv_hero;
    }
    gf_HeroReveal(lv_hero);
    UnitSetPropertyFixed(lv_hero, c_unitPropLifePercent, 100.0);
    UnitSetPosition(lv_hero, lv_at, false);
    UnitSetFacing(lv_hero, c_DROP_YAW, 0.0);
    CameraPan(lp_player, lv_at, 0.0, -1, 10.0, false);
    gf_HeroDropPhase(lp_player, c_DROP_PHASE_IDLE);
    gv_dropPod[lp_player] = null;
    gv_dropLandings[lp_player] += 1;
    // The intro's own parts end (it checks), then the scene: at an intro
    // touchdown both owners leave here, so the restore runs once.
    gf_IntroEnd(lp_player);
    // Input back before the bind: the bind sends the control mode.
    gf_SceneLeave(lp_player, c_SCENE_DROP);
    // The bind follows the hero; nothing else may stay in the follow.
    gf_CameraFollowStop(lp_player);
    gf_HeroBindPlayer(lp_player, lv_hero);
    // The bind starts in Point & Click (gf_PncEnsure) with the arm by unit
    // height. Every touchdown then starts in TPS at the minimum arm
    // (operator 2026-11-20). TPS goes on through its toggle command, as
    // the HUD button does (gf_HeroDropTpsOn). Adding the behavior directly
    // left the toggle off: its off command was hidden and a TPS-off order
    // did nothing (herodrop/20261120-210634; operator 2026-11-20: buggy).
    gv_dropTpsArm[lp_player] = true;
    gf_HeroDropTpsOn(lp_player, lv_hero);
    // The pod opens: its death clip opens the doors.
    UnitKill(lv_pod);
    // A toggle order in the loop of the revive did not take
    // (herodrop/20261116-225854): the toggles are set again over the next
    // loops (gf_HeroDropRestore), through their commands.
    gv_dropRestoreLoops[lp_player] = c_DROP_RESTORE_LOOPS;
}

// The zoom, one camera write per tick over one tick; the fall in the
// first tick at or after c_DROP_ZOOM_LENGTH.
void gf_HeroDropZoomStep (int lp_player) {
    fixed lv_t = TimerGetElapsed(gv_sCOBA_Clock) - gv_dropZoomStart[lp_player];

    if (lv_t >= c_DROP_ZOOM_LENGTH) {
        gf_HeroDropFall(lp_player);
        return;
    }
    gf_HeroDropZoomApply(lp_player, lv_t + c_DROP_TICK, MinF(c_DROP_TICK, c_DROP_ZOOM_LENGTH - lv_t));
}

// TPS on through the toggle command; once it is on, the touchdown arm
// (the collision tick moves the camera to it), one time.
void gf_HeroDropTpsOn (int lp_player, unit lp_hero) {
    if (!gf_TpsActive(lp_player)) {
        UnitIssueOrder(lp_hero, Order(AbilityCommand("SCOBATPSToggle", 0)), c_orderQueueReplace);
        gv_dropTpsOrders[lp_player] += 1;
        return;
    }
    if (gv_dropTpsArm[lp_player]) {
        gv_dropTpsArm[lp_player] = false;
        gf_ControlModeApply(lp_player);
        gv_cameraDistanceDesired[lp_player] = c_DROP_LAND_ARM;
    }
}

// The toggles the hero had (R-DROP-6), after the revive. gf_ToggleSet
// does nothing once a toggle matches.
void gf_HeroDropRestore (int lp_player) {
    unit lv_hero = gv_tPSUNIT[lp_player];

    if (gv_dropRestoreLoops[lp_player] <= 0) {
        return;
    }
    gv_dropRestoreLoops[lp_player] -= 1;
    if (!UnitIsValid(lv_hero) || !UnitIsAlive(lv_hero)) {
        return;
    }
    gf_HeroDropTpsOn(lp_player, lv_hero);
    gf_AttackSingleSet(lv_hero, gv_dropSingle[lp_player]);
    gf_ChaseStandSet(lv_hero, gv_dropStand[lp_player]);
}

void gf_HeroDropStep (int lp_player) {
    unit lv_pod = gv_dropPod[lp_player];
    fixed lv_t;
    fixed lv_next;
    int lv_k;

    if (!UnitIsValid(lv_pod)) {
        return;
    }
    // The engine's clip time. No Birth: the camera holds, and touchdown
    // comes late on the script clock (a miss, counted for the tests).
    lv_t = gf_HeroDropClipRead(lp_player);
    // Smooth: the engine clip time anchors a steady game clock once; the
    // per-loop read jitters (up to 80 ms). Re-anchor only on real drift.
    if (lv_t >= 0.0) {
        if (gv_dropClipBase[lp_player] < 0.0 || AbsF(TimerGetElapsed(gv_sCOBA_Clock) - gv_dropClipBase[lp_player] - lv_t) > c_DROP_CLIP_DRIFT) {
            gv_dropClipBase[lp_player] = TimerGetElapsed(gv_sCOBA_Clock) - lv_t;
            gv_dropLegDirty[lp_player] = true;
        }
        lv_t = TimerGetElapsed(gv_sCOBA_Clock) - gv_dropClipBase[lp_player];
    }
    if (lv_t < 0.0) {
        if (TimerGetElapsed(gv_sCOBA_Clock) - gv_dropStartAt[lp_player] >= c_DROP_FALL + c_DROP_LAND_LATE) {
            gf_HeroDropLand(lp_player);
        }
        return;
    }
    if (lv_t >= c_DROP_FALL) {
        // The first loop at or after the land key: the root is down.
        gf_HeroDropLand(lp_player);
        return;
    }
    // Birth's root is linear between keys: one camera move per leg, to the
    // leg's end key over the clip time left. No per-loop restarts. The
    // operator judged this the right motion (podbirth/20261117-120310).
    lv_k = 1;
    while (lv_k < c_POD_BIRTH_KEYS - 1 && gv_podBirthT[lv_k] <= lv_t) {
        lv_k += 1;
    }
    if (lv_k == gv_dropLeg[lp_player] && !gv_dropLegDirty[lp_player]) {
        return;
    }
    gv_dropLeg[lp_player] = lv_k;
    gv_dropLegDirty[lp_player] = false;
    lv_next = MinF(gv_podBirthT[lv_k], c_DROP_FALL);
    gf_HeroDropRoot(lp_player, lv_next);
    gf_HeroDropAim(lp_player, MaxF(lv_next - lv_t, c_DROP_TICK));
}

// One trigger for every seat (R-DROP-8, R-DROP-9): the active hero of a
// played seat died. Only hero types come back; the Alt+3/Alt+4 test bodies
// of player 1 get no pod.
bool gt_HeroDropDeath_Func (bool testConds, bool runActions) {
    unit lv_unit = EventUnit();
    int lv_p = UnitGetOwner(lv_unit);

    if (!runActions) {
        return true;
    }
    if (!gf_RosterPlayed(lv_p) || lv_unit != gv_tPSUNIT[lv_p] || gv_dropPending[lv_p] || !gf_UnitIsHero(lv_unit)) {
        return true;
    }
    if (lv_p == 1 && !gv_heroSwitchReady) {
        return true;
    }
    gf_HeroDropDied(lv_p, lv_unit);
    return true;
}

bool gt_HeroDropTick_Func (bool testConds, bool runActions) {
    int lv_p;

    if (!runActions) {
        return true;
    }
    for (lv_p = c_SCOBA_HERO_FIRST; lv_p <= c_SCOBA_HERO_LAST; lv_p += 1) {
        if (!gf_RosterPlayed(lv_p)) {
            continue;
        }
        gf_HeroDropRestore(lv_p);
        gf_HeroDropTrack(lv_p);
        if (gv_dropPhase[lv_p] == c_DROP_PHASE_ARM) {
            gf_HeroDropArmStep(lv_p);
        }
        else if (gv_dropPhase[lv_p] == c_DROP_PHASE_ZOOM) {
            gf_HeroDropZoomStep(lv_p);
        }
        else {
            gf_HeroDropStep(lv_p);
        }
    }
    return true;
}

void gt_HeroDrop_Init () {
    gf_PodBirthLoad();
    gt_HeroDropDeath = TriggerCreate("gt_HeroDropDeath_Func");
    TriggerAddEventUnitDied(gt_HeroDropDeath, null);
    gt_HeroDropTick = TriggerCreate("gt_HeroDropTick_Func");
    TriggerAddEventTimePeriodic(gt_HeroDropTick, c_DROP_TICK, c_timeGame);
}
