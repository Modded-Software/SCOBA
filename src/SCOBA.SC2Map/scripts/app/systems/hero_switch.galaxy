// Module: systems/hero_switch

const string c_HERO_VIKING_TYPE = "SCOBAVikingHero";
const fixed c_HERO_VIKING_CAM_DIST = 6.0;

string gf_UnitActorId (unit lp_unit) {
    string lv_type;

    lv_type = UnitGetType(lp_unit);
    if (lv_type == "ToshSCOBA") {
        return "ToshSCOBAUnit";
    }
    if (lv_type == "KerriganSCOBA") {
        return "KerriganSCOBAUnit";
    }
    return lv_type;
}

bool gf_HeroIsParked (unit lp_unit) {
    if (!UnitIsValid(lp_unit)) {
        return false;
    }
    if (!gv_heroSwitchReady || lp_unit == gv_heroActive) {
        return false;
    }
    return lp_unit == gv_heroTosh || lp_unit == gv_heroKerrigan || lp_unit == gv_heroScv || lp_unit == gv_heroViking;
}

void gf_HeroPark (unit lp_unit) {
    if (!UnitIsValid(lp_unit)) {
        return;
    }
    UnitIssueOrder(lp_unit, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
    libNtve_gf_PauseUnit(lp_unit, true);
    UnitSetState(lp_unit, c_unitStateSelectable, false);
    UnitSetState(lp_unit, c_unitStateHighlightable, false);
    UnitSetState(lp_unit, c_unitStateHidden, true);
    UnitSetPosition(lp_unit, gv_heroPark, true);
}

void gf_HeroReveal (unit lp_unit) {
    if (!UnitIsValid(lp_unit)) {
        return;
    }
    UnitSetState(lp_unit, c_unitStateHidden, false);
    libNtve_gf_PauseUnit(lp_unit, false);
    UnitSetState(lp_unit, c_unitStateSelectable, true);
    UnitSetState(lp_unit, c_unitStateHighlightable, true);
    UnitSetState(lp_unit, c_unitStateStatusBar, false);
}

void gf_HeroApplyToggles (unit lp_unit) {
    if (!UnitIsValid(lp_unit)) {
        return;
    }
    UnitAbilityEnable(lp_unit, "SCOBAAutoAttackStatus", true);
    UnitAbilityShow(lp_unit, "SCOBAAutoAttackStatus", true);
    UnitAbilityEnable(lp_unit, "SCOBAAutoAttackToggle", true);
    UnitAbilityShow(lp_unit, "SCOBAAutoAttackToggle", true);
    // TPS for heroes only (gf_ControlRegular).
    UnitAbilityEnable(lp_unit, "SCOBATPSToggle", gf_UnitIsHero(lp_unit));
    UnitAbilityShow(lp_unit, "SCOBATPSToggle", gf_UnitIsHero(lp_unit));
    // Chase toggle: heroes only. Enabled on all, so script can force Move.
    UnitAbilityEnable(lp_unit, "SCOBARightClickToggle", true);
    UnitAbilityShow(lp_unit, "SCOBARightClickToggle", gf_UnitIsHero(lp_unit));
}

void gf_HeroApplyCamera (int lp_player, unit lp_unit) {
    if (!UnitIsValid(lp_unit)) {
        return;
    }
    if (UnitGetType(lp_unit) == "Tosh" || UnitGetType(lp_unit) == "ToshSCOBA") {
        CameraSetValue(lp_player, c_cameraValueDistance, 1.5, 0.5, -1, 10);
        gv_cameraDistanceDesired[lp_player] = 1.5;
    }
    else if (lp_unit == gv_heroViking) {
        // By handle, not type: it holds after the SCOBAHeroAssaultMode morph.
        CameraSetValue(lp_player, c_cameraValueDistance, c_HERO_VIKING_CAM_DIST, 0.5, -1, 10);
        gv_cameraDistanceDesired[lp_player] = c_HERO_VIKING_CAM_DIST;
    }
    else {
        CameraSetValue(lp_player, c_cameraValueDistance, 2.5, 0.5, -1, 10);
        gv_cameraDistanceDesired[lp_player] = 2.5;
    }
    // Base offset plus the active terms; a flyer adds its flight height.
    gf_CameraHeightApply(lp_player, 0.5);
    CameraUseHeightSmoothing(lp_player, false);
    CameraFollowUnitGroup(lp_player, libNtve_gf_ConvertUnitToUnitGroup(lp_unit), true, false);
}

// Makes lp_hero lp_player's hero: script state, toggles shown, direct
// control, camera, selection. Used by the hero switch and the hero return.
void gf_HeroBindPlayer (int lp_player, unit lp_hero) {
    if (lp_player == 1) {
        gv_heroActive = lp_hero;
    }
    gv_tPSUNIT[lp_player] = lp_hero;
    if (gf_RosterPlayed(lp_player) && lp_player != 1) {
        gv_rosterHero[lp_player] = lp_hero;
    }
    gf_CombatSyncRoot(lp_player);
    gf_AnimReset(lp_player);
    gf_HeroApplyToggles(lp_hero);
    UnitBehaviorRemove(lp_hero, "UnitDirectControl", 1);
    UnitBehaviorAdd(lp_hero, "UnitDirectControl", lp_hero, 1);
    UnitSetState(lp_hero, c_unitStateStatusBar, false);
    UnitXPGainEnable(lp_hero, null, true);
    gf_ControlApply(lp_player);
    gf_PncEnsure(lp_player);
    gf_HeroApplyCamera(lp_player, lp_hero);
    UnitClearSelection(lp_player);
    UnitSelect(lp_hero, lp_player, true);
}

// Player 1's hero switch (the developer bodies).
void gf_HeroBind (unit lp_hero) {
    gf_HeroBindPlayer(1, lp_hero);
}

void gf_HeroSwitchTo (unit lp_target) {
    unit lv_old;
    point lv_pos;
    fixed lv_facing;

    if (!gv_heroSwitchReady) {
        return;
    }
    // A dead hero waits for its pod: no switch (R-DROP-7).
    if (gv_dropPending[1]) {
        gv_dropSwitchBlocked[1] += 1;
        return;
    }
    if (!UnitIsValid(lp_target) || !UnitIsAlive(lp_target)) {
        return;
    }
    if (lp_target == gv_heroActive) {
        return;
    }
    lv_old = gv_heroActive;
    if (!UnitIsValid(lv_old)) {
        return;
    }
    gf_AimEnd(1);
    gf_StrafeHoldSet(1, false);
    if (gv_sCOBAOrderMode[1]) {
        gf_OrderExit(1);
    }
    lv_pos = UnitGetPosition(lv_old);
    lv_facing = UnitGetFacing(lv_old);
    UnitClearSelection(1);
    gv_unitTarget[1] = null;
    gv_unitHighlight[1] = null;
    UnitBehaviorRemove(lv_old, "UnitDirectControl", 1);
    gv_pncSingleShot[1] = false;
    gv_tpsShotKind[1] = c_TPS_SHOT_NONE;
    gv_tpsShotTarget[1] = null;
    gf_AnimReset(1);
    gf_HeroPark(lv_old);
    UnitSetOwner(lp_target, 1, false);
    UnitSetPosition(lp_target, lv_pos, true);
    UnitSetFacing(lp_target, lv_facing, 0.0);
    gf_HeroReveal(lp_target);
    gf_AttackSingleSet(lp_target, UnitBehaviorCount(lv_old, c_SCOBA_SINGLE_BEHAVIOR) > 0);
    // Regular units: Chase is always Move (operator 2026-11-18).
    gf_ChaseStandSet(lp_target, gf_UnitIsHero(lp_target) && UnitBehaviorCount(lv_old, c_SCOBA_STAND_BEHAVIOR) > 0);
    gf_HeroBind(lp_target);
}

void gf_HeroUnitsReplace () {
    unit lv_oldTosh;
    unit lv_oldKerrigan;
    point lv_toshPos;
    point lv_kerriganPos;
    fixed lv_toshFacing;
    fixed lv_kerriganFacing;
    int lv_kerriganOwner;

    lv_oldTosh = UnitFromId(622754155);
    lv_oldKerrigan = UnitFromId(649131550);
    if (!UnitIsValid(lv_oldTosh) || !UnitIsValid(lv_oldKerrigan)) {
        return;
    }
    lv_toshPos = UnitGetPosition(lv_oldTosh);
    lv_kerriganPos = UnitGetPosition(lv_oldKerrigan);
    lv_toshFacing = UnitGetFacing(lv_oldTosh);
    lv_kerriganFacing = UnitGetFacing(lv_oldKerrigan);
    lv_kerriganOwner = UnitGetOwner(lv_oldKerrigan);
    libNtve_gf_CreateUnitsAtPoint2(1, "ToshSCOBA", 0, 1, lv_toshPos);
    gv_heroTosh = UnitLastCreated();
    UnitSetFacing(gv_heroTosh, lv_toshFacing, 0.0);
    libNtve_gf_CreateUnitsAtPoint2(1, "KerriganSCOBA", 0, lv_kerriganOwner, lv_kerriganPos);
    gv_heroKerrigan = UnitLastCreated();
    UnitSetFacing(gv_heroKerrigan, lv_kerriganFacing, 0.0);
    UnitRemove(lv_oldTosh);
    UnitRemove(lv_oldKerrigan);
    UnitSelect(gv_heroTosh, 1, true);
    // Kerrigan is a player 1 developer body (Alt+2), not a seat hero.
    gf_RosterHeroesCreate();
}

// Seat heroes (R-ROSTER-5): player 1 keeps the placed Tosh; every other
// played seat gets its seat hero at its lane spawn. An unplayed seat 1
// loses the placed Tosh. The map init loop binds a selected hero.
void gf_RosterHeroesCreate () {
    int lv_lane;
    int lv_p;
    string lv_type;

    for (lv_lane = 1; lv_lane <= c_ROSTER_LANES; lv_lane += 1) {
        lv_p = gf_RosterSeat(lv_lane);
        lv_type = gf_RosterHeroType(lv_lane);
        gv_rosterHero[lv_p] = null;
        if (lv_p == 1) {
            if (gf_RosterPlayed(1)) {
                gv_rosterHero[1] = gv_heroTosh;
            }
            else if (UnitIsValid(gv_heroTosh)) {
                UnitRemove(gv_heroTosh);
                gv_heroTosh = null;
            }
            continue;
        }
        if (!gf_RosterPlayed(lv_p) || lv_type == "") {
            continue;
        }
        gf_RosterHeroCreate(lv_lane);
        UnitSelect(gv_rosterHero[lv_p], lv_p, true);
    }
}

// The seat hero of lp_lane at its spawn (map init; tests that play a seat).
unit gf_RosterHeroCreate (int lp_lane) {
    int lv_p = gf_RosterSeat(lp_lane);

    UnitCreate(1, gf_RosterHeroType(lp_lane), 0, lv_p, RegionGetCenter(gv_sPAWNLOCATIONS[lp_lane]), 225.0);
    gv_rosterHero[lv_p] = UnitLastCreated();
    gf_HeroAbilitiesDefault(gv_rosterHero[lv_p]);
    return gv_rosterHero[lv_p];
}

void gf_HeroSwitchInit () {
    gv_heroPark = Point(0.0, 0.0);
    if (!UnitIsValid(gv_heroTosh)) {
        gv_heroTosh = UnitFromId(622754155);
    }
    if (!UnitIsValid(gv_heroKerrigan)) {
        gv_heroKerrigan = UnitFromId(649131550);
    }
    gv_heroActive = gv_heroTosh;
    if (!UnitIsValid(gv_heroTosh) || !UnitIsValid(gv_heroKerrigan)) {
        return;
    }
    gv_tPSUNIT[1] = gv_heroTosh;
    gf_HeroPark(gv_heroKerrigan);
    // Alt+3: an SCV to place and inspect buildings, parked like Kerrigan.
    if (!UnitIsValid(gv_heroScv)) {
        UnitCreate(1, "SCV", 0, 1, gv_heroPark, 0.0);
        gv_heroScv = UnitLastCreated();
    }
    // The test bodies cannot die: no revive, no pod for them.
    UnitSetState(gv_heroScv, c_unitStateInvulnerable, true);
    gf_HeroPark(gv_heroScv);
    // Alt+4: a Viking (flight mode) to watch the map from the air in TPS.
    if (!UnitIsValid(gv_heroViking)) {
        UnitCreate(1, c_HERO_VIKING_TYPE, 0, 1, gv_heroPark, 0.0);
        gv_heroViking = UnitLastCreated();
    }
    UnitSetState(gv_heroViking, c_unitStateInvulnerable, true);
    gf_HeroPark(gv_heroViking);
    gv_heroSwitchReady = true;
}

bool gt_HeroSwitchTosh_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    // Input hold of this player (systems/input_hold).
    if (gf_InputHeld(1)) {
        return true;
    }
    gf_HeroSwitchTo(gv_heroTosh);
    return true;
}

bool gt_HeroSwitchKerrigan_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    // Input hold of this player (systems/input_hold).
    if (gf_InputHeld(1)) {
        return true;
    }
    gf_HeroSwitchTo(gv_heroKerrigan);
    return true;
}

bool gt_HeroSwitchScv_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    // Input hold of this player (systems/input_hold).
    if (gf_InputHeld(1)) {
        return true;
    }
    gf_HeroSwitchTo(gv_heroScv);
    return true;
}

bool gt_HeroSwitchViking_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    // Input hold of this player (systems/input_hold).
    if (gf_InputHeld(1)) {
        return true;
    }
    gf_HeroSwitchTo(gv_heroViking);
    return true;
}

void gt_HeroSwitch_Init () {
    gt_HeroSwitchViking = TriggerCreate("gt_HeroSwitchViking_Func");
    TriggerAddEventKeyPressed(gt_HeroSwitchViking, 1, c_key4, true, c_keyModifierStateIgnore, c_keyModifierStateIgnore, c_keyModifierStateRequire);
    gt_HeroSwitchScv = TriggerCreate("gt_HeroSwitchScv_Func");
    TriggerAddEventKeyPressed(gt_HeroSwitchScv, 1, c_key3, true, c_keyModifierStateIgnore, c_keyModifierStateIgnore, c_keyModifierStateRequire);
    gt_HeroSwitchTosh = TriggerCreate("gt_HeroSwitchTosh_Func");
    TriggerAddEventKeyPressed(gt_HeroSwitchTosh, 1, c_key1, true, c_keyModifierStateIgnore, c_keyModifierStateIgnore, c_keyModifierStateRequire);
    gt_HeroSwitchKerrigan = TriggerCreate("gt_HeroSwitchKerrigan_Func");
    TriggerAddEventKeyPressed(gt_HeroSwitchKerrigan, 1, c_key2, true, c_keyModifierStateIgnore, c_keyModifierStateIgnore, c_keyModifierStateRequire);
}