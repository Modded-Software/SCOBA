// Module: systems/intro
// The intro (REQ-INTRO, SPEC-INTRO): a loop of camera shots with no UI and
// the line "Press SPACE to deploy". SPACE: a 3 s countdown, then a crash zoom on the hero's drop
// point, then the hero pod fall of the hero drop. Touchdown ends it.
//
// Per seat (R-INTRO-16): state, camera, prompt, countdown, deploy. Flow
// and triggers: systems/intro_flow. Map init (gt_IntroPrepare): black,
// cinematic mode, the seat's input held. End of gt_MapInit (gf_IntroStart): hero
// out of the world, dialogs hidden, music, creep seed, prompt, first cut.
// One trigger writes the camera in the intro (gt_IntroTick).

// --- Shots -------------------------------------------------------------

fixed gf_IntroSmooth (fixed lp_u) {
    return lp_u * lp_u * (3.0 - 2.0 * lp_u);
}

// Eased progress, as ease() in scripts/hitvolumes/intro_shots.py.
fixed gf_IntroEase (int lp_ease, fixed lp_u, fixed lp_length) {
    fixed lv_u = MinF(MaxF(lp_u, 0.0), 1.0);
    fixed lv_r = c_INTRO_ARC_RAMP;
    fixed lv_v = 1.0 / (1.0 - c_INTRO_ARC_RAMP);
    fixed lv_w;

    if (lp_ease == c_INTRO_EASE_E || lp_ease == c_INTRO_EASE_Z) {
        return gf_IntroSmooth(lv_u);
    }
    if (lp_ease == c_INTRO_EASE_L) {
        return lv_u;
    }
    if (lp_ease == c_INTRO_EASE_S) {
        return 0.0;
    }
    if (lp_ease == c_INTRO_EASE_A) {
        if (lv_u < lv_r) {
            return lv_v * lv_u * lv_u / (2.0 * lv_r);
        }
        if (lv_u > 1.0 - lv_r) {
            return 1.0 - lv_v * (1.0 - lv_u) * (1.0 - lv_u) / (2.0 * lv_r);
        }
        return lv_v * (lv_u - lv_r / 2.0);
    }
    if (lp_ease == c_INTRO_EASE_O) {
        return 1.0 - (1.0 - lv_u) * (1.0 - lv_u) * (1.0 - lv_u);
    }
    // c_INTRO_EASE_C: O over c_INTRO_CRASH_MOVE, then held.
    lv_w = MinF(lv_u * lp_length / c_INTRO_CRASH_MOVE, 1.0);
    return 1.0 - (1.0 - lv_w) * (1.0 - lv_w) * (1.0 - lv_w);
}

fixed gf_IntroLerp (fixed lp_a, fixed lp_b, fixed lp_e) {
    return lp_a + (lp_b - lp_a) * lp_e;
}

void gf_IntroDofSet (int lp_player, bool lp_on) {
    gv_introDof[lp_player] = lp_on;
    if (lp_on) {
        CameraSetValue(lp_player, c_cameraValueDepthOfField, c_INTRO_DOF_ON, 0.0, 0.0, 0.0);
        CameraSetValue(lp_player, c_cameraValueFocalDepth, c_INTRO_DOF_FOCUS, 0.0, 0.0, 0.0);
        CameraSetValue(lp_player, c_cameraValueFalloffStart, c_INTRO_DOF_FAR_START, 0.0, 0.0, 0.0);
        CameraSetValue(lp_player, c_cameraValueFalloffEnd, c_INTRO_DOF_FAR_END, 0.0, 0.0, 0.0);
        CameraSetValue(lp_player, c_cameraValueFalloffStartNear, c_INTRO_DOF_NEAR_START, 0.0, 0.0, 0.0);
        CameraSetValue(lp_player, c_cameraValueFalloffEndNear, c_INTRO_DOF_NEAR_END, 0.0, 0.0, 0.0);
        return;
    }
    CameraSetValue(lp_player, c_cameraValueDepthOfField, 0.0, 0.0, 0.0, 0.0);
    CameraSetValue(lp_player, c_cameraValueFocalDepth, c_INTRO_DFLT_FOCUS, 0.0, 0.0, 0.0);
    CameraSetValue(lp_player, c_cameraValueFalloffStart, c_INTRO_DFLT_FAR_START, 0.0, 0.0, 0.0);
    CameraSetValue(lp_player, c_cameraValueFalloffEnd, c_INTRO_DFLT_FAR_END, 0.0, 0.0, 0.0);
    CameraSetValue(lp_player, c_cameraValueFalloffStartNear, 0.0, 0.0, 0.0, 0.0);
    CameraSetValue(lp_player, c_cameraValueFalloffEndNear, 0.0, 0.0, 0.0, 0.0);
}

// Every intro scene: near DOF (operator 2026-11-17); far DOF only on the
// rows flagged dof in the shot table.
void gf_IntroSceneDof (int lp_player, int lp_row, bool lp_far) {
    // The row's focal distance: its arm, or a set focus (S1, operator 2026-11-18).
    fixed lv_d = gv_introRow_focus[lp_row];
    // Falloffs are distances from the focal plane: SMALLER = MORE blur
    // (aimdof pick: near 0.2..1.8 blurred hardest). Strength divides them.
    fixed lv_k = lv_d / c_INTRO_DOF_FOCUS / (c_INTRO_SCENE_NEAR_SCALE * gv_introRow_near[lp_row]);

    gf_IntroDofSet(lp_player, true);
    // Near DOF scaled to the shot's arm and lowered (operator 2026-11-17:
    // the S8 Predator arm is 2, intro near 1..6 is for focus 16).
    CameraSetValue(lp_player, c_cameraValueFocalDepth, lv_d, 0.0, 0.0, 0.0);
    CameraSetValue(lp_player, c_cameraValueFalloffStartNear, c_INTRO_DOF_NEAR_START * lv_k, 0.0, 0.0, 0.0);
    CameraSetValue(lp_player, c_cameraValueFalloffEndNear, c_INTRO_DOF_NEAR_END * lv_k, 0.0, 0.0, 0.0);
    // Per-shot far blur (table far > 0): far x arm past the focus; smaller = more.
    if (gv_introRow_far[lp_row] > 0.0) {
        CameraSetValue(lp_player, c_cameraValueFalloffStart, lv_d * gv_introRow_far[lp_row], 0.0, 0.0, 0.0);
        CameraSetValue(lp_player, c_cameraValueFalloffEnd, lv_d * gv_introRow_far[lp_row] * 3.0, 0.0, 0.0, 0.0);
        return;
    }
    if (!lp_far) {
        CameraSetValue(lp_player, c_cameraValueFalloffStart, c_CAM_DOF_FAR_NONE, 0.0, 0.0, 0.0);
        CameraSetValue(lp_player, c_cameraValueFalloffEnd, c_CAM_DOF_FAR_NONE * 2.0, 0.0, 0.0, 0.0);
    }
}

// Camera at progress lp_u of row lp_row, blended over lp_time (0 at a cut).
void gf_IntroApply (int lp_player, int lp_row, fixed lp_u, fixed lp_time) {
    fixed lv_e = gf_IntroEase(gv_introRow_ease[lp_row], lp_u, gv_introRow_length[lp_row]);
    bool lv_odd = ModI(gv_introPass[lp_player], 2) == 1;
    fixed lv_x0 = gv_introRow_x0[lp_row];
    fixed lv_y0 = gv_introRow_y0[lp_row];
    fixed lv_x1 = gv_introRow_x1[lp_row];
    fixed lv_y1 = gv_introRow_y1[lp_row];
    fixed lv_yaw0 = gv_introRow_yaw0[lp_row];
    fixed lv_yaw1 = gv_introRow_yaw1[lp_row];
    fixed lv_swap;
    fixed lv_z;
    point lv_target;

    if (lv_odd && gv_introRow_variant[lp_row] == c_INTRO_VAR_TARGET) {
        lv_swap = lv_x0; lv_x0 = lv_x1; lv_x1 = lv_swap;
        lv_swap = lv_y0; lv_y0 = lv_y1; lv_y1 = lv_swap;
    }
    if (lv_odd && gv_introRow_variant[lp_row] == c_INTRO_VAR_YAW) {
        lv_swap = lv_yaw0; lv_yaw0 = lv_yaw1; lv_yaw1 = lv_swap;
    }
    if (lp_row == c_INTRO_ROW_ZOOM) {
        // The zoom ends on the drop's first frame: the drop yaw, and the
        // look ray through the pod's Birth start meets the ground at the
        // landing spot (SPEC-HERO-DROP 3), moved by the drop's side arm.
        lv_yaw0 = c_DROP_YAW;
        lv_yaw1 = c_DROP_YAW;
        lv_target = gf_HeroDropSide(gv_introDropAt[lp_player], c_DROP_YAW);
    }
    else {
        lv_target = Point(gf_IntroLerp(lv_x0, lv_x1, lv_e), gf_IntroLerp(lv_y0, lv_y1, lv_e));
    }
    gv_introYaw[lp_player] = gf_IntroLerp(lv_yaw0, lv_yaw1, lv_e);
    gv_introTarget[lp_player] = lv_target;
    gv_introPitch[lp_player] = gf_IntroLerp(gv_introRow_pitch0[lp_row], gv_introRow_pitch1[lp_row], lv_e);
    gv_introFov[lp_player] = gf_IntroLerp(gv_introRow_fov0[lp_row], gv_introRow_fov1[lp_row], lv_e);
    if (gv_introRow_ease[lp_row] == c_INTRO_EASE_Z) {
        // Dolly zoom (R-INTRO-7): distance x tan(FOV / 2) constant.
        gv_introDist[lp_player] = c_INTRO_DOLLY_K / Tan(gv_introFov[lp_player] / 2.0);
    }
    else {
        gv_introDist[lp_player] = gf_IntroLerp(gv_introRow_dist0[lp_row], gv_introRow_dist1[lp_row], lv_e);
    }
    lv_z = gf_IntroLerp(gv_introRow_z0[lp_row], gv_introRow_z1[lp_row], lv_e);
    if (lp_row == c_INTRO_ROW_ZOOM) {
        // No height offset: the arm reaches back to the pod's start.
        lv_z = c_SCOBA_CAMERA_HEIGHT_OFFSET;
        gv_introDist[lp_player] = gf_IntroLerp(gv_introRow_dist0[lp_row], c_DROP_POD_ARM + c_POD_BIRTH_START_Z / Sin(c_POD_BIRTH_PITCH), lv_e);
    }
    // Raw only: reads 0 in this map (SPEC-INTRO F13). The table z is the
    // offset above the ground.
    gv_introGround[lp_player] = WorldHeight(c_heightMapGround, lv_target);
    gv_introHeight[lp_player] = lv_z;
    CameraPan(lp_player, lv_target, lp_time, 0.0, 0.0, false);
    gv_introSent[lp_player] = lv_target;
    CameraSetValue(lp_player, c_cameraValueYaw, gv_introYaw[lp_player], lp_time, 0.0, 0.0);
    CameraSetValue(lp_player, c_cameraValuePitch, gv_introPitch[lp_player], lp_time, 0.0, 0.0);
    CameraSetValue(lp_player, c_cameraValueDistance, gv_introDist[lp_player], lp_time, 0.0, 0.0);
    CameraSetValue(lp_player, c_cameraValueFieldOfView, gv_introFov[lp_player], lp_time, 0.0, 0.0);
    CameraSetValue(lp_player, c_cameraValueHeightOffset, gv_introHeight[lp_player], lp_time, 0.0, 0.0);
}

// The Psi Destroyer hum: on for the whole of S9, off elsewhere (operator
// 2026-11-18). One loop per seat; it fades out on the cut away.
void gf_IntroHum (int lp_player, bool lp_on) {
    if (lp_on == gv_introHumOn[lp_player]) {
        return;
    }
    gv_introHumOn[lp_player] = lp_on;
    if (lp_on) {
        SoundPlay(SoundLink(c_INTRO_PSI_HUM, c_soundIndexAny), PlayerGroupSingle(lp_player), 100.0, 0.0);
        gv_introHum[lp_player] = SoundLastPlayed();
        return;
    }
    SoundStop(gv_introHum[lp_player], true);
}

// S4: the seat's Doodad sound channel down, back to 100 % on the cut away.
void gf_IntroQuiet (int lp_player, bool lp_on) {
    if (lp_on == gv_introQuiet[lp_player]) {
        return;
    }
    gv_introQuiet[lp_player] = lp_on;
    if (lp_on) {
        SoundChannelSetVolume(PlayerGroupSingle(lp_player), c_soundCategoryDoodad, c_INTRO_CAGED_VOLUME, c_INTRO_CAGED_FADE);
        return;
    }
    SoundChannelSetVolume(PlayerGroupSingle(lp_player), c_soundCategoryDoodad, 100.0, c_INTRO_CAGED_FADE);
}

// Cut to row lp_row at time lp_t into it.
void gf_IntroCut (int lp_player, int lp_row, fixed lp_t) {
    gf_IntroHum(lp_player, lp_row == c_INTRO_ROW_PSI);
    gf_IntroQuiet(lp_player, lp_row == c_INTRO_ROW_CAGED);
    gv_introShot[lp_player] = lp_row;
    gv_introShotStart[lp_player] = TimerGetElapsed(gv_sCOBA_Clock) - lp_t;
    gv_introCuts[lp_player] += 1;
    gf_IntroSceneDof(lp_player, lp_row, gv_introRow_dof[lp_row]);
    gf_IntroApply(lp_player, lp_row, lp_t / gv_introRow_length[lp_row], 0.0);
}

// Tests: jump to shot lp_row at lp_t seconds, pass lp_pass.
void gf_IntroGoto (int lp_player, int lp_row, fixed lp_t, int lp_pass) {
    if (gv_introState[lp_player] != c_INTRO_LOOP) {
        return;
    }
    gv_introPass[lp_player] = lp_pass;
    gf_IntroCut(lp_player, lp_row, lp_t);
}

void gf_IntroLoopStep (int lp_player) {
    fixed lv_t = TimerGetElapsed(gv_sCOBA_Clock) - gv_introShotStart[lp_player];
    int lv_row = gv_introShot[lp_player];

    if (lv_t >= gv_introRow_length[lv_row]) {
        lv_t -= gv_introRow_length[lv_row];
        lv_row += 1;
        if (lv_row >= c_INTRO_SHOTS) {
            lv_row = 0;
            gv_introPass[lp_player] += 1;
        }
        // A long frame never skips a shot: the next one starts at its top
        // if the time left over is longer than it.
        if (lv_t >= gv_introRow_length[lv_row]) {
            lv_t = 0.0;
        }
        gf_IntroCut(lp_player, lv_row, lv_t);
        return;
    }
    gf_IntroApply(lp_player, lv_row, (lv_t + c_INTRO_TICK) / gv_introRow_length[lv_row], c_INTRO_TICK);
}

void gf_IntroZoomStep (int lp_player) {
    fixed lv_t = TimerGetElapsed(gv_sCOBA_Clock) - gv_introZoomStart[lp_player];
    fixed lv_len = gv_introRow_length[c_INTRO_ROW_ZOOM];

    if (lv_t >= lv_len) {
        gf_IntroFall(lp_player);
        return;
    }
    gf_IntroApply(lp_player, c_INTRO_ROW_ZOOM, (lv_t + c_INTRO_TICK) / lv_len, MinF(c_INTRO_TICK, lv_len - lv_t));
}

// --- Prompt ------------------------------------------------------------

void gf_IntroPromptCreate () {
    DialogCreate(c_INTRO_PROMPT_W, c_INTRO_PROMPT_H, c_anchorBottom, 0, c_INTRO_PROMPT_OFFSET, false);
    gv_introPrompt = DialogLastCreated();
    DialogSetImageVisible(gv_introPrompt, false);
    libNtve_gf_CreateDialogItemLabel(gv_introPrompt, c_INTRO_PROMPT_W, c_INTRO_PROMPT_H, c_anchorCenter, 0, 0, StringToText("Press SPACE to deploy"), Color(100,100,100), false, 0.0);
    gv_introPromptLabel = DialogControlLastCreated();
    libNtve_gf_SetDialogItemStyle(gv_introPromptLabel, "SCOBAIntroPrompt", PlayerGroupAll());
    DialogSetRenderPriority(gv_introPrompt, 600);
    // Shown per seat (gf_IntroStartSeat).
}

void gf_IntroPromptHide (int lp_player) {
    if (gv_introPrompt != c_invalidDialogId) {
        DialogSetVisible(gv_introPrompt, PlayerGroupSingle(lp_player), false);
    }
}

// --- Creep seed (R-INTRO-13) ------------------------------------------

void gf_IntroSeedOrder (unit lp_unit) {
    int lv_side = 1;
    region lv_dest = gv_sPAWNLOCATIONS[1];
    point lv_gate;

    if (PlayerRace(UnitGetOwner(lp_unit)) == "Terr") {
        lv_side = 0;
        lv_dest = gv_sPAWNLOCATIONS[4];
    }
    UnitIssueOrder(lp_unit, OrderTargetingPoint(AbilityCommand("attack", 0), RegionGetCenter(gv_xLOCATIONS[1])), c_orderQueueReplace);
    lv_gate = gf_GatePick(lv_side, 1);
    if (lv_gate != null) {
        UnitIssueOrder(lp_unit, OrderTargetingPoint(AbilityCommand("attack", 0), lv_gate), c_orderQueueAddToEnd);
    }
    UnitIssueOrder(lp_unit, OrderTargetingPoint(AbilityCommand("attack", 0), RegionRandomPoint(lv_dest)), c_orderQueueAddToEnd);
}

void gf_IntroSeedGroup (unitgroup lp_group) {
    UnitGroupLoopBegin(lp_group);
    for ( ; !UnitGroupLoopDone() ; UnitGroupLoopStep() ) {
        UnitSetState(UnitGroupLoopCurrent(), c_unitStateHighlightable, true);
        // First to the X center, so the two groups' paths cross there
        // (operator 2026-11-17: they walked past each other); then on
        // through the enemy half's gate, queued.
        gf_IntroSeedOrder(UnitGroupLoopCurrent());
        gv_introSeeded += 1;
    }
    UnitGroupLoopEnd();
}

void gf_IntroSeed () {
    point lv_x = RegionGetCenter(gv_xLOCATIONS[1]);
    point lv_terran = PointWithOffset(lv_x, c_INTRO_SEED_OFFSET, c_INTRO_SEED_OFFSET);
    point lv_zerg = PointWithOffset(lv_x, -c_INTRO_SEED_OFFSET, -c_INTRO_SEED_OFFSET);
    unitgroup lv_group;

    // c_INTRO_SEED_BACK cells back toward each side's own spawn, so the
    // groups do not fight at once (operator 2026-11-17).
    lv_terran = PointWithOffsetPolar(lv_terran, c_INTRO_SEED_BACK, AngleBetweenPoints(lv_terran, RegionGetCenter(gv_sPAWNLOCATIONS[1])));
    lv_zerg = PointWithOffsetPolar(lv_zerg, c_INTRO_SEED_BACK, AngleBetweenPoints(lv_zerg, RegionGetCenter(gv_sPAWNLOCATIONS[4])));

    lv_group = gf_CreateSpawnGroup(4, "Marine", 1, lv_terran);
    libNtve_gf_CreateUnitsAtPoint2(1, "Goliath", 0, 1, lv_terran);
    UnitGroupAddUnitGroup(lv_group, UnitLastCreatedGroup());
    gf_IntroSeedGroup(lv_group);
    gv_introSeedTerran = UnitGroupCopy(lv_group);
    lv_group = gf_CreateSpawnGroup(8, "Zergling", 4, lv_zerg);
    libNtve_gf_CreateUnitsAtPoint2(2, "Roach", 0, 4, lv_zerg);
    UnitGroupAddUnitGroup(lv_group, UnitLastCreatedGroup());
    gf_IntroSeedGroup(lv_group);
    gv_introSeedZerg = UnitGroupCopy(lv_group);
}
