// Module: systems/aim_shooting

bool gf_AimTargetInRange (int lp_player, unit lp_unit) {
    unit lv_hero;

    lv_hero = gv_tPSUNIT[lp_player];
    if (!UnitIsValid(lv_hero) || !UnitIsValid(lp_unit)) {
        return false;
    }
    return UnitInRangeAndAbleToAttackTarget(lv_hero, lp_unit);
}

// The first enabled weapon of the hero, or 0.
int gf_AimWeaponIndex (int lp_player) {
    unit lv_hero;
    int lv_index;
    int lv_count;

    lv_hero = gv_tPSUNIT[lp_player];
    if (!UnitIsValid(lv_hero)) {
        return 0;
    }
    lv_count = UnitWeaponCount(lv_hero);
    for (lv_index = 1; lv_index <= lv_count; lv_index += 1) {
        if (UnitWeaponIsEnabled(lv_hero, lv_index)) {
            return lv_index;
        }
    }
    return 0;
}

fixed gf_AimWeaponRange (int lp_player) {
    int lv_index;

    lv_index = gf_AimWeaponIndex(lp_player);
    if (lv_index <= 0) {
        return 0.0;
    }
    return UnitWeaponRange(gv_tPSUNIT[lp_player], lv_index);
}

point gf_AimCrosshairPoint (int lp_player) {
    unit lv_hero;
    point lv_origin;
    fixed lv_yaw;
    fixed lv_pitch;
    fixed lv_cos;
    fixed lv_dx;
    fixed lv_dy;
    fixed lv_dz;
    fixed lv_x;
    fixed lv_y;
    fixed lv_z;
    fixed lv_ray_z;
    fixed lv_ground;
    fixed lv_dist;

    lv_hero = gv_tPSUNIT[lp_player];
    if (!UnitIsValid(lv_hero)) {
        return CameraGetTarget(lp_player);
    }
    lv_origin = gf_AimProxyPoint(lp_player);
    lv_yaw = CameraGetYaw(lp_player);
    lv_pitch = CameraGetPitch(lp_player);
    if (lv_pitch > 180.0) {
        lv_pitch = lv_pitch - 360.0;
    }
    lv_cos = Cos(lv_pitch);
    lv_dx = Cos(lv_yaw) * lv_cos;
    lv_dy = Sin(lv_yaw) * lv_cos;
    lv_dz = -Sin(lv_pitch);
    lv_z = PointGetHeight(UnitGetPosition(lv_hero)) + c_SCOBA_CROSSHAIR_ORIGIN_HEIGHT;
    lv_dist = c_SCOBA_CROSSHAIR_MIN_RANGE;
    while (lv_dist <= c_SCOBA_CROSSHAIR_MAX_RANGE) {
        lv_x = PointGetX(lv_origin) + (lv_dx * lv_dist);
        lv_y = PointGetY(lv_origin) + (lv_dy * lv_dist);
        lv_ray_z = lv_z + (lv_dz * lv_dist);
        lv_ground = WorldHeight(c_heightMapGround, Point(lv_x, lv_y));
        if (lv_ray_z <= lv_ground) {
            return libNtve_gf_PointFromXYZ(lv_x, lv_y, lv_ground);
        }
        lv_dist = lv_dist + c_SCOBA_CROSSHAIR_STEP;
    }
    return libNtve_gf_PointFromXYZ(
        PointGetX(lv_origin) + (lv_dx * c_SCOBA_CROSSHAIR_MAX_RANGE),
        PointGetY(lv_origin) + (lv_dy * c_SCOBA_CROSSHAIR_MAX_RANGE),
        lv_z + (lv_dz * c_SCOBA_CROSSHAIR_MAX_RANGE)
    );
}

unit gf_AimUnitAtCrosshair (int lp_player, bool lp_enemyOnly) {
    unit lv_hero;
    unit lv_unit;
    unit lv_best;
    unitgroup lv_group;
    point lv_originPoint;
    point lv_unitPoint;
    fixed lv_yaw;
    fixed lv_pitch;
    fixed lv_cos;
    fixed lv_dx;
    fixed lv_dy;
    fixed lv_dz;
    fixed lv_ox;
    fixed lv_oy;
    fixed lv_oz;
    fixed lv_ux;
    fixed lv_uy;
    fixed lv_uz;
    fixed lv_t;
    fixed lv_perp;
    fixed lv_bestPerp;
    fixed lv_radius;

    lv_hero = gv_tPSUNIT[lp_player];
    if (!UnitIsValid(lv_hero)) {
        return null;
    }
    lv_originPoint = gf_AimProxyPoint(lp_player);
    lv_ox = PointGetX(lv_originPoint);
    lv_oy = PointGetY(lv_originPoint);
    lv_oz = PointGetHeight(UnitGetPosition(lv_hero)) + c_SCOBA_CROSSHAIR_ORIGIN_HEIGHT;
    lv_yaw = CameraGetYaw(lp_player);
    lv_pitch = CameraGetPitch(lp_player);
    if (lv_pitch > 180.0) {
        lv_pitch = lv_pitch - 360.0;
    }
    lv_cos = Cos(lv_pitch);
    lv_dx = Cos(lv_yaw) * lv_cos;
    lv_dy = Sin(lv_yaw) * lv_cos;
    lv_dz = -Sin(lv_pitch);
    lv_group = UnitGroup(null, c_playerAny, RegionCircle(lv_originPoint, c_SCOBA_CROSSHAIR_MAX_RANGE), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_best = null;
    lv_bestPerp = c_SCOBA_CROSSHAIR_MAX_RANGE * c_SCOBA_CROSSHAIR_MAX_RANGE;
    UnitGroupLoopBegin(lv_group);
    for ( ; !UnitGroupLoopDone() ; UnitGroupLoopStep() ) {
        lv_unit = UnitGroupLoopCurrent();
        if (!gf_UnitTargetValid(lp_player, lv_unit, lp_enemyOnly) || !UnitIsAlive(lv_unit)) {
            continue;
        }
        lv_unitPoint = UnitGetPosition(lv_unit);
        lv_ux = PointGetX(lv_unitPoint) - lv_ox;
        lv_uy = PointGetY(lv_unitPoint) - lv_oy;
        lv_uz = PointGetHeight(lv_unitPoint) - lv_oz;
        lv_t = (lv_ux * lv_dx) + (lv_uy * lv_dy) + (lv_uz * lv_dz);
        if (lv_t < c_SCOBA_CROSSHAIR_MIN_RANGE || lv_t > c_SCOBA_CROSSHAIR_MAX_RANGE) {
            continue;
        }
        lv_perp = (lv_ux * lv_ux) + (lv_uy * lv_uy) + (lv_uz * lv_uz) - (lv_t * lv_t);
        lv_radius = UnitGetPropertyFixed(lv_unit, c_unitPropRadius, c_unitPropNormal) + c_SCOBA_CLICK_MARGIN;
        if (lv_perp > (lv_radius * lv_radius)) {
            continue;
        }
        if (lv_perp < lv_bestPerp) {
            lv_best = lv_unit;
            lv_bestPerp = lv_perp;
        }
    }
    UnitGroupLoopEnd();
    return lv_best;
}

unit gf_AimTargetAtCrosshair (int lp_player) {
    return gf_AimUnitAtCrosshair(lp_player, true);
}

// The shot proxy: one neutral unit per player. It stands on the aim ray,
// inside weapon range, at the ray's height (R-TPS-53, 54, 59). The stock
// unit is unselectable, uncommandable, and immune to damage.
unit gf_TpsProxyPlace (int lp_player) {
    unit lv_hero;
    int lv_weapon;
    point lv_from;
    point lv_aim;
    point lv_at;
    fixed lv_min;
    fixed lv_max;
    fixed lv_dist;
    fixed lv_shot;
    fixed lv_angle;
    fixed lv_eye;
    fixed lv_height;

    lv_hero = gv_tPSUNIT[lp_player];
    lv_weapon = gf_AimWeaponIndex(lp_player);
    lv_from = UnitGetPosition(lv_hero);
    lv_aim = gf_AimCrosshairPoint(lp_player);
    lv_min = StringToFixed(CatalogFieldValueGet(c_gameCatalogWeapon, UnitWeaponGet(lv_hero, lv_weapon), "MinimumRange", lp_player)) + c_SCOBA_AIM_POINT_RANGE_MARGIN;
    lv_max = UnitWeaponRange(lv_hero, lv_weapon) - c_SCOBA_AIM_POINT_RANGE_MARGIN;
    if (lv_max < lv_min) {
        lv_max = lv_min;
    }
    lv_dist = DistanceBetweenPoints(lv_from, lv_aim);
    lv_angle = CameraGetYaw(lp_player);
    if (lv_dist >= c_SCOBA_CROSSHAIR_MIN_RANGE) {
        lv_angle = AngleBetweenPoints(lv_from, lv_aim);
    }
    lv_shot = MaxF(lv_min, MinF(lv_max, lv_dist));
    lv_at = PointWithOffsetPolar(lv_from, lv_shot, lv_angle);
    // The ray height at the shot distance, above the ground there.
    lv_eye = PointGetHeight(lv_from) + c_SCOBA_CROSSHAIR_ORIGIN_HEIGHT;
    lv_height = 0.0;
    if (lv_dist >= c_SCOBA_CROSSHAIR_MIN_RANGE) {
        lv_height = lv_eye + ((PointGetHeight(lv_aim) - lv_eye) * (lv_shot / lv_dist)) - WorldHeight(c_heightMapGround, lv_at);
    }
    lv_height = MaxF(0.0, lv_height);
    if (!UnitIsValid(gv_tpsProxy[lp_player])) {
        libNtve_gf_CreateUnitsAtPoint2(1, c_SCOBA_TPS_PROXY_UNIT, 0, 0, lv_at);
        gv_tpsProxy[lp_player] = UnitLastCreated();
        UnitSetState(gv_tpsProxy[lp_player], c_unitStateSelectable, false);
        UnitSetState(gv_tpsProxy[lp_player], c_unitStateStatusBar, false);
    }
    UnitSetPosition(gv_tpsProxy[lp_player], lv_at, false);
    UnitSetHeight(gv_tpsProxy[lp_player], lv_height, 0.0);
    gv_tpsProxyHeight[lp_player] = lv_height;
    return gv_tpsProxy[lp_player];
}

void gf_TpsProxyRemove (int lp_player) {
    if (UnitIsValid(gv_tpsProxy[lp_player])) {
        UnitRemove(gv_tpsProxy[lp_player]);
    }
    gv_tpsProxy[lp_player] = null;
}

void gf_TpsShotClear (int lp_player) {
    gv_tpsShotKind[lp_player] = c_TPS_SHOT_NONE;
    gv_tpsShotTarget[lp_player] = null;
}

// The effect one aim shot runs: the weapon's own effect. A shot that ends
// at the proxy in the air hits nothing, so it runs the weapon's air effect:
// the same launch, no hit. A weapon without an air effect keeps its effect.
string gf_AimShotEffect (int lp_player, string lp_weapon, unit lp_target) {
    if (lp_weapon == c_SCOBA_WEAPON_TOSH && lp_target == gv_tpsProxy[lp_player] && gv_tpsProxyHeight[lp_player] > c_TPS_PROXY_AIR_HEIGHT) {
        return c_SCOBA_SHOT_TOSH_AIR;
    }
    return CatalogFieldValueGet(c_gameCatalogWeapon, lp_weapon, "Effect", lp_player);
}

// The engine fired a hero weapon. If it is the pending aim shot, its text
// floats now (R-TPS-70 to 72). Nothing else creates these floaters.
void gf_TpsShotFired (int lp_player, unit lp_target) {
    int lv_kind;

    lv_kind = gv_tpsShotKind[lp_player];
    if (lv_kind == c_TPS_SHOT_NONE || lp_target != gv_tpsShotTarget[lp_player]) {
        return;
    }
    if (lv_kind == c_TPS_SHOT_OUT_OF_RANGE) {
        gv_aimOutOfRange[lp_player] += 1;
    }
    gf_UiFloaterShow(lp_player, lv_kind);
    gf_TpsShotClear(lp_player);
}

// A pending shot whose weapon effect event did not come within
// c_TPS_SHOT_TIMEOUT is dropped. It leaves no text and does not block the
// next click.
void gf_TpsShotExpire (int lp_player) {
    if (gv_tpsShotKind[lp_player] == c_TPS_SHOT_NONE) {
        return;
    }
    if ((GameGetMissionTime() - gv_tpsShotAt[lp_player]) < c_TPS_SHOT_TIMEOUT) {
        return;
    }
    gf_TpsShotClear(lp_player);
}

// The aim click: exactly one hero shot (R-TPS-50). The engine runs the
// weapon's effect from the hero at the target: damage, launch, sound, and
// the button clock are the weapon's own data. The shot holds no order, so a
// walking hero keeps walking (R-TPS-61). The weapon's cooldown is started
// with the time the weapon data states. It never sets the UI target
// (R-TPS-82).
void gf_AimShotPress (int lp_player) {
    unit lv_hero;
    unit lv_unit;
    unit lv_target;
    int lv_kind;
    int lv_index;
    string lv_weapon;
    string lv_effect;

    if (!gf_IsHeroPlayer(lp_player) || !gv_aIMACTIVE[lp_player]) {
        return;
    }
    lv_hero = gv_tPSUNIT[lp_player];
    if (!UnitIsValid(lv_hero) || !UnitIsAlive(lv_hero)) {
        return;
    }
    gv_aimShotPresses += 1;
    // On cooldown or with a shot under way: no shot, no text (R-TPS-58).
    if (UnitGetCooldown(lv_hero, c_SCOBA_ATTACK_COOLDOWN) > 0.0 || gv_tpsShotKind[lp_player] != c_TPS_SHOT_NONE) {
        return;
    }
    lv_index = gf_AimWeaponIndex(lp_player);
    if (lv_index <= 0) {
        return;
    }
    lv_unit = gf_AimUnitAtCrosshair(lp_player, false);
    lv_kind = c_TPS_SHOT_MISS;
    lv_target = null;
    if (UnitIsValid(lv_unit)) {
        lv_kind = c_TPS_SHOT_HIT;
        if (gf_IsClickFriendly(lp_player, lv_unit)) {
            lv_kind = c_TPS_SHOT_FRIENDLY;
        }
        if (gf_AimTargetInRange(lp_player, lv_unit)) {
            lv_target = lv_unit;
        }
        else if (lv_kind == c_TPS_SHOT_HIT) {
            lv_kind = c_TPS_SHOT_OUT_OF_RANGE;
        }
    }
    if (lv_target == null) {
        lv_target = gf_TpsProxyPlace(lp_player);
    }
    lv_weapon = UnitWeaponGet(lv_hero, lv_index);
    lv_effect = gf_AimShotEffect(lp_player, lv_weapon, lv_target);
    gv_tpsShotKind[lp_player] = lv_kind;
    gv_tpsShotTarget[lp_player] = lv_target;
    gv_tpsShotAt[lp_player] = GameGetMissionTime();
    gv_tpsShotEffect[lp_player] = lv_effect;
    UnitCreateEffectUnit(lv_hero, lv_effect, lv_target);
    UnitAddCooldown(lv_hero, c_SCOBA_ATTACK_COOLDOWN, StringToFixed(CatalogFieldValueGet(c_gameCatalogWeapon, lv_weapon, "Cost.Cooldown.TimeUse", lp_player)));
}

bool gt_AimShootingInit_Func (bool testConds, bool runActions) {
    int lv_player;

    if (!runActions) {
        return true;
    }
    for (lv_player = c_SCOBA_HERO_FIRST; lv_player <= c_SCOBA_HERO_LAST; lv_player += 1) {
        gv_animAimAttackUntil[lv_player] = -1.0;
        gv_animTargetPitchStep[lv_player] = 0;
        gv_animTargetPitchTime[lv_player] = -1.0;
        gv_aimShots[lv_player] = 0;
        gv_aimOutOfRange[lv_player] = 0;
    }
    return true;
}

void gt_AimShootingInit_Init () {
    gt_AimShootingInit = TriggerCreate("gt_AimShootingInit_Func");
    TriggerAddEventMapInit(gt_AimShootingInit);
}
