// Module: systems/animation_aim

fixed gf_AnimDirCenter (int lp_dir) {
    if (lp_dir == c_ANIM_DIR_FORWARD_LEFT) {
        return 45.0;
    }
    if (lp_dir == c_ANIM_DIR_LEFT) {
        return 90.0;
    }
    if (lp_dir == c_ANIM_DIR_BACK_LEFT) {
        return 135.0;
    }
    if (lp_dir == c_ANIM_DIR_BACK) {
        return 180.0;
    }
    if (lp_dir == c_ANIM_DIR_BACK_RIGHT) {
        return -135.0;
    }
    if (lp_dir == c_ANIM_DIR_RIGHT) {
        return -90.0;
    }
    if (lp_dir == c_ANIM_DIR_FORWARD_RIGHT) {
        return -45.0;
    }
    return 0.0;
}

int gf_AnimNearestDir (fixed lp_delta) {
    if (lp_delta >= 157.5 || lp_delta <= -157.5) {
        return c_ANIM_DIR_BACK;
    }
    if (lp_delta >= 112.5) {
        return c_ANIM_DIR_BACK_LEFT;
    }
    if (lp_delta >= 67.5) {
        return c_ANIM_DIR_LEFT;
    }
    if (lp_delta >= 22.5) {
        return c_ANIM_DIR_FORWARD_LEFT;
    }
    if (lp_delta > -22.5) {
        return c_ANIM_DIR_FORWARD;
    }
    if (lp_delta > -67.5) {
        return c_ANIM_DIR_FORWARD_RIGHT;
    }
    if (lp_delta > -112.5) {
        return c_ANIM_DIR_RIGHT;
    }
    return c_ANIM_DIR_BACK_RIGHT;
}

int gf_AnimPickDir (int lp_player, fixed lp_delta) {
    int lv_current;

    lv_current = gv_animAimDir[lp_player];
    if (lv_current >= 0 && lv_current < c_ANIM_DIR_COUNT) {
        if (AbsF(gf_AnimYawDelta(gf_AnimDirCenter(lv_current), lp_delta)) <= (22.5 + c_ANIM_DIR_HYSTERESIS)) {
            return lv_current;
        }
    }
    return gf_AnimNearestDir(lp_delta);
}

fixed gf_AnimInputHeading (int lp_player) {
    fixed lv_yaw;

    lv_yaw = CameraGetYaw(lp_player);
    if (gv_fORWARD[lp_player] && !gv_bACKWARD[lp_player]) {
        if (gv_lEFT[lp_player]) {
            lv_yaw = lv_yaw + 45.0;
        }
        if (gv_rIGHT[lp_player]) {
            lv_yaw = lv_yaw - 45.0;
        }
        return lv_yaw;
    }
    if (gv_bACKWARD[lp_player] && !gv_fORWARD[lp_player]) {
        lv_yaw = lv_yaw + 180.0;
        if (gv_lEFT[lp_player]) {
            lv_yaw = lv_yaw - 45.0;
        }
        if (gv_rIGHT[lp_player]) {
            lv_yaw = lv_yaw + 45.0;
        }
        return lv_yaw;
    }
    if (gv_lEFT[lp_player]) {
        return lv_yaw + 90.0;
    }
    if (gv_rIGHT[lp_player]) {
        return lv_yaw - 90.0;
    }
    return lv_yaw;
}

void gf_AnimUpdateAimDir (int lp_player) {
    fixed lv_delta;

    if (!gf_StrafeMoveActive(lp_player)) {
        return;
    }
    if (!gf_MovementKeyHeld(lp_player)) {
        return;
    }
    lv_delta = gf_AnimYawDelta(CameraGetYaw(lp_player), gf_AnimInputHeading(lp_player));
    gv_animAimDir[lp_player] = gf_AnimPickDir(lp_player, lv_delta);
}

void gf_AnimUpdateAimTurn (int lp_player) {
    fixed lv_yaw;
    fixed lv_delta;

    if (!gv_aIMACTIVE[lp_player]) {
        return;
    }
    lv_yaw = CameraGetYaw(lp_player);
    if (!gv_animAimYawSeen[lp_player]) {
        gv_animAimYawLast[lp_player] = lv_yaw;
        gv_animAimYawSeen[lp_player] = true;
        gv_animAimTurn[lp_player] = 0;
        gv_animAimTurnHold[lp_player] = 0;
        return;
    }
    lv_delta = gf_AnimYawDelta(gv_animAimYawLast[lp_player], lv_yaw);
    gv_animAimYawLast[lp_player] = lv_yaw;
    if (AbsF(lv_delta) > c_ANIM_AIM_TURN_DEADBAND) {
        if (lv_delta > 0.0) {
            gv_animAimTurn[lp_player] = c_ANIM_LOWER_TURN_LEFT;
        }
        else {
            gv_animAimTurn[lp_player] = c_ANIM_LOWER_TURN_RIGHT;
        }
        gv_animAimTurnHold[lp_player] = c_ANIM_AIM_TURN_HOLD_TICKS;
        return;
    }
    if (gv_animAimTurnHold[lp_player] > 0) {
        gv_animAimTurnHold[lp_player] -= 1;
        if (gv_animAimTurnHold[lp_player] <= 0) {
            gv_animAimTurn[lp_player] = 0;
        }
        return;
    }
    gv_animAimTurn[lp_player] = 0;
}

void gf_AnimConfigAimAll (int lp_profile, int lp_state, string lp_clip) {
    int lv_dir;

    for (lv_dir = 0; lv_dir < c_ANIM_DIR_COUNT; lv_dir += 1) {
        gv_animAimClip[lp_profile][lp_state][lv_dir] = lp_clip;
    }
}

void gf_AnimConfigAimDir (int lp_profile, int lp_state, int lp_dir, string lp_clip) {
    gv_animAimClip[lp_profile][lp_state][lp_dir] = lp_clip;
}

void gf_AnimConfigAimWalk (int lp_profile, int lp_state) {
    gf_AnimConfigAimDir(lp_profile, lp_state, c_ANIM_DIR_FORWARD, "Attack,Walk,Forward");
    gf_AnimConfigAimDir(lp_profile, lp_state, c_ANIM_DIR_FORWARD_LEFT, "Attack,Walk,Forward,Left");
    gf_AnimConfigAimDir(lp_profile, lp_state, c_ANIM_DIR_LEFT, "Attack,Walk,Left");
    gf_AnimConfigAimDir(lp_profile, lp_state, c_ANIM_DIR_BACK_LEFT, "Attack,Walk,Back,Left");
    gf_AnimConfigAimDir(lp_profile, lp_state, c_ANIM_DIR_BACK, "Attack,Walk,Back");
    gf_AnimConfigAimDir(lp_profile, lp_state, c_ANIM_DIR_BACK_RIGHT, "Attack,Walk,Back,Right");
    gf_AnimConfigAimDir(lp_profile, lp_state, c_ANIM_DIR_RIGHT, "Attack,Walk,Right");
    gf_AnimConfigAimDir(lp_profile, lp_state, c_ANIM_DIR_FORWARD_RIGHT, "Attack,Walk,Forward,Right");
}
// Slow walk leg clips per direction (R-SLOW-11; walkanim.slow bakes them).
void gf_AnimConfigAimSlow (int lp_profile, int lp_state) {
    gf_AnimConfigAimDir(lp_profile, lp_state, c_ANIM_DIR_FORWARD, "Attack,Walk,Slow,Forward");
    gf_AnimConfigAimDir(lp_profile, lp_state, c_ANIM_DIR_FORWARD_LEFT, "Attack,Walk,Slow,Forward,Left");
    gf_AnimConfigAimDir(lp_profile, lp_state, c_ANIM_DIR_LEFT, "Attack,Walk,Slow,Left");
    gf_AnimConfigAimDir(lp_profile, lp_state, c_ANIM_DIR_BACK_LEFT, "Attack,Walk,Slow,Back,Left");
    gf_AnimConfigAimDir(lp_profile, lp_state, c_ANIM_DIR_BACK, "Attack,Walk,Slow,Back");
    gf_AnimConfigAimDir(lp_profile, lp_state, c_ANIM_DIR_BACK_RIGHT, "Attack,Walk,Slow,Back,Right");
    gf_AnimConfigAimDir(lp_profile, lp_state, c_ANIM_DIR_RIGHT, "Attack,Walk,Slow,Right");
    gf_AnimConfigAimDir(lp_profile, lp_state, c_ANIM_DIR_FORWARD_RIGHT, "Attack,Walk,Slow,Forward,Right");
    // The upper body when not aiming (R-SLOW-19).
    gf_AnimConfigUpper(lp_profile, c_ANIM_UPPER_WALK_SLOW, "Walk,Slow,Arm", c_ANIM_SLOW_BLEND);
    gf_AnimConfigUpper(lp_profile, c_ANIM_UPPER_WALK_SLOW_BACK, "Walk,Slow,Arm,Back", c_ANIM_SLOW_BLEND);
}
string gf_AnimAimPitchNum (int lp_value) {
    if (lp_value < 10) {
        return "0" + IntToString(lp_value);
    }
    return IntToString(lp_value);
}
string gf_AnimAimPitchClip (int lp_step) {
    return "Ready,Alternate," + gf_AnimAimPitchNum(lp_step);
}
void gf_AnimAimPitchTick (int lp_player) {
    unit lv_hero;
    actor lv_actor;
    fixed lv_pitch;
    fixed lv_time;
    fixed lv_camera;
    fixed lv_ratio;
    int lv_step;
    string lv_clip;

    if (!gv_aIMACTIVE[lp_player]) {
        return;
    }
    if (!gv_animAimUpperOn[lp_player]) {
        return;
    }
    lv_hero = gv_tPSUNIT[lp_player];
    if (!UnitIsValid(lv_hero)) {
        return;
    }
    gv_animAimPitchTicks[lp_player] += 1;
    lv_camera = CameraGetPitch(lp_player);
    if (lv_camera > 180.0) {
        lv_camera = lv_camera - 360.0;
    }
    lv_pitch = gv_animAimPitchRest[lp_player] - lv_camera;
    if (lv_pitch > c_ANIM_AIM_PITCH_MAX) {
        lv_pitch = c_ANIM_AIM_PITCH_MAX;
    }
    if (lv_pitch < c_ANIM_AIM_PITCH_MIN) {
        lv_pitch = c_ANIM_AIM_PITCH_MIN;
    }
    lv_ratio = (lv_pitch - c_ANIM_AIM_PITCH_MIN) / (c_ANIM_AIM_PITCH_MAX - c_ANIM_AIM_PITCH_MIN);
    lv_time = lv_ratio * c_ANIM_AIM_PITCH_TIME;
    lv_step = FixedToInt(Round(lv_ratio * (c_ANIM_AIM_PITCH_STEPS - 1))) + 1;
    if (lv_step < 1) {
        lv_step = 1;
    }
    if (lv_step > c_ANIM_AIM_PITCH_STEPS) {
        lv_step = c_ANIM_AIM_PITCH_STEPS;
    }
    if (lv_step == gv_animAimPitchStep[lp_player]) {
        return;
    }
    lv_clip = gf_AnimAimPitchClip(lv_step);
    lv_actor = libNtve_gf_MainActorofUnit(lv_hero);
    ActorSend(lv_actor, MakeMsgAnimPlay(c_ANIM_BRACKET_UPPER, lv_clip, c_animFlagPlayForever, 0.06, 0.06, c_animTimeDefault, c_animTimeVariantAsAutomatic));
    gf_AnimAimBreathSync(lp_player, lv_hero);
    gv_animAimPitchStep[lp_player] = lv_step;
    gv_animAimPitchTime[lp_player] = lv_time;
    gv_animAimPitchSends[lp_player] += 1;
    gf_AnimEvent(lp_player, "pitch_step", lv_clip, lv_step);
    gf_ProbeSetUpperClip(lp_player, lv_clip);
}

// Aim pose breathing (R-TPS-19). A new pitch step is a new clip and would
// start its breath over. Every pitch clip of a hero is one breath long, so
// the new clip is set to the game clock's place in the breath: the breath
// runs on across pitch steps.
void gf_AnimAimBreathSync (int lp_player, unit lp_hero) {
    fixed lv_period;

    lv_period = gv_animBreathPeriod[gf_AnimHeroProfile(lp_hero)];
    if (lv_period <= 0.0) {
        return;
    }
    gv_animBreathPhase[lp_player] = ModF(TimerGetElapsed(gv_sCOBA_Clock), lv_period);
    ActorSend(libNtve_gf_MainActorofUnit(lp_hero), "AnimSetTime " + c_ANIM_BRACKET_UPPER + " " + FixedToString(gv_animBreathPhase[lp_player], c_fixedPrecisionAny) + " 0");
    gv_animBreathSyncs[lp_player] += 1;
}

int gf_AnimTargetPitchKey (fixed lp_pitch) {
    fixed lv_ratio;
    int lv_step;

    if (lp_pitch > c_ANIM_AIM_PITCH_MAX) {
        lp_pitch = c_ANIM_AIM_PITCH_MAX;
    }
    if (lp_pitch < c_ANIM_AIM_PITCH_MIN) {
        lp_pitch = c_ANIM_AIM_PITCH_MIN;
    }
    lv_ratio = (lp_pitch - c_ANIM_AIM_PITCH_MIN) / (c_ANIM_AIM_PITCH_MAX - c_ANIM_AIM_PITCH_MIN);
    lv_step = FixedToInt(Round(lv_ratio * (c_ANIM_AIM_PITCH_STEPS - 1))) + 1;
    if (lv_step < 1) {
        lv_step = 1;
    }
    if (lv_step > c_ANIM_AIM_PITCH_STEPS) {
        lv_step = c_ANIM_AIM_PITCH_STEPS;
    }
    return lv_step;
}

void gf_AnimTargetPitchApply (int lp_player, int lp_step) {
    unit lv_hero;
    actor lv_actor;
    string lv_clip;

    if (gv_aIMACTIVE[lp_player]) {
        return;
    }
    if (lp_step == gv_animTargetPitchStep[lp_player]) {
        return;
    }
    lv_hero = gv_tPSUNIT[lp_player];
    if (!UnitIsValid(lv_hero)) {
        return;
    }
    lv_clip = gf_AnimAimPitchClip(lp_step);
    lv_actor = libNtve_gf_MainActorofUnit(lv_hero);
    ActorSend(lv_actor, MakeMsgAnimPlay(c_ANIM_BRACKET_UPPER, lv_clip, c_animFlagPlayForever, 0.06, 0.06, c_animTimeDefault, c_animTimeVariantAsAutomatic));
    gf_AnimAimBreathSync(lp_player, lv_hero);
    gv_animTargetPitchStep[lp_player] = lp_step;
    gv_animTargetPitchTime[lp_player] = ((lp_step - 1) * c_ANIM_AIM_PITCH_TIME) / (c_ANIM_AIM_PITCH_STEPS - 1);
    gf_AnimEvent(lp_player, "target_pitch_step", lv_clip, lp_step);
}

void gf_AnimTargetPitchBegin (int lp_player, unit lp_target) {
    gv_animAttackTarget[lp_player] = lp_target;
    gf_AnimTargetPitchTick(lp_player);
}

void gf_AnimTargetPitchTick (int lp_player) {
    unit lv_hero;
    unit lv_target;
    fixed lv_dz;
    fixed lv_dist;
    fixed lv_pitch;

    if (gv_aIMACTIVE[lp_player]) {
        return;
    }
    lv_hero = gv_tPSUNIT[lp_player];
    if (!UnitIsValid(lv_hero)) {
        return;
    }
    lv_target = gv_animAttackTarget[lp_player];
    if (!UnitIsValid(lv_target)) {
        lv_target = gv_unitTarget[lp_player];
        gv_animAttackTarget[lp_player] = lv_target;
    }
    lv_pitch = c_ANIM_AIM_PITCH_REST;
    if (UnitIsValid(lv_target)) {
        lv_dz = gf_UnitWorldZ(lv_target) - gf_UnitWorldZ(lv_hero);
        lv_dist = DistanceBetweenPoints(UnitGetPosition(lv_hero), UnitGetPosition(lv_target));
        if (lv_dist > 0.01) {
            lv_pitch = c_ANIM_AIM_PITCH_REST + ATan2(lv_dz, lv_dist);
        }
    }
    gf_AnimTargetPitchApply(lp_player, gf_AnimTargetPitchKey(lv_pitch));
}

void gf_AnimTargetPitchClear (int lp_player) {
    gv_animTargetPitchStep[lp_player] = 0;
    gv_animTargetPitchTime[lp_player] = -1.0;
}

void gf_AnimHeadClear (int lp_player) {
    gv_animHeadLookSeen[lp_player] = false;
    gv_animHeadLookYaw[lp_player] = 0.0;
    gv_animHeadLookWant[lp_player] = 0.0;
    gv_animHeadLookPitch[lp_player] = 0.0;
    gv_animHeadLookPitchWant[lp_player] = 0.0;
    if (gv_animHeadStep[lp_player] == 0) {
        return;
    }
    gv_animHeadStep[lp_player] = 0;
    if (UnitIsValid(gv_tPSUNIT[lp_player])) {
        ActorSend(libNtve_gf_MainActorofUnit(gv_tPSUNIT[lp_player]), "AnimClear " + c_ANIM_BRACKET_HEAD);
    }
}

fixed gf_AnimHeadSignedPitch (fixed lp_cameraPitch) {
    if (lp_cameraPitch > 180.0) {
        return lp_cameraPitch - 360.0;
    }
    return lp_cameraPitch;
}

// The step for an angle on a symmetric range: 1 at -max, the last at +max.
int gf_AnimHeadStepOf (fixed lp_angle, fixed lp_max, int lp_steps) {
    fixed lv_angle;

    lv_angle = MaxF(-lp_max, MinF(lp_max, lp_angle));
    return FixedToInt(Round(((lv_angle + lp_max) / (2.0 * lp_max)) * (lp_steps - 1))) + 1;
}

// The pitch step for a camera pitch: 1 is fully down, the last is fully up.
int gf_AnimHeadStep (fixed lp_cameraPitch) {
    return gf_AnimHeadStepOf((c_ANIM_HEAD_LEVEL_PITCH - gf_AnimHeadSignedPitch(lp_cameraPitch)) * c_ANIM_HEAD_SCALE, c_ANIM_HEAD_MAX, c_ANIM_HEAD_STEPS);
}

// Head look (R-TPS-16, operator 2026-11-21): the head looks at a point
// c_ANIM_HEAD_LOOK_DIST along the screen-centre ray past the
// camera target. Wanted yaw (minus facing) and pitch (up +) go from the eye
// to that point, clamped to the head range; the shown angles ease to them
// with c_ANIM_HEAD_LOOK_TAU. The torso and the facing are not touched. The
// ray is the same as gf_AimPickRay's, computed here so the shot globals are
// left alone.
void gf_AnimHeadLookUpdate (int lp_player, unit lp_hero) {
    fixed lv_now = GameGetMissionTime();
    fixed lv_k;
    point lv_from = gf_AimCameraFocus(lp_player);
    fixed lv_pitch = gf_AnimHeadSignedPitch(CameraGetPitch(lp_player));
    fixed lv_reach = Cos(lv_pitch) * c_ANIM_HEAD_LOOK_DIST;
    fixed lv_dx = PointGetX(lv_from) + Cos(CameraGetYaw(lp_player)) * lv_reach - PointGetX(UnitGetPosition(lp_hero));
    fixed lv_dy = PointGetY(lv_from) + Sin(CameraGetYaw(lp_player)) * lv_reach - PointGetY(UnitGetPosition(lp_hero));
    // Camera target height minus eye height, then down the ray.
    fixed lv_dz = gf_CameraTargetOffset(lp_hero) - gf_CameraUnitHeight(lp_hero) * c_ANIM_HEAD_EYE_FRAC - Sin(lv_pitch) * c_ANIM_HEAD_LOOK_DIST;

    gv_animHeadLookWant[lp_player] = MaxF(-c_ANIM_HEAD_YAW_MAX, MinF(c_ANIM_HEAD_YAW_MAX, gf_AnimYawDelta(UnitGetFacing(lp_hero), AngleBetweenPoints(Point(0.0, 0.0), Point(lv_dx, lv_dy)))));
    gv_animHeadLookPitchWant[lp_player] = MaxF(-c_ANIM_HEAD_MAX, MinF(c_ANIM_HEAD_MAX, ATan2(lv_dz, SquareRoot(lv_dx * lv_dx + lv_dy * lv_dy))));
    if (!gv_animHeadLookSeen[lp_player]) {
        gv_animHeadLookSeen[lp_player] = true;
        gv_animHeadLookYaw[lp_player] = gv_animHeadLookWant[lp_player];
        gv_animHeadLookPitch[lp_player] = gv_animHeadLookPitchWant[lp_player];
        gv_animHeadLookAt[lp_player] = lv_now;
    }
    lv_k = MinF(1.0, MaxF(0.0, lv_now - gv_animHeadLookAt[lp_player]) / c_ANIM_HEAD_LOOK_TAU);
    gv_animHeadLookAt[lp_player] = lv_now;
    gv_animHeadLookYaw[lp_player] += (gv_animHeadLookWant[lp_player] - gv_animHeadLookYaw[lp_player]) * lv_k;
    gv_animHeadLookPitch[lp_player] += (gv_animHeadLookPitchWant[lp_player] - gv_animHeadLookPitch[lp_player]) * lv_k;
}

// The step for an angle, kept at lp_current (1-based, 0 none) while the
// angle stays within c_ANIM_HEAD_HOLD step widths of its center.
int gf_AnimHeadHoldStep (int lp_current, fixed lp_angle, fixed lp_max, int lp_steps) {
    int lv_step = gf_AnimHeadStepOf(lp_angle, lp_max, lp_steps);
    fixed lv_width = 2.0 * lp_max / IntToFixed(lp_steps - 1);
    fixed lv_center;

    if (lp_current < 1 || lp_current == lv_step) {
        return lv_step;
    }
    lv_center = -lp_max + IntToFixed(lp_current - 1) * lv_width;
    if (AbsF(MaxF(-lp_max, MinF(lp_max, lp_angle)) - lv_center) < c_ANIM_HEAD_HOLD * lv_width) {
        return lp_current;
    }
    return lv_step;
}

// TPS, not aiming: the head looks at the look point (R-TPS-16), so it
// tilts with the camera pitch (R-TPS-13). Aiming pitches the whole
// torso instead (R-TPS-14). A middle hold turns it off with the rest of the
// TPS body rules.
void gf_AnimHeadTick (int lp_player) {
    unit lv_hero;
    int lv_profile;
    int lv_step;
    int lv_pitchNow = 0;
    int lv_yawNow = 0;

    lv_hero = gv_tPSUNIT[lp_player];
    if (!UnitIsValid(lv_hero)) {
        gv_animHeadStep[lp_player] = 0;
        return;
    }
    lv_profile = gf_AnimHeroProfile(lv_hero);
    if (!gf_TpsActive(lp_player) || gv_aIMACTIVE[lp_player] || gv_mOUSEMIDDLE[lp_player] || (lv_profile != c_ANIM_HERO_TOSH && lv_profile != c_ANIM_HERO_KERRIGAN)) {
        gf_AnimHeadClear(lp_player);
        return;
    }
    gf_AnimHeadLookUpdate(lp_player, lv_hero);
    if (gv_animHeadStep[lp_player] > 0) {
        lv_pitchNow = ModI(gv_animHeadStep[lp_player] - 1, c_ANIM_HEAD_STEPS) + 1;
        lv_yawNow = (gv_animHeadStep[lp_player] - 1) / c_ANIM_HEAD_STEPS + 1;
    }
    lv_step = gf_AnimHeadHoldStep(lv_pitchNow, gv_animHeadLookPitch[lp_player], c_ANIM_HEAD_MAX, c_ANIM_HEAD_STEPS);
    lv_step += (gf_AnimHeadHoldStep(lv_yawNow, gv_animHeadLookYaw[lp_player], c_ANIM_HEAD_YAW_MAX, c_ANIM_HEAD_YAW_STEPS) - 1) * c_ANIM_HEAD_STEPS;
    if (lv_step == gv_animHeadStep[lp_player]) {
        return;
    }
    ActorSend(libNtve_gf_MainActorofUnit(lv_hero), MakeMsgAnimPlay(c_ANIM_BRACKET_HEAD, "Ready,Cover," + gf_AnimAimPitchNum(lv_step), c_animFlagPlayForever, c_ANIM_HEAD_BLEND, c_ANIM_HEAD_BLEND, c_animTimeDefault, c_animTimeVariantAsAutomatic));
    gv_animHeadStep[lp_player] = lv_step;
    gv_animHeadSends[lp_player] += 1;
}

bool gt_AnimPitchTick_Func (bool testConds, bool runActions) {
    int lv_player;

    if (!runActions) {
        return true;
    }
    for (lv_player = c_SCOBA_HERO_FIRST; lv_player <= c_SCOBA_HERO_LAST; lv_player += 1) {
        gf_AnimHeadTick(lv_player);
        gf_AnimAimPitchTick(lv_player);
    }
    return true;
}

void gt_AnimPitchTick_Init () {
    gt_AnimPitchTick = TriggerCreate("gt_AnimPitchTick_Func");
    TriggerAddEventTimePeriodic(gt_AnimPitchTick, c_ANIM_AIM_PITCH_TICK, c_timeGame);
    TriggerAddEventCameraMove(gt_AnimPitchTick, c_playerAny, c_cameraMoveReasonAny);
}
