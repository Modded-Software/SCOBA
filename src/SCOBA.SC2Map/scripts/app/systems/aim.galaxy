// Module: systems/aim

point gf_AimShoulderPoint (int lp_player) {
    unit lv_hero;
    point lv_pos;
    fixed lv_yaw;
    fixed lv_x;
    fixed lv_y;

    lv_hero = gv_tPSUNIT[lp_player];
    if (!UnitIsValid(lv_hero)) {
        return Point(0.0, 0.0);
    }
    lv_pos = UnitGetPosition(lv_hero);
    lv_yaw = CameraGetYaw(lp_player) + c_SCOBA_AIM_SHOULDER_ANGLE;
    lv_x = PointGetX(lv_pos) + (Cos(lv_yaw) * c_SCOBA_AIM_SHOULDER_OFFSET);
    lv_y = PointGetY(lv_pos) + (Sin(lv_yaw) * c_SCOBA_AIM_SHOULDER_OFFSET);
    return Point(lv_x, lv_y);
}

point gf_AimProxyPoint (int lp_player) {
    unit lv_hero;
    point lv_pos;
    fixed lv_yaw;
    fixed lv_x;
    fixed lv_y;
    fixed lv_offset;

    lv_hero = gv_tPSUNIT[lp_player];
    if (!UnitIsValid(lv_hero)) {
        return Point(0.0, 0.0);
    }
    lv_pos = UnitGetPosition(lv_hero);
    lv_yaw = CameraGetYaw(lp_player) + c_SCOBA_AIM_SHOULDER_ANGLE;
    lv_offset = c_SCOBA_AIM_SHOULDER_OFFSET;
    lv_x = PointGetX(lv_pos) + (Cos(lv_yaw) * lv_offset);
    lv_y = PointGetY(lv_pos) + (Sin(lv_yaw) * lv_offset);
    return Point(lv_x, lv_y);
}

void gf_AimProxyCreate (int lp_player) {
    point lv_point;

    if (UnitIsValid(gv_aimCameraProxy[lp_player])) {
        return;
    }
    lv_point = gf_AimProxyPoint(lp_player);
    libNtve_gf_UnitCreateFacingPoint(1, "InvisibleTargetDummy", 0, lp_player, lv_point, lv_point);
    gv_aimCameraProxy[lp_player] = UnitLastCreated();
    UnitSetState(gv_aimCameraProxy[lp_player], c_unitStateSelectable, false);
    UnitSetState(gv_aimCameraProxy[lp_player], c_unitStateStatusBar, false);
}

void gf_AimProxyDestroy (int lp_player) {
    if (UnitIsValid(gv_aimCameraProxy[lp_player])) {
        UnitRemove(gv_aimCameraProxy[lp_player]);
    }
    gv_aimCameraProxy[lp_player] = null;
}

void gf_AimDebugDump (int lp_player) {
    bank lv_bank;

    lv_bank = BankLoad("SCOBACAMDBG", lp_player);
    BankSectionCreate(lv_bank, "aim");
    BankValueSetFromString(lv_bank, "aim", "ticks", IntToString(gv_aimDbgTicks[lp_player]));
    BankValueSetFromString(lv_bank, "aim", "maxstep", FixedToString(gv_aimDbgMaxStep[lp_player], c_fixedPrecisionAny));
    BankValueSetFromString(lv_bank, "aim", "clamps", IntToString(gv_aimDbgClamps[lp_player]));
    BankValueSetFromString(lv_bank, "aim", "desired", FixedToString(gv_cameraDistanceDesired[lp_player], c_fixedPrecisionAny));
    BankValueSetFromString(lv_bank, "aim", "current", FixedToString(CameraGetDistance(lp_player), c_fixedPrecisionAny));
    BankSave(lv_bank);
}

void gf_AimCameraTick (int lp_player) {
    point lv_target;
    fixed lv_step;

    if (!gv_aIMACTIVE[lp_player]) {
        return;
    }
    if (!UnitIsValid(gv_aimCameraProxy[lp_player])) {
        return;
    }
    lv_target = gf_AimProxyPoint(lp_player);
    lv_step = DistanceBetweenPoints(Point(gv_aimDbgLastX[lp_player], gv_aimDbgLastY[lp_player]), lv_target);
    if (lv_step > gv_aimDbgMaxStep[lp_player]) {
        gv_aimDbgMaxStep[lp_player] = lv_step;
    }
    gv_aimDbgLastX[lp_player] = PointGetX(lv_target);
    gv_aimDbgLastY[lp_player] = PointGetY(lv_target);
    gv_aimDbgTicks[lp_player] += 1;
    UnitSetPosition(gv_aimCameraProxy[lp_player], lv_target, true);
}

void gf_AimCameraSet (int lp_player, bool lp_aim) {
    unit lv_hero;
    unitgroup lv_group;

    lv_hero = gv_tPSUNIT[lp_player];
    if (!UnitIsValid(lv_hero)) {
        return;
    }
    if (lp_aim) {
        gf_AimProxyCreate(lp_player);
        lv_group = libNtve_gf_ConvertUnitToUnitGroup(lv_hero);
        UnitGroupAddUnitGroup(lv_group, libNtve_gf_ConvertUnitToUnitGroup(gv_aimCameraProxy[lp_player]));
        CameraFollowUnitGroup(lp_player, lv_group, true, false);
    }
    else {
        gf_AimProxyDestroy(lp_player);
        CameraFollowUnitGroup(lp_player, libNtve_gf_ConvertUnitToUnitGroup(lv_hero), true, false);
    }
}

void gf_AimBegin (int lp_player) {
    point lv_proxy;

    if (!gf_IsHeroPlayer(lp_player)) {
        return;
    }
    if (gv_aIMACTIVE[lp_player]) {
        return;
    }
    if (!UnitIsValid(gv_tPSUNIT[lp_player])) {
        return;
    }
    gv_aIMACTIVE[lp_player] = true;
    UnitBehaviorAdd(gv_tPSUNIT[lp_player], "SCOBAAimNoTurn", gv_tPSUNIT[lp_player], 1);
    if (!gf_MovementKeyHeld(lp_player)) {
        gf_AimMoveStop(lp_player);
    }
    gf_AnimReset(lp_player);
    CameraSetValue(lp_player, c_cameraValueFieldOfView, c_SCOBA_AIM_FOV, 0.2, -1, 10);
    if (gv_cameraDistanceDesired[lp_player] <= 0.0) {
        gv_cameraDistanceDesired[lp_player] = CameraGetDistance(lp_player);
    }
    gv_cameraAimSavedDistance[lp_player] = gv_cameraDistanceDesired[lp_player];
    gv_cameraDistanceDesired[lp_player] = gv_cameraDistanceDesired[lp_player] * c_SCOBA_AIM_ARM_SCALE;
    gf_CameraZoomApply(lp_player);
    gf_AimCameraSet(lp_player, true);
    lv_proxy = gf_AimProxyPoint(lp_player);
    gv_aimDbgMaxStep[lp_player] = 0.0;
    gv_aimDbgTicks[lp_player] = 0;
    gv_aimDbgClamps[lp_player] = 0;
    gv_aimDbgLastX[lp_player] = PointGetX(lv_proxy);
    gv_aimDbgLastY[lp_player] = PointGetY(lv_proxy);
    gf_ControlApply(lp_player);
}

void gf_AimEnd (int lp_player) {
    unit lv_hero;
    actor lv_actor;

    if (!gf_IsHeroPlayer(lp_player)) {
        return;
    }
    if (!gv_aIMACTIVE[lp_player]) {
        return;
    }
    if (!gf_MovementKeyHeld(lp_player)) {
        gf_AimMoveStop(lp_player);
    }
    if (UnitIsValid(gv_tPSUNIT[lp_player])) {
        UnitSetFacing(gv_tPSUNIT[lp_player], CameraGetYaw(lp_player), c_ANIM_AIM_TURN_DURATION);
        UnitBehaviorRemove(gv_tPSUNIT[lp_player], "SCOBAAimNoTurn", 1);
    }
    gv_aIMACTIVE[lp_player] = false;
    gf_AimDebugDump(lp_player);
    gv_animAimUpperOn[lp_player] = false;
    gv_animAimPitchTime[lp_player] = -1.0;
    gv_animAimPitchStep[lp_player] = 0;
    gf_AnimReset(lp_player);
    lv_hero = gv_tPSUNIT[lp_player];
    if (UnitIsValid(lv_hero)) {
        lv_actor = libNtve_gf_MainActorofUnit(lv_hero);
        ActorSend(lv_actor, "AnimBlendTimeRemove");
        ActorSend(ActorFromActor(lv_actor, "Model"), "AnimBlendTimeRemove");
    }
    if (gv_cAMERAFOV[lp_player] <= 0.0) {
        gv_cAMERAFOV[lp_player] = c_SCOBA_REST_FOV;
    }
    CameraSetValue(lp_player, c_cameraValueFieldOfView, gv_cAMERAFOV[lp_player], 0.2, -1, 10);
    gf_AimCameraSet(lp_player, false);
    if (gv_cameraAimSavedDistance[lp_player] > 0.0) {
        gv_cameraDistanceDesired[lp_player] = gv_cameraAimSavedDistance[lp_player];
        gf_CameraZoomApply(lp_player);
        gv_cameraAimSavedDistance[lp_player] = 0.0;
    }
    gf_ControlApply(lp_player);
}

bool gt_AimInit_Func (bool testConds, bool runActions) {
    int lv_player;

    if (!runActions) {
        return true;
    }
    for (lv_player = c_SCOBA_HERO_FIRST; lv_player <= c_SCOBA_HERO_LAST; lv_player += 1) {
        gv_aIMACTIVE[lv_player] = false;
        gv_aimCameraProxy[lv_player] = null;
        gv_cAMERAFOV[lv_player] = c_SCOBA_REST_FOV;
    }
    return true;
}

void gt_AimInit_Init () {
    gt_AimInit = TriggerCreate("gt_AimInit_Func");
    TriggerAddEventMapInit(gt_AimInit);
}

int gf_ReticleKindAt (int lp_player, point lp_point) {
    unit lv_unit;

    if (!gf_IsHeroPlayer(lp_player)) {
        return 0;
    }
    lv_unit = gf_UnitTargetAtPoint(lp_player, lp_point, false);
    if (!UnitIsValid(lv_unit)) {
        return 0;
    }
    if (gf_IsClickEnemy(lp_player, lv_unit)) {
        return 1;
    }
    if (UnitGetOwner(lv_unit) == lp_player) {
        return 2;
    }
    return 0;
}

int gf_ReticleKind (int lp_player) {
    if (!gf_IsHeroPlayer(lp_player)) {
        return 0;
    }
    return gf_ReticleKindAt(lp_player, CameraGetTarget(lp_player));
}

void gf_ReticleCreate (int lp_player) {
    playergroup lv_group;

    if (gv_reticleDialog[lp_player] != c_invalidDialogId) {
        return;
    }
    lv_group = PlayerGroupSingle(lp_player);
    DialogCreate(32, 32, c_anchorCenter, 0, 0, false);
    gv_reticleDialog[lp_player] = DialogLastCreated();
    DialogSetImageVisible(gv_reticleDialog[lp_player], false);
    libNtve_gf_CreateDialogItemImage(gv_reticleDialog[lp_player], 32, 32, c_anchorCenter, 0, 0, StringToText(""), "Assets\\Textures\\cursor-target-none.dds", c_triggerImageTypeNormal, false, Color(255,255,255), c_triggerBlendModeNormal);
    gv_reticleBase[lp_player] = DialogControlLastCreated();
    libNtve_gf_CreateDialogItemImage(gv_reticleDialog[lp_player], 32, 32, c_anchorCenter, 0, 0, StringToText(""), "Assets\\Textures\\storm_ui_cursor_default_enemy.dds", c_triggerImageTypeNormal, false, Color(255,255,255), c_triggerBlendModeNormal);
    gv_reticleEnemy[lp_player] = DialogControlLastCreated();
    libNtve_gf_CreateDialogItemImage(gv_reticleDialog[lp_player], 32, 32, c_anchorCenter, 0, 0, StringToText(""), "Assets\\Textures\\storm_ui_cursor_default_friendly.dds", c_triggerImageTypeNormal, false, Color(255,255,255), c_triggerBlendModeNormal);
    gv_reticleFriendly[lp_player] = DialogControlLastCreated();
    DialogControlSetVisible(gv_reticleBase[lp_player], lv_group, true);
    DialogControlSetVisible(gv_reticleEnemy[lp_player], lv_group, false);
    DialogControlSetVisible(gv_reticleFriendly[lp_player], lv_group, false);
    DialogSetVisible(gv_reticleDialog[lp_player], lv_group, false);
}

bool gt_AimCursorTick_Func (bool testConds, bool runActions) {
    int lv_player;
    int lv_kind;
    playergroup lv_group;
    bool lv_visible;

    if (!runActions) {
        return true;
    }
    for (lv_player = c_SCOBA_HERO_FIRST; lv_player <= c_SCOBA_HERO_LAST; lv_player += 1) {
        if (!gf_IsHeroPlayer(lv_player)) {
            continue;
        }
        gf_ReticleCreate(lv_player);
        lv_group = PlayerGroupSingle(lv_player);
        lv_visible = gf_ActionModeActive(lv_player) && !gv_aCTIONALT[lv_player];
        DialogSetVisible(gv_reticleDialog[lv_player], lv_group, lv_visible);
        if (!lv_visible) {
            continue;
        }
        lv_kind = gf_ReticleKind(lv_player);
        DialogControlSetVisible(gv_reticleBase[lv_player], lv_group, lv_kind == 0);
        DialogControlSetVisible(gv_reticleEnemy[lv_player], lv_group, lv_kind == 1);
        DialogControlSetVisible(gv_reticleFriendly[lv_player], lv_group, lv_kind == 2);
    }
    return true;
}

void gt_AimCursorTick_Init () {
    gt_AimCursorTick = TriggerCreate("gt_AimCursorTick_Func");
    TriggerAddEventTimePeriodic(gt_AimCursorTick, 0.01, c_timeGame);
}

bool gt_AimCameraTick_Func (bool testConds, bool runActions) {
    int lv_player;

    if (!runActions) {
        return true;
    }
    for (lv_player = c_SCOBA_HERO_FIRST; lv_player <= c_SCOBA_HERO_LAST; lv_player += 1) {
        if (!gf_IsHeroPlayer(lv_player)) {
            continue;
        }
        gf_AimCameraTick(lv_player);
    }
    return true;
}

void gt_AimCameraTick_Init () {
    gt_AimCameraTick = TriggerCreate("gt_AimCameraTick_Func");
    TriggerAddEventTimePeriodic(gt_AimCameraTick, 0.02, c_timeGame);
}