// Module: systems/scene
// The cinematic scene per seat (SPEC-HERO-DROP 3b). The intro loop enters
// it with c_SCENE_INTRO, the drop sequence with c_SCENE_DROP. The first
// owner turns it on, the last one off. Nothing else writes cinematic mode,
// the UI mode, the minimap, the map dialogs or the input hold.

bool gf_SceneActive (int lp_player) {
    if (lp_player < 0 || lp_player >= 16) {
        return false;
    }
    return gv_sceneOwners[lp_player] != 0;
}

bool gf_SceneHas (int lp_player, int lp_owner) {
    if (lp_player < 0 || lp_player >= 16) {
        return false;
    }
    return (gv_sceneOwners[lp_player] & lp_owner) != 0;
}

// Map dialogs of a seat hidden in the scene (R-INTRO-2).
int gf_SceneDialog (int lp_player, int lp_i) {
    if (lp_i == 0) { return gv_pbInfoDlg; }
    if (lp_i == 1) { return gv_pbXpDlg[lp_player]; }
    if (lp_i == 2) { return gv_pbHpDlg[lp_player]; }
    if (lp_i == 3) { return gv_pbNrgDlg[lp_player]; }
    if (lp_i == 4) { return gv_singleButtonDialog; }
    if (lp_i == 5) { return gv_singleButtonDialogAbilities; }
    if (lp_i == 6) { return gv_singleButtonDialogInventory; }
    if (lp_i == 7) { return gv_hudMapDialog[0]; }
    if (lp_i == 8) { return gv_hudMapDialog[1]; }
    if (lp_i == 9) { return gv_hudMapDialog[2]; }
    if (lp_i == 10) { return gv_userSelectionDialog; }
    if (lp_i == 11) { return gv_abilitiesSelectionDialog; }
    if (lp_i == 12) { return gv_abilitiesSelectionAdditionalColumnDialog; }
    if (lp_i == 13) { return gv_sCOBAOrderDialog; }
    if (lp_i == 14) { return gv_walletDialog; }
    return c_invalidDialogId;
}

// Triggers gated by the scene's input hold: player input, and every camera
// writer (R-INTRO-9, SPEC-INTRO 3.8). Each checks gf_InputHeld; none is
// disabled. The build checks that (scripts/input_gate_check.py).
trigger gf_SceneTrigger (int lp_i) {
    if (lp_i == 0) { return gt_CameraFollowDistance; }
    if (lp_i == 1) { return gt_CameraDebugMove; }
    if (lp_i == 2) { return gt_ZoomEnd; }
    if (lp_i == 3) { return gt_ZoomStart; }
    if (lp_i == 4) { return gt_CursorStart; }
    if (lp_i == 5) { return gt_CursorEnd; }
    if (lp_i == 6) { return gt_LeftOrbitStart; }
    if (lp_i == 7) { return gt_RightOrbitStart; }
    if (lp_i == 8) { return gt_CameraTurnTick; }
    if (lp_i == 9) { return gt_CameraCollisionTick; }
    if (lp_i == 10) { return gt_AimCameraTick; }
    if (lp_i == 11) { return gt_AimCursorTick; }
    if (lp_i == 12) { return gt_AimMoveTick; }
    if (lp_i == 13) { return gt_ForwardStart; }
    if (lp_i == 14) { return gt_ForwardEnd; }
    if (lp_i == 15) { return gt_BackwardStart; }
    if (lp_i == 16) { return gt_BackwardEnd; }
    if (lp_i == 17) { return gt_LeftStart; }
    if (lp_i == 18) { return gt_LeftEnd; }
    if (lp_i == 19) { return gt_RightStart; }
    if (lp_i == 20) { return gt_RightEnd; }
    if (lp_i == 21) { return gt_JumpKey; }
    if (lp_i == 22) { return gt_OrderKey; }
    if (lp_i == 23) { return gt_OrderButton; }
    if (lp_i == 24) { return gt_OrderCancel; }
    if (lp_i == 25) { return gt_TargetClick; }
    if (lp_i == 26) { return gt_TargetRelease; }
    if (lp_i == 27) { return gt_UnitClick[1]; }
    if (lp_i == 28) { return gt_HeroSwitchTosh; }
    if (lp_i == 29) { return gt_HeroSwitchKerrigan; }
    if (lp_i == 30) { return gt_TpsOn; }
    if (lp_i == 31) { return gt_TpsOff; }
    if (lp_i == 32) { return gt_KeepHeroSelected; }
    if (lp_i == 33) { return gt_QuakeTick; }
    if (lp_i == 34) { return gt_HudMapClick; }
    if (lp_i == 35) { return gt_SBDialogStatsCallback; }
    if (lp_i == 36) { return gt_UserSelectionDialogCallback; }
    if (lp_i == 37) { return gt_SBDialogAbilitiesCallback; }
    if (lp_i == 38) { return gt_AbilitiesSelectionDialogCallback; }
    if (lp_i == 39) { return gt_AbilitiesandStatsTriggerDevelopment; }
    if (lp_i == 40) { return gt_HeroSwitchScv; }
    if (lp_i == 41) { return gt_HeroSwitchViking; }
    if (lp_i == 42) { return gt_SlowKeyDown; }
    return null;
}

// Every dialog the seat sees is kept for the restore and hidden. On enter
// and every loop of the scene (gt_SceneTick).
void gf_SceneDialogsEnforce (int lp_player) {
    int lv_i;
    int lv_d;

    for (lv_i = 0; lv_i < c_SCENE_DIALOGS; lv_i += 1) {
        lv_d = gf_SceneDialog(lp_player, lv_i);
        if (lv_d != c_invalidDialogId && DialogIsVisible(lv_d, lp_player)) {
            gv_sceneDialogKept[lp_player][lv_i] = true;
            gv_sceneDialogReshown[lp_player] += 1;
            DialogSetVisible(lv_d, PlayerGroupSingle(lp_player), false);
        }
    }
}

void gf_SceneDialogsRestore (int lp_player) {
    int lv_i;
    int lv_d;

    for (lv_i = 0; lv_i < c_SCENE_DIALOGS; lv_i += 1) {
        lv_d = gf_SceneDialog(lp_player, lv_i);
        if (lv_d == c_invalidDialogId) {
            continue;
        }
        DialogSetVisible(lv_d, PlayerGroupSingle(lp_player), gv_sceneDialogKept[lp_player][lv_i]);
    }
}

// Number of the scene dialogs a seat sees (tests).
int gf_SceneDialogsVisible (int lp_player) {
    int lv_i;
    int lv_d;
    int lv_n = 0;

    for (lv_i = 0; lv_i < c_SCENE_DIALOGS; lv_i += 1) {
        lv_d = gf_SceneDialog(lp_player, lv_i);
        if (lv_d != c_invalidDialogId && DialogIsVisible(lv_d, lp_player)) {
            lv_n += 1;
        }
    }
    return lv_n;
}

// The Dflt camera DOF.
void gf_SceneDofDefault (int lp_player) {
    CameraSetValue(lp_player, c_cameraValueDepthOfField, 0.0, 0.0, 0.0, 0.0);
    CameraSetValue(lp_player, c_cameraValueFocalDepth, c_SCENE_DFLT_FOCUS, 0.0, 0.0, 0.0);
    CameraSetValue(lp_player, c_cameraValueFalloffStart, c_SCENE_DFLT_FAR_START, 0.0, 0.0, 0.0);
    CameraSetValue(lp_player, c_cameraValueFalloffEnd, c_SCENE_DFLT_FAR_END, 0.0, 0.0, 0.0);
    CameraSetValue(lp_player, c_cameraValueFalloffStartNear, 0.0, 0.0, 0.0, 0.0);
    CameraSetValue(lp_player, c_cameraValueFalloffEndNear, 0.0, 0.0, 0.0, 0.0);
}

// On: input held (mouse rotation off), cinematic mode, fullscreen UI,
// no minimap, dialogs hidden.
void gf_SceneEnter (int lp_player, int lp_owner) {
    int lv_i;
    bool lv_keep;

    if (lp_player < 0 || lp_player >= 16) {
        return;
    }
    if (gv_sceneOwners[lp_player] != 0) {
        gv_sceneOwners[lp_player] = gv_sceneOwners[lp_player] | lp_owner;
        return;
    }
    gv_sceneOwners[lp_player] = lp_owner;
    gv_sceneEnters[lp_player] += 1;
    // Cinematic mode already hid the dialogs and keeps what it found
    // (gf_CineUiHide): the scene must not forget that.
    lv_keep = gv_cineOn[lp_player];
    gv_inputHeld[lp_player] = true;
    gv_inputHolds[lp_player] += 1;
    // The hold gives no direction: a hero walking on the keys stops. The
    // keys stay stored (systems/movement).
    gf_MoveKeysChanged(lp_player);
    gf_ControlSendRelative(lp_player, false);
    CinematicMode(PlayerGroupSingle(lp_player), true, 0.0);
    UISetMode(PlayerGroupSingle(lp_player), c_uiModeFullscreen, 0.0);
    UISetFrameVisible(PlayerGroupSingle(lp_player), c_syncFrameTypeMinimapPanel, false);
    if (!lv_keep) {
        for (lv_i = 0; lv_i < c_SCENE_DIALOGS; lv_i += 1) {
            gv_sceneDialogKept[lp_player][lv_i] = false;
        }
    }
    gf_SceneDialogsEnforce(lp_player);
}

// Off when the last owner leaves: DOF default, dialogs back, input free,
// cinematic mode off, console UI, minimap. The caller sends the control
// mode again (the drop's bind).
void gf_SceneLeave (int lp_player, int lp_owner) {
    if (!gf_SceneHas(lp_player, lp_owner)) {
        return;
    }
    gv_sceneOwners[lp_player] = gv_sceneOwners[lp_player] - (gv_sceneOwners[lp_player] & lp_owner);
    if (gv_sceneOwners[lp_player] != 0) {
        return;
    }
    gf_SceneDofDefault(lp_player);
    gv_inputHeld[lp_player] = false;
    // Keys pressed in the hold and still down move the hero now (R-PNC-58).
    gf_MoveKeysChanged(lp_player);
    CinematicMode(PlayerGroupSingle(lp_player), false, c_SCENE_LETTERBOX_OUT);
    // Cinematic mode on: the UI stays hidden (fullscreen, no minimap, no
    // dialogs); F9 brings it back (gf_CineUiShow).
    if (gv_cineOn[lp_player]) {
        return;
    }
    gf_SceneDialogsRestore(lp_player);
    UISetMode(PlayerGroupSingle(lp_player), c_uiModeConsole, c_SCENE_LETTERBOX_OUT);
    UISetFrameVisible(PlayerGroupSingle(lp_player), c_syncFrameTypeMinimapPanel, true);
}

// --- Cinematic mode (REQ-CINEMATIC) -----------------------------------------
// F9: all UI hidden, input free. Shift+F9: 16:9 letterbox, only while on.

bool gf_CineOn (int lp_player) {
    if (lp_player < 0 || lp_player >= 16) {
        return false;
    }
    return gv_cineOn[lp_player];
}

// The two black bars, top and bottom: layout frames, shown per player.
void gf_CineBarsHookup () {
    if (gv_cineBarCtl[0] != c_invalidDialogControlId) {
        return;
    }
    gv_cineBarCtl[0] = DialogControlHookupStandard(c_triggerControlTypeImage, "ScobaCineTop");
    gv_cineBarCtl[1] = DialogControlHookupStandard(c_triggerControlTypeImage, "ScobaCineBottom");
}

// Bars shown to the player, sliding ones included (tests).
int gf_CineBarsVisible (int lp_player) {
    int lv_i;
    int lv_n = 0;

    for (lv_i = 0; lv_i < c_CINE_BARS; lv_i += 1) {
        if (gv_cineBarCtl[lv_i] != c_invalidDialogControlId && DialogControlIsVisible(gv_cineBarCtl[lv_i], lp_player)) {
            lv_n += 1;
        }
    }
    return lv_n;
}

// On: show the bars and slide them in. Off: slide them out; the scene
// tick hides them when the slide is done (gf_CineHideTick).
void gf_CineBoxShow (int lp_player, bool lp_on) {
    int lv_i;
    playergroup lv_group = PlayerGroupSingle(lp_player);
    string lv_event = "Out";

    gf_CineBarsHookup();
    if (lp_on) {
        lv_event = "In";
        gv_cineHideAt[lp_player] = -1.0;
        gv_cineSlideIns[lp_player] += 1;
    }
    else {
        if (gf_CineBarsVisible(lp_player) == 0) {
            return;
        }
        gv_cineHideAt[lp_player] = GameGetMissionTime() + c_CINE_HIDE_AFTER;
        gv_cineSlideOuts[lp_player] += 1;
    }
    for (lv_i = 0; lv_i < c_CINE_BARS; lv_i += 1) {
        if (lp_on) {
            DialogControlSetVisible(gv_cineBarCtl[lv_i], lv_group, true);
        }
        DialogControlSendAnimationEvent(gv_cineBarCtl[lv_i], lv_group, lv_event);
    }
}

// Hides the bars of a finished slide out.
void gf_CineHideTick (int lp_player) {
    int lv_i;

    if (gv_cineHideAt[lp_player] < 0.0 || GameGetMissionTime() < gv_cineHideAt[lp_player]) {
        return;
    }
    gv_cineHideAt[lp_player] = -1.0;
    for (lv_i = 0; lv_i < c_CINE_BARS; lv_i += 1) {
        DialogControlSetVisible(gv_cineBarCtl[lv_i], PlayerGroupSingle(lp_player), false);
    }
}

// A slide out is pending (tests).
bool gf_CineBarsLeaving (int lp_player) {
    return gv_cineHideAt[lp_player] >= 0.0;
}

// Hides the game UI, the minimap, the map dialogs, the world texts and the
// TPS texts. The crosshair follows gv_cineOn (gt_AimCursorTick). In a
// scene the scene already hid all but the texts and keeps its dialogs.
void gf_CineUiHide (int lp_player) {
    int lv_i;
    playergroup lv_group = PlayerGroupSingle(lp_player);

    if (!gf_SceneActive(lp_player)) {
        for (lv_i = 0; lv_i < c_SCENE_DIALOGS; lv_i += 1) {
            gv_sceneDialogKept[lp_player][lv_i] = false;
        }
        UISetMode(lv_group, c_uiModeFullscreen, 0.0);
        UISetFrameVisible(lv_group, c_syncFrameTypeMinimapPanel, false);
    }
    gf_SceneDialogsEnforce(lp_player);
    UISetFrameVisible(lv_group, c_syncFrameTypeTextTag, false);
    gf_UiFloaterHookup();
    DialogControlSetVisible(gv_uiFloaterPanel, lv_group, false);
}

// Brings back what gf_CineUiHide hid. In a scene only the texts: the scene
// restores the rest when it ends (gf_SceneLeave).
void gf_CineUiShow (int lp_player) {
    playergroup lv_group = PlayerGroupSingle(lp_player);

    UISetFrameVisible(lv_group, c_syncFrameTypeTextTag, true);
    gf_UiFloaterHookup();
    DialogControlSetVisible(gv_uiFloaterPanel, lv_group, true);
    if (gf_SceneActive(lp_player)) {
        return;
    }
    gf_SceneDialogsRestore(lp_player);
    UISetMode(lv_group, c_uiModeConsole, 0.0);
    UISetFrameVisible(lv_group, c_syncFrameTypeMinimapPanel, true);
}

void gf_CineSet (int lp_player, bool lp_on) {
    if (lp_player < 0 || lp_player >= 16 || gv_cineOn[lp_player] == lp_on) {
        return;
    }
    gv_cineOn[lp_player] = lp_on;
    gv_cineToggles[lp_player] += 1;
    if (lp_on) {
        gf_CineUiHide(lp_player);
        return;
    }
    // Off: the letterbox goes with it.
    gv_cineBox[lp_player] = false;
    gf_CineBoxShow(lp_player, false);
    gf_CineUiShow(lp_player);
}

// One key press. lp_shift: Shift+F9, the letterbox; refused while the
// mode is off.
void gf_CineKeyPress (int lp_player, bool lp_shift) {
    if (lp_player < 0 || lp_player >= 16) {
        return;
    }
    if (!lp_shift) {
        gf_CineSet(lp_player, !gv_cineOn[lp_player]);
        return;
    }
    if (!gv_cineOn[lp_player]) {
        gv_cineBoxRefused[lp_player] += 1;
        return;
    }
    gv_cineBox[lp_player] = !gv_cineBox[lp_player];
    gv_cineBoxToggles[lp_player] += 1;
    gf_CineBoxShow(lp_player, gv_cineBox[lp_player]);
}

bool gt_CineKey_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    gf_CineKeyPress(EventPlayer(), false);
    return true;
}

bool gt_CineBoxKey_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    gf_CineKeyPress(EventPlayer(), true);
    return true;
}

bool gt_SceneTick_Func (bool testConds, bool runActions) {
    int lv_p;

    if (!runActions) {
        return true;
    }
    for (lv_p = 0; lv_p < 16; lv_p += 1) {
        if (gv_sceneOwners[lv_p] != 0 || gv_cineOn[lv_p]) {
            gf_SceneDialogsEnforce(lv_p);
        }
        gf_CineHideTick(lv_p);
    }
    return true;
}

void gt_Scene_Init () {
    int lv_i;

    gt_SceneTick = TriggerCreate("gt_SceneTick_Func");
    TriggerAddEventTimePeriodic(gt_SceneTick, c_SCENE_TICK, c_timeGame);
    for (lv_i = 0; lv_i < c_CINE_BARS; lv_i += 1) {
        gv_cineBarCtl[lv_i] = c_invalidDialogControlId;
    }
    for (lv_i = 0; lv_i < 16; lv_i += 1) {
        gv_cineHideAt[lv_i] = -1.0;
    }
    // F9 without Shift, Shift+F9 (shift, control, alt).
    gt_CineKey = TriggerCreate("gt_CineKey_Func");
    TriggerAddEventKeyPressed(gt_CineKey, c_playerAny, c_CINE_KEY, true, c_keyModifierStateExclude, c_keyModifierStateIgnore, c_keyModifierStateIgnore);
    gt_CineBoxKey = TriggerCreate("gt_CineBoxKey_Func");
    TriggerAddEventKeyPressed(gt_CineBoxKey, c_playerAny, c_CINE_KEY, true, c_keyModifierStateRequire, c_keyModifierStateIgnore, c_keyModifierStateIgnore);
}
