// Module: systems/animation_fsm

void gf_AnimReset (int lp_player) {
    gv_animResets[lp_player] += 1;
    gf_TpsStatusHover(lp_player, null);
    gf_AnimUpperClear(lp_player);
    gf_AnimLowerClear(lp_player);
    gf_AnimHeadClear(lp_player);
    gf_JumpAnimInvalidate(lp_player);  // the lower clear above may drop a jump clip
    gv_animUpperState[lp_player] = c_ANIM_UPPER_NONE;
    gv_animLowerState[lp_player] = c_ANIM_LOWER_NONE;
    gv_animUpperClipIndex[lp_player] = -1;
    gv_animLowerClipIndex[lp_player] = -1;
    gv_animAttackState[lp_player] = c_ANIM_UPPER_NONE;
    gv_animAttackUntil[lp_player] = -1.0;
    gv_animReadyUntil[lp_player] = -1.0;
    gv_animAttackTarget[lp_player] = null;
    gv_animTargetPitchStep[lp_player] = 0;
    gv_animTargetPitchTime[lp_player] = -1.0;
    gv_animFullDir[lp_player] = -1;
    gv_animAimDir[lp_player] = c_ANIM_DIR_FORWARD;
    gv_animMoveHold[lp_player] = 0;
    gv_animHasTurnTarget[lp_player] = false;
    gv_animHasMoveTarget[lp_player] = false;
    gv_animAimYawSeen[lp_player] = false;
    gv_animAimTurn[lp_player] = 0;
    gv_animAimTurnHold[lp_player] = 0;
    gv_animFreeFacingSeen[lp_player] = false;
    gv_animFreeTurnHold[lp_player] = 0;
    gv_animAimUpperOn[lp_player] = false;
    gv_animAimPitchTime[lp_player] = -1.0;
    gv_animAimPitchStep[lp_player] = 0;
    gf_AnimAimAttackClear(lp_player);
    gv_animAimPitchRest[lp_player] = c_ANIM_AIM_PITCH_REST;
    gv_animHasPos[lp_player] = false;
    if (UnitIsValid(gv_tPSUNIT[lp_player])) {
        gv_animLastPos[lp_player] = UnitGetPosition(gv_tPSUNIT[lp_player]);
        gv_animHasPos[lp_player] = true;
    }
}
bool gf_AnimMoveIntent (int lp_player) {
    unit lv_hero;

    lv_hero = gv_tPSUNIT[lp_player];
    if (!UnitIsValid(lv_hero)) {
        return false;
    }
    if (gf_StrafeMoveActive(lp_player)) {
        return gf_MovementKeyHeld(lp_player);
    }
    if (UnitOrderCount(lv_hero) > 0 && UnitOrderHasAbil(lv_hero, "move")) {
        return true;
    }
    return false;
}
bool gf_AnimMoving (int lp_player) {
    unit lv_hero;

    lv_hero = gv_tPSUNIT[lp_player];
    if (!UnitIsValid(lv_hero) || !gv_animHasPos[lp_player]) {
        return false;
    }
    return DistanceBetweenPoints(gv_animLastPos[lp_player], UnitGetPosition(lv_hero)) > c_ANIM_MOVE_EPSILON;
}
bool gf_AnimAttackActive (int lp_player) {
    if (gv_animAttackUntil[lp_player] < 0.0) {
        return false;
    }
    return TimerGetElapsed(gv_sCOBA_Clock) < gv_animAttackUntil[lp_player];
}
// PNC pose hold (R-PNC-80): Tosh keeps the shooting pose between shots,
// while he has an attack order and for c_ANIM_READY_LINGER after a shot.
// In TPS only with Attack auto and not aiming (R-TPS-17): the aim holds its
// own pose, and Attack single fires no shot outside the aim. Not Kerrigan.
bool gf_AnimReadyHold (int lp_player) {
    unit lv_hero;

    lv_hero = gv_tPSUNIT[lp_player];
    if (!UnitIsValid(lv_hero) || !UnitIsAlive(lv_hero)) {
        return false;
    }
    if (gv_aIMACTIVE[lp_player]) {
        return false;
    }
    if (gf_TpsActive(lp_player) && !gf_CombatAutoOn(lp_player)) {
        return false;
    }
    if (gf_AnimHeroProfile(lv_hero) != c_ANIM_HERO_TOSH) {
        return false;
    }
    if (UnitOrderHasAbil(lv_hero, "attack")) {
        return true;
    }
    return gv_animReadyUntil[lp_player] >= 0.0 && TimerGetElapsed(gv_sCOBA_Clock) < gv_animReadyUntil[lp_player];
}
// Ends the linger. An attack order still holds the pose.
void gf_AnimReadyEnd (int lp_player) {
    gv_animReadyUntil[lp_player] = -1.0;
}
bool gf_AnimAimAttackActive (int lp_player) {
    if (gv_animAimAttackUntil[lp_player] < 0.0) {
        return false;
    }
    return TimerGetElapsed(gv_sCOBA_Clock) < gv_animAimAttackUntil[lp_player];
}
// Speed factor of the attack clip: reference period over the weapon period,
// so a faster weapon plays a faster, shorter clip.
fixed gf_AnimAttackSpeed (int lp_player, string lp_weapon) {
    fixed lv_period = StringToFixed(CatalogFieldValueGet(c_gameCatalogWeapon, lp_weapon, "Period", lp_player));

    if ((lv_period <= 0.0)) {
        return 1.0;
    }
    return MaxF(c_ANIM_ATTACK_SPEED_MIN, c_ANIM_ATTACK_PERIOD_REF / lv_period);
}

void gf_AnimAttackStart (int lp_player, string lp_weapon, unit lp_target) {
    unit lv_hero;
    int lv_profile;
    int lv_state;

    gv_animAttackSpeed[lp_player] = gf_AnimAttackSpeed(lp_player, lp_weapon);
    if (gv_aIMACTIVE[lp_player]) {
        gf_AnimAimAttackStart(lp_player, lp_weapon);
        return;
    }
    lv_hero = gv_tPSUNIT[lp_player];
    if (!UnitIsValid(lv_hero)) {
        return;
    }
    lv_profile = gf_AnimHeroProfile(lv_hero);
    if (lv_profile != c_ANIM_HERO_TOSH && lv_profile != c_ANIM_HERO_KERRIGAN) {
        return;
    }
    if (!UnitIsValid(lp_target)) {
        lp_target = gv_unitTarget[lp_player];
    }
    gv_animAttackTarget[lp_player] = lp_target;
    lv_state = c_ANIM_UPPER_ATTACK;
    if ((UnitGetType(lv_hero) == "Kerrigan" || UnitGetType(lv_hero) == "KerriganSCOBA") && lp_weapon == "QueenOfBladesPsiBlast") {
        lv_state = c_ANIM_UPPER_ATTACK_SPELL;
    }
    gv_animAttackState[lp_player] = lv_state;
    gv_animAttackUntil[lp_player] = TimerGetElapsed(gv_sCOBA_Clock) + (c_ANIM_ATTACK_DURATION / gv_animAttackSpeed[lp_player]);
    gv_animReadyUntil[lp_player] = TimerGetElapsed(gv_sCOBA_Clock) + c_ANIM_READY_LINGER;
    gf_AnimTargetPitchBegin(lp_player, lp_target);
    gf_AnimUpperAttackStart(lp_player, lv_state);
}
// True while the hero turns in place: its facing changed this tick (or within
// the hold) and it neither moves nor wants to. Reads the engine facing, so
// TPS rotate and PNC right-click rotate are both covered. Returns the stand
// turn state (c_ANIM_LOWER_TURN_LEFT/RIGHT, the turn-in-place leg clips) or
// c_ANIM_LOWER_NONE. Operator 2026-11-16: the walk clip was wrong here.
int gf_AnimFreeTurning (int lp_player, unit lp_hero) {
    fixed lv_facing = UnitGetFacing(lp_hero);
    fixed lv_delta;

    if (!gv_animFreeFacingSeen[lp_player]) {
        gv_animFreeFacingLast[lp_player] = lv_facing;
        gv_animFreeFacingSeen[lp_player] = true;
        return c_ANIM_LOWER_NONE;
    }
    lv_delta = gf_AnimYawDelta(gv_animFreeFacingLast[lp_player], lv_facing);
    gv_animFreeFacingLast[lp_player] = lv_facing;
    // Only real movement ends it: a rotate is a move order that turns the
    // hero before it moves (move intent alone left the stock walk playing).
    if (gf_AnimMoving(lp_player)) {
        gv_animFreeTurnHold[lp_player] = 0;
        return c_ANIM_LOWER_NONE;
    }
    if (AbsF(lv_delta) > c_ANIM_FREE_TURN_DEADBAND) {
        if (gv_animFreeTurnHold[lp_player] <= 0) {
            gv_animFreeTurns[lp_player] += 1;
        }
        if ((lv_delta > 0.0)) {
            gv_animFreeTurnState[lp_player] = c_ANIM_LOWER_TURN_LEFT;
        }
        else {
            gv_animFreeTurnState[lp_player] = c_ANIM_LOWER_TURN_RIGHT;
        }
        gv_animFreeTurnHold[lp_player] = c_ANIM_FREE_TURN_HOLD_TICKS;
        return gv_animFreeTurnState[lp_player];
    }
    if (gv_animFreeTurnHold[lp_player] > 0) {
        gv_animFreeTurnHold[lp_player] -= 1;
        return gv_animFreeTurnState[lp_player];
    }
    return c_ANIM_LOWER_NONE;
}

int gf_AnimLowerState (int lp_player) {
    if (!gf_AnimMoveIntent(lp_player) && !gf_AnimMoving(lp_player)) {
        if (gv_animMoveHold[lp_player] < c_ANIM_LOWER_HOLD_TICKS) {
            gv_animMoveHold[lp_player] += 1;
        }
        if (gv_animMoveHold[lp_player] < c_ANIM_LOWER_HOLD_TICKS) {
            if (gv_animLowerState[lp_player] != c_ANIM_LOWER_NONE && gv_animLowerState[lp_player] != c_ANIM_LOWER_IDLE) {
                return gv_animLowerState[lp_player];
            }
        }
        return c_ANIM_LOWER_IDLE;
    }
    gv_animMoveHold[lp_player] = 0;
    if (gv_bACKWARD[lp_player] && !gv_fORWARD[lp_player]) {
        return c_ANIM_LOWER_WALK_BACK;
    }
    return c_ANIM_LOWER_WALK;
}
void gf_AnimTick (int lp_player) {
    unit lv_hero;
    int lv_upper;
    int lv_lower;
    bool lv_attacking;
    int lv_turning;

    lv_hero = gv_tPSUNIT[lp_player];
    if (!UnitIsValid(lv_hero)) {
        return;
    }
    lv_attacking = gf_AnimAttackActive(lp_player);
    if (gv_aIMACTIVE[lp_player]) {
        lv_lower = gf_AnimLowerState(lp_player);
        gv_animAttackUntil[lp_player] = -1.0;
        gv_animReadyUntil[lp_player] = -1.0;
        gv_animAttackState[lp_player] = c_ANIM_UPPER_NONE;
        gf_AnimUpdateAimTurn(lp_player);
        if (lv_lower == c_ANIM_LOWER_IDLE && gv_animAimTurn[lp_player] != 0) {
            lv_lower = gv_animAimTurn[lp_player];
        }
        gf_AnimUpdateAimDir(lp_player);
        gf_AnimFullSet(lp_player, lv_lower);
        gf_AnimUpperSet(lp_player, c_ANIM_UPPER_AIM_MID);
        gf_AnimAimPitchTick(lp_player);
        lv_upper = c_ANIM_UPPER_AIM_MID;
    }
    else {
        lv_lower = c_ANIM_LOWER_NONE;
        // Right hold: directional walk clips. Standing keeps the stock clip.
        if (gv_holdStrafe[lp_player]) {
            gf_AnimUpdateAimDir(lp_player);
            lv_lower = gf_AnimLowerState(lp_player);
            if (lv_lower != c_ANIM_LOWER_WALK && lv_lower != c_ANIM_LOWER_WALK_BACK) {
                lv_lower = c_ANIM_LOWER_NONE;
            }
            // Forward plays the stock walk, the clip a middle hold plays.
            if (gv_animAimDir[lp_player] == c_ANIM_DIR_FORWARD) {
                lv_lower = c_ANIM_LOWER_NONE;
            }
        }
        lv_turning = gf_AnimFreeTurning(lp_player, lv_hero);  // every tick: keeps the last facing current
        if ((lv_lower == c_ANIM_LOWER_NONE) && (lv_turning != c_ANIM_LOWER_NONE)) {
            lv_lower = lv_turning;
        }
        gf_AnimFullSet(lp_player, lv_lower);
        if (lv_attacking) {
            lv_upper = gv_animAttackState[lp_player];
        }
        else if (gf_AnimReadyHold(lp_player)) {
            // Between shots: the pitch pose stays on the upper bracket.
            lv_upper = c_ANIM_UPPER_READY;
            gv_animAttackUntil[lp_player] = -1.0;
            gv_animAttackState[lp_player] = c_ANIM_UPPER_NONE;
        }
        else {
            lv_upper = c_ANIM_UPPER_NONE;
            gv_animAttackUntil[lp_player] = -1.0;
            gv_animAttackState[lp_player] = c_ANIM_UPPER_NONE;
            gv_animAttackTarget[lp_player] = null;
        }
        gf_AnimUpperSet(lp_player, lv_upper);
        if (lv_upper != c_ANIM_UPPER_NONE) {
            gf_AnimTargetPitchTick(lp_player);
        }
    }
    gv_animLowerState[lp_player] = lv_lower;
    gv_animLowerClipIndex[lp_player] = lv_lower;
    gv_animUpperState[lp_player] = lv_upper;
    gv_animUpperClipIndex[lp_player] = lv_upper;
    if (gf_StrafeMoveActive(lp_player) && !gf_MovementKeyHeld(lp_player) && gv_animHasMoveTarget[lp_player]) {
        gf_AimMoveStop(lp_player);
    }
    gf_AnimFacingTick(lp_player);
    gf_AnimLog(lp_player);
    gv_animLastPos[lp_player] = UnitGetPosition(lv_hero);
    gv_animHasPos[lp_player] = true;
}
bool gt_AnimTick_Func (bool testConds, bool runActions) {
    int lv_player;

    if (!runActions) {
        return true;
    }
    for (lv_player = c_SCOBA_HERO_FIRST; lv_player <= c_SCOBA_HERO_LAST; lv_player += 1) {
        gf_AnimTick(lv_player);
    }
    return true;
}
void gt_AnimTick_Init () {
    gt_AnimTick = TriggerCreate("gt_AnimTick_Func");
    TriggerAddEventTimePeriodic(gt_AnimTick, 0.05, c_timeGame);
}

