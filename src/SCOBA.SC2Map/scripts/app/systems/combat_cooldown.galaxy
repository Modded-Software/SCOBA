// Module: systems/combat_cooldown

bool gt_CombatStartedAttack_Func (bool testConds, bool runActions) {
    int lv_player;
    unit lv_hero;
    unit lv_target;
    fixed lv_now;
    fixed lv_delta;
    fixed lv_period;
    bool lv_aim;

    if (!runActions) {
        return true;
    }
    lv_player = gf_AimShooterPlayer(EventUnit());
    lv_aim = lv_player >= 0;
    if (!lv_aim) {
        lv_player = gf_HeroPlayerFromUnit(EventUnit());
    }
    if (lv_player < c_SCOBA_HERO_FIRST || lv_player > c_SCOBA_HERO_LAST) {
        return true;
    }
    lv_hero = gv_tPSUNIT[lv_player];
    if (!UnitIsValid(lv_hero) || !UnitIsAlive(lv_hero)) {
        return true;
    }
    lv_target = EventUnitTarget();
    gf_AnimAttackStart(lv_player, EventUnitGetWeapon(), lv_target);
    if (lv_aim) {
        gf_AimShooterMirrorCooldown(lv_player);
        return true;
    }
    lv_now = TimerGetElapsed(gv_sCOBA_Clock);
    lv_delta = lv_now - gv_sCOBA_LastAttackAt[lv_player];
    if (gv_sCOBA_LastAttackAt[lv_player] > 0.0 && lv_delta >= c_SCOBA_MIN_ATTACK_PERIOD && lv_delta <= c_SCOBA_MAX_ATTACK_PERIOD) {
        gv_sCOBA_AttackPeriod[lv_player] = lv_delta;
    }
    gv_sCOBA_LastAttackAt[lv_player] = lv_now;
    lv_period = gv_sCOBA_AttackPeriod[lv_player];
    if (lv_period <= 0.0) {
        lv_period = c_SCOBA_INITIAL_WEAPON_PERIOD;
    }
    UnitAbilityReset(lv_hero, AbilityCommand("SCOBAAutoAttackStatus", 0), c_spendLocationAbility);
    UnitAbilityAddCooldown(lv_hero, "SCOBAAutoAttackStatus", "Abil/SCOBAAutoAttackStatus", lv_period);
    return true;
}