// Module: systems/combat_cooldown
// Data sets the Weapon Attack button cooldown on each shot.
// This module only reacts to the fired weapon effect.

string gf_AttackEffectWeapon (string lp_effect) {
    if (lp_effect == c_SCOBA_EFFECT_TOSH || lp_effect == c_SCOBA_EFFECT_TOSH_POINT) {
        return c_SCOBA_WEAPON_TOSH;
    }
    if (lp_effect == c_SCOBA_EFFECT_TALONS || lp_effect == c_SCOBA_EFFECT_TALONS_SHOT) {
        return c_SCOBA_WEAPON_TALONS;
    }
    if (lp_effect == c_SCOBA_EFFECT_PSIBLAST || lp_effect == c_SCOBA_EFFECT_PSIBLAST_POINT) {
        return c_SCOBA_WEAPON_PSIBLAST;
    }
    return "";
}

bool gt_CombatAttackEffect_Func (bool testConds, bool runActions) {
    int lv_player;
    unit lv_hero;
    string lv_weapon;

    if (!runActions) {
        return true;
    }
    gv_aimShotEffectEvents += 1;
    lv_player = gf_HeroPlayerFromUnit(EventPlayerEffectUsedUnit(c_effectUnitCaster));
    if (lv_player < c_SCOBA_HERO_FIRST || lv_player > c_SCOBA_HERO_LAST) {
        return true;
    }
    lv_hero = gv_tPSUNIT[lv_player];
    if (!UnitIsValid(lv_hero) || !UnitIsAlive(lv_hero)) {
        return true;
    }
    lv_weapon = gf_AttackEffectWeapon(EventPlayerEffectUsed());
    if (lv_weapon == "") {
        return true;
    }
    if (gv_aIMACTIVE[lv_player]) {
        gv_aimShots[lv_player] += 1;
    }
    gf_AnimAttackStart(lv_player, lv_weapon, EventPlayerEffectUsedUnit(c_effectUnitTarget));
    gf_PncShotFired(lv_player);
    return true;
}
