// Module: systems/targeting

void gf_DbgInputLog (string lp_key, string lp_value) {
    bank lv_bank;

    if (!gv_bINPUTLOG) {
        return;
    }
    lv_bank = BankLoad("SCOBADBG", 1);
    BankSectionCreate(lv_bank, "input");
    BankValueSetFromString(lv_bank, "input", lp_key, lp_value);
    BankSave(lv_bank);
}

bool gt_Target_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_triggeringUnit;
    unit lv_targetUnit;
    int lv_localPlayer;
    int lv_localBar;

    // Variable Initialization
    lv_triggeringUnit = EventUnit();
    lv_targetUnit = EventUnitTarget();
    lv_localPlayer = -1;
    if (UnitIsValid(lv_targetUnit)) {
        lv_localPlayer = UnitGetOwner(lv_targetUnit);
    }
    lv_localBar = gf_BossBarId(lv_localPlayer, 4);

    // Conditions
    if (testConds) {
        if (lv_localPlayer < 1 || lv_localPlayer > 6) {
            return false;
        }

        if (!UnitIsValid(lv_triggeringUnit) || !UnitIsValid(lv_targetUnit) || !UnitIsValid(gv_tPSUNIT[lv_localPlayer])) {
            return false;
        }

        if (!((lv_targetUnit == gv_tPSUNIT[lv_localPlayer]))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    gf_UnitTargetSet(lv_localPlayer, lv_triggeringUnit);
    return true;
}

void gt_Target_Init () {
    gt_Target = TriggerCreate("gt_Target_Func");
    TriggerAddEventUnitAttacked2(gt_Target, null, null);
}

bool gt_ClearTarget_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_triggeringUnit;
    int lv_localPlayer;
    int lv_localBar;

    // Variable Initialization
    lv_triggeringUnit = EventUnit();
    lv_localPlayer = EventPlayer();
    lv_localBar = gf_BossBarId(lv_localPlayer, 4);

    // Conditions
    if (testConds) {
        if (lv_localPlayer < 1 || lv_localPlayer > 6) {
            return false;
        }

        if (!UnitIsValid(lv_triggeringUnit) || !UnitIsValid(gv_tPSUNIT[lv_localPlayer])) {
            return false;
        }

        if (!((lv_triggeringUnit == gv_tPSUNIT[lv_localPlayer]))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    gf_UnitTargetSet(lv_localPlayer, null);
    return true;
}

void gt_ClearTarget_Init () {
    gt_ClearTarget = TriggerCreate("gt_ClearTarget_Func");
}

void gf_UnitTargetSet (int lp_player, unit lp_unit) {
    unit lv_old;
    string lv_portrait;
    string lv_actor;
    bool lv_enemy;
    int lv_bar;

    if (!gf_IsHeroPlayer(lp_player)) {
        return;
    }
    if (gf_AimShotProxyIs(lp_unit) || gf_AimShooterIs(lp_unit)) {
        lp_unit = null;
    }
    if (UnitIsValid(lp_unit) && (lp_unit == gv_tPSUNIT[lp_player])) {
        lp_unit = null;
    }
    lv_bar = gf_BossBarId(lp_player, 4);
    lv_old = gv_unitTarget[lp_player];
    if (lv_old != lp_unit) {
        if (UnitIsValid(lv_old)) {
            UnitStatusBarOverride(lv_old, -1);
        }
    }
    gv_unitTarget[lp_player] = lp_unit;
    DialogSetVisible(gv_sCOBAOrderDialog, PlayerGroupSingle(lp_player), (UnitIsValid(lp_unit) && (UnitGetOwner(lp_unit) == lp_player)));
    if (!UnitIsValid(lp_unit)) {
        libNtve_gf_ShowHideBossBar(false, lv_bar);
        return;
    }
    UnitStatusBarOverride(lp_unit, -1);
    lv_enemy = (libNtve_gf_PlayerIsEnemy(lp_player, UnitGetOwner(lp_unit), libNtve_ge_PlayerRelation_Ally) == false);
    lv_portrait = "";
    lv_actor = gf_UnitActorId(lp_unit);
    if (CatalogEntryIsValid(c_gameCatalogActor, lv_actor)) {
        lv_portrait = CatalogFieldValueGet(c_gameCatalogActor, lv_actor, "UnitIcon", lp_player);
    }
    if (lv_portrait == "") {
        lv_portrait = "Assets\\Textures\\btn-command-attack.dds";
    }
    libNtve_gf_DisplayBossBar(lv_bar, lv_portrait, UnitTypeGetName(UnitGetType(lp_unit)), 100, PlayerGroupSingle(lp_player));
    if (lv_enemy) {
        libNtve_gf_SetBossBarRace(lv_bar, libNtve_ge_BossBarRace_Zerg, true);
    }
    libNtve_gf_SetBossBarBoss(lv_bar, lp_unit, true);
    libNtve_gf_MoveBossBar(lv_bar, c_anchorTop, 0, 50);
}

bool gf_IsClickEnemy (int lp_player, unit lp_unit) {
    if (!UnitIsValid(lp_unit) || !UnitIsAlive(lp_unit)) {
        return false;
    }
    if (gf_AimShotProxyIs(lp_unit) || gf_AimShooterIs(lp_unit)) {
        return false;
    }
    return libNtve_gf_PlayerIsEnemy(lp_player, UnitGetOwner(lp_unit), libNtve_ge_PlayerRelation_Ally) == false;
}

bool gf_UnitTargetValid (int lp_player, unit lp_unit, bool lp_enemyOnly) {
    if (!UnitIsValid(lp_unit) || !UnitIsAlive(lp_unit)) {
        return false;
    }
    if (lp_unit == gv_tPSUNIT[lp_player]) {
        return false;
    }
    if (gf_AimShotProxyIs(lp_unit) || gf_AimShooterIs(lp_unit)) {
        return false;
    }
    if (lp_enemyOnly && !gf_IsClickEnemy(lp_player, lp_unit)) {
        return false;
    }
    return true;
}

unit gf_UnitTargetAtPoint (int lp_player, point lp_point, bool lp_enemyOnly) {
    unit lv_unit;
    unit lv_best;
    unitgroup lv_group;
    fixed lv_bestDistance;
    fixed lv_distance;
    fixed lv_radius;

    lv_group = UnitGroup(null, c_playerAny, RegionCircle(lp_point, c_SCOBA_CLICK_SCAN_RADIUS), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_best = null;
    lv_bestDistance = c_SCOBA_CLICK_SCAN_RADIUS + 1.0;
    UnitGroupLoopBegin(lv_group);
    for ( ; !UnitGroupLoopDone() ; UnitGroupLoopStep() ) {
        lv_unit = UnitGroupLoopCurrent();
        if (lv_unit == gv_tPSUNIT[lp_player] || !UnitIsValid(lv_unit) || !UnitIsAlive(lv_unit)) {
            continue;
        }
        if (gf_AimShotProxyIs(lv_unit) || gf_AimShooterIs(lv_unit)) {
            continue;
        }
        if (lp_enemyOnly && !gf_IsClickEnemy(lp_player, lv_unit)) {
            continue;
        }
        lv_radius = UnitGetPropertyFixed(lv_unit, c_unitPropRadius, c_unitPropNormal) + c_SCOBA_CLICK_MARGIN;
        lv_distance = DistanceBetweenPoints(lp_point, UnitGetPosition(lv_unit));
        if (lv_distance <= lv_radius && lv_distance < lv_bestDistance) {
            lv_best = lv_unit;
            lv_bestDistance = lv_distance;
        }
    }
    UnitGroupLoopEnd();
    return lv_best;
}

void gf_ShowMoveMarker (int lp_player, point lp_point) {
    string lv_model;
    actor lv_actor;

    lv_model = "CommandUIHarnessMoveZerg";
    if (PlayerRace(lp_player) == "Terr") {
        lv_model = "CommandUIHarnessMoveTerran";
    }
    else if (PlayerRace(lp_player) == "Prot") {
        lv_model = "CommandUIHarnessMoveProtoss";
    }
    lv_actor = libNtve_gf_CreateModelAtPoint(lv_model, lp_point);
    Wait(0.6, c_timeGame);
    ActorSend(lv_actor, "Destroy");
}

void gf_RightClickExecute (int lp_player, point lp_point, unit lp_pressUnit) {
    unit lv_unit;

    lv_unit = lp_pressUnit;
    if (gf_UnitTargetValid(lp_player, lv_unit, true)) {
        gf_UnitTargetSet(lp_player, lv_unit);
        gf_CombatManualAttack(lp_player, lv_unit);
        return;
    }
    gf_CombatCancelAuto(lp_player);
    gv_sCOBAManualOrder[lp_player] = false;
    gf_CombatSyncRoot(lp_player);
    if (gf_CombatStandOn(lp_player)) {
        UnitIssueOrder(gv_tPSUNIT[lp_player], Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
        gv_sCOBAFSM[lp_player] = c_SCOBA_FSM_IDLE;
    }
    else {
        UnitIssueOrder(gv_tPSUNIT[lp_player], OrderTargetingPoint(AbilityCommand("move", 0), lp_point), c_orderQueueReplace);
        gv_sCOBAFSM[lp_player] = c_SCOBA_FSM_MOVING;
        gf_ShowMoveMarker(lp_player, lp_point);
    }
}

void gf_MousePressRight (int lp_player, int lp_xui, int lp_yui, fixed lp_x, fixed lp_y) {
    gv_mOUSERIGHTCANCEL[lp_player] = false;
    gv_unitClickCandidate[lp_player] = null;
    gv_mOUSEPRESSXUI[lp_player] = lp_xui;
    gv_mOUSEPRESSYUI[lp_player] = lp_yui;
    gv_mOUSEPRESSX[lp_player] = lp_x;
    gv_mOUSEPRESSY[lp_player] = lp_y;
    gv_mOUSEPRESSYAW[lp_player] = CameraGetYaw(lp_player);
    gv_mOUSEPRESSPITCH[lp_player] = CameraGetPitch(lp_player);
    gv_unitRightPressHighlight[lp_player] = gv_unitHighlight[lp_player];
    if (gv_mOUSELEFT[lp_player]) {
        gv_mOUSERIGHTCANCEL[lp_player] = true;
        gv_mOUSELEFTCANCEL[lp_player] = true;
    }
}

bool gf_MouseReleaseRight (int lp_player, int lp_xui, int lp_yui) {
    point lv_point;
    bool lv_drag;
    unit lv_unit;

    gf_MouseForwardStop(lp_player);
    lv_drag = gv_rIGHTORBIT[lp_player] || (AbsF(gf_AnimYawDelta(CameraGetYaw(lp_player), gv_mOUSEPRESSYAW[lp_player])) >= c_SCOBA_CLICK_DRAG_ANGLE) || (AbsF(CameraGetPitch(lp_player) - gv_mOUSEPRESSPITCH[lp_player]) >= c_SCOBA_CLICK_DRAG_ANGLE);
    if (gv_mOUSERIGHTCANCEL[lp_player] || lv_drag) {
        gv_mOUSERIGHTCANCEL[lp_player] = false;
        return false;
    }
    lv_point = Point(gv_mOUSEPRESSX[lp_player], gv_mOUSEPRESSY[lp_player]);
    lv_unit = gv_unitClickCandidate[lp_player];
    if (!gf_UnitTargetValid(lp_player, lv_unit, true)) {
        lv_unit = gv_unitRightPressHighlight[lp_player];
    }
    if (!gf_UnitTargetValid(lp_player, lv_unit, true)) {
        lv_unit = gf_UnitTargetAtPoint(lp_player, lv_point, true);
    }
    if (!gf_UnitTargetValid(lp_player, lv_unit, true)) {
        lv_unit = null;
    }
    gv_unitClickCandidate[lp_player] = null;
    gv_unitRightPressHighlight[lp_player] = null;
    if (gv_sCOBAOrderMode[lp_player] == true) {
        gf_OrderExecute(lp_player, gv_mOUSEPRESSX[lp_player], gv_mOUSEPRESSY[lp_player], lv_unit);
    }
    else if (UnitIsValid(gv_tPSUNIT[lp_player])) {
        gf_RightClickExecute(lp_player, lv_point, lv_unit);
    }
    return true;
}

bool gt_TargetClick_Func (bool testConds, bool runActions) {
    int lv_player;

    lv_player = EventPlayer();
    if (!runActions) {
        return true;
    }
    if (!gf_IsHeroPlayer(lv_player)) {
        return true;
    }

    if (gf_ActionModeActive(lv_player)) {
        if (gv_aCTIONALT[lv_player]) {
            return true;
        }
        if (EventMouseClickedButton() == gv_mOUSECURSOR) {
            gv_aCTIONPRESSED[lv_player] = true;
            gv_mOUSELEFTPRESSX[lv_player] = EventMouseClickedPosXWorld();
            gv_mOUSELEFTPRESSY[lv_player] = EventMouseClickedPosYWorld();
            gv_mOUSELEFTPRESSYAW[lv_player] = CameraGetYaw(lv_player);
            gv_mOUSELEFTPRESSPITCH[lv_player] = CameraGetPitch(lv_player);
            gv_unitClickCandidate[lv_player] = null;
            gv_unitPressHighlight[lv_player] = gv_unitHighlight[lv_player];
            if (gv_aIMACTIVE[lv_player]) {
                gf_AimShotPress(lv_player);
            }
        }
        return true;
    }

    if (EventMouseClickedButton() == gv_mOUSECURSOR) {
        gv_mOUSELEFTCANCEL[lv_player] = gv_mOUSERIGHT[lv_player];
        gv_mOUSELEFTPRESSXUI[lv_player] = EventMouseClickedPosXUI();
        gv_mOUSELEFTPRESSYUI[lv_player] = EventMouseClickedPosYUI();
        gv_mOUSELEFTPRESSX[lv_player] = EventMouseClickedPosXWorld();
        gv_mOUSELEFTPRESSY[lv_player] = EventMouseClickedPosYWorld();
        gv_mOUSELEFTPRESSYAW[lv_player] = CameraGetYaw(lv_player);
        gv_mOUSELEFTPRESSPITCH[lv_player] = CameraGetPitch(lv_player);
        gv_unitClickCandidate[lv_player] = null;
        gv_unitPressHighlight[lv_player] = gv_unitHighlight[lv_player];
        gf_DbgInputLog("leftXW", IntToString(FixedToInt(gv_mOUSELEFTPRESSX[lv_player])));
        gf_DbgInputLog("leftYW", IntToString(FixedToInt(gv_mOUSELEFTPRESSY[lv_player])));
        if (UnitIsValid(gv_unitHighlight[lv_player])) {
            gf_DbgInputLog("leftHover", UnitGetType(gv_unitHighlight[lv_player]));
        }
        else {
            gf_DbgInputLog("leftHover", "none");
        }
        if (gv_mOUSERIGHT[lv_player]) {
            gv_mOUSERIGHTCANCEL[lv_player] = true;
        }
        return true;
    }

    if (EventMouseClickedButton() != gv_fIRE) {
        return true;
    }
    gf_DbgInputLog("rightXW", IntToString(FixedToInt(EventMouseClickedPosXWorld())));
    gf_DbgInputLog("rightYW", IntToString(FixedToInt(EventMouseClickedPosYWorld())));
    gf_MousePressRight(lv_player, EventMouseClickedPosXUI(), EventMouseClickedPosYUI(), EventMouseClickedPosXWorld(), EventMouseClickedPosYWorld());
    return true;
}

bool gt_TargetRelease_Func (bool testConds, bool runActions) {
    int lv_player;
    bool lv_drag;
    unit lv_unit;

    lv_player = EventPlayer();
    if (!runActions) {
        return true;
    }
    if (!gf_IsHeroPlayer(lv_player)) {
        return true;
    }
    if (gf_ActionModeActive(lv_player)) {
        if (gv_aCTIONALT[lv_player]) {
            return true;
        }
        if (EventMouseClickedButton() == gv_mOUSECURSOR) {
            if (!gv_aCTIONPRESSED[lv_player]) {
                return true;
            }
            gv_aCTIONPRESSED[lv_player] = false;
            lv_drag = (AbsF(gf_AnimYawDelta(CameraGetYaw(lv_player), gv_mOUSELEFTPRESSYAW[lv_player])) >= c_SCOBA_CLICK_DRAG_ANGLE) || (AbsF(CameraGetPitch(lv_player) - gv_mOUSELEFTPRESSPITCH[lv_player]) >= c_SCOBA_CLICK_DRAG_ANGLE);
            gv_unitClickCandidate[lv_player] = null;
            gv_unitPressHighlight[lv_player] = null;
            if (!lv_drag && !gv_aIMACTIVE[lv_player]) {
                lv_unit = gf_UnitTargetAtPoint(lv_player, CameraGetTarget(lv_player), true);
                if (UnitIsValid(lv_unit)) {
                    gf_UnitTargetSet(lv_player, lv_unit);
                    gf_CombatManualAttack(lv_player, lv_unit);
                }
            }
        }
        return true;
    }
    if (EventMouseClickedButton() == gv_mOUSECURSOR) {
        gf_MouseForwardStop(lv_player);
        lv_drag = gv_lEFTORBIT[lv_player] || (AbsF(gf_AnimYawDelta(CameraGetYaw(lv_player), gv_mOUSELEFTPRESSYAW[lv_player])) >= c_SCOBA_CLICK_DRAG_ANGLE) || (AbsF(CameraGetPitch(lv_player) - gv_mOUSELEFTPRESSPITCH[lv_player]) >= c_SCOBA_CLICK_DRAG_ANGLE);
        if (!gv_mOUSELEFTCANCEL[lv_player] && !lv_drag) {
            if (gv_sCOBAOrderMode[lv_player] == true) {
                gf_OrderExit(lv_player);
            }
            lv_unit = gv_unitClickCandidate[lv_player];
            if (!gf_UnitTargetValid(lv_player, lv_unit, false)) {
                lv_unit = gv_unitPressHighlight[lv_player];
            }
            if (!gf_UnitTargetValid(lv_player, lv_unit, false)) {
                lv_unit = gf_UnitTargetAtPoint(lv_player, Point(gv_mOUSELEFTPRESSX[lv_player], gv_mOUSELEFTPRESSY[lv_player]), false);
            }
            if (!gf_UnitTargetValid(lv_player, lv_unit, false)) {
                lv_unit = null;
            }
            gv_unitClickCandidate[lv_player] = null;
            gv_unitPressHighlight[lv_player] = null;
            if (UnitIsValid(lv_unit)) {
                gf_DbgInputLog("leftTarget", UnitGetType(lv_unit));
            }
            else {
                gf_DbgInputLog("leftTarget", "none");
            }
            gf_UnitTargetSet(lv_player, lv_unit);
            gf_SelectHero(lv_player);
        }
        gv_mOUSELEFTCANCEL[lv_player] = false;
        return true;
    }
    if (EventMouseClickedButton() != gv_fIRE) {
        return true;
    }
    gf_MouseReleaseRight(lv_player, EventMouseClickedPosXUI(), EventMouseClickedPosYUI());
    if (UnitIsValid(gv_unitTarget[lv_player])) {
        gf_DbgInputLog("rightTarget", UnitGetType(gv_unitTarget[lv_player]));
    }
    else {
        gf_DbgInputLog("rightTarget", "none");
    }
    return true;
}

void gt_TargetClick_Init () {
    gt_TargetClick = TriggerCreate("gt_TargetClick_Func");
    TriggerAddEventMouseClicked(gt_TargetClick, c_playerAny, gv_mOUSECURSOR, true);
    TriggerAddEventMouseClicked(gt_TargetClick, c_playerAny, gv_fIRE, true);
    gt_TargetRelease = TriggerCreate("gt_TargetRelease_Func");
    TriggerAddEventMouseClicked(gt_TargetRelease, c_playerAny, gv_mOUSECURSOR, false);
    TriggerAddEventMouseClicked(gt_TargetRelease, c_playerAny, gv_fIRE, false);
}

bool gf_UnitClickEvent (int lp_player, bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    if (!gf_IsHeroPlayer(lp_player)) {
        return true;
    }
    gv_unitClickCandidate[lp_player] = EventUnit();
    if (UnitIsValid(gv_unitClickCandidate[lp_player])) {
        gf_DbgInputLog("unitClick", UnitGetType(gv_unitClickCandidate[lp_player]));
    }
    gf_SelectHero(lp_player);
    return true;
}

void gt_UnitClick_Init () {
    int lv_player;

    for (lv_player = 1; lv_player <= 6; lv_player += 1) {
        if (lv_player == 1) {
            gt_UnitClick[lv_player] = TriggerCreate("gt_UnitClick1_Func");
        }
        else if (lv_player == 2) {
            gt_UnitClick[lv_player] = TriggerCreate("gt_UnitClick2_Func");
        }
        else if (lv_player == 3) {
            gt_UnitClick[lv_player] = TriggerCreate("gt_UnitClick3_Func");
        }
        else if (lv_player == 4) {
            gt_UnitClick[lv_player] = TriggerCreate("gt_UnitClick4_Func");
        }
        else if (lv_player == 5) {
            gt_UnitClick[lv_player] = TriggerCreate("gt_UnitClick5_Func");
        }
        else {
            gt_UnitClick[lv_player] = TriggerCreate("gt_UnitClick6_Func");
        }
        TriggerAddEventUnitClick(gt_UnitClick[lv_player], null, lv_player);
    }
}

bool gt_TargetRing_Func (bool testConds, bool runActions) {
    int lv_player;
    unit lv_unit;

    if (!runActions) {
        return true;
    }
    for (lv_player = 1; lv_player <= 6; lv_player += 1) {
        lv_unit = gv_unitTarget[lv_player];
        if (gv_unitTarget[lv_player] != null && (!UnitIsValid(lv_unit) || !UnitIsAlive(lv_unit))) {
            gf_UnitTargetSet(lv_player, null);
            continue;
        }
        if (UnitIsValid(lv_unit)) {
            if (gv_sCOBAOrderMode[lv_player] == false) {
                UnitFlashSelection(lv_unit, 1.0);
            }
            gf_BossBarUpdate(lv_player);
        }
    }
    return true;
}

void gt_TargetRing_Init () {
    gt_TargetRing = TriggerCreate("gt_TargetRing_Func");
    TriggerAddEventTimePeriodic(gt_TargetRing, 0.2, c_timeGame);
}
