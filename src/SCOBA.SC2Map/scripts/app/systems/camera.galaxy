// Module: systems/camera

void gf_CameraZoomApply (int lp_player) {
    fixed lv_desired;
    fixed lv_safe;

    lv_desired = gv_cameraDistanceDesired[lp_player];
    lv_safe = gf_CameraSafeDistance(lp_player, lv_desired);
    if (lv_safe > lv_desired) {
        lv_safe = lv_desired;
    }
    CameraSetValue(lp_player, c_cameraValueDistance, lv_safe, c_SCOBA_ZOOM_BLEND, -1, 10);
    gv_cameraDistanceApplied[lp_player] = lv_safe;
}

bool gt_CameraFollowDistance_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_localPlayer;

    // Variable Initialization
    lv_localPlayer = EventPlayer();

    // Actions
    if (!runActions) {
        return true;
    }

    if (gv_cameraDistanceDesired[lv_localPlayer] <= 0.0) {
        gv_cameraDistanceDesired[lv_localPlayer] = CameraGetDistance(lv_localPlayer);
    }
    gv_cameraDistanceDesired[lv_localPlayer] = gv_cameraDistanceDesired[lv_localPlayer] - (EventMouseWheelSpin() / 2.0);
    if (gv_cameraDistanceDesired[lv_localPlayer] < 1.0) {
        gv_cameraDistanceDesired[lv_localPlayer] = 1.0;
    }
    if (gv_cameraDistanceDesired[lv_localPlayer] > 40.0) {
        gv_cameraDistanceDesired[lv_localPlayer] = 40.0;
    }
    gf_CameraZoomApply(lv_localPlayer);
    return true;
}

void gt_CameraFollowDistance_Init () {
    gt_CameraFollowDistance = TriggerCreate("gt_CameraFollowDistance_Func");
    TriggerAddEventMouseWheel(gt_CameraFollowDistance, c_playerAny);
}

bool gt_CameraDebugMove_Func (bool testConds, bool runActions) {
    int lv_player;

    if (!runActions) {
        return true;
    }
    lv_player = EventPlayer();
    if (!gf_IsHeroPlayer(lv_player)) {
        return true;
    }
    gv_cAMDBGCOUNT[lv_player] += 1;
    gv_cAMDBGLAST[lv_player] = EventCameraMoveReason();
    return true;
}

void gt_CameraDebugMove_Init () {
    gt_CameraDebugMove = TriggerCreate("gt_CameraDebugMove_Func");
    TriggerAddEventCameraMove(gt_CameraDebugMove, c_playerAny, c_cameraMoveReasonAny);
}

bool gt_CameraDebug_Func (bool testConds, bool runActions) {
    bank lv_bank;
    unit lv_hero;
    point lv_target;
    string lv_text;

    if (!runActions) {
        return true;
    }
    lv_bank = BankLoad("SCOBACAMDBG", 1);
    BankSectionCreate(lv_bank, "state");
    lv_text = "lock=" + gf_AnimFlag(gv_eDGEBLOCK[1]);
    lv_text = lv_text + " rel=" + gf_AnimFlag(gv_cONTROLRELATIVE[1]);
    lv_text = lv_text + " action=" + gf_AnimFlag(gf_ActionModeActive(1));
    lv_text = lv_text + " aim=" + gf_AnimFlag(gv_aIMACTIVE[1]);
    lv_text = lv_text + " count=" + IntToString(gv_cAMDBGCOUNT[1]);
    lv_text = lv_text + " last=" + IntToString(gv_cAMDBGLAST[1]);
    lv_text = lv_text + " step=" + FixedToString(gv_aimDbgMaxStep[1], c_fixedPrecisionAny);
    lv_text = lv_text + " clamps=" + IntToString(gv_aimDbgClamps[1]);
    lv_text = lv_text + " dist=" + FixedToString(CameraGetDistance(1), c_fixedPrecisionAny);
    lv_hero = gv_tPSUNIT[1];
    if (UnitIsValid(lv_hero)) {
        lv_target = CameraGetTarget(1);
        lv_text = lv_text + " hx=" + IntToString(FixedToInt(PointGetX(UnitGetPosition(lv_hero))));
        lv_text = lv_text + " hy=" + IntToString(FixedToInt(PointGetY(UnitGetPosition(lv_hero))));
        lv_text = lv_text + " tx=" + IntToString(FixedToInt(PointGetX(lv_target)));
        lv_text = lv_text + " ty=" + IntToString(FixedToInt(PointGetY(lv_target)));
    }
    BankValueSetFromString(lv_bank, "state", "p1", lv_text);
    BankSave(lv_bank);
    return true;
}

void gt_CameraDebug_Init () {
    gt_CameraDebug = TriggerCreate("gt_CameraDebug_Func");
    TriggerAddEventTimePeriodic(gt_CameraDebug, 1.0, c_timeGame);
}


