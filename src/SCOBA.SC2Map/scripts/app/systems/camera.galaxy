// Module: systems/camera

bool gt_CameraFollowDistance_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_localPlayer;

    // Variable Initialization
    lv_localPlayer = EventPlayer();

    // Actions
    if (!runActions) {
        return true;
    }

    CameraSetValue(lv_localPlayer, c_cameraValueDistance, (CameraGetDistance(lv_localPlayer) - (EventMouseWheelSpin() / 2.0)), 0.2, -1, 10);
    return true;
}

void gt_CameraFollowDistance_Init () {
    gt_CameraFollowDistance = TriggerCreate("gt_CameraFollowDistance_Func");
    TriggerAddEventMouseWheel(gt_CameraFollowDistance, c_playerAny);
}

bool gt_Jump_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_localPlayer;

    // Variable Initialization
    lv_localPlayer = EventPlayer();

    // Actions
    if (!runActions) {
        return true;
    }

    UnitBehaviorAdd(gv_tPSUNIT[lv_localPlayer], "DehakaJump", gv_tPSUNIT[lv_localPlayer], 1);
    return true;
}

void gt_Jump_Init () {
    gt_Jump = TriggerCreate("gt_Jump_Func");
    TriggerAddEventKeyPressed(gt_Jump, c_playerAny, gv_jUMP, true, c_keyModifierStateIgnore, c_keyModifierStateIgnore, c_keyModifierStateIgnore);
}

bool gt_ZoomEnd_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_localPlayer;

    // Variable Initialization
    lv_localPlayer = EventPlayer();

    // Actions
    if (!runActions) {
        return true;
    }

    gv_cAMERAFOV[lv_localPlayer] = c_SCOBA_REST_FOV;
    CameraSetValue(lv_localPlayer, c_cameraValueFieldOfView, c_SCOBA_REST_FOV, 0.5, -1, 10.0);
    return true;
}

void gt_ZoomEnd_Init () {
    gt_ZoomEnd = TriggerCreate("gt_ZoomEnd_Func");
    TriggerAddEventKeyPressed(gt_ZoomEnd, c_playerAny, gv_zOOM, false, c_keyModifierStateIgnore, c_keyModifierStateIgnore, c_keyModifierStateIgnore);
}

