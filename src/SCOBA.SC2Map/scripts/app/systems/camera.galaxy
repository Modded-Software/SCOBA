bool gt_CursorStart_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_localPlayer;

    // Variable Initialization
    lv_localPlayer = EventPlayer();

    // Actions
    if (!runActions) {
        return true;
    }

    if (gf_ActionModeActive(lv_localPlayer)) {
        if ((EventMouseClickedButton() == gv_fIRE) && !gv_aCTIONALT[lv_localPlayer]) {
            gf_AimBegin(lv_localPlayer);
        }
        return true;
    }

    if ((EventMouseClickedButton() == gv_mOUSECURSOR)) {
        gv_rOTATECAMERA[lv_localPlayer] = true;
    }

    if ((EventMouseClickedButton() == gv_aBILITYCAMERA)) {
        gv_mOUSEMIDDLE[lv_localPlayer] = true;
    }

    if (((EventMouseClickedButton() == gv_fIRE) || (EventMouseClickedButton() == gv_aBILITYCAMERA))) {
        gv_rOTATEUNIT[lv_localPlayer] = true;
    }

    if (((gv_rOTATEUNIT[lv_localPlayer] == true) || (gv_rOTATECAMERA[lv_localPlayer] == true))) {
        CameraSetMouseRotates(lv_localPlayer, true);
        CameraForceMouseRelative(lv_localPlayer, true);
        CameraLockInput(lv_localPlayer, false);
    }
    if (gv_mOUSELEFT[lv_localPlayer] && gv_mOUSERIGHT[lv_localPlayer] && !gv_mOUSEFORWARD[lv_localPlayer]) {
        gf_MouseForwardStart(lv_localPlayer);
    }
    return true;
}

void gt_CursorStart_Init () {
    gt_CursorStart = TriggerCreate("gt_CursorStart_Func");
    TriggerAddEventMouseClicked(gt_CursorStart, c_playerAny, gv_mOUSECURSOR, true);
    TriggerAddEventMouseClicked(gt_CursorStart, c_playerAny, gv_fIRE, true);
    TriggerAddEventMouseClicked(gt_CursorStart, c_playerAny, gv_aBILITYCAMERA, true);
}

bool gt_CursorEnd_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_localPlayer;

    // Variable Initialization
    lv_localPlayer = EventPlayer();

    // Actions
    if (!runActions) {
        return true;
    }

    if (gf_ActionModeActive(lv_localPlayer)) {
        if (EventMouseClickedButton() == gv_fIRE) {
            gf_AimEnd(lv_localPlayer);
        }
        return true;
    }

    if ((EventMouseClickedButton() == gv_mOUSECURSOR)) {
        gv_mOUSELEFT[lv_localPlayer] = false;
        gv_rOTATECAMERA[lv_localPlayer] = false;
    }

    if ((EventMouseClickedButton() == gv_fIRE)) {
        gv_mOUSERIGHT[lv_localPlayer] = false;
    }

    if ((EventMouseClickedButton() == gv_aBILITYCAMERA)) {
        gv_mOUSEMIDDLE[lv_localPlayer] = false;
    }

    gv_rOTATEUNIT[lv_localPlayer] = (gv_mOUSERIGHT[lv_localPlayer] || gv_mOUSEMIDDLE[lv_localPlayer]);

    if (((gv_rOTATEUNIT[lv_localPlayer] == true) || (gv_rOTATECAMERA[lv_localPlayer] == true))) {
        CameraSetMouseRotates(lv_localPlayer, true);
        CameraForceMouseRelative(lv_localPlayer, true);
        CameraLockInput(lv_localPlayer, false);
    }
    else {
        CameraSetMouseRotates(lv_localPlayer, false);
        CameraForceMouseRelative(lv_localPlayer, false);
        UISetCursorVisible(PlayerGroupSingle(lv_localPlayer), true);
        CameraLockInput(lv_localPlayer, true);
    }

    return true;
}

void gt_CursorEnd_Init () {
    gt_CursorEnd = TriggerCreate("gt_CursorEnd_Func");
    TriggerAddEventMouseClicked(gt_CursorEnd, c_playerAny, gv_fIRE, false);
    TriggerAddEventMouseClicked(gt_CursorEnd, c_playerAny, gv_mOUSECURSOR, false);
    TriggerAddEventMouseClicked(gt_CursorEnd, c_playerAny, gv_aBILITYCAMERA, false);
}

bool gt_CameraTurnTick_Func (bool testConds, bool runActions) {
    int lv_player;

    if (!runActions) {
        return true;
    }
    for (lv_player = c_SCOBA_HERO_FIRST; lv_player <= c_SCOBA_HERO_LAST; lv_player += 1) {
        if (!gf_ActionModeActive(lv_player) && (gv_rOTATEUNIT[lv_player] == true) && UnitIsValid(gv_tPSUNIT[lv_player])) {
            gf_TurnToYaw(lv_player, CameraGetYaw(lv_player));
        }
        else if (!gf_ActionModeActive(lv_player) && !gv_aIMACTIVE[lv_player]) {
            gv_animHasTurnTarget[lv_player] = false;
        }
    }
    return true;
}

void gt_CameraTurnTick_Init () {
    gt_CameraTurnTick = TriggerCreate("gt_CameraTurnTick_Func");
    TriggerAddEventTimePeriodic(gt_CameraTurnTick, 0.05, c_timeGame);
}

bool gt_XCenterUnitOrders_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    if ((PlayerRace(EventPlayer()) == "Terr")) {
        UnitGroupIssueOrder(libNtve_gf_ConvertUnitToUnitGroup(EventUnit()), OrderTargetingPoint(AbilityCommand("attack", 0), RegionGetCenter(RegionFromId(2))), c_orderQueueReplace);
    }
    else {
        UnitGroupIssueOrder(libNtve_gf_ConvertUnitToUnitGroup(EventUnit()), OrderTargetingPoint(AbilityCommand("attack", 0), RegionGetCenter(RegionFromId(1))), c_orderQueueReplace);
    }
    return true;
}

void gt_XCenterUnitOrders_Init () {
    gt_XCenterUnitOrders = TriggerCreate("gt_XCenterUnitOrders_Func");
    TriggerAddEventUnitRegion(gt_XCenterUnitOrders, null, RegionFromId(8), true);
}

