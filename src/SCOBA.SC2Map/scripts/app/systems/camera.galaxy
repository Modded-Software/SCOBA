bool gt_CursorStart_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_localPlayer;

    // Variable Initialization
    lv_localPlayer = EventPlayer();

    // Actions
    if (!runActions) {
        return true;
    }

    if (gf_ActionModeActive(lv_localPlayer)) {
        if ((EventMouseClickedButton() == gv_fIRE) && !gv_aCTIONALT[lv_localPlayer]) {
            gf_AimBegin(lv_localPlayer);
        }
        return true;
    }

    if ((EventMouseClickedButton() == gv_mOUSECURSOR)) {
        gv_mOUSELEFT[lv_localPlayer] = true;
        gv_lEFTORBIT[lv_localPlayer] = false;
        gv_mOUSELEFTPRESSXUI[lv_localPlayer] = EventMouseClickedPosXUI();
        gv_mOUSELEFTPRESSYUI[lv_localPlayer] = EventMouseClickedPosYUI();
    }
    else if ((EventMouseClickedButton() == gv_fIRE)) {
        gv_mOUSERIGHT[lv_localPlayer] = true;
        gv_rIGHTORBIT[lv_localPlayer] = false;
        gv_mOUSERIGHTPRESSXUI[lv_localPlayer] = EventMouseClickedPosXUI();
        gv_mOUSERIGHTPRESSYUI[lv_localPlayer] = EventMouseClickedPosYUI();
    }
    else if ((EventMouseClickedButton() == gv_aBILITYCAMERA)) {
        gv_mOUSEMIDDLE[lv_localPlayer] = true;
    }

    gf_ControlApply(lv_localPlayer);
    if (gv_mOUSELEFT[lv_localPlayer] && gv_mOUSERIGHT[lv_localPlayer] && !gv_mOUSEFORWARD[lv_localPlayer]) {
        gf_MouseForwardStart(lv_localPlayer);
    }
    return true;
}

void gt_CursorStart_Init () {
    gt_CursorStart = TriggerCreate("gt_CursorStart_Func");
    TriggerAddEventMouseClicked(gt_CursorStart, c_playerAny, gv_mOUSECURSOR, true);
    TriggerAddEventMouseClicked(gt_CursorStart, c_playerAny, gv_fIRE, true);
    TriggerAddEventMouseClicked(gt_CursorStart, c_playerAny, gv_aBILITYCAMERA, true);
}

bool gt_CursorEnd_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_localPlayer;

    // Variable Initialization
    lv_localPlayer = EventPlayer();

    // Actions
    if (!runActions) {
        return true;
    }

    if (gf_ActionModeActive(lv_localPlayer)) {
        if (EventMouseClickedButton() == gv_fIRE) {
            gf_AimEnd(lv_localPlayer);
        }
        return true;
    }

    if ((EventMouseClickedButton() == gv_mOUSECURSOR)) {
        gv_mOUSELEFT[lv_localPlayer] = false;
        gv_lEFTORBIT[lv_localPlayer] = false;
    }
    else if ((EventMouseClickedButton() == gv_fIRE)) {
        gv_mOUSERIGHT[lv_localPlayer] = false;
        gv_rIGHTORBIT[lv_localPlayer] = false;
    }
    else if ((EventMouseClickedButton() == gv_aBILITYCAMERA)) {
        gv_mOUSEMIDDLE[lv_localPlayer] = false;
    }
    gf_ControlApply(lv_localPlayer);
    return true;
}

void gt_CursorEnd_Init () {
    gt_CursorEnd = TriggerCreate("gt_CursorEnd_Func");
    TriggerAddEventMouseClicked(gt_CursorEnd, c_playerAny, gv_fIRE, false);
    TriggerAddEventMouseClicked(gt_CursorEnd, c_playerAny, gv_mOUSECURSOR, false);
    TriggerAddEventMouseClicked(gt_CursorEnd, c_playerAny, gv_aBILITYCAMERA, false);
}

bool gt_LeftOrbitStart_Func (bool testConds, bool runActions) {
    int lv_player;
    int lv_dx;
    int lv_dy;

    if (!runActions) {
        return true;
    }
    lv_player = EventPlayer();
    if (!gf_IsHeroPlayer(lv_player)) {
        return true;
    }
    if (!gv_mOUSELEFT[lv_player] || gv_mOUSELEFTCANCEL[lv_player] || gv_lEFTORBIT[lv_player]) {
        return true;
    }
    lv_dx = EventMouseMovedPosXUI() - gv_mOUSELEFTPRESSXUI[lv_player];
    lv_dy = EventMouseMovedPosYUI() - gv_mOUSELEFTPRESSYUI[lv_player];
    if ((lv_dx * lv_dx + lv_dy * lv_dy) > (c_SCOBA_LEFT_ORBIT_PIXELS * c_SCOBA_LEFT_ORBIT_PIXELS)) {
        gv_lEFTORBIT[lv_player] = true;
        gv_rOTATECAMERA[lv_player] = true;
        gv_cONTROLRELATIVE[lv_player] = true;
        CameraSetMouseRotates(lv_player, true);
        CameraForceMouseRelative(lv_player, true);
    }
    return true;
}

void gt_LeftOrbitStart_Init () {
    gt_LeftOrbitStart = TriggerCreate("gt_LeftOrbitStart_Func");
    TriggerAddEventMouseMoved(gt_LeftOrbitStart, c_playerAny);
}

bool gt_RightOrbitStart_Func (bool testConds, bool runActions) {
    int lv_player;
    int lv_dx;
    int lv_dy;

    if (!runActions) {
        return true;
    }
    lv_player = EventPlayer();
    if (!gf_IsHeroPlayer(lv_player)) {
        return true;
    }
    if (!gv_mOUSERIGHT[lv_player] || gv_mOUSERIGHTCANCEL[lv_player] || gv_rIGHTORBIT[lv_player]) {
        return true;
    }
    lv_dx = EventMouseMovedPosXUI() - gv_mOUSERIGHTPRESSXUI[lv_player];
    lv_dy = EventMouseMovedPosYUI() - gv_mOUSERIGHTPRESSYUI[lv_player];
    if ((lv_dx * lv_dx + lv_dy * lv_dy) > (c_SCOBA_RIGHT_ORBIT_PIXELS * c_SCOBA_RIGHT_ORBIT_PIXELS)) {
        gv_rIGHTORBIT[lv_player] = true;
        gv_rOTATEUNIT[lv_player] = true;
        gv_cONTROLRELATIVE[lv_player] = true;
        CameraSetMouseRotates(lv_player, true);
        CameraForceMouseRelative(lv_player, true);
    }
    return true;
}

void gt_RightOrbitStart_Init () {
    gt_RightOrbitStart = TriggerCreate("gt_RightOrbitStart_Func");
    TriggerAddEventMouseMoved(gt_RightOrbitStart, c_playerAny);
}

fixed gf_CameraSafeDistance (int lp_player, fixed lp_desired) {
    fixed lv_pitch;
    fixed lv_yaw;
    fixed lv_horiz;
    fixed lv_tx;
    fixed lv_ty;
    fixed lv_tz;
    fixed lv_offset;
    fixed lv_ex;
    fixed lv_ey;
    fixed lv_ez;
    fixed lv_fraction;
    fixed lv_sampleZ;
    fixed lv_safe;
    int lv_seg;
    point lv_target;
    point lv_eye;
    point lv_sample;

    if (lp_desired <= 0.0) {
        return 0.0;
    }
    lv_pitch = CameraGetPitch(lp_player);
    if (lv_pitch > 180.0) {
        lv_pitch = lv_pitch - 360.0;
    }
    lv_yaw = CameraGetYaw(lp_player);
    lv_horiz = Cos(lv_pitch) * lp_desired;
    lv_target = CameraGetTarget(lp_player);
    lv_eye = PointWithOffsetPolar(lv_target, lv_horiz, lv_yaw + 180.0);
    lv_tx = PointGetX(lv_target);
    lv_ty = PointGetY(lv_target);
    lv_tz = PointGetHeight(lv_target);
    if (lv_tz < WorldHeight(c_heightMapGround, lv_target)) {
        lv_tz = WorldHeight(c_heightMapGround, lv_target);
    }
    lv_offset = gv_iMMORTAL;
    if (UnitGetType(gv_tPSUNIT[lp_player]) == "Tosh") {
        lv_offset = gv_mARINE;
    }
    lv_ex = PointGetX(lv_eye);
    lv_ey = PointGetY(lv_eye);
    lv_ez = lv_tz + lv_offset + (Sin(lv_pitch) * lp_desired);
    for (lv_seg = 1; lv_seg <= 16; lv_seg += 1) {
        lv_fraction = lv_seg / 16.0;
        lv_sample = Point(lv_tx + ((lv_ex - lv_tx) * lv_fraction), lv_ty + ((lv_ey - lv_ty) * lv_fraction));
        lv_sampleZ = lv_tz + ((lv_ez - lv_tz) * lv_fraction);
        if (((lv_fraction * lp_desired) > 0.8) && ((lv_sampleZ - 0.25) < WorldHeight(c_heightMapGround, lv_sample))) {
            lv_safe = (lp_desired * ((lv_seg - 1) / 16.0)) - 0.25;
            if (lv_safe < 0.4) {
                lv_safe = 0.4;
            }
            return lv_safe;
        }
        
    }
    return lp_desired;
}

void gf_CameraCollisionApply (int lp_player) {
    fixed lv_desired;
    fixed lv_current;
    fixed lv_safe;

    if (!UnitIsValid(gv_tPSUNIT[lp_player]) || gv_cameraCollisionOff[lp_player]) {
        return;
    }
    if (gv_cameraDistanceDesired[lp_player] <= 0.0) {
        gv_cameraDistanceDesired[lp_player] = CameraGetDistance(lp_player);
    }
    lv_desired = gv_cameraDistanceDesired[lp_player];
    lv_current = CameraGetDistance(lp_player);
    lv_safe = gf_CameraSafeDistance(lp_player, lv_desired);
    if ((lv_safe < (lv_current - 0.15)) && (AbsF(lv_safe - gv_cameraDistanceApplied[lp_player]) > 0.15)) {
        CameraSetValue(lp_player, c_cameraValueDistance, lv_safe, c_SCOBA_COLLISION_CLAMP_BLEND, -1, 10);
        gv_cameraDistanceApplied[lp_player] = lv_safe;
        if (gv_aIMACTIVE[lp_player]) {
            gv_aimDbgClamps[lp_player] += 1;
        }
    }
    else if ((lv_current < (lv_desired - 0.15)) && (lv_safe >= (lv_desired - 0.05)) && (AbsF(lv_desired - gv_cameraDistanceApplied[lp_player]) > 0.15)) {
        CameraSetValue(lp_player, c_cameraValueDistance, lv_desired, c_SCOBA_COLLISION_RESTORE_BLEND, -1, 10);
        gv_cameraDistanceApplied[lp_player] = lv_desired;
        if (gv_aIMACTIVE[lp_player]) {
            gv_aimDbgClamps[lp_player] += 1;
        }
    }
}

bool gt_CameraCollisionTick_Func (bool testConds, bool runActions) {
    int lv_player;

    if (!runActions) {
        return true;
    }
    for (lv_player = c_SCOBA_HERO_FIRST; lv_player <= c_SCOBA_HERO_LAST; lv_player += 1) {
        gf_CameraCollisionApply(lv_player);
    }
    return true;
}

void gt_CameraCollisionTick_Init () {
    gt_CameraCollisionTick = TriggerCreate("gt_CameraCollisionTick_Func");
    TriggerAddEventTimePeriodic(gt_CameraCollisionTick, 0.02, c_timeGame);
}

bool gt_CameraTurnTick_Func (bool testConds, bool runActions) {
    int lv_player;

    if (!runActions) {
        return true;
    }
    for (lv_player = c_SCOBA_HERO_FIRST; lv_player <= c_SCOBA_HERO_LAST; lv_player += 1) {
        if (!gf_ActionModeActive(lv_player) && (gv_rOTATEUNIT[lv_player] == true) && UnitIsValid(gv_tPSUNIT[lv_player])) {
            gf_TurnToYaw(lv_player, CameraGetYaw(lv_player));
        }
        else if (!gf_ActionModeActive(lv_player) && !gv_aIMACTIVE[lv_player]) {
            gv_animHasTurnTarget[lv_player] = false;
        }
    }
    return true;
}

void gt_CameraTurnTick_Init () {
    gt_CameraTurnTick = TriggerCreate("gt_CameraTurnTick_Func");
    TriggerAddEventTimePeriodic(gt_CameraTurnTick, 0.05, c_timeGame);
}

bool gt_XCenterUnitOrders_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    if ((PlayerRace(EventPlayer()) == "Terr")) {
        UnitGroupIssueOrder(libNtve_gf_ConvertUnitToUnitGroup(EventUnit()), OrderTargetingPoint(AbilityCommand("attack", 0), RegionGetCenter(RegionFromId(2))), c_orderQueueReplace);
    }
    else {
        UnitGroupIssueOrder(libNtve_gf_ConvertUnitToUnitGroup(EventUnit()), OrderTargetingPoint(AbilityCommand("attack", 0), RegionGetCenter(RegionFromId(1))), c_orderQueueReplace);
    }
    return true;
}

