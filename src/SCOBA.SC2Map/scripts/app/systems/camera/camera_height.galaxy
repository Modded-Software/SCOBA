// Module: systems/camera/camera_height
// The TPS / POC camera follows the bound unit's height (R-TPS-90). The
// heights are the tops of the measured hit shapes, generated into
// data/camera_heights by scripts/hitvolumes/camera_heights.py. Tosh
// (ToshSCOBA) is the reference: his height gives the old fixed target
// offset (c_SCOBA_CAMERA_HEIGHT_OFFSET) and arm (c_SCOBA_CAMERA_ARM).
// A height asked of no unit, or of a type without a measured height, is a
// defect: it stops the calling thread with a script error. The build check
// (camera_heights.py, missing_bodies) makes sure every bound body has one.

// A unit's absolute z: the engine ground under it plus its height above
// that ground. A unit position carries no height (PointGetHeight reads 0),
// and UnitGetHeight is above the ground (ground run 20261119-141014).
fixed gf_UnitWorldZ (unit lp_unit) {
    return WorldHeight(c_heightMapGround, UnitGetPosition(lp_unit)) + UnitGetHeight(lp_unit);
}

void gf_CamHeightType (string lp_name, fixed lp_height) {
    DataTableSetFixed(true, "CAMH_" + lp_name, lp_height);
}

// Stops the calling thread with a script error that names the defect.
// The engine writes it to ScriptError.txt, which fails a test run.
void gf_CamHeightFail (string lp_why) {
    int lv_zero = 0;

    TriggerDebugOutput(1, StringToText("camera height: " + lp_why), true);
    lv_zero = 1 / lv_zero;
}

// Whether the unit is a unit whose type has a measured height.
bool gf_CameraHeightKnown (unit lp_unit) {
    return UnitIsValid(lp_unit) && DataTableValueExists(true, "CAMH_" + UnitGetType(lp_unit));
}

// The unit's measured height. No unit, or a type without a row, is a defect.
fixed gf_CameraUnitHeight (unit lp_unit) {
    if (!UnitIsValid(lp_unit)) {
        gf_CamHeightFail("asked of no unit");
        return 0.0;  // not reached: the fail stops the thread
    }
    if (!gf_CameraHeightKnown(lp_unit)) {
        gf_CamHeightFail(UnitGetType(lp_unit) + " has no measured height; run hitvolumes.measure");
        return 0.0;  // not reached: the fail stops the thread
    }
    return DataTableGetFixed(true, "CAMH_" + UnitGetType(lp_unit));
}

// Height scale of the unit against Tosh: 1 for Tosh.
fixed gf_CameraHeightScale (unit lp_unit) {
    return gf_CameraUnitHeight(lp_unit) / c_CAM_HEIGHT_REFERENCE;
}

// The camera target height above the unit's ground point.
fixed gf_CameraTargetOffset (unit lp_unit) {
    return c_SCOBA_CAMERA_HEIGHT_OFFSET * gf_CameraHeightScale(lp_unit);
}

// The default camera arm for the unit.
fixed gf_CameraArm (unit lp_unit) {
    return c_SCOBA_CAMERA_ARM * gf_CameraHeightScale(lp_unit);
}
