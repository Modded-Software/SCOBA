// Module: systems/camera/camera

// Ends every camera follow of a player. CameraFollowUnitGroup with follow
// false removes the units of the group given; an empty group removes none
// (herodrop/20261119-170732: the camera kept the dead hero through the
// drop). So the group the engine holds is removed.
void gf_CameraFollowStop (int lp_player) {
    CameraFollowUnitGroup(lp_player, CameraFollowUnitGroupGet(lp_player), false, false);
}

// The one writer of the TPS camera height offset while a quake, a jump or a
// hero drop is active: base + quake shake + jump elevation (R-JUMP-17) +
// pod height (R-DROP-4). lp_time blends to the value; the jump and the drop
// pass their per-loop height time so camera and unit move together.
// A flying bound unit's flight height: the camera follows the unit's ground
// point, so the offset lifts it to the unit. 0 for ground units (a jump
// has its own term).
fixed gf_CameraUnitLift (int lp_player) {
    return gf_FlightCamHeight(lp_player);  // systems/flight; 0 on the ground
}

// The base is the bound unit's target offset (R-TPS-90): 0.9 for Tosh,
// scaled by height for the others.
fixed gf_CameraHeightBase (int lp_player) {
    return gf_CameraTargetOffset(gv_tPSUNIT[lp_player]);
}

// The bound unit type of the last height write. A morph keeps the unit and
// changes its type (Viking landing): gt_CameraMorphTick writes again.
string[8] gv_cameraHeightType;
const fixed c_CAMERA_MORPH_BLEND = 0.5;
trigger gt_CameraMorphTick;

// The camera height offset over the target's ground: the one value the
// height writer sends and the ground clamp measures from.
fixed gf_CameraHeightTotal (int lp_player) {
    return gf_CameraHeightBase(lp_player) + gv_quakeHeight[lp_player] + gv_jumpCamHeight[lp_player] + gv_dropCamHeight[lp_player] + gf_CameraUnitLift(lp_player);
}

void gf_CameraHeightApply (int lp_player, fixed lp_time) {
    fixed lv_height = gf_CameraHeightTotal(lp_player);

    gv_cameraHeightType[lp_player] = UnitGetType(gv_tPSUNIT[lp_player]);
    // Velocity 0, deceleration 0: a plain linear blend over lp_time. The old
    // (-1, 10) carried velocity and eased out, and lagged the jump (operator).
    CameraSetValue(lp_player, c_cameraValueHeightOffset, lv_height, lp_time, 0.0, 0.0);
    gv_cameraHeightApplied[lp_player] = lv_height;
}

// Bound unit changed type since the last write (R-TPS-90): write the new
// base. Only after a first write, so the intro camera is left alone.
bool gt_CameraMorphTick_Func (bool testConds, bool runActions) {
    int lv_p;
    unit lv_u;

    if (!runActions) {
        return true;
    }
    for (lv_p = c_SCOBA_HERO_FIRST; lv_p <= c_SCOBA_HERO_LAST; lv_p += 1) {
        lv_u = gv_tPSUNIT[lv_p];
        if (!UnitIsValid(lv_u) || gv_cameraHeightType[lv_p] == "") {
            continue;
        }
        if (gf_InputHeld(lv_p)) {
            continue;
        }
        if (UnitGetType(lv_u) != gv_cameraHeightType[lv_p]) {
            gf_CameraHeightApply(lv_p, c_CAMERA_MORPH_BLEND);
        }
    }
    return true;
}

void gt_CameraMorphTick_Init () {
    gt_CameraMorphTick = TriggerCreate("gt_CameraMorphTick_Func");
    TriggerAddEventTimePeriodic(gt_CameraMorphTick, 0.125, c_timeGame);
}

void gf_CameraZoomApply (int lp_player) {
    fixed lv_desired;
    fixed lv_safe;

    lv_desired = gv_cameraDistanceDesired[lp_player];
    lv_safe = gf_CameraSafeDistance(lp_player, lv_desired);
    if (lv_safe > lv_desired) {
        lv_safe = lv_desired;
    }
    CameraSetValue(lp_player, c_cameraValueDistance, lv_safe, c_SCOBA_ZOOM_BLEND, -1, 10);
    gv_cameraDistanceApplied[lp_player] = lv_safe;
}

bool gt_CameraFollowDistance_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_localPlayer;

    // Variable Initialization
    lv_localPlayer = EventPlayer();

    // Actions
    if (!runActions) {
        return true;
    }
    // Input hold of this player (systems/input_hold).
    if (gf_InputHeld(EventPlayer())) {
        return true;
    }

    if (gv_cameraDistanceDesired[lv_localPlayer] <= 0.0) {
        gv_cameraDistanceDesired[lv_localPlayer] = CameraGetDistance(lv_localPlayer);
    }
    gv_cameraDistanceDesired[lv_localPlayer] = gv_cameraDistanceDesired[lv_localPlayer] - (EventMouseWheelSpin() / 2.0);
    if (gv_cameraDistanceDesired[lv_localPlayer] < 1.0) {
        gv_cameraDistanceDesired[lv_localPlayer] = 1.0;
    }
    if (gv_cameraDistanceDesired[lv_localPlayer] > 40.0) {
        gv_cameraDistanceDesired[lv_localPlayer] = 40.0;
    }
    gf_CameraZoomApply(lv_localPlayer);
    return true;
}

void gt_CameraFollowDistance_Init () {
    gt_CameraFollowDistance = TriggerCreate("gt_CameraFollowDistance_Func");
    TriggerAddEventMouseWheel(gt_CameraFollowDistance, c_playerAny);
}

bool gt_CameraDebugMove_Func (bool testConds, bool runActions) {
    int lv_player;

    if (!runActions) {
        return true;
    }
    // Input hold of this player (systems/input_hold).
    if (gf_InputHeld(EventPlayer())) {
        return true;
    }
    lv_player = EventPlayer();
    if (!gf_IsHeroPlayer(lv_player)) {
        return true;
    }
    gv_cAMDBGCOUNT[lv_player] += 1;
    gv_cAMDBGLAST[lv_player] = EventCameraMoveReason();
    return true;
}

void gt_CameraDebugMove_Init () {
    gt_CameraDebugMove = TriggerCreate("gt_CameraDebugMove_Func");
    TriggerAddEventCameraMove(gt_CameraDebugMove, c_playerAny, c_cameraMoveReasonAny);
}

bool gt_CameraDebug_Func (bool testConds, bool runActions) {
    bank lv_bank;
    unit lv_hero;
    point lv_target;
    string lv_text;

    if (!runActions) {
        return true;
    }
    lv_bank = BankLoad("SCOBACAMDBG", 1);
    BankSectionCreate(lv_bank, "state");
    lv_text = "lock=" + gf_AnimFlag(gv_eDGEBLOCK[1]);
    lv_text = lv_text + " rel=" + gf_AnimFlag(gv_cONTROLRELATIVE[1]);
    lv_text = lv_text + " action=" + gf_AnimFlag(gf_TpsActive(1));
    lv_text = lv_text + " aim=" + gf_AnimFlag(gv_aIMACTIVE[1]);
    lv_text = lv_text + " count=" + IntToString(gv_cAMDBGCOUNT[1]);
    lv_text = lv_text + " last=" + IntToString(gv_cAMDBGLAST[1]);
    lv_text = lv_text + " step=" + FixedToString(gv_aimDbgMaxStep[1], c_fixedPrecisionAny);
    lv_text = lv_text + " clamps=" + IntToString(gv_aimDbgClamps[1]);
    lv_text = lv_text + " dist=" + FixedToString(CameraGetDistance(1), c_fixedPrecisionAny);
    lv_hero = gv_tPSUNIT[1];
    if (UnitIsValid(lv_hero)) {
        lv_target = CameraGetTarget(1);
        lv_text = lv_text + " hx=" + IntToString(FixedToInt(PointGetX(UnitGetPosition(lv_hero))));
        lv_text = lv_text + " hy=" + IntToString(FixedToInt(PointGetY(UnitGetPosition(lv_hero))));
        lv_text = lv_text + " tx=" + IntToString(FixedToInt(PointGetX(lv_target)));
        lv_text = lv_text + " ty=" + IntToString(FixedToInt(PointGetY(lv_target)));
    }
    BankValueSetFromString(lv_bank, "state", "p1", lv_text);
    BankSave(lv_bank);
    return true;
}

void gt_CameraDebug_Init () {
    gt_CameraDebug = TriggerCreate("gt_CameraDebug_Func");
    TriggerAddEventTimePeriodic(gt_CameraDebug, 1.0, c_timeGame);
}


bool gt_ZoomEnd_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_localPlayer;

    // Variable Initialization
    lv_localPlayer = EventPlayer();

    // Actions
    if (!runActions) {
        return true;
    }
    // Input hold of this player (systems/input_hold).
    if (gf_InputHeld(EventPlayer())) {
        return true;
    }

    gv_cAMERAFOV[lv_localPlayer] = c_SCOBA_REST_FOV;
    CameraSetValue(lv_localPlayer, c_cameraValueFieldOfView, c_SCOBA_REST_FOV, 0.5, -1, 10.0);
    return true;
}

void gt_ZoomEnd_Init () {
    gt_ZoomEnd = TriggerCreate("gt_ZoomEnd_Func");
    TriggerAddEventKeyPressed(gt_ZoomEnd, c_playerAny, gv_zOOM, false, c_keyModifierStateIgnore, c_keyModifierStateIgnore, c_keyModifierStateIgnore);
}

