// Module: systems/damage_floaters

// The font size of a damage number: the base size at 0 damage, the largest
// size from c_FLOATER_DAMAGE_FULL up.
int gf_FloaterDamageSize (fixed lp_damage) {
    fixed lv_share;

    lv_share = MinF(MaxF(lp_damage, 0.0) / c_FLOATER_DAMAGE_FULL, 1.0);
    return c_FLOATER_SIZE_BASE + FixedToInt(Round(lv_share * IntToFixed(c_FLOATER_SIZE_MAX - c_FLOATER_SIZE_BASE)));
}

void gf_FloaterCreate (int lp_player, point lp_point, text lp_text, color lp_color, int lp_size) {
    int lv_tag;
    point lv_point;

    lv_point = PointWithOffset(lp_point, RandomFixed(0.0 - c_FLOATER_JITTER, c_FLOATER_JITTER), RandomFixed(0.0 - c_FLOATER_JITTER, c_FLOATER_JITTER));
    TextTagCreate(lp_text, lp_size, lv_point, 1.6, true, false, PlayerGroupSingle(lp_player));
    lv_tag = TextTagLastCreated();
    TextTagSetColor(lv_tag, c_textTagColorText, lp_color);
    TextTagSetVelocity(lv_tag, 0.70, 90.0);  // operator 2026-11-16: twice as far (was 0.35)
    TextTagSetTime(lv_tag, c_textTagTimeDuration, 1.6);
    TextTagSetTime(lv_tag, c_textTagTimeFadeOut, 1.1);
    TextTagShow(lv_tag, PlayerGroupSingle(lp_player), true);
}

bool gt_DamageFloater_Func (bool testConds, bool runActions) {
    unit lv_victim;
    unit lv_source;
    int lv_player;
    fixed lv_damage;
    int lv_amount;
    text lv_text;

    lv_victim = EventUnit();
    lv_source = EventUnitDamageSourceUnit();
    lv_damage = EventUnitDamageAmount();

    if (!runActions) {
        return true;
    }

    if (!UnitIsValid(lv_victim) || !UnitIsValid(lv_source)) {
        return true;
    }
    if (lv_victim == lv_source) {
        return true;
    }
    
    if (lv_damage <= 0.0) {
        return true;
    }

    lv_player = gf_HeroPlayerFromUnit(lv_source);
    if (!gf_IsHeroPlayer(lv_player)) {
        return true;
    }

    lv_amount = FixedToInt(Round(lv_damage));
    lv_text = StringToText(IntToString(lv_amount));
    gf_FloaterCreate(lv_player, UnitGetPosition(lv_victim), lv_text, Color(100.0, 25.0, 25.0), gf_FloaterDamageSize(lv_damage));
    return true;
}

void gt_DamageFloater_Init () {
    gt_DamageFloater = TriggerCreate("gt_DamageFloater_Func");
    TriggerAddEventUnitDamaged(gt_DamageFloater, null, c_unitDamageTypeAny, c_unitDamageEither, null);
}