// Module: systems/spawns

// Drop pod spots (operator 2026-11-20: pods landed on buildings): a free
// 4x4 cell square in or near the spawn region. Free: all 16 cells ground
// pathable on one cliff level (buildings and doodad footprints block), no
// living, shown ground unit within c_POD_SPOT_CLEAR, and at least
// c_POD_SPOT_SPACING from the other pods of the wave.
const int c_POD_SPOT_TRIES = 24;        // random spots in the region
const fixed c_POD_SPOT_CLEAR = 2.5;     // unit-free radius around the center
const fixed c_POD_SPOT_SPACING = 4.0;   // between pod centers
const fixed c_POD_SPOT_NEAR = 12.0;     // ring search past the region edge
const int c_POD_SPOT_RING_STEPS = 16;   // angles per ring
int gv_podSpotPicks;                    // spots picked (tests)
int gv_podSpotRing;                     // picked by the ring search (tests)
int gv_podSpotNone;                     // no free spot found: region center (tests)

// The 4x4 square centered on lp_at (a cell corner) is free of terrain,
// buildings and ground units.
bool gf_DropPodSpotFree (point lp_at) {
    int lv_i;
    int lv_j;
    point lv_c;
    fixed lv_level = PointPathingCliffLevel(PointWithOffset(lp_at, -1.5, -1.5));
    unitgroup lv_near;

    for (lv_i = 0; lv_i < 4; lv_i += 1) {
        for (lv_j = 0; lv_j < 4; lv_j += 1) {
            lv_c = PointWithOffset(lp_at, IntToFixed(lv_i) - 1.5, IntToFixed(lv_j) - 1.5);
            if (!PointPathingPassable(lv_c) || PointPathingCliffLevel(lv_c) != lv_level) {
                return false;
            }
        }
    }
    lv_near = UnitGroup(null, c_playerAny, RegionCircle(lp_at, c_POD_SPOT_CLEAR), UnitFilter(0, 0, (1 << c_targetFilterMissile) | (1 << c_targetFilterAir), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 1);
    return UnitGroupCount(lv_near, c_unitCountAll) == 0;
}

// Distance to the nearer used pod; 9999 with none.
fixed gf_DropPodSpotGap (point lp_at, point lp_usedA, point lp_usedB) {
    fixed lv_d = 9999.0;

    if (lp_usedA != null) {
        lv_d = MinF(lv_d, DistanceBetweenPoints(lp_at, lp_usedA));
    }
    if (lp_usedB != null) {
        lv_d = MinF(lv_d, DistanceBetweenPoints(lp_at, lp_usedB));
    }
    return lv_d;
}

// A cell corner: the 4x4 square covers whole cells.
point gf_DropPodSpotSnap (point lp_at) {
    return Point(IntToFixed(FixedToInt(PointGetX(lp_at) + 0.5)), IntToFixed(FixedToInt(PointGetY(lp_at) + 0.5)));
}

// In the region: the free spot farthest from the used pods among random
// tries. None: rings around the region center, outward to the region
// radius plus c_POD_SPOT_NEAR, the first free spot. None at all: the
// region center, counted in gv_podSpotNone.
point gf_DropPodPoint (region lp_region, point lp_usedA, point lp_usedB) {
    int lv_try;
    int lv_k;
    point lv_pick;
    point lv_best = null;
    fixed lv_bestGap = 0.0;
    fixed lv_gap;
    point lv_center = RegionGetCenter(lp_region);
    fixed lv_radius = MaxF(PointGetX(RegionGetBoundsMax(lp_region)) - PointGetX(RegionGetBoundsMin(lp_region)), PointGetY(RegionGetBoundsMax(lp_region)) - PointGetY(RegionGetBoundsMin(lp_region))) / 2.0;
    fixed lv_r;

    gv_podSpotPicks += 1;
    for (lv_try = 0; lv_try < c_POD_SPOT_TRIES; lv_try += 1) {
        lv_pick = gf_DropPodSpotSnap(RegionRandomPoint(lp_region));
        lv_gap = gf_DropPodSpotGap(lv_pick, lp_usedA, lp_usedB);
        if (lv_gap >= c_POD_SPOT_SPACING && lv_gap > lv_bestGap && gf_DropPodSpotFree(lv_pick)) {
            lv_bestGap = lv_gap;
            lv_best = lv_pick;
        }
    }
    if (lv_best != null) {
        return lv_best;
    }
    for (lv_r = 0.0; lv_r <= lv_radius + c_POD_SPOT_NEAR; lv_r += 1.0) {
        for (lv_k = 0; lv_k < c_POD_SPOT_RING_STEPS; lv_k += 1) {
            lv_pick = gf_DropPodSpotSnap(PointWithOffsetPolar(lv_center, lv_r, IntToFixed(lv_k) * 360.0 / IntToFixed(c_POD_SPOT_RING_STEPS)));
            if (gf_DropPodSpotGap(lv_pick, lp_usedA, lp_usedB) >= c_POD_SPOT_SPACING && gf_DropPodSpotFree(lv_pick)) {
                gv_podSpotRing += 1;
                return lv_pick;
            }
        }
    }
    gv_podSpotNone += 1;
    return lv_center;
}

// Wave units are script units: the base AI of their owner leaves them
// alone (REQ-BASE-AI R-BASE-20).
unitgroup gf_CreateSpawnGroup (int lp_count, string lp_type, int lp_player, point lp_point) {
    unitgroup lv_group;

    libNtve_gf_CreateUnitsAtPoint2(lp_count, lp_type, 0, lp_player, lp_point);
    lv_group = UnitLastCreatedGroup();
    if (gf_BaseAiIsAiPlayer(lp_player)) {
        gf_BaseAiExcludeGroup(lv_group);
    }
    return lv_group;
}

void gf_OrderSpawnGroup (unitgroup lp_group, int lp_side, int lp_lane) {
    UnitGroupLoopBegin(lp_group);
    for ( ; !UnitGroupLoopDone() ; UnitGroupLoopStep() ) {
        UnitSetState(UnitGroupLoopCurrent(), c_unitStateHighlightable, true);
    }
    UnitGroupLoopEnd();
    gf_GateSendGroup(lp_group, lp_side, lp_lane, gv_xLOCATIONS[lp_lane]);
}

// One lane wave of a Zerg lane lp_map (4..6) in three pods; one of a Terran
// lane (1..3) in two. The reinforcement and the hero drop escort both run
// these. They wait while the pods land. The units made are added to
// lp_into. lp_goliath: the Terran wave always has its Goliath (the hero
// drop escort, operator 2026-11-20); else only while the seat has none.
void gf_ZergLaneWave (int lp_map, point lp_podA, point lp_podB, point lp_podC, unitgroup lp_into) {
    int lv_playerIndex = gf_RosterSeat(lp_map);
    int lv_lane = lp_map - 3;
    unitgroup lv_group;

    lv_group = gf_CreateSpawnGroup(8, "Zergling", lv_playerIndex, lp_podA);
    UnitGroupAddUnitGroup(lp_into, lv_group);
    gf_PodImpactQueue(libVCMI_ge_DropPodRace_Zerg, lp_podA);
    libVCMI_gf_CreateDropPod(libVCMI_ge_DropPodRace_Zerg, lp_podA, lv_group, false, lv_playerIndex);
    Wait(4.0, c_timeGame);
    gf_OrderSpawnGroup(lv_group, 0, lv_lane);

    lv_group = gf_CreateSpawnGroup(1, "RoachCorpser", lv_playerIndex, lp_podB);
    UnitGroupAddUnitGroup(lp_into, lv_group);
    gf_PodImpactQueue(libVCMI_ge_DropPodRace_Zerg, lp_podB);
    libVCMI_gf_CreateDropPod(libVCMI_ge_DropPodRace_Zerg, lp_podB, lv_group, false, lv_playerIndex);
    Wait(4.0, c_timeGame);
    gf_OrderSpawnGroup(lv_group, 0, lv_lane);

    lv_group = gf_CreateSpawnGroup(2, "Roach", lv_playerIndex, lp_podC);
    if ((TechTreeUnitCount(lv_playerIndex, "Queen", c_techCountQueuedOrBetter) == 0)) {
        UnitGroupAddUnitGroup(lv_group, gf_CreateSpawnGroup(1, "Queen", lv_playerIndex, lp_podC));
    }
    UnitGroupAddUnitGroup(lp_into, lv_group);
    gf_PodImpactQueue(libVCMI_ge_DropPodRace_Zerg, lp_podC);
    libVCMI_gf_CreateDropPod(libVCMI_ge_DropPodRace_Zerg, lp_podC, lv_group, false, lv_playerIndex);
    Wait(4.0, c_timeGame);
    gf_OrderSpawnGroup(lv_group, 0, lv_lane);
}

void gf_TerranLaneWave (int lp_map, point lp_podA, point lp_podB, unitgroup lp_into, bool lp_goliath) {
    int lv_playerIndex = gf_RosterSeat(lp_map);
    int lv_lane = lp_map;
    unitgroup lv_group;

    lv_group = gf_CreateSpawnGroup(4, "Marine", lv_playerIndex, lp_podA);
    if (lp_goliath || (TechTreeUnitCount(lv_playerIndex, "Goliath", c_techCountQueuedOrBetter) == 0)) {
        UnitGroupAddUnitGroup(lv_group, gf_CreateSpawnGroup(1, "Goliath", lv_playerIndex, lp_podA));
    }
    UnitGroupAddUnitGroup(lp_into, lv_group);
    gf_PodImpactQueue(libVCMI_ge_DropPodRace_Terran, lp_podA);
    libVCMI_gf_CreateDropPod(libVCMI_ge_DropPodRace_Terran, lp_podA, lv_group, true, lv_playerIndex);
    gf_OrderSpawnGroup(lv_group, 1, lv_lane);

    lv_group = gf_CreateSpawnGroup(2, "Marauder", lv_playerIndex, lp_podB);
    UnitGroupAddUnitGroup(lv_group, gf_CreateSpawnGroup(1, "Firebat", lv_playerIndex, lp_podB));
    UnitGroupAddUnitGroup(lp_into, lv_group);
    gf_PodImpactQueue(libVCMI_ge_DropPodRace_Terran, lp_podB);
    libVCMI_gf_CreateDropPod(libVCMI_ge_DropPodRace_Terran, lp_podB, lv_group, true, lv_playerIndex);
    gf_OrderSpawnGroup(lv_group, 1, lv_lane);
}

// --- Hero drop escort (REQ-HERO-DROP R-DROP-14) ----------------------------
// Every hero drop brings one extra lane wave of the seat's lane (operator
// 2026-11-20). Its pods face as the hero pod, so they fall the same way
// (southwest). Free spots off the hero pod (gf_DropPodPoint). Its own
// thread: the lane waves wait.
trigger gt_DropEscort;
int gv_escortLane;          // parameters of the next gt_DropEscort run
point gv_escortHeroAt;
fixed gv_escortFacing;
int[8] gv_escortWaves;      // escort waves started per seat (tests)
fixed[8] gv_escortPodFacing; // the facing given to the seat's last escort pods (tests)
point[8] gv_escortPodA;     // the seat's last escort pod points (tests)
point[8] gv_escortPodB;
unitgroup[8] gv_escortUnits; // the units of the seat's last escort wave (tests)

point gf_EscortPoint (region lp_region, point lp_usedA, point lp_usedB, fixed lp_facing) {
    point lv_at = gf_DropPodPoint(lp_region, lp_usedA, lp_usedB);

    PointSetFacing(lv_at, lp_facing);
    return lv_at;
}

bool gt_DropEscort_Func (bool testConds, bool runActions) {
    int lv_map = gv_escortLane;
    point lv_hero = gv_escortHeroAt;
    fixed lv_facing = gv_escortFacing;
    int lv_seat;
    point lv_podA;
    point lv_podB;

    if (!runActions) {
        return true;
    }
    lv_seat = gf_RosterSeat(lv_map);
    lv_podA = gf_EscortPoint(gv_sPAWNLOCATIONS[lv_map], lv_hero, null, lv_facing);
    lv_podB = gf_EscortPoint(gv_sPAWNLOCATIONS[lv_map], lv_hero, lv_podA, lv_facing);
    gv_escortWaves[lv_seat] += 1;
    gv_escortPodFacing[lv_seat] = lv_facing;
    gv_escortPodA[lv_seat] = lv_podA;
    gv_escortPodB[lv_seat] = lv_podB;
    gv_escortUnits[lv_seat] = UnitGroupEmpty();
    if (gf_RosterTerran(lv_map)) {
        gf_TerranLaneWave(lv_map, lv_podA, lv_podB, gv_escortUnits[lv_seat], true);
    }
    else {
        gf_ZergLaneWave(lv_map, lv_podA, lv_podB, gf_EscortPoint(gv_sPAWNLOCATIONS[lv_map], lv_podA, lv_podB, lv_facing), gv_escortUnits[lv_seat]);
    }
    return true;
}

// lp_facing: the hero pod's facing.
void gf_DropEscort (int lp_player, point lp_heroAt, fixed lp_facing) {
    gv_escortLane = gf_RosterLaneOf(lp_player);
    gv_escortHeroAt = lp_heroAt;
    gv_escortFacing = lp_facing;
    TriggerExecute(gt_DropEscort, true, false);
}

bool gt_ZerusSpawn_Func (bool testConds, bool runActions) {
    int lv_map;

    // Variable Declarations
    int lv_playerIndex;
    point lv_podA;
    point lv_podB;
    point lv_podC;

    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    // Zerg lanes (core/roster): waves of the seat; lv_lane is the gate lane.
    for (lv_map = 1; lv_map <= c_ROSTER_LANES; lv_map += 1) {
        if (gf_RosterTerran(lv_map)) {
            continue;
        }
        lv_playerIndex = gf_RosterSeat(lv_map);
        lv_podA = gf_DropPodPoint(gv_sPAWNLOCATIONS[lv_map], null, null);
        lv_podB = gf_DropPodPoint(gv_sPAWNLOCATIONS[lv_map], lv_podA, null);
        lv_podC = gf_DropPodPoint(gv_sPAWNLOCATIONS[lv_map], lv_podA, lv_podB);

        gf_ZergLaneWave(lv_map, lv_podA, lv_podB, lv_podC, UnitGroupEmpty());
    }
    return true;
}

void gt_ZerusSpawn_Init () {
    gt_ZerusSpawn = TriggerCreate("gt_ZerusSpawn_Func");
    TriggerAddEventTimer(gt_ZerusSpawn, gv_sPAWNTIMER);
}

bool gt_TerranSpawn_Func (bool testConds, bool runActions) {
    int lv_map;

    // Variable Declarations
    int lv_playerIndex;
    point lv_podA;
    point lv_podB;

    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    // Terran lanes (core/roster): waves of the seat; lv_lane is the gate lane.
    for (lv_map = 1; lv_map <= c_ROSTER_LANES; lv_map += 1) {
        if (!gf_RosterTerran(lv_map)) {
            continue;
        }
        lv_playerIndex = gf_RosterSeat(lv_map);
        lv_podA = gf_DropPodPoint(gv_sPAWNLOCATIONS[lv_map], null, null);
        lv_podB = gf_DropPodPoint(gv_sPAWNLOCATIONS[lv_map], lv_podA, null);
        // A waiting hero's drop starts with this wave, off the two lane
        // pods (systems/hero_drop; nothing when no hero waits). Before the
        // lane pods: libVCMI_gf_CreateDropPod waits, and a hero that dies in
        // that wait must not get this wave's drop (herodrop/20261118-190259).
        if (gf_RosterPlayed(lv_playerIndex)) {
            gf_HeroDropGo(lv_playerIndex, lv_podA, lv_podB);
        }

        gf_TerranLaneWave(lv_map, lv_podA, lv_podB, UnitGroupEmpty(), false);
    }
    return true;
}

void gt_TerranSpawn_Init () {
    gt_TerranSpawn = TriggerCreate("gt_TerranSpawn_Func");
    gt_DropEscort = TriggerCreate("gt_DropEscort_Func");
    TriggerAddEventTimer(gt_TerranSpawn, gv_sPAWNTIMER);
}

bool gt_JungleCatsLeft_Func (bool testConds, bool runActions) {
    // Conditions
    if (testConds) {
        if (!((UnitGetType(EventUnit()) == "Predator"))) {
            return false;
        }

        if (!((libNtve_gf_UnitInRegion(EventUnit(), RegionFromId(12)) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitIssueOrder(EventUnit(), OrderTargetingPoint(AbilityCommand("attack", 0), RegionRandomPoint(RegionFromId(12))), c_orderQueueReplace);
    return true;
}

void gt_JungleCatsLeft_Init () {
    gt_JungleCatsLeft = TriggerCreate("gt_JungleCatsLeft_Func");
    TriggerAddEventUnitBecomesIdle(gt_JungleCatsLeft, null, true);
}

