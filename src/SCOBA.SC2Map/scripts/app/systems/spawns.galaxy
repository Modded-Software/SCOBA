// Module: systems/spawns

point gf_DropPodPoint (region lp_region, point lp_usedA, point lp_usedB) {
    int lv_try;
    point lv_pick;
    point lv_best;
    fixed lv_bestDistance;
    fixed lv_distance;

    lv_best = RegionRandomPoint(lp_region);
    lv_bestDistance = 0.0;
    for (lv_try = 0; lv_try < 16; lv_try += 1) {
        lv_pick = RegionRandomPoint(lp_region);
        lv_distance = 9999.0;
        if (lp_usedA != null) {
            lv_distance = MinF(lv_distance, DistanceBetweenPoints(lv_pick, lp_usedA));
        }
        if (lp_usedB != null) {
            lv_distance = MinF(lv_distance, DistanceBetweenPoints(lv_pick, lp_usedB));
        }
        if (lv_distance > lv_bestDistance) {
            lv_bestDistance = lv_distance;
            lv_best = lv_pick;
        }
    }
    return lv_best;
}

unitgroup gf_CreateSpawnGroup (int lp_count, string lp_type, int lp_player, point lp_point) {
    libNtve_gf_CreateUnitsAtPoint2(lp_count, lp_type, 0, lp_player, lp_point);
    return UnitLastCreatedGroup();
}

void gf_OrderSpawnGroup (unitgroup lp_group, point lp_target) {
    UnitGroupLoopBegin(lp_group);
    for ( ; !UnitGroupLoopDone() ; UnitGroupLoopStep() ) {
        UnitSetState(UnitGroupLoopCurrent(), c_unitStateHighlightable, true);
    }
    UnitGroupLoopEnd();
    UnitGroupIssueOrder(lp_group, OrderTargetingPoint(AbilityCommand("attack", 0), lp_target), c_orderQueueReplace);
}

bool gt_ZerusSpawn_Func (bool testConds, bool runActions) {
    int auto58D71E67_ae;
    int auto58D71E67_ai;

    // Variable Declarations
    int lv_playerIndex;
    point lv_target;
    point lv_podA;
    point lv_podB;
    point lv_podC;
    unitgroup lv_group;

    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    auto58D71E67_ae = 6;
    auto58D71E67_ai = 1;
    lv_playerIndex = 4;
    for ( ; ( (auto58D71E67_ai >= 0 && lv_playerIndex <= auto58D71E67_ae) || (auto58D71E67_ai <= 0 && lv_playerIndex >= auto58D71E67_ae) ) ; lv_playerIndex += auto58D71E67_ai ) {
        lv_target = RegionGetCenter(gv_xLOCATIONS[(lv_playerIndex - 3)]);
        lv_podA = gf_DropPodPoint(gv_sPAWNLOCATIONS[lv_playerIndex], null, null);
        lv_podB = gf_DropPodPoint(gv_sPAWNLOCATIONS[lv_playerIndex], lv_podA, null);
        lv_podC = gf_DropPodPoint(gv_sPAWNLOCATIONS[lv_playerIndex], lv_podA, lv_podB);

        lv_group = gf_CreateSpawnGroup(8, "Zergling", lv_playerIndex, lv_podA);
        libVCMI_gf_CreateDropPod(libVCMI_ge_DropPodRace_Zerg, lv_podA, lv_group, false, lv_playerIndex);
        Wait(4.0, c_timeGame);
        gf_OrderSpawnGroup(lv_group, lv_target);

        lv_group = gf_CreateSpawnGroup(1, "RoachCorpser", lv_playerIndex, lv_podB);
        libVCMI_gf_CreateDropPod(libVCMI_ge_DropPodRace_Zerg, lv_podB, lv_group, false, lv_playerIndex);
        Wait(4.0, c_timeGame);
        gf_OrderSpawnGroup(lv_group, lv_target);

        lv_group = gf_CreateSpawnGroup(2, "Roach", lv_playerIndex, lv_podC);
        if ((TechTreeUnitCount(lv_playerIndex, "Queen", c_techCountQueuedOrBetter) == 0)) {
            libNtve_gf_CreateUnitsAtPoint2(1, "Queen", 0, lv_playerIndex, lv_podC);
            UnitGroupAddUnitGroup(lv_group, UnitLastCreatedGroup());
        }
        libVCMI_gf_CreateDropPod(libVCMI_ge_DropPodRace_Zerg, lv_podC, lv_group, false, lv_playerIndex);
        Wait(4.0, c_timeGame);
        gf_OrderSpawnGroup(lv_group, lv_target);
    }
    return true;
}

void gt_ZerusSpawn_Init () {
    gt_ZerusSpawn = TriggerCreate("gt_ZerusSpawn_Func");
    TriggerAddEventTimer(gt_ZerusSpawn, gv_sPAWNTIMER);
}

bool gt_TerranSpawn_Func (bool testConds, bool runActions) {
    int autoA973637F_ae;
    int autoA973637F_ai;

    // Variable Declarations
    int lv_playerIndex;
    point lv_target;
    point lv_podA;
    point lv_podB;
    unitgroup lv_group;

    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    autoA973637F_ae = 3;
    autoA973637F_ai = 1;
    lv_playerIndex = 1;
    for ( ; ( (autoA973637F_ai >= 0 && lv_playerIndex <= autoA973637F_ae) || (autoA973637F_ai <= 0 && lv_playerIndex >= autoA973637F_ae) ) ; lv_playerIndex += autoA973637F_ai ) {
        lv_target = RegionGetCenter(gv_xLOCATIONS[lv_playerIndex]);
        lv_podA = gf_DropPodPoint(gv_sPAWNLOCATIONS[lv_playerIndex], null, null);
        lv_podB = gf_DropPodPoint(gv_sPAWNLOCATIONS[lv_playerIndex], lv_podA, null);

        lv_group = gf_CreateSpawnGroup(4, "Marine", lv_playerIndex, lv_podA);
        if ((TechTreeUnitCount(lv_playerIndex, "Goliath", c_techCountQueuedOrBetter) == 0)) {
            libNtve_gf_CreateUnitsAtPoint2(1, "Goliath", 0, lv_playerIndex, lv_podA);
            UnitGroupAddUnitGroup(lv_group, UnitLastCreatedGroup());
        }
        libVCMI_gf_CreateDropPod(libVCMI_ge_DropPodRace_Terran, lv_podA, lv_group, true, lv_playerIndex);
        gf_OrderSpawnGroup(lv_group, lv_target);

        lv_group = gf_CreateSpawnGroup(2, "Marauder", lv_playerIndex, lv_podB);
        libNtve_gf_CreateUnitsAtPoint2(1, "Firebat", 0, lv_playerIndex, lv_podB);
        UnitGroupAddUnitGroup(lv_group, UnitLastCreatedGroup());
        libVCMI_gf_CreateDropPod(libVCMI_ge_DropPodRace_Terran, lv_podB, lv_group, true, lv_playerIndex);
        gf_OrderSpawnGroup(lv_group, lv_target);
    }
    return true;
}

void gt_TerranSpawn_Init () {
    gt_TerranSpawn = TriggerCreate("gt_TerranSpawn_Func");
    TriggerAddEventTimer(gt_TerranSpawn, gv_sPAWNTIMER);
}

bool gt_JungleCatsLeft_Func (bool testConds, bool runActions) {
    // Conditions
    if (testConds) {
        if (!((UnitGetType(EventUnit()) == "Predator"))) {
            return false;
        }

        if (!((libNtve_gf_UnitInRegion(EventUnit(), RegionFromId(12)) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitIssueOrder(EventUnit(), OrderTargetingPoint(AbilityCommand("attack", 0), RegionRandomPoint(RegionFromId(12))), c_orderQueueReplace);
    return true;
}

void gt_JungleCatsLeft_Init () {
    gt_JungleCatsLeft = TriggerCreate("gt_JungleCatsLeft_Func");
    TriggerAddEventUnitBecomesIdle(gt_JungleCatsLeft, null, true);
}

