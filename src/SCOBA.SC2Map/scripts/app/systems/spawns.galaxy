// Module: systems/spawns

point gf_DropPodPoint (region lp_region, point lp_usedA, point lp_usedB) {
    int lv_try;
    point lv_pick;
    point lv_best;
    fixed lv_bestDistance;
    fixed lv_distance;

    lv_best = RegionRandomPoint(lp_region);
    lv_bestDistance = 0.0;
    for (lv_try = 0; lv_try < 16; lv_try += 1) {
        lv_pick = RegionRandomPoint(lp_region);
        lv_distance = 9999.0;
        if (lp_usedA != null) {
            lv_distance = MinF(lv_distance, DistanceBetweenPoints(lv_pick, lp_usedA));
        }
        if (lp_usedB != null) {
            lv_distance = MinF(lv_distance, DistanceBetweenPoints(lv_pick, lp_usedB));
        }
        if (lv_distance > lv_bestDistance) {
            lv_bestDistance = lv_distance;
            lv_best = lv_pick;
        }
    }
    return lv_best;
}

// Wave units are script units: the base AI of their owner leaves them
// alone (REQ-BASE-AI R-BASE-20).
unitgroup gf_CreateSpawnGroup (int lp_count, string lp_type, int lp_player, point lp_point) {
    unitgroup lv_group;

    libNtve_gf_CreateUnitsAtPoint2(lp_count, lp_type, 0, lp_player, lp_point);
    lv_group = UnitLastCreatedGroup();
    if (gf_BaseAiIsAiPlayer(lp_player)) {
        gf_BaseAiExcludeGroup(lv_group);
    }
    return lv_group;
}

void gf_OrderSpawnGroup (unitgroup lp_group, int lp_side, int lp_lane) {
    UnitGroupLoopBegin(lp_group);
    for ( ; !UnitGroupLoopDone() ; UnitGroupLoopStep() ) {
        UnitSetState(UnitGroupLoopCurrent(), c_unitStateHighlightable, true);
    }
    UnitGroupLoopEnd();
    gf_GateSendGroup(lp_group, lp_side, lp_lane, gv_xLOCATIONS[lp_lane]);
}

bool gt_ZerusSpawn_Func (bool testConds, bool runActions) {
    int lv_map;

    // Variable Declarations
    int lv_playerIndex;
    int lv_lane;
    point lv_podA;
    point lv_podB;
    point lv_podC;
    unitgroup lv_group;

    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    // Zerg lanes (core/roster): waves of the seat; lv_lane is the gate lane.
    for (lv_map = 1; lv_map <= c_ROSTER_LANES; lv_map += 1) {
        if (gf_RosterTerran(lv_map)) {
            continue;
        }
        lv_playerIndex = gf_RosterSeat(lv_map);
        lv_lane = lv_map - 3;
        lv_podA = gf_DropPodPoint(gv_sPAWNLOCATIONS[lv_map], null, null);
        lv_podB = gf_DropPodPoint(gv_sPAWNLOCATIONS[lv_map], lv_podA, null);
        lv_podC = gf_DropPodPoint(gv_sPAWNLOCATIONS[lv_map], lv_podA, lv_podB);

        lv_group = gf_CreateSpawnGroup(8, "Zergling", lv_playerIndex, lv_podA);
        gf_PodImpactQueue(libVCMI_ge_DropPodRace_Zerg, lv_podA);
        libVCMI_gf_CreateDropPod(libVCMI_ge_DropPodRace_Zerg, lv_podA, lv_group, false, lv_playerIndex);
        Wait(4.0, c_timeGame);
        gf_OrderSpawnGroup(lv_group, 0, lv_lane);

        lv_group = gf_CreateSpawnGroup(1, "RoachCorpser", lv_playerIndex, lv_podB);
        gf_PodImpactQueue(libVCMI_ge_DropPodRace_Zerg, lv_podB);
        libVCMI_gf_CreateDropPod(libVCMI_ge_DropPodRace_Zerg, lv_podB, lv_group, false, lv_playerIndex);
        Wait(4.0, c_timeGame);
        gf_OrderSpawnGroup(lv_group, 0, lv_lane);

        lv_group = gf_CreateSpawnGroup(2, "Roach", lv_playerIndex, lv_podC);
        if ((TechTreeUnitCount(lv_playerIndex, "Queen", c_techCountQueuedOrBetter) == 0)) {
            UnitGroupAddUnitGroup(lv_group, gf_CreateSpawnGroup(1, "Queen", lv_playerIndex, lv_podC));
        }
        gf_PodImpactQueue(libVCMI_ge_DropPodRace_Zerg, lv_podC);
        libVCMI_gf_CreateDropPod(libVCMI_ge_DropPodRace_Zerg, lv_podC, lv_group, false, lv_playerIndex);
        Wait(4.0, c_timeGame);
        gf_OrderSpawnGroup(lv_group, 0, lv_lane);
    }
    return true;
}

void gt_ZerusSpawn_Init () {
    gt_ZerusSpawn = TriggerCreate("gt_ZerusSpawn_Func");
    TriggerAddEventTimer(gt_ZerusSpawn, gv_sPAWNTIMER);
}

bool gt_TerranSpawn_Func (bool testConds, bool runActions) {
    int lv_map;

    // Variable Declarations
    int lv_playerIndex;
    int lv_lane;
    point lv_podA;
    point lv_podB;
    unitgroup lv_group;

    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    // Terran lanes (core/roster): waves of the seat; lv_lane is the gate lane.
    for (lv_map = 1; lv_map <= c_ROSTER_LANES; lv_map += 1) {
        if (!gf_RosterTerran(lv_map)) {
            continue;
        }
        lv_playerIndex = gf_RosterSeat(lv_map);
        lv_lane = lv_map;
        lv_podA = gf_DropPodPoint(gv_sPAWNLOCATIONS[lv_map], null, null);
        lv_podB = gf_DropPodPoint(gv_sPAWNLOCATIONS[lv_map], lv_podA, null);
        // A waiting hero's drop starts with this wave, off the two lane
        // pods (systems/hero_drop; nothing when no hero waits). Before the
        // lane pods: libVCMI_gf_CreateDropPod waits, and a hero that dies in
        // that wait must not get this wave's drop (herodrop/20261118-190259).
        if (gf_RosterPlayed(lv_playerIndex)) {
            gf_HeroDropGo(lv_playerIndex, lv_podA, lv_podB);
        }

        lv_group = gf_CreateSpawnGroup(4, "Marine", lv_playerIndex, lv_podA);
        if ((TechTreeUnitCount(lv_playerIndex, "Goliath", c_techCountQueuedOrBetter) == 0)) {
            UnitGroupAddUnitGroup(lv_group, gf_CreateSpawnGroup(1, "Goliath", lv_playerIndex, lv_podA));
        }
        gf_PodImpactQueue(libVCMI_ge_DropPodRace_Terran, lv_podA);
        libVCMI_gf_CreateDropPod(libVCMI_ge_DropPodRace_Terran, lv_podA, lv_group, true, lv_playerIndex);
        gf_OrderSpawnGroup(lv_group, 1, lv_lane);

        lv_group = gf_CreateSpawnGroup(2, "Marauder", lv_playerIndex, lv_podB);
        UnitGroupAddUnitGroup(lv_group, gf_CreateSpawnGroup(1, "Firebat", lv_playerIndex, lv_podB));
        gf_PodImpactQueue(libVCMI_ge_DropPodRace_Terran, lv_podB);
        libVCMI_gf_CreateDropPod(libVCMI_ge_DropPodRace_Terran, lv_podB, lv_group, true, lv_playerIndex);
        gf_OrderSpawnGroup(lv_group, 1, lv_lane);
    }
    return true;
}

void gt_TerranSpawn_Init () {
    gt_TerranSpawn = TriggerCreate("gt_TerranSpawn_Func");
    TriggerAddEventTimer(gt_TerranSpawn, gv_sPAWNTIMER);
}

bool gt_JungleCatsLeft_Func (bool testConds, bool runActions) {
    // Conditions
    if (testConds) {
        if (!((UnitGetType(EventUnit()) == "Predator"))) {
            return false;
        }

        if (!((libNtve_gf_UnitInRegion(EventUnit(), RegionFromId(12)) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitIssueOrder(EventUnit(), OrderTargetingPoint(AbilityCommand("attack", 0), RegionRandomPoint(RegionFromId(12))), c_orderQueueReplace);
    return true;
}

void gt_JungleCatsLeft_Init () {
    gt_JungleCatsLeft = TriggerCreate("gt_JungleCatsLeft_Func");
    TriggerAddEventUnitBecomesIdle(gt_JungleCatsLeft, null, true);
}

