bool gt_UnitHighlightOff6_Func (bool testConds, bool runActions) {
    gf_UnitHighlightOff(6, testConds, runActions);
    return true;
}

void gt_UnitHighlightOn_Init () {
    int lv_player;

    for (lv_player = 1; lv_player <= 6; lv_player += 1) {
        if (lv_player == 1) {
            gt_UnitHighlightOn[lv_player] = TriggerCreate("gt_UnitHighlightOn1_Func");
        }
        else if (lv_player == 2) {
            gt_UnitHighlightOn[lv_player] = TriggerCreate("gt_UnitHighlightOn2_Func");
        }
        else if (lv_player == 3) {
            gt_UnitHighlightOn[lv_player] = TriggerCreate("gt_UnitHighlightOn3_Func");
        }
        else if (lv_player == 4) {
            gt_UnitHighlightOn[lv_player] = TriggerCreate("gt_UnitHighlightOn4_Func");
        }
        else if (lv_player == 5) {
            gt_UnitHighlightOn[lv_player] = TriggerCreate("gt_UnitHighlightOn5_Func");
        }
        else {
            gt_UnitHighlightOn[lv_player] = TriggerCreate("gt_UnitHighlightOn6_Func");
        }
        TriggerAddEventUnitHighlight(gt_UnitHighlightOn[lv_player], null, lv_player, true);
    }
}

void gt_UnitHighlightOff_Init () {
    int lv_player;

    for (lv_player = 1; lv_player <= 6; lv_player += 1) {
        if (lv_player == 1) {
            gt_UnitHighlightOff[lv_player] = TriggerCreate("gt_UnitHighlightOff1_Func");
        }
        else if (lv_player == 2) {
            gt_UnitHighlightOff[lv_player] = TriggerCreate("gt_UnitHighlightOff2_Func");
        }
        else if (lv_player == 3) {
            gt_UnitHighlightOff[lv_player] = TriggerCreate("gt_UnitHighlightOff3_Func");
        }
        else if (lv_player == 4) {
            gt_UnitHighlightOff[lv_player] = TriggerCreate("gt_UnitHighlightOff4_Func");
        }
        else if (lv_player == 5) {
            gt_UnitHighlightOff[lv_player] = TriggerCreate("gt_UnitHighlightOff5_Func");
        }
        else {
            gt_UnitHighlightOff[lv_player] = TriggerCreate("gt_UnitHighlightOff6_Func");
        }
        TriggerAddEventUnitHighlight(gt_UnitHighlightOff[lv_player], null, lv_player, false);
    }
}