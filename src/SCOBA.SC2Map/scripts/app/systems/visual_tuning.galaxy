// Module: systems/visual_tuning

void gf_ScaleDeathTimePlayer (int lp_player, string lp_unitType, fixed lp_factor) {
    string lv_value;
    fixed lv_death;

    lv_value = CatalogFieldValueGet(c_gameCatalogUnit, lp_unitType, "DeathTime", lp_player);
    if (lv_value == "") {
        return;
    }
    lv_death = StringToFixed(lv_value);
    if (lv_death <= 0.0) {
        return;
    }
    CatalogFieldValueSet(c_gameCatalogUnit, lp_unitType, "DeathTime", lp_player, FixedToString((lv_death * lp_factor), c_fixedPrecisionAny));
}

void gf_ScaleDeathTime (string lp_unitType, fixed lp_factor) {
    int lv_player;

    for (lv_player = 1; lv_player <= 6; lv_player += 1) {
        gf_ScaleDeathTimePlayer(lv_player, lp_unitType, lp_factor);
    }
}

void gf_TripleDeathTime (string lp_unitType) {
    gf_ScaleDeathTime(lp_unitType, 3.0);
}

void gf_SetUnitLifePercent (string lp_unitType, fixed lp_percent) {
    unitgroup lv_group;
    unit lv_unit;
    fixed lv_max;

    lv_group = UnitGroup(null, c_playerAny, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    UnitGroupLoopBegin(lv_group);
    for ( ; !UnitGroupLoopDone() ; UnitGroupLoopStep() ) {
        lv_unit = UnitGroupLoopCurrent();
        if (UnitGetType(lv_unit) != lp_unitType) {
            continue;
        }
        lv_max = UnitGetPropertyFixed(lv_unit, c_unitPropLifeMax, c_unitPropCurrent);
        UnitSetPropertyFixed(lv_unit, c_unitPropLife, lv_max * lp_percent);
    }
    UnitGroupLoopEnd();
}

// Turns every unit of one type to face the first unit of another type.
// The Leviathan's placed rotation did not hold in game (operator 2026-11-17).
void gf_FaceTypeAtType (string lp_type, string lp_target) {
    unitgroup lv_targets = UnitGroup(lp_target, c_playerAny, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 1);
    unit lv_target = UnitGroupUnit(lv_targets, 1);
    unitgroup lv_group;
    unit lv_unit;

    if (lv_target == null) {
        return;
    }
    lv_group = UnitGroup(lp_type, c_playerAny, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
    UnitGroupLoopBegin(lv_group);
    for ( ; !UnitGroupLoopDone() ; UnitGroupLoopStep() ) {
        lv_unit = UnitGroupLoopCurrent();
        UnitSetFacing(lv_unit, AngleBetweenPoints(UnitGetPosition(lv_unit), UnitGetPosition(lv_target)), 0.0);
    }
    UnitGroupLoopEnd();
}

// Hides every unit of one type (operator 2026-11-17: Leviathan hidden).
void gf_HideType (string lp_type) {
    unitgroup lv_group = UnitGroup(lp_type, c_playerAny, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);

    UnitGroupLoopBegin(lv_group);
    for ( ; !UnitGroupLoopDone() ; UnitGroupLoopStep() ) {
        UnitSetState(UnitGroupLoopCurrent(), c_unitStateHidden, true);
    }
    UnitGroupLoopEnd();
}

// Sets the flying height of every unit of one type farther than a radius from a point.
void gf_SetHeightBeyond (string lp_type, point lp_at, fixed lp_radius, fixed lp_height) {
    unitgroup lv_group = UnitGroup(lp_type, c_playerAny, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
    unit lv_unit;

    UnitGroupLoopBegin(lv_group);
    for ( ; !UnitGroupLoopDone() ; UnitGroupLoopStep() ) {
        lv_unit = UnitGroupLoopCurrent();
        if (DistanceBetweenPoints(UnitGetPosition(lv_unit), lp_at) > lp_radius) {
            UnitSetHeight(lv_unit, lp_height, 0.0);
        }
    }
    UnitGroupLoopEnd();
}

// Every unit of one type holds: stop order, no move, no turn.
void gf_HoldType (string lp_type) {
    unitgroup lv_group = UnitGroup(lp_type, c_playerAny, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
    unit lv_unit;

    UnitGroupLoopBegin(lv_group);
    for ( ; !UnitGroupLoopDone() ; UnitGroupLoopStep() ) {
        lv_unit = UnitGroupLoopCurrent();
        UnitIssueOrder(lv_unit, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
        UnitSetState(lv_unit, c_unitStateMoveSuppressed, true);
        UnitSetState(lv_unit, c_unitStateTurnSuppressed, true);
    }
    UnitGroupLoopEnd();
}

// The S2 Zerus tree (operator 2026-11-20): a model actor at map init, just
// behind the S2 start eye (data/intro_shots). Variation and scale as an
// editor ZerusTree doodad at 100 %. A second one next to it, further down
// the camera path: 75 %, turned (c_INTRO_TREE2_FACING).
void gf_IntroTreePlace () {
    gv_introTree = libNtve_gf_CreateModelAtPoint("ZerusTree", Point(c_INTRO_TREE_X, c_INTRO_TREE_Y));
    ActorSend(gv_introTree, "ModelSwap ZerusTree " + IntToString(c_INTRO_TREE_VARIATION));
    ActorSend(gv_introTree, libNtve_gf_SetScale(c_INTRO_TREE_SCALE_XY, c_INTRO_TREE_SCALE_XY, c_INTRO_TREE_SCALE_Z, 0.0));
    gv_introTree2 = libNtve_gf_CreateModelAtPoint("ZerusTree", Point(c_INTRO_TREE2_X, c_INTRO_TREE2_Y));
    ActorSend(gv_introTree2, "ModelSwap ZerusTree " + IntToString(c_INTRO_TREE_VARIATION));
    ActorSend(gv_introTree2, libNtve_gf_SetScale(c_INTRO_TREE2_SCALE_XY, c_INTRO_TREE2_SCALE_XY, c_INTRO_TREE2_SCALE_Z, 0.0));
    libNtve_gf_MakeModelFaceAngle(gv_introTree2, c_INTRO_TREE2_FACING);
}

bool gt_VisualTuning_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    gf_IntroTreePlace();
    gf_TripleDeathTime("Armory");
    gf_TripleDeathTime("AutoTurret");
    gf_TripleDeathTime("Banshee");
    gf_TripleDeathTime("Barracks");
    gf_TripleDeathTime("BarracksTechLab");
    gf_TripleDeathTime("Battlecruiser");
    gf_TripleDeathTime("Brakk");
    gf_TripleDeathTime("Bunker");
