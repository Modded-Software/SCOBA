// Module: systems/visual_tuning

void gf_TripleDeathTime (string lp_unitType) {
    int lv_player;
    string lv_value;
    fixed lv_death;

    for (lv_player = 1; lv_player <= 6; lv_player += 1) {
        lv_value = CatalogFieldValueGet(c_gameCatalogUnit, lp_unitType, "DeathTime", lv_player);
        if (lv_value == "") {
            continue;
        }
        lv_death = StringToFixed(lv_value);
        if (lv_death <= 0.0) {
            continue;
        }
        CatalogFieldValueSet(c_gameCatalogUnit, lp_unitType, "DeathTime", lv_player, FixedToString((lv_death * 3.0), c_fixedPrecisionAny));
    }
}

bool gt_VisualTuning_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    gf_TripleDeathTime("Armory");
    gf_TripleDeathTime("AutoTurret");
