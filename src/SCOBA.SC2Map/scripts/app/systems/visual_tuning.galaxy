    gf_TripleDeathTime("EngineeringBay");
    gf_TripleDeathTime("Factory");
    gf_TripleDeathTime("FactoryTechLab");
    gf_TripleDeathTime("Firebat");
    gf_TripleDeathTime("GehennaCruiser");
    gf_TripleDeathTime("Goliath");
    gf_TripleDeathTime("GreaterNydusWorm");
    gf_TripleDeathTime("Hellion");
    gf_TripleDeathTime("HybridUltraliskShackled");
    gf_TripleDeathTime("InfestedAbomination");
    gf_TripleDeathTime("InfestedCivilian");
    gf_TripleDeathTime("InfestedColonistShip");
    gf_TripleDeathTime("InfestedSiegeBreaker");
    gf_TripleDeathTime("InfestedSiegeBreakerSieged");
    gf_TripleDeathTime("InfestedTerranCampaign");
    gf_TripleDeathTime("Infestor");
    gf_TripleDeathTime("InfestorBurrowed");
    gf_TripleDeathTime("Kerrigan");
    gf_TripleDeathTime("KorhalPalaceTurret");
    gf_TripleDeathTime("Kraith");
    gf_TripleDeathTime("KraithSpineVolleyWeapon");
    gf_TripleDeathTime("Marauder");
    gf_TripleDeathTime("Marine");
    gf_TripleDeathTime("Medic");
    gf_TripleDeathTime("MercCompound");
    gf_TripleDeathTime("Mitosaurus");
    gf_TripleDeathTime("MitosaurusB");
    gf_TripleDeathTime("MitosaurusC");
    gf_TripleDeathTime("Mothership");
    gf_TripleDeathTime("Overlord");
    gf_TripleDeathTime("SCOBAVistaOverlord");
    gf_TripleDeathTime("Overseer");
    gf_TripleDeathTime("PerditionTurret");
    gf_TripleDeathTime("PerditionTurretUnderground");
    gf_TripleDeathTime("Predator");
    gf_TripleDeathTime("Queen");
    gf_TripleDeathTime("Roach");
    gf_TripleDeathTime("RoachCorpser");
    gf_TripleDeathTime("SCV");
    gf_TripleDeathTime("SensorTower");
    gf_TripleDeathTime("SpineCrawler");
    gf_TripleDeathTime("SporeCannon");
    gf_TripleDeathTime("SporeCrawler");
    gf_TripleDeathTime("SupplyDepot");
    gf_TripleDeathTime("Thor");
    gf_TripleDeathTime("Tosh");
    gf_TripleDeathTime("Ultralisk");
    gf_TripleDeathTime("WarpPrismPhasing");
    gf_TripleDeathTime("Zergling");
    gf_ScaleDeathTimePlayer(7, "MengskBC", 100.0);
    gf_ScaleDeathTimePlayer(8, "Leviathan", 100.0);
    // Pride of Augustgrad: starts at 1500 of 100000 (operator 2026-11-18: 1000, 1250, then 1500).
    gf_SetUnitLifePercent("MengskBC", 0.015);
    gf_FaceTypeAtType("Leviathan", "MengskBC");
    gf_HideType("Leviathan");
    // The MengskBC north and east of X Center (region 8): twice the unit's
    // Height 256. The one over X Center keeps 256. All three hold still.
    gf_SetHeightBeyond("MengskBC", RegionGetCenter(RegionFromId(8)), 20.0, 512.0);
    gf_HoldType("MengskBC");
    return true;
}

void gt_VisualTuning_Init () {
    gt_VisualTuning = TriggerCreate("gt_VisualTuning_Func");
    TriggerAddEventMapInit(gt_VisualTuning);
}
