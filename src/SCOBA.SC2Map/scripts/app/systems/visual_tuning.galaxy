// Module: systems/visual_tuning

void gf_ScaleDeathTimePlayer (int lp_player, string lp_unitType, fixed lp_factor) {
    string lv_value;
    fixed lv_death;

    lv_value = CatalogFieldValueGet(c_gameCatalogUnit, lp_unitType, "DeathTime", lp_player);
    if (lv_value == "") {
        return;
    }
    lv_death = StringToFixed(lv_value);
    if (lv_death <= 0.0) {
        return;
    }
    CatalogFieldValueSet(c_gameCatalogUnit, lp_unitType, "DeathTime", lp_player, FixedToString((lv_death * lp_factor), c_fixedPrecisionAny));
}

void gf_ScaleDeathTime (string lp_unitType, fixed lp_factor) {
    int lv_player;

    for (lv_player = 1; lv_player <= 6; lv_player += 1) {
        gf_ScaleDeathTimePlayer(lv_player, lp_unitType, lp_factor);
    }
}

void gf_TripleDeathTime (string lp_unitType) {
    gf_ScaleDeathTime(lp_unitType, 3.0);
}

void gf_SetUnitLifePercent (string lp_unitType, fixed lp_percent) {
    unitgroup lv_group;
    unit lv_unit;
    fixed lv_max;

    lv_group = UnitGroup(null, c_playerAny, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    UnitGroupLoopBegin(lv_group);
    for ( ; !UnitGroupLoopDone() ; UnitGroupLoopStep() ) {
        lv_unit = UnitGroupLoopCurrent();
        if (UnitGetType(lv_unit) != lp_unitType) {
            continue;
        }
        lv_max = UnitGetPropertyFixed(lv_unit, c_unitPropLifeMax, c_unitPropCurrent);
        UnitSetPropertyFixed(lv_unit, c_unitPropLife, lv_max * lp_percent);
    }
    UnitGroupLoopEnd();
}

