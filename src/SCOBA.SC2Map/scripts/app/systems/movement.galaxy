// Module: systems/movement

// Move targets scale with the bound unit's own speed, so a fast unit (the
// 22.5 Wraith) never reaches its target and slows between orders. The old
// fixed values stay the floor: the heroes (speed ~3) are unchanged.
// Free mode: a ground unit keeps the 0.5 step; a flyer leads by 0.5 s
// (a 2-tick lead measured uneven, 16.3 of 22.5: run 20261118-111454).
const fixed c_MOVE_STEP = 0.5;            // free-mode step, ground
const fixed c_MOVE_STEP_TIME = 0.5;       // free-mode step of a flyer, s ahead
const fixed c_MOVE_TARGET_TIME = 2.0;     // strafe target: 2 s ahead
const fixed c_MOVE_RETARGET_TIME = 0.25;  // strafe retarget: 0.25 s before it

fixed gf_MoveSpeed (unit lp_u) {
    return UnitGetPropertyFixed(lp_u, c_unitPropMovementSpeed, c_unitPropCurrent);
}

fixed gf_MoveTargetDist (unit lp_u) {
    return MaxF(c_ANIM_MOVE_TARGET, gf_MoveSpeed(lp_u) * c_MOVE_TARGET_TIME);
}

fixed gf_MoveRetargetDist (unit lp_u) {
    return MaxF(c_ANIM_MOVE_RETARGET, gf_MoveSpeed(lp_u) * c_MOVE_RETARGET_TIME);
}

void gf_CombatMoveStep (int lp_player, fixed lp_angle) {
    unit lv_hero;
    point lv_next;
    fixed lv_step = c_MOVE_STEP;

    lv_hero = gv_tPSUNIT[lp_player];
    if (!UnitIsValid(lv_hero)) {
        return;
    }
    if (gf_FlightIs(lp_player)) {
        lv_step = MaxF(c_MOVE_STEP, gf_MoveSpeed(lv_hero) * c_MOVE_STEP_TIME);
    }
    lv_next = PointWithOffsetPolar(UnitGetPosition(lv_hero), lv_step, lp_angle);
    UnitIssueOrder(lv_hero, OrderTargetingPoint(AbilityCommand("move", 0), lv_next), c_orderQueueReplace);
}

bool gt_DisableClickMove_Func (bool testConds, bool runActions) {
    int lv_player;

    if (!runActions) {
        return true;
    }
    lv_player = gf_HeroPlayerFromUnit(EventUnit());
    if (lv_player < c_SCOBA_HERO_FIRST || lv_player > c_SCOBA_HERO_LAST) {
        return true;
    }
    if (gf_MovementKeyHeld(lv_player)) {
        return true;
    }
    if (!gf_CombatStandOn(lv_player)) {
        return true;
    }
    UnitIssueOrder(EventUnit(), Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
    return true;
}

void gt_DisableClickMove_Init () {
    gt_DisableClickMove = TriggerCreate("gt_DisableClickMove_Func");
    TriggerAddEventUnitOrder(gt_DisableClickMove, null, AbilityCommand("move", 0));
}

// One W loop and one S loop per player (operator 2026-11-25: on the flying
// Viking W/S sometimes stopped). W and S held together cancel; each loop
// ends while the other key is held. The release of one key restarts the
// loop of the other key if it is still held. Before, nothing restarted it:
// hold W, tap S, and the hero stood still with W held. The guard also stops
// a key repeat from starting a second loop.
bool[16] gv_moveLoopFwd;     // a W loop runs
bool[16] gv_moveLoopBack;    // an S loop runs

void gf_ForwardBegin (int lp_player) {
    fixed lv_angle;

    if (gv_sCOBAOrderMode[lp_player] == true) {
        return;
    }
    if (!UnitIsValid(gv_tPSUNIT[lp_player])) {
        return;
    }
    gv_fORWARD[lp_player] = true;
    if (gv_moveLoopFwd[lp_player] || gv_bACKWARD[lp_player]) {
        return;
    }
    gv_moveLoopFwd[lp_player] = true;
    gf_CombatSetRoot(lp_player, false);
    while ((gv_fORWARD[lp_player] == true) && (gv_bACKWARD[lp_player] == false)) {
        if (((gv_rOTATEUNIT[lp_player] == true) || (gv_rOTATECAMERA[lp_player] == false))) {
            lv_angle = CameraGetYaw(lp_player);
        }
        else {
            lv_angle = UnitGetFacing(gv_tPSUNIT[lp_player]);
        }
        if ((gv_lEFT[lp_player] == true)) {
            lv_angle = (lv_angle + 45.0);
        }

        if ((gv_rIGHT[lp_player] == true)) {
            lv_angle = (lv_angle - 45.0);
        }

        if (gf_StrafeMoveActive(lp_player)) {
            gf_StrafeLoopStep(lp_player);
        }
        else {
            gf_CombatMoveStep(lp_player, lv_angle);
            gf_UnitTurn(gv_tPSUNIT[lp_player], lv_angle, c_ANIM_MOVE_TURN_DURATION);
            Wait(0.01, c_timeGame);
        }
    }
    gv_moveLoopFwd[lp_player] = false;
}

// S held: walk away from the camera yaw (or the facing at the loop start).
void gf_BackwardBegin (int lp_player) {
    fixed lv_angle;

    if (gv_sCOBAOrderMode[lp_player] == true) {
        return;
    }
    if (!UnitIsValid(gv_tPSUNIT[lp_player])) {
        return;
    }
    gv_bACKWARD[lp_player] = true;
    if (gv_moveLoopBack[lp_player] || gv_fORWARD[lp_player]) {
        return;
    }
    gv_moveLoopBack[lp_player] = true;
    gv_mOVEMENTDIRECTION[lp_player] = UnitGetFacing(gv_tPSUNIT[lp_player]);
    gf_CombatSetRoot(lp_player, false);
    while ((gv_bACKWARD[lp_player] == true) && (gv_fORWARD[lp_player] == false)) {
        if (((gv_rOTATEUNIT[lp_player] == true) || (gv_rOTATECAMERA[lp_player] == false))) {
            lv_angle = (CameraGetYaw(lp_player) + 180.0);
        }
        else {
            lv_angle = (gv_mOVEMENTDIRECTION[lp_player] + 180.0);
        }
        if ((gv_lEFT[lp_player] == true)) {
            lv_angle = (lv_angle - 45.0);
        }

        if ((gv_rIGHT[lp_player] == true)) {
            lv_angle = (lv_angle + 45.0);
        }

        if (gf_StrafeMoveActive(lp_player)) {
            gf_StrafeLoopStep(lp_player);
        }
        else {
            gf_CombatMoveStep(lp_player, lv_angle);
            gf_UnitTurn(gv_tPSUNIT[lp_player], lv_angle, c_ANIM_MOVE_TURN_DURATION);
            Wait(0.01, c_timeGame);
        }
    }
    gv_moveLoopBack[lp_player] = false;
}

void gf_MouseForwardStart (int lp_player) {
    if (gv_sCOBAOrderMode[lp_player] == true) {
        return;
    }
    gv_mOUSEFORWARD[lp_player] = true;
    if (!gv_fORWARD[lp_player]) {
        gf_ForwardBegin(lp_player);
    }
}

void gf_MouseForwardStop (int lp_player) {
    if (!gv_mOUSEFORWARD[lp_player]) {
        return;
    }
    gv_mOUSEFORWARD[lp_player] = false;
    if (!gv_kEYFORWARD[lp_player]) {
        gv_fORWARD[lp_player] = false;
    }
    if (!gf_MovementKeyHeld(lp_player)) {
        gf_AimMoveStop(lp_player);
        gf_CombatSyncRoot(lp_player);
    }
    // S still held: it walks again.
    if (!gv_fORWARD[lp_player] && gv_bACKWARD[lp_player]) {
        gf_BackwardBegin(lp_player);
    }
}

bool gt_ForwardStart_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_localPlayer;

    // Variable Initialization
    lv_localPlayer = EventPlayer();

    // Actions
    if (!runActions) {
        return true;
    }
    // Input hold of this player (systems/input_hold).
    if (gf_InputHeld(EventPlayer())) {
        return true;
    }

    if (gv_sCOBAOrderMode[lv_localPlayer] == true) {
        return true;
    }

    gv_kEYFORWARD[lv_localPlayer] = true;
    gf_ForwardBegin(lv_localPlayer);  // the loop guard drops a key repeat
    return true;
}

void gt_ForwardStart_Init () {
    gt_ForwardStart = TriggerCreate("gt_ForwardStart_Func");
    TriggerAddEventKeyPressed(gt_ForwardStart, c_playerAny, gv_mOVEFORWARD, true, c_keyModifierStateIgnore, c_keyModifierStateIgnore, c_keyModifierStateIgnore);
}

bool gt_ForwardEnd_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_localPlayer;

    // Variable Initialization
    lv_localPlayer = EventPlayer();

    // Actions
    if (!runActions) {
        return true;
    }
    // The key is up, input hold or not: a release dropped during a hold
    // left W "held" and the next press did nothing.
    gv_kEYFORWARD[lv_localPlayer] = false;
    if (!gv_mOUSEFORWARD[lv_localPlayer]) {
        gv_fORWARD[lv_localPlayer] = false;
    }
    // Input hold of this player (systems/input_hold).
    if (gf_InputHeld(EventPlayer())) {
        return true;
    }
    if (!gf_MovementKeyHeld(lv_localPlayer)) {
        gf_AimMoveStop(lv_localPlayer);
        gf_CombatSyncRoot(lv_localPlayer);
    }
    // S still held: it walks again.
    if (!gv_fORWARD[lv_localPlayer] && gv_bACKWARD[lv_localPlayer]) {
        gf_BackwardBegin(lv_localPlayer);
    }
    return true;
}

void gt_ForwardEnd_Init () {
    gt_ForwardEnd = TriggerCreate("gt_ForwardEnd_Func");
    TriggerAddEventKeyPressed(gt_ForwardEnd, c_playerAny, gv_mOVEFORWARD, false, c_keyModifierStateIgnore, c_keyModifierStateIgnore, c_keyModifierStateIgnore);
}

bool gt_BackwardStart_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_localPlayer;

    // Variable Initialization
    lv_localPlayer = EventPlayer();

    // Actions
    if (!runActions) {
        return true;
    }
    // Input hold of this player (systems/input_hold).
    if (gf_InputHeld(EventPlayer())) {
        return true;
    }

    gf_BackwardBegin(lv_localPlayer);  // the loop guard drops a key repeat
    return true;
}

void gt_BackwardStart_Init () {
    gt_BackwardStart = TriggerCreate("gt_BackwardStart_Func");
    TriggerAddEventKeyPressed(gt_BackwardStart, c_playerAny, gv_mOVEBACKWARD, true, c_keyModifierStateIgnore, c_keyModifierStateIgnore, c_keyModifierStateIgnore);
}

bool gt_BackwardEnd_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_localPlayer;

    // Variable Initialization
    lv_localPlayer = EventPlayer();

    // Actions
    if (!runActions) {
        return true;
    }
    // The key is up, input hold or not (as W).
    gv_bACKWARD[lv_localPlayer] = false;
    // Input hold of this player (systems/input_hold).
    if (gf_InputHeld(EventPlayer())) {
        return true;
    }
    UnitBehaviorRemove(gv_tPSUNIT[lv_localPlayer], "VileAcidSlowEffectsLevel2", 1);
    if (!gf_MovementKeyHeld(lv_localPlayer)) {
        gf_AimMoveStop(lv_localPlayer);
        gf_CombatSyncRoot(lv_localPlayer);
    }
    // W (key or mouse) still held: it walks again.
    if (gv_fORWARD[lv_localPlayer]) {
        gf_ForwardBegin(lv_localPlayer);
    }
    return true;
}

void gt_BackwardEnd_Init () {
    gt_BackwardEnd = TriggerCreate("gt_BackwardEnd_Func");
    TriggerAddEventKeyPressed(gt_BackwardEnd, c_playerAny, gv_mOVEBACKWARD, false, c_keyModifierStateIgnore, c_keyModifierStateIgnore, c_keyModifierStateIgnore);
}

bool gf_SideHeld (int lp_player, bool lp_left) {
    if (lp_left) {
        return gv_lEFT[lp_player];
    }
    return gv_rIGHT[lp_player];
}

void gf_SideSet (int lp_player, bool lp_left, bool lp_on) {
    if (lp_left) {
        gv_lEFT[lp_player] = lp_on;
    }
    else {
        gv_rIGHT[lp_player] = lp_on;
    }
}

// A (lp_left) / D held. Left is +90 from the yaw, right -90; W / S bend it
// 45 toward forward / back. Regular units: no A/D (operator 2026-11-18:
// the keys clash with the ability-panel hotkeys).
void gf_SideBegin (int lp_player, bool lp_left) {
    fixed lv_side = 90.0;
    fixed lv_angle;

    if (gv_sCOBAOrderMode[lp_player] == true || gf_ControlRegular(lp_player)) {
        return;
    }
    if (!lp_left) {
        lv_side = -90.0;
    }

    gf_SideSet(lp_player, lp_left, true);
    gf_CombatSetRoot(lp_player, false);
    while (gf_SideHeld(lp_player, lp_left) && !gf_ControlRegular(lp_player)) {
        if (((gv_rOTATEUNIT[lp_player] == true) || (gv_rOTATECAMERA[lp_player] == false))) {
            lv_angle = (CameraGetYaw(lp_player) + lv_side);
        }
        else {
            lv_angle = (UnitGetFacing(gv_tPSUNIT[lp_player]) + lv_side);
        }
        if ((gv_fORWARD[lp_player] == true)) {
            lv_angle = (lv_angle - lv_side / 2.0);
        }

        if ((gv_bACKWARD[lp_player] == true)) {
            lv_angle = (lv_angle + lv_side / 2.0);
        }

        if (gf_StrafeMoveActive(lp_player)) {
            gf_StrafeLoopStep(lp_player);
        }
        else {
            gf_CombatMoveStep(lp_player, lv_angle);
            gf_UnitTurn(gv_tPSUNIT[lp_player], lv_angle, c_ANIM_MOVE_TURN_DURATION);
            Wait(0.01, c_timeGame);
        }
    }
}

// A / D released. Only a press that set the flag stops movement, so the
// key on a regular unit does not stop its order.
void gf_SideEnd (int lp_player, bool lp_left) {
    if (!gf_SideHeld(lp_player, lp_left)) {
        return;
    }
    gf_SideSet(lp_player, lp_left, false);
    if (!gf_MovementKeyHeld(lp_player)) {
        gf_AimMoveStop(lp_player);
        gf_CombatSyncRoot(lp_player);
    }
}

bool gt_LeftStart_Func (bool testConds, bool runActions) {
    // Input hold of this player (systems/input_hold).
    if (runActions && !gf_InputHeld(EventPlayer())) {
        gf_SideBegin(EventPlayer(), true);
    }
    return true;
}

void gt_LeftStart_Init () {
    gt_LeftStart = TriggerCreate("gt_LeftStart_Func");
    TriggerAddEventKeyPressed(gt_LeftStart, c_playerAny, gv_mOVELEFT, true, c_keyModifierStateIgnore, c_keyModifierStateIgnore, c_keyModifierStateIgnore);
}

bool gt_LeftEnd_Func (bool testConds, bool runActions) {
    // Input hold of this player (systems/input_hold).
    if (runActions && !gf_InputHeld(EventPlayer())) {
        gf_SideEnd(EventPlayer(), true);
    }
    return true;
}

void gt_LeftEnd_Init () {
    gt_LeftEnd = TriggerCreate("gt_LeftEnd_Func");
    TriggerAddEventKeyPressed(gt_LeftEnd, c_playerAny, gv_mOVELEFT, false, c_keyModifierStateIgnore, c_keyModifierStateIgnore, c_keyModifierStateIgnore);
}

bool gt_RightStart_Func (bool testConds, bool runActions) {
    // Input hold of this player (systems/input_hold).
    if (runActions && !gf_InputHeld(EventPlayer())) {
        gf_SideBegin(EventPlayer(), false);
    }
    return true;
}

void gt_RightStart_Init () {
    gt_RightStart = TriggerCreate("gt_RightStart_Func");
    TriggerAddEventKeyPressed(gt_RightStart, c_playerAny, gv_mOVERIGHT, true, c_keyModifierStateIgnore, c_keyModifierStateIgnore, c_keyModifierStateIgnore);
}

bool gt_RightEnd_Func (bool testConds, bool runActions) {
    // Input hold of this player (systems/input_hold).
    if (runActions && !gf_InputHeld(EventPlayer())) {
        gf_SideEnd(EventPlayer(), false);
    }
    return true;
}

void gt_RightEnd_Init () {
    gt_RightEnd = TriggerCreate("gt_RightEnd_Func");
    TriggerAddEventKeyPressed(gt_RightEnd, c_playerAny, gv_mOVERIGHT, false, c_keyModifierStateIgnore, c_keyModifierStateIgnore, c_keyModifierStateIgnore);
}
