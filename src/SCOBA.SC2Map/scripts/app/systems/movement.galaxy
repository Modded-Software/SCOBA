// Module: systems/movement

// Move targets scale with the bound unit's own speed, so a fast unit (the
// 22.5 Wraith) never reaches its target and slows between orders. The old
// fixed values stay the floor: the heroes (speed ~3) are unchanged.
// Free mode: a ground unit keeps the 0.5 step; a flyer leads by 0.5 s
// (a 2-tick lead measured uneven, 16.3 of 22.5: run 20261118-111454).
const fixed c_MOVE_STEP = 0.5;            // free-mode step, ground
const fixed c_MOVE_STEP_TIME = 0.5;       // free-mode step of a flyer, s ahead
const fixed c_MOVE_TARGET_TIME = 2.0;     // strafe target: 2 s ahead
const fixed c_MOVE_RETARGET_TIME = 0.25;  // strafe retarget: 0.25 s before it

fixed gf_MoveSpeed (unit lp_u) {
    return UnitGetPropertyFixed(lp_u, c_unitPropMovementSpeed, c_unitPropCurrent);
}

fixed gf_MoveTargetDist (unit lp_u) {
    return MaxF(c_ANIM_MOVE_TARGET, gf_MoveSpeed(lp_u) * c_MOVE_TARGET_TIME);
}

fixed gf_MoveRetargetDist (unit lp_u) {
    return MaxF(c_ANIM_MOVE_RETARGET, gf_MoveSpeed(lp_u) * c_MOVE_RETARGET_TIME);
}

void gf_CombatMoveStep (int lp_player, fixed lp_angle) {
    unit lv_hero;
    point lv_next;
    fixed lv_step = c_MOVE_STEP;

    lv_hero = gv_tPSUNIT[lp_player];
    if (!UnitIsValid(lv_hero)) {
        return;
    }
    if (gf_FlightIs(lp_player)) {
        lv_step = MaxF(c_MOVE_STEP, gf_MoveSpeed(lv_hero) * c_MOVE_STEP_TIME);
    }
    lv_next = PointWithOffsetPolar(UnitGetPosition(lv_hero), lv_step, lp_angle);
    UnitIssueOrder(lv_hero, OrderTargetingPoint(AbilityCommand("move", 0), lv_next), c_orderQueueReplace);
}

bool gt_DisableClickMove_Func (bool testConds, bool runActions) {
    int lv_player;

    if (!runActions) {
        return true;
    }
    lv_player = gf_HeroPlayerFromUnit(EventUnit());
    if (lv_player < c_SCOBA_HERO_FIRST || lv_player > c_SCOBA_HERO_LAST) {
        return true;
    }
    if (gf_MovementKeyHeld(lv_player)) {
        return true;
    }
    if (!gf_CombatStandOn(lv_player)) {
        return true;
    }
    UnitIssueOrder(EventUnit(), Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
    return true;
}

void gt_DisableClickMove_Init () {
    gt_DisableClickMove = TriggerCreate("gt_DisableClickMove_Func");
    TriggerAddEventUnitOrder(gt_DisableClickMove, null, AbilityCommand("move", 0));
}

// WASD (R-PNC-57 to 59, SPEC-POINT-AND-CLICK 5.8a). The key triggers store
// the key state. gf_MoveKeysApply derives the direction flags from it. One
// tick (gt_AimMoveTick, systems/strafe) steps the hero each game loop while
// a direction is held. No thread per key: a key event cannot be lost in a
// loop guard, and only a release ends the movement.
const int c_MOVE_KEY_FWD = 0;
const int c_MOVE_KEY_BACK = 1;
const int c_MOVE_KEY_LEFT = 2;
const int c_MOVE_KEY_RIGHT = 3;

bool[8] gv_moveHeroFrame;  // the free walk runs in the hero-facing frame

bool gf_MoveKeyGet (int lp_player, int lp_key) {
    if (lp_key == c_MOVE_KEY_FWD) {
        return gv_kEYFORWARD[lp_player];
    }
    if (lp_key == c_MOVE_KEY_BACK) {
        return gv_kEYBACKWARD[lp_player];
    }
    if (lp_key == c_MOVE_KEY_LEFT) {
        return gv_kEYLEFT[lp_player];
    }
    return gv_kEYRIGHT[lp_player];
}

// A key or the two-button walk is down. A direction flag set alone moves
// nothing in the free walk (SPEC-JUMP F8).
bool gf_MoveKeyDown (int lp_player) {
    return gv_kEYFORWARD[lp_player] || gv_kEYBACKWARD[lp_player] || gv_kEYLEFT[lp_player] || gv_kEYRIGHT[lp_player] || gv_mOUSEFORWARD[lp_player];
}

// The direction flags from the key state and the two-button walk. W against
// S and A against D: the one pressed last (R-PNC-59). An input hold gives no
// direction. Regular units: no A/D (operator 2026-11-18: the keys clash
// with the ability-panel hotkeys).
void gf_MoveKeysApply (int lp_player) {
    bool lv_w = gv_kEYFORWARD[lp_player] || gv_mOUSEFORWARD[lp_player];
    bool lv_s = gv_kEYBACKWARD[lp_player];
    bool lv_a = gv_kEYLEFT[lp_player];
    bool lv_d = gv_kEYRIGHT[lp_player];

    if (gf_ControlRegular(lp_player)) {
        lv_a = false;
        lv_d = false;
    }
    if (lv_w && lv_s) {
        lv_w = !gv_keyBackLast[lp_player];
        lv_s = gv_keyBackLast[lp_player];
    }
    if (lv_a && lv_d) {
        lv_a = !gv_keyRightLast[lp_player];
        lv_d = gv_keyRightLast[lp_player];
    }
    if (gf_InputHeld(lp_player)) {
        lv_w = false;
        lv_s = false;
        lv_a = false;
        lv_d = false;
    }
    gv_fORWARD[lp_player] = lv_w;
    gv_bACKWARD[lp_player] = lv_s;
    gv_lEFT[lp_player] = lv_a;
    gv_rIGHT[lp_player] = lv_d;
}

// Free walk heading. The frame is the camera yaw. During a left orbit alone
// it is the hero facing at the start of the walk (SPEC-POINT-AND-CLICK 5.8).
fixed gf_MoveHeading (int lp_player) {
    fixed lv_yaw = CameraGetYaw(lp_player);
    fixed lv_base = lv_yaw;

    if (gv_rOTATECAMERA[lp_player] && !gv_rOTATEUNIT[lp_player]) {
        if (!gv_moveHeroFrame[lp_player]) {
            gv_moveHeroFrame[lp_player] = true;
            gv_mOVEMENTDIRECTION[lp_player] = UnitGetFacing(gv_tPSUNIT[lp_player]);
        }
        lv_base = gv_mOVEMENTDIRECTION[lp_player];
    }
    else {
        gv_moveHeroFrame[lp_player] = false;
    }
    return lv_base + (gf_AnimInputHeading(lp_player) - lv_yaw);
}

// One free walk step: the stand root off, a short move order, the turn to
// the travel direction.
void gf_MoveStep (int lp_player) {
    unit lv_hero = gv_tPSUNIT[lp_player];
    fixed lv_angle;

    if (!UnitIsValid(lv_hero)) {
        return;
    }
    lv_angle = gf_MoveHeading(lp_player);
    gf_CombatSetRoot(lp_player, false);
    gf_CombatMoveStep(lp_player, lv_angle);
    gf_UnitTurn(lv_hero, lv_angle, c_ANIM_MOVE_TURN_DURATION);
}

// One movement step of a player: the strafe step in strafe movement, else
// the free walk step. Each game loop (gt_AimMoveTick) and at once on a key
// change.
void gf_MoveTick (int lp_player) {
    if (gf_InputHeld(lp_player) || !gf_MovementKeyHeld(lp_player)) {
        return;
    }
    if (gf_StrafeMoveActive(lp_player)) {
        gv_moveSteps[lp_player] += 1;
        gf_AimMoveStep(lp_player, gf_AnimInputHeading(lp_player));
        return;
    }
    if (gf_MoveKeyDown(lp_player)) {
        gv_moveSteps[lp_player] += 1;
        gf_MoveStep(lp_player);
    }
}

// After a change of the key state, the two-button walk, the input hold or
// the bound unit. A direction held: one step at once with a new strafe
// target; it replaces any move order of the hero (R-PNC-58). The last
// direction gone: the stop and the stand root.
void gf_MoveKeysChanged (int lp_player) {
    bool lv_was;

    if (!gf_IsHeroPlayer(lp_player)) {
        return;
    }
    lv_was = gf_MovementKeyHeld(lp_player);
    gf_MoveKeysApply(lp_player);
    if (gf_MovementKeyHeld(lp_player)) {
        gv_animHasMoveTarget[lp_player] = false;
        gf_MoveTick(lp_player);
        return;
    }
    gv_moveHeroFrame[lp_player] = false;
    if (lv_was) {
        gf_AimMoveStop(lp_player);
        gf_CombatSyncRoot(lp_player);
    }
}

// Left and right mouse buttons together walk forward (R-PNC-56).
void gf_MouseForwardStart (int lp_player) {
    if (gv_sCOBAOrderMode[lp_player] == true) {
        return;
    }
    gv_mOUSEFORWARD[lp_player] = true;
    gv_keyBackLast[lp_player] = false;
    gf_MoveKeysChanged(lp_player);
}

void gf_MouseForwardStop (int lp_player) {
    if (!gv_mOUSEFORWARD[lp_player]) {
        return;
    }
    gv_mOUSEFORWARD[lp_player] = false;
    gf_MoveKeysChanged(lp_player);
}

// The one entry of the eight key triggers and of the test harness. Every
// down and every up is stored: order mode, a missing hero and the input
// hold do not drop a key (R-PNC-58). A down of a key that is down is a key
// repeat and changes nothing.
bool gf_MoveKeySet (int lp_player, int lp_key, bool lp_down) {
    if (!gf_IsHeroPlayer(lp_player) || gf_MoveKeyGet(lp_player, lp_key) == lp_down) {
        return true;
    }
    if (lp_key == c_MOVE_KEY_FWD) {
        gv_kEYFORWARD[lp_player] = lp_down;
        if (lp_down) {
            gv_keyBackLast[lp_player] = false;
        }
    }
    else if (lp_key == c_MOVE_KEY_BACK) {
        gv_kEYBACKWARD[lp_player] = lp_down;
        gv_keyBackLast[lp_player] = lp_down;
        if (!lp_down) {
            UnitBehaviorRemove(gv_tPSUNIT[lp_player], "VileAcidSlowEffectsLevel2", 1);
        }
    }
    else if (lp_key == c_MOVE_KEY_LEFT) {
        gv_kEYLEFT[lp_player] = lp_down;
        if (lp_down) {
            gv_keyRightLast[lp_player] = false;
        }
    }
    else {
        gv_kEYRIGHT[lp_player] = lp_down;
        gv_keyRightLast[lp_player] = lp_down;
    }
    // Input hold of this player (systems/input_hold): the key is stored and
    // the hero does not move. gf_SceneLeave applies the stored keys.
    if (gf_InputHeld(lp_player)) {
        return true;
    }
    gf_MoveKeysChanged(lp_player);
    return true;
}

bool gt_ForwardStart_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    return gf_MoveKeySet(EventPlayer(), c_MOVE_KEY_FWD, true);
}

void gt_ForwardStart_Init () {
    gt_ForwardStart = TriggerCreate("gt_ForwardStart_Func");
    TriggerAddEventKeyPressed(gt_ForwardStart, c_playerAny, gv_mOVEFORWARD, true, c_keyModifierStateIgnore, c_keyModifierStateIgnore, c_keyModifierStateIgnore);
}

bool gt_ForwardEnd_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    return gf_MoveKeySet(EventPlayer(), c_MOVE_KEY_FWD, false);
}

void gt_ForwardEnd_Init () {
    gt_ForwardEnd = TriggerCreate("gt_ForwardEnd_Func");
    TriggerAddEventKeyPressed(gt_ForwardEnd, c_playerAny, gv_mOVEFORWARD, false, c_keyModifierStateIgnore, c_keyModifierStateIgnore, c_keyModifierStateIgnore);
