// Module: systems/movement

bool gf_AimMoveActive (int lp_player) {
    return gv_aIMACTIVE[lp_player];
}

void gf_CombatMoveStep (int lp_player, fixed lp_angle) {
    unit lv_hero;
    point lv_next;

    lv_hero = gv_tPSUNIT[lp_player];
    if (!UnitIsValid(lv_hero)) {
        return;
    }
    if (!gf_CombatRunGunActive(lp_player)) {
        gv_sCOBARunGunMode[lp_player] = false;
        UnitIssueOrder(lv_hero, OrderTargetingPoint(AbilityCommand("move", 0), PointWithOffsetPolar(UnitGetPosition(lv_hero), 0.5, lp_angle)), c_orderQueueReplace);
        return;
    }
    if (gv_sCOBARunGunMode[lp_player] && UnitOrderHasAbil(lv_hero, "move") && AbsF(gf_AnimYawDelta(gv_sCOBARunGunHeading[lp_player], lp_angle)) < c_SCOBA_RUNGUN_HEADING) {
        return;
    }
    lv_next = PointWithOffsetPolar(UnitGetPosition(lv_hero), c_SCOBA_RUNGUN_TARGET, lp_angle);
    UnitIssueOrder(lv_hero, OrderTargetingPoint(AbilityCommand("move", 3), lv_next), c_orderQueueReplace);
    gv_sCOBARunGunMode[lp_player] = true;
    gv_sCOBARunGunHeading[lp_player] = lp_angle;
}

void gf_AimMoveStep (int lp_player, fixed lp_angle) {
    unit lv_hero;
    point lv_next;
    fixed lv_dist;
    bool lv_need;

    if (!gf_AimMoveActive(lp_player)) {
        return;
    }
    lv_hero = gv_tPSUNIT[lp_player];
    if (!UnitIsValid(lv_hero)) {
        return;
    }
    gf_CombatSetRoot(lp_player, false);
    gf_AimShooterPin(lp_player);
    lv_need = false;
    if (!gv_animHasMoveTarget[lp_player]) {
        lv_need = true;
    }
    if (!lv_need && !UnitOrderHasAbil(lv_hero, "move")) {
        lv_need = true;
    }
    if (!lv_need && DistanceBetweenPoints(UnitGetPosition(lv_hero), gv_animMoveTarget[lp_player]) <= c_ANIM_MOVE_RETARGET) {
        lv_need = true;
    }
    if (!lv_need && AbsF(gf_AnimYawDelta(gv_animMoveHeading[lp_player], lp_angle)) >= c_ANIM_MOVE_HEADING) {
        lv_need = true;
    }
    if (lv_need) {
        UnitSetFacing(lv_hero, CameraGetYaw(lp_player), c_ANIM_AIM_TURN_DURATION);
        lv_dist = c_ANIM_MOVE_TARGET;
        while (lv_dist >= (c_ANIM_MOVE_RETARGET * 3.0)) {
            lv_next = PointWithOffsetPolar(UnitGetPosition(lv_hero), lv_dist, lp_angle);
            if (PointPathingPassable(lv_next) && UnitPathableToPoint(lv_hero, lv_next, 0.0, lv_dist)) {
                break;
            }
            lv_dist = lv_dist - c_ANIM_MOVE_RETARGET;
        }
        if (lv_dist >= (c_ANIM_MOVE_RETARGET * 3.0)) {
            UnitIssueOrder(lv_hero, OrderTargetingPoint(AbilityCommand("move", 0), lv_next), c_orderQueueReplace);
            gv_animMoveTarget[lp_player] = lv_next;
            gv_animMoveHeading[lp_player] = lp_angle;
            gv_animHasMoveTarget[lp_player] = true;
        }
    }
}


bool gt_AimMoveTick_Func (bool testConds, bool runActions) {
    int lv_player;

    if (!runActions) {
        return true;
    }
    for (lv_player = c_SCOBA_HERO_FIRST; lv_player <= c_SCOBA_HERO_LAST; lv_player += 1) {
        if (!gf_AimMoveActive(lv_player)) {
            continue;
        }
        if (!gf_MovementKeyHeld(lv_player)) {
            continue;
        }
        gf_AimMoveStep(lv_player, gf_AnimInputHeading(lv_player));
    }
    return true;
}

void gt_AimMoveTick_Init () {
    gt_AimMoveTick = TriggerCreate("gt_AimMoveTick_Func");
    TriggerAddEventTimePeriodic(gt_AimMoveTick, c_ANIM_MOVE_TICK, c_timeGame);
}

void gf_AimMoveStop (int lp_player) {
    unit lv_hero;

    if (gf_AimMoveActive(lp_player) && gf_MovementKeyHeld(lp_player)) {
        return;
    }
    gv_animHasMoveTarget[lp_player] = false;
    if (!gf_AimMoveActive(lp_player)) {
        return;
    }
    lv_hero = gv_tPSUNIT[lp_player];
    if (!UnitIsValid(lv_hero)) {
        return;
    }
    UnitIssueOrder(lv_hero, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
    gv_sCOBAFSM[lp_player] = c_SCOBA_FSM_IDLE;
}

bool gt_DisableClickMove_Func (bool testConds, bool runActions) {
    int lv_player;

    if (!runActions) {
        return true;
    }
    lv_player = gf_HeroPlayerFromUnit(EventUnit());
    if (lv_player < c_SCOBA_HERO_FIRST || lv_player > c_SCOBA_HERO_LAST) {
        return true;
    }
    if (gf_MovementKeyHeld(lv_player)) {
        return true;
    }
    if (!gf_CombatStandOn(lv_player)) {
        return true;
    }
    UnitIssueOrder(EventUnit(), Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
    return true;
}

void gt_DisableClickMove_Init () {
    gt_DisableClickMove = TriggerCreate("gt_DisableClickMove_Func");
    TriggerAddEventUnitOrder(gt_DisableClickMove, null, AbilityCommand("move", 0));
}

void gf_ForwardBegin (int lp_player) {
    fixed lv_angle;

    if (gv_sCOBAOrderMode[lp_player] == true) {
        return;
    }
    if (!UnitIsValid(gv_tPSUNIT[lp_player])) {
        return;
    }
    gv_fORWARD[lp_player] = true;
    gf_CombatBeginMove(lp_player);
    while ((gv_fORWARD[lp_player] == true) && (gv_bACKWARD[lp_player] == false)) {
        if (((gv_rOTATEUNIT[lp_player] == true) || (gv_rOTATECAMERA[lp_player] == false))) {
            lv_angle = CameraGetYaw(lp_player);
        }
        else {
            lv_angle = UnitGetFacing(gv_tPSUNIT[lp_player]);
        }
        if ((gv_lEFT[lp_player] == true)) {
            lv_angle = (lv_angle + 45.0);
        }

        if ((gv_rIGHT[lp_player] == true)) {
            lv_angle = (lv_angle - 45.0);
        }

        if (gf_AimMoveActive(lp_player)) {
            Wait(c_ANIM_MOVE_TICK, c_timeGame);
        }
        else {
            gf_CombatMoveStep(lp_player, lv_angle);
            UnitSetFacing(gv_tPSUNIT[lp_player], lv_angle, 0.01);
            Wait(0.01, c_timeGame);
        }
    }
}

void gf_MouseForwardStart (int lp_player) {
    if (gv_sCOBAOrderMode[lp_player] == true) {
        return;
    }
    gv_mOUSEFORWARD[lp_player] = true;
    if (!gv_fORWARD[lp_player]) {
        gf_ForwardBegin(lp_player);
    }
}

void gf_MouseForwardStop (int lp_player) {
    if (!gv_mOUSEFORWARD[lp_player]) {
        return;
    }
    gv_mOUSEFORWARD[lp_player] = false;
    if (!gv_kEYFORWARD[lp_player]) {
        gv_fORWARD[lp_player] = false;
    }
    if (!gf_MovementKeyHeld(lp_player)) {
        gf_AimMoveStop(lp_player);
        gv_sCOBAFSM[lp_player] = c_SCOBA_FSM_IDLE;
    }
}

bool gt_ForwardStart_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_localPlayer;

    // Variable Initialization
    lv_localPlayer = EventPlayer();

    // Actions
    if (!runActions) {
        return true;
    }

    if (gv_sCOBAOrderMode[lv_localPlayer] == true) {
        return true;
    }

    gv_kEYFORWARD[lv_localPlayer] = true;
    if (!gv_fORWARD[lv_localPlayer]) {
        gf_ForwardBegin(lv_localPlayer);
    }
    return true;
}

void gt_ForwardStart_Init () {
    gt_ForwardStart = TriggerCreate("gt_ForwardStart_Func");
    TriggerAddEventKeyPressed(gt_ForwardStart, c_playerAny, gv_mOVEFORWARD, true, c_keyModifierStateIgnore, c_keyModifierStateIgnore, c_keyModifierStateIgnore);
}

bool gt_ForwardEnd_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_localPlayer;

    // Variable Initialization
    lv_localPlayer = EventPlayer();

    // Actions
    if (!runActions) {
        return true;
    }

    gv_kEYFORWARD[lv_localPlayer] = false;
    if (!gv_mOUSEFORWARD[lv_localPlayer]) {
        gv_fORWARD[lv_localPlayer] = false;
    }
    if (!gf_MovementKeyHeld(lv_localPlayer)) {
        gf_AimMoveStop(lv_localPlayer);
        gv_sCOBAFSM[lv_localPlayer] = c_SCOBA_FSM_IDLE;
    }
    return true;
}

void gt_ForwardEnd_Init () {
    gt_ForwardEnd = TriggerCreate("gt_ForwardEnd_Func");
    TriggerAddEventKeyPressed(gt_ForwardEnd, c_playerAny, gv_mOVEFORWARD, false, c_keyModifierStateIgnore, c_keyModifierStateIgnore, c_keyModifierStateIgnore);
}

bool gt_BackwardStart_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_localPlayer;
    fixed lv_angle;

    // Variable Initialization
    lv_localPlayer = EventPlayer();

    // Actions
    if (!runActions) {
        return true;
    }

    if (gv_sCOBAOrderMode[lv_localPlayer] == true) {
        return true;
    }

    if ((gv_bACKWARD[lv_localPlayer] == false)) {
        gv_mOVEMENTDIRECTION[lv_localPlayer] = UnitGetFacing(gv_tPSUNIT[lv_localPlayer]);
    }

    gv_bACKWARD[lv_localPlayer] = true;
    gf_CombatBeginMove(lv_localPlayer);
    while ((gv_bACKWARD[lv_localPlayer] == true) && (gv_fORWARD[lv_localPlayer] == false)) {
        if (((gv_rOTATEUNIT[lv_localPlayer] == true) || (gv_rOTATECAMERA[lv_localPlayer] == false))) {
            lv_angle = (CameraGetYaw(lv_localPlayer) + 180.0);
        }
        else {
            lv_angle = (gv_mOVEMENTDIRECTION[lv_localPlayer] + 180.0);
        }
        if ((gv_lEFT[lv_localPlayer] == true)) {
            lv_angle = (lv_angle - 45.0);
        }

        if ((gv_rIGHT[lv_localPlayer] == true)) {
            lv_angle = (lv_angle + 45.0);
        }

        if (gf_AimMoveActive(lv_localPlayer)) {
            Wait(c_ANIM_MOVE_TICK, c_timeGame);
        }
        else {
            gf_CombatMoveStep(lv_localPlayer, lv_angle);
            UnitSetFacing(gv_tPSUNIT[lv_localPlayer], lv_angle, 0.01);
            Wait(0.01, c_timeGame);
        }
    }
    return true;
}

void gt_BackwardStart_Init () {
    gt_BackwardStart = TriggerCreate("gt_BackwardStart_Func");
    TriggerAddEventKeyPressed(gt_BackwardStart, c_playerAny, gv_mOVEBACKWARD, true, c_keyModifierStateIgnore, c_keyModifierStateIgnore, c_keyModifierStateIgnore);
}

bool gt_BackwardEnd_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_localPlayer;

    // Variable Initialization
    lv_localPlayer = EventPlayer();

    // Actions
    if (!runActions) {
        return true;
    }

    gv_bACKWARD[lv_localPlayer] = false;
    UnitBehaviorRemove(gv_tPSUNIT[lv_localPlayer], "VileAcidSlowEffectsLevel2", 1);
    if (!gf_MovementKeyHeld(lv_localPlayer)) {
        gf_AimMoveStop(lv_localPlayer);
        gv_sCOBAFSM[lv_localPlayer] = c_SCOBA_FSM_IDLE;
    }
    return true;
}

void gt_BackwardEnd_Init () {
    gt_BackwardEnd = TriggerCreate("gt_BackwardEnd_Func");
    TriggerAddEventKeyPressed(gt_BackwardEnd, c_playerAny, gv_mOVEBACKWARD, false, c_keyModifierStateIgnore, c_keyModifierStateIgnore, c_keyModifierStateIgnore);
}

