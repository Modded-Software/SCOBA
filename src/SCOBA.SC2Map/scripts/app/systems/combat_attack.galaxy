// Module: systems/combat_attack

void gt_ToggleCommands_Init () {
    int lv_player;
    string lv_ref;

    gt_AutoBehaviorChange = TriggerCreate("gt_AutoBehaviorChange_Func");
    gt_StandBehaviorChange = TriggerCreate("gt_StandBehaviorChange_Func");
    for (lv_player = c_SCOBA_HERO_FIRST; lv_player <= c_SCOBA_HERO_LAST; lv_player += 1) {
        lv_ref = "gv_tPSUNIT[" + IntToString(lv_player) + "]";
        TriggerAddEventUnitBehaviorChange(gt_AutoBehaviorChange, UnitRefFromVariable(lv_ref), c_SCOBA_SINGLE_BEHAVIOR, c_unitBehaviorChangeActivate);
        TriggerAddEventUnitBehaviorChange(gt_StandBehaviorChange, UnitRefFromVariable(lv_ref), c_SCOBA_STAND_BEHAVIOR, c_unitBehaviorChangeActivate);
        TriggerAddEventUnitBehaviorChange(gt_StandBehaviorChange, UnitRefFromVariable(lv_ref), c_SCOBA_STAND_BEHAVIOR, c_unitBehaviorChangeDeactivate);
    }
}

// Attack switched to single: end the current attack.
bool gt_AutoBehaviorChange_Func (bool testConds, bool runActions) {
    int lv_player;
    unit lv_hero;

    if (!runActions) {
        return true;
    }
    lv_hero = EventUnit();
    lv_player = gf_HeroPlayerFromUnit(lv_hero);
    if (lv_player < c_SCOBA_HERO_FIRST || lv_player > c_SCOBA_HERO_LAST) {
        return true;
    }
    gv_pncSingleShot[lv_player] = false;
    gf_PncAttackEnd(lv_player);
    return true;
}

bool gt_StandBehaviorChange_Func (bool testConds, bool runActions) {
    int lv_player;

    if (!runActions) {
        return true;
    }
    lv_player = gf_HeroPlayerFromUnit(EventUnit());
    if (lv_player < c_SCOBA_HERO_FIRST || lv_player > c_SCOBA_HERO_LAST) {
        return true;
    }
    // Regular units: Chase is always Move. Stand turned on is undone.
    if (!gf_UnitIsHero(EventUnit()) && UnitBehaviorCount(EventUnit(), c_SCOBA_STAND_BEHAVIOR) > 0) {
        gv_chaseRefused[lv_player] += 1;
        gf_ChaseStandSet(EventUnit(), false);
    }
    gf_CombatSyncRoot(lv_player);
    return true;
}

bool gt_WeaponAttackCmd_Func (bool testConds, bool runActions) {
    int lv_player;
    unit lv_hero;
    unit lv_target;

    if (!runActions) {
        return true;
    }
    lv_player = EventPlayer();
    lv_hero = gv_tPSUNIT[lv_player];
    lv_target = EventUnitTargetUnit();
    if (!UnitIsValid(lv_hero) || !UnitIsAlive(lv_hero)) {
        return true;
    }
    if (!UnitIsValid(lv_target) || !UnitIsAlive(lv_target)) {
        return true;
    }
    if (libNtve_gf_PlayerIsEnemy(lv_player, UnitGetOwner(lv_target), libNtve_ge_PlayerRelation_Ally)) {
        return true;
    }
    gf_PncAttack(lv_player, lv_target);
    return true;
}

void gt_AttackEvent_Init () {
    gt_CombatAttackEffect = TriggerCreate("gt_CombatAttackEffect_Func");
    TriggerAddEventPlayerEffectUsed(gt_CombatAttackEffect, c_playerAny, c_SCOBA_EFFECT_TOSH);
    TriggerAddEventPlayerEffectUsed(gt_CombatAttackEffect, c_playerAny, c_SCOBA_EFFECT_TOSH_AIR);
    TriggerAddEventPlayerEffectUsed(gt_CombatAttackEffect, c_playerAny, c_SCOBA_EFFECT_TALONS);
    TriggerAddEventPlayerEffectUsed(gt_CombatAttackEffect, c_playerAny, c_SCOBA_EFFECT_PSIBLAST);

    gt_WeaponAttackCmd = TriggerCreate("gt_WeaponAttackCmd_Func");
    TriggerAddEventUnitAbility(gt_WeaponAttackCmd, UnitRefFromVariable("gv_tPSUNIT[1]"), AbilityCommand("SCOBAAutoAttackStatus", 0), c_unitAbilStageExecute, false);
    TriggerAddEventUnitAbility(gt_WeaponAttackCmd, UnitRefFromVariable("gv_tPSUNIT[2]"), AbilityCommand("SCOBAAutoAttackStatus", 0), c_unitAbilStageExecute, false);
    TriggerAddEventUnitAbility(gt_WeaponAttackCmd, UnitRefFromVariable("gv_tPSUNIT[3]"), AbilityCommand("SCOBAAutoAttackStatus", 0), c_unitAbilStageExecute, false);
    TriggerAddEventUnitAbility(gt_WeaponAttackCmd, UnitRefFromVariable("gv_tPSUNIT[4]"), AbilityCommand("SCOBAAutoAttackStatus", 0), c_unitAbilStageExecute, false);
    TriggerAddEventUnitAbility(gt_WeaponAttackCmd, UnitRefFromVariable("gv_tPSUNIT[5]"), AbilityCommand("SCOBAAutoAttackStatus", 0), c_unitAbilStageExecute, false);
    TriggerAddEventUnitAbility(gt_WeaponAttackCmd, UnitRefFromVariable("gv_tPSUNIT[6]"), AbilityCommand("SCOBAAutoAttackStatus", 0), c_unitAbilStageExecute, false);
}

fixed gf_TalonsRadius (unit lp_unit) {
    return StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, UnitGetType(lp_unit), "Radius", c_playerAny));
}

// True for an enemy ground unit in the swing: within c_SCOBA_TALONS_REACH
// edge to edge, its centre within half of c_SCOBA_TALONS_ARC of her facing.
bool gf_TalonsInSwing (int lp_player, unit lp_hero, unit lp_unit) {
    point lv_at = UnitGetPosition(lp_hero);
    fixed lv_off;

    if (lp_unit == lp_hero || UnitGetOwner(lp_unit) == 0 || UnitFilterMatch(lp_unit, lp_player, UnitFilter((1 << c_targetFilterAir), 0, 0, 0))) {
        return false;
    }
    if (!libNtve_gf_PlayerIsEnemy(lp_player, UnitGetOwner(lp_unit), libNtve_ge_PlayerRelation_Enemy)) {
        return false;
    }
    if (DistanceBetweenPoints(lv_at, UnitGetPosition(lp_unit)) > gf_TalonsRadius(lp_hero) + c_SCOBA_TALONS_REACH + gf_TalonsRadius(lp_unit)) {
        return false;
    }
    lv_off = ModF(AngleBetweenPoints(lv_at, UnitGetPosition(lp_unit)) - UnitGetFacing(lp_hero) + 540.0, 360.0) - 180.0;
    return AbsF(lv_off) <= c_SCOBA_TALONS_ARC / 2.0;
}

// Kerrigan's talons swing (operator 2026-11-23), on the TPS left mouse
// down without aim (gf_TpsLeftPress). Every enemy in her front arc takes
// SCOBATalonsSwingHit. It swings with no target, standing or walking. The attack cooldown gates it as it gates the aim shot
// (gf_AimShotPress). Other heroes do nothing on F.
void gf_TalonsSwing (int lp_player) {
    unit lv_hero = gv_tPSUNIT[lp_player];
    unitgroup lv_near;
    unit lv_u;
    int lv_i;

    if (!gf_IsHeroPlayer(lp_player) || !UnitIsValid(lv_hero) || !UnitIsAlive(lv_hero)) {
        return;
    }
    if (UnitGetType(lv_hero) != c_SCOBA_UNIT_KERRIGAN || UnitGetCooldown(lv_hero, c_SCOBA_ATTACK_COOLDOWN) > 0.0) {
        return;
    }
    gv_talonsSwings[lp_player] += 1;
    UnitCreateEffectPoint(lv_hero, c_SCOBA_EFFECT_TALONS_CLOCK, UnitGetPosition(lv_hero));
    lv_near = UnitGroup(null, c_playerAny, RegionCircle(UnitGetPosition(lv_hero), gf_TalonsRadius(lv_hero) + c_SCOBA_TALONS_REACH + 2.0), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterStasis - 32)) | (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterInvulnerable - 32))), 0);
    for (lv_i = 1; lv_i <= UnitGroupCount(lv_near, c_unitCountAll); lv_i += 1) {
        lv_u = UnitGroupUnit(lv_near, lv_i);
        if (gf_TalonsInSwing(lp_player, lv_hero, lv_u)) {
            UnitCreateEffectUnit(lv_hero, c_SCOBA_EFFECT_TALONS_SWING, lv_u);
        }
    }
    UnitAddCooldown(lv_hero, c_SCOBA_ATTACK_COOLDOWN, StringToFixed(CatalogFieldValueGet(c_gameCatalogWeapon, c_SCOBA_WEAPON_TALONS, "Cost.Cooldown.TimeUse", lp_player)));
    gf_AnimAttackStart(lp_player, c_SCOBA_WEAPON_TALONS, null);
}
