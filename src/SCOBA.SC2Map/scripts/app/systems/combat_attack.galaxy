bool gt_AutoBehaviorChange_Func (bool testConds, bool runActions) {
    int lv_player;
    unit lv_hero;

    if (!runActions) {
        return true;
    }
    lv_hero = EventUnit();
    lv_player = gf_HeroPlayerFromUnit(lv_hero);
    if (lv_player < c_SCOBA_HERO_FIRST || lv_player > c_SCOBA_HERO_LAST) {
        return true;
    }
    if (UnitBehaviorCount(lv_hero, "SCOBAAutoAttackBehavior") > 0) {
        gv_sCOBAAutoTarget[lv_player] = null;
        gf_CombatStep(lv_player);
    }
    else {
        gf_CombatCancelAuto(lv_player);
        gf_CombatSyncRoot(lv_player);
        if (gv_sCOBAManualOrder[lv_player]) {
            gv_sCOBAFSM[lv_player] = c_SCOBA_FSM_MANUAL;
        }
        else {
            gv_sCOBAFSM[lv_player] = c_SCOBA_FSM_IDLE;
        }
    }
    return true;
}

bool gt_StandBehaviorChange_Func (bool testConds, bool runActions) {
    int lv_player;
    unit lv_hero;

    if (!runActions) {
        return true;
    }
    lv_hero = EventUnit();
    lv_player = gf_HeroPlayerFromUnit(lv_hero);
    if (lv_player < c_SCOBA_HERO_FIRST || lv_player > c_SCOBA_HERO_LAST) {
        return true;
    }
    if (gf_CombatAutoOn(lv_player)) {
        gf_CombatStep(lv_player);
    }
    else {
        gf_CombatCancelAuto(lv_player);
        gf_CombatSyncRoot(lv_player);
        if (gv_sCOBAManualOrder[lv_player]) {
            gv_sCOBAFSM[lv_player] = c_SCOBA_FSM_MANUAL;
        }
        else {
            gv_sCOBAFSM[lv_player] = c_SCOBA_FSM_IDLE;
        }
    }
    return true;
}

bool gt_AutoOnCmd_Func (bool testConds, bool runActions) {
    int lv_player;
    unit lv_hero;

    if (!runActions) {
        return true;
    }
    lv_player = EventPlayer();
    lv_hero = gv_tPSUNIT[lv_player];
    if (!UnitIsValid(lv_hero)) {
        return true;
    }
    gv_sCOBAAutoTarget[lv_player] = null;
    gf_CombatStep(lv_player);
    return true;
}

bool gt_AutoOffCmd_Func (bool testConds, bool runActions) {
    int lv_player;
    unit lv_hero;

    if (!runActions) {
        return true;
    }
    lv_player = EventPlayer();
    lv_hero = gv_tPSUNIT[lv_player];
    if (!UnitIsValid(lv_hero)) {
        return true;
    }
    gf_CombatCancelAuto(lv_player);
    gf_CombatSyncRoot(lv_player);
    if (gv_sCOBAManualOrder[lv_player]) {
        gv_sCOBAFSM[lv_player] = c_SCOBA_FSM_MANUAL;
    }
    else {
        gv_sCOBAFSM[lv_player] = c_SCOBA_FSM_IDLE;
    }
    return true;
}

bool gt_StandCmd_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    gf_CombatSetStance(EventPlayer(), true);
    return true;
}

bool gt_WalkCmd_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    gf_CombatSetStance(EventPlayer(), false);
    return true;
}

bool gt_WeaponAttackCmd_Func (bool testConds, bool runActions) {
    int lv_player;
    unit lv_hero;
    unit lv_target;

    if (!runActions) {
        return true;
    }
    lv_player = EventPlayer();
    lv_hero = gv_tPSUNIT[lv_player];
    lv_target = EventUnitTargetUnit();
    if (!UnitIsValid(lv_hero) || !UnitIsAlive(lv_hero)) {
        return true;
    }
    UnitAbilityReset(lv_hero, AbilityCommand("SCOBAAutoAttackStatus", 0), c_spendLocationAbility);
    if (!UnitIsValid(lv_target) || !UnitIsAlive(lv_target)) {
        return true;
    }
    if (libNtve_gf_PlayerIsEnemy(lv_player, UnitGetOwner(lv_target), libNtve_ge_PlayerRelation_Ally)) {
        return true;
    }
    gf_CombatManualAttack(lv_player, lv_target);
    return true;
}

void gt_AttackEvent_Init () {
    gt_CombatStartedAttack = TriggerCreate("gt_CombatStartedAttack_Func");
    TriggerAddEventUnitStartedAttack2(gt_CombatStartedAttack, UnitRefFromVariable("gv_tPSUNIT[1]"), null);
    TriggerAddEventUnitStartedAttack2(gt_CombatStartedAttack, UnitRefFromVariable("gv_tPSUNIT[2]"), null);
    TriggerAddEventUnitStartedAttack2(gt_CombatStartedAttack, UnitRefFromVariable("gv_tPSUNIT[3]"), null);
    TriggerAddEventUnitStartedAttack2(gt_CombatStartedAttack, UnitRefFromVariable("gv_tPSUNIT[4]"), null);
    TriggerAddEventUnitStartedAttack2(gt_CombatStartedAttack, UnitRefFromVariable("gv_tPSUNIT[5]"), null);
    TriggerAddEventUnitStartedAttack2(gt_CombatStartedAttack, UnitRefFromVariable("gv_tPSUNIT[6]"), null);

    gt_WeaponAttackCmd = TriggerCreate("gt_WeaponAttackCmd_Func");
    TriggerAddEventUnitAbility(gt_WeaponAttackCmd, UnitRefFromVariable("gv_tPSUNIT[1]"), AbilityCommand("SCOBAAutoAttackStatus", 0), c_unitAbilStageExecute, false);
    TriggerAddEventUnitAbility(gt_WeaponAttackCmd, UnitRefFromVariable("gv_tPSUNIT[2]"), AbilityCommand("SCOBAAutoAttackStatus", 0), c_unitAbilStageExecute, false);
    TriggerAddEventUnitAbility(gt_WeaponAttackCmd, UnitRefFromVariable("gv_tPSUNIT[3]"), AbilityCommand("SCOBAAutoAttackStatus", 0), c_unitAbilStageExecute, false);
    TriggerAddEventUnitAbility(gt_WeaponAttackCmd, UnitRefFromVariable("gv_tPSUNIT[4]"), AbilityCommand("SCOBAAutoAttackStatus", 0), c_unitAbilStageExecute, false);
    TriggerAddEventUnitAbility(gt_WeaponAttackCmd, UnitRefFromVariable("gv_tPSUNIT[5]"), AbilityCommand("SCOBAAutoAttackStatus", 0), c_unitAbilStageExecute, false);
    TriggerAddEventUnitAbility(gt_WeaponAttackCmd, UnitRefFromVariable("gv_tPSUNIT[6]"), AbilityCommand("SCOBAAutoAttackStatus", 0), c_unitAbilStageExecute, false);
}