// Module: systems/combat_attack

void gt_ToggleCommands_Init () {
    int lv_player;
    string lv_ref;

    gt_AutoBehaviorChange = TriggerCreate("gt_AutoBehaviorChange_Func");
    gt_StandBehaviorChange = TriggerCreate("gt_StandBehaviorChange_Func");
    for (lv_player = c_SCOBA_HERO_FIRST; lv_player <= c_SCOBA_HERO_LAST; lv_player += 1) {
        lv_ref = "gv_tPSUNIT[" + IntToString(lv_player) + "]";
        TriggerAddEventUnitBehaviorChange(gt_AutoBehaviorChange, UnitRefFromVariable(lv_ref), c_SCOBA_SINGLE_BEHAVIOR, c_unitBehaviorChangeActivate);
        TriggerAddEventUnitBehaviorChange(gt_StandBehaviorChange, UnitRefFromVariable(lv_ref), c_SCOBA_STAND_BEHAVIOR, c_unitBehaviorChangeActivate);
        TriggerAddEventUnitBehaviorChange(gt_StandBehaviorChange, UnitRefFromVariable(lv_ref), c_SCOBA_STAND_BEHAVIOR, c_unitBehaviorChangeDeactivate);
    }
}

// Attack switched to single: end the current attack.
bool gt_AutoBehaviorChange_Func (bool testConds, bool runActions) {
    int lv_player;
    unit lv_hero;

    if (!runActions) {
        return true;
    }
    lv_hero = EventUnit();
    lv_player = gf_HeroPlayerFromUnit(lv_hero);
    if (lv_player < c_SCOBA_HERO_FIRST || lv_player > c_SCOBA_HERO_LAST) {
        return true;
    }
    gv_pncSingleShot[lv_player] = false;
    gf_PncAttackEnd(lv_player);
    return true;
}

bool gt_StandBehaviorChange_Func (bool testConds, bool runActions) {
    int lv_player;

    if (!runActions) {
        return true;
    }
    lv_player = gf_HeroPlayerFromUnit(EventUnit());
    if (lv_player < c_SCOBA_HERO_FIRST || lv_player > c_SCOBA_HERO_LAST) {
        return true;
    }
    gf_CombatSyncRoot(lv_player);
    return true;
}

bool gt_WeaponAttackCmd_Func (bool testConds, bool runActions) {
    int lv_player;
    unit lv_hero;
    unit lv_target;

    if (!runActions) {
        return true;
    }
    lv_player = EventPlayer();
    lv_hero = gv_tPSUNIT[lv_player];
    lv_target = EventUnitTargetUnit();
    if (!UnitIsValid(lv_hero) || !UnitIsAlive(lv_hero)) {
        return true;
    }
    if (!UnitIsValid(lv_target) || !UnitIsAlive(lv_target)) {
        return true;
    }
    if (libNtve_gf_PlayerIsEnemy(lv_player, UnitGetOwner(lv_target), libNtve_ge_PlayerRelation_Ally)) {
        return true;
    }
    gf_PncAttack(lv_player, lv_target);
    return true;
}

void gt_AttackEvent_Init () {
    gt_CombatAttackEffect = TriggerCreate("gt_CombatAttackEffect_Func");
    TriggerAddEventPlayerEffectUsed(gt_CombatAttackEffect, c_playerAny, c_SCOBA_EFFECT_TOSH);
    TriggerAddEventPlayerEffectUsed(gt_CombatAttackEffect, c_playerAny, c_SCOBA_EFFECT_TOSH_POINT);
    TriggerAddEventPlayerEffectUsed(gt_CombatAttackEffect, c_playerAny, c_SCOBA_EFFECT_TALONS);
    TriggerAddEventPlayerEffectUsed(gt_CombatAttackEffect, c_playerAny, c_SCOBA_EFFECT_TALONS_SHOT);
    TriggerAddEventPlayerEffectUsed(gt_CombatAttackEffect, c_playerAny, c_SCOBA_EFFECT_PSIBLAST);
    TriggerAddEventPlayerEffectUsed(gt_CombatAttackEffect, c_playerAny, c_SCOBA_EFFECT_PSIBLAST_POINT);

    gt_WeaponAttackCmd = TriggerCreate("gt_WeaponAttackCmd_Func");
    TriggerAddEventUnitAbility(gt_WeaponAttackCmd, UnitRefFromVariable("gv_tPSUNIT[1]"), AbilityCommand("SCOBAAutoAttackStatus", 0), c_unitAbilStageExecute, false);
    TriggerAddEventUnitAbility(gt_WeaponAttackCmd, UnitRefFromVariable("gv_tPSUNIT[2]"), AbilityCommand("SCOBAAutoAttackStatus", 0), c_unitAbilStageExecute, false);
    TriggerAddEventUnitAbility(gt_WeaponAttackCmd, UnitRefFromVariable("gv_tPSUNIT[3]"), AbilityCommand("SCOBAAutoAttackStatus", 0), c_unitAbilStageExecute, false);
    TriggerAddEventUnitAbility(gt_WeaponAttackCmd, UnitRefFromVariable("gv_tPSUNIT[4]"), AbilityCommand("SCOBAAutoAttackStatus", 0), c_unitAbilStageExecute, false);
    TriggerAddEventUnitAbility(gt_WeaponAttackCmd, UnitRefFromVariable("gv_tPSUNIT[5]"), AbilityCommand("SCOBAAutoAttackStatus", 0), c_unitAbilStageExecute, false);
    TriggerAddEventUnitAbility(gt_WeaponAttackCmd, UnitRefFromVariable("gv_tPSUNIT[6]"), AbilityCommand("SCOBAAutoAttackStatus", 0), c_unitAbilStageExecute, false);
}