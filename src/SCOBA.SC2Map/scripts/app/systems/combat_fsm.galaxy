// Module: systems/combat_fsm
// The engine owns acquisition, chase, and firing.
// This module reads the two toggles, keeps the stand root, and issues
// the attack and cancel orders.

bool gf_CombatAutoOn (int lp_player) {
    return UnitBehaviorCount(gv_tPSUNIT[lp_player], c_SCOBA_SINGLE_BEHAVIOR) <= 0;
}

bool gf_CombatStandOn (int lp_player) {
    return UnitBehaviorCount(gv_tPSUNIT[lp_player], c_SCOBA_STAND_BEHAVIOR) > 0;
}

void gf_CombatSetRoot (int lp_player, bool lp_root) {
    unit lv_hero;
    int lv_count;

    lv_hero = gv_tPSUNIT[lp_player];
    if (!UnitIsValid(lv_hero)) {
        return;
    }
    lv_count = UnitBehaviorCount(lv_hero, "SCOBAStandRoot");
    if (lp_root) {
        if (lv_count <= 0) {
            UnitBehaviorAdd(lv_hero, "SCOBAStandRoot", lv_hero, 1);
        }
    }
    else if (lv_count > 0) {
        UnitBehaviorRemove(lv_hero, "SCOBAStandRoot", lv_count);
    }
}

void gf_CombatSyncRoot (int lp_player) {
    if (gv_sCOBAOrderMode[lp_player] || gv_aIMACTIVE[lp_player] || gf_MovementKeyHeld(lp_player)) {
        gf_CombatSetRoot(lp_player, false);
        return;
    }
    gf_CombatSetRoot(lp_player, gf_CombatStandOn(lp_player));
}

void gf_PncAttack (int lp_player, unit lp_unit) {
    unit lv_hero;

    lv_hero = gv_tPSUNIT[lp_player];
    if (!UnitIsValid(lv_hero) || !UnitIsAlive(lv_hero) || !UnitIsValid(lp_unit) || !UnitIsAlive(lp_unit)) {
        return;
    }
    gf_UnitTargetSet(lp_player, lp_unit);
    gf_CombatSyncRoot(lp_player);
    if (gf_CombatStandOn(lp_player) && !UnitInRangeAndAbleToAttackTarget(lv_hero, lp_unit)) {
        gf_FloaterCreate(lp_player, UnitGetPosition(lp_unit), StringToText(c_SCOBA_OUT_OF_RANGE_TEXT), Color(70.0, 70.0, 70.0));
        return;
    }
    gv_pncSingleShot[lp_player] = !gf_CombatAutoOn(lp_player);
    UnitIssueOrder(lv_hero, OrderTargetingUnit(AbilityCommand("attack", 0), lp_unit), c_orderQueueReplace);
}

// Ends the current attack with the stock hold-fire pattern: the attack
// ability is disabled for 0.07 s. A stop order does not end it.
void gf_PncAttackEnd (int lp_player) {
    unit lv_hero;

    lv_hero = gv_tPSUNIT[lp_player];
    if (UnitIsValid(lv_hero)) {
        UnitBehaviorAdd(lv_hero, c_SCOBA_ATTACK_END_BEHAVIOR, lv_hero, 1);
    }
}

void gf_PncShotFired (int lp_player) {
    if (!gv_pncSingleShot[lp_player]) {
        return;
    }
    gv_pncSingleShot[lp_player] = false;
    gf_PncAttackEnd(lp_player);
}

void gf_PncCancel (int lp_player) {
    gf_UnitTargetSet(lp_player, null);
    gv_pncSingleShot[lp_player] = false;
    gf_PncAttackEnd(lp_player);
}

// A toggle is a behavior switched by its toggle ability: command 0 turns it
// on, command 1 turns it off. The command-card button follows the ability,
// not the behavior, so the behavior is never added or removed directly.
void gf_ToggleSet (unit lp_unit, string lp_abil, string lp_behavior, bool lp_on) {
    if (!UnitIsValid(lp_unit)) {
        return;
    }
    if ((UnitBehaviorCount(lp_unit, lp_behavior) > 0) == lp_on) {
        return;
    }
    if (lp_on) {
        UnitIssueOrder(lp_unit, Order(AbilityCommand(lp_abil, 0)), c_orderQueueReplace);
    }
    else {
        UnitIssueOrder(lp_unit, Order(AbilityCommand(lp_abil, 1)), c_orderQueueReplace);
    }
}

void gf_AttackSingleSet (unit lp_unit, bool lp_single) {
    gf_ToggleSet(lp_unit, c_SCOBA_ATTACK_TOGGLE, c_SCOBA_SINGLE_BEHAVIOR, lp_single);
}

void gf_ChaseStandSet (unit lp_unit, bool lp_stand) {
    gf_ToggleSet(lp_unit, c_SCOBA_CHASE_TOGGLE, c_SCOBA_STAND_BEHAVIOR, lp_stand);
}
