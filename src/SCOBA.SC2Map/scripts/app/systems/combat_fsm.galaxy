// Module: systems/combat_fsm

bool gf_CombatAutoOn (int lp_player) {
    return UnitBehaviorCount(gv_tPSUNIT[lp_player], "SCOBAAutoAttackBehavior") > 0;
}

bool gf_CombatStandOn (int lp_player) {
    return UnitBehaviorCount(gv_tPSUNIT[lp_player], "SCOBARightClickStandBehavior") > 0;
}

void gf_CombatSetRoot (int lp_player, bool lp_root) {
    unit lv_hero;
    int lv_count;

    lv_hero = gv_tPSUNIT[lp_player];
    if (!UnitIsValid(lv_hero)) {
        return;
    }
    lv_count = UnitBehaviorCount(lv_hero, "SCOBAStandRoot");
    if (lp_root) {
        if (lv_count <= 0) {
            UnitBehaviorAdd(lv_hero, "SCOBAStandRoot", lv_hero, 1);
        }
    }
    else if (lv_count > 0) {
        UnitBehaviorRemove(lv_hero, "SCOBAStandRoot", lv_count);
    }
}

void gf_CombatSyncRoot (int lp_player) {
    if (gv_sCOBAOrderMode[lp_player] || gf_MovementKeyHeld(lp_player)) {
        gf_CombatSetRoot(lp_player, false);
        return;
    }
    gf_CombatSetRoot(lp_player, gf_CombatStandOn(lp_player));
}

void gf_CombatReset (int lp_player) {
    gf_CombatSetRoot(lp_player, false);
    gv_sCOBAFSM[lp_player] = c_SCOBA_FSM_IDLE;
    gv_sCOBAAutoTarget[lp_player] = null;
    gv_sCOBAAutoOrder[lp_player] = false;
    gv_sCOBAManualOrder[lp_player] = false;
}

void gf_CombatCancelAuto (int lp_player) {
    unit lv_hero;

    lv_hero = gv_tPSUNIT[lp_player];
    gv_sCOBAAutoTarget[lp_player] = null;
    if (gv_sCOBAAutoOrder[lp_player] && gv_sCOBAManualOrder[lp_player] == false && UnitIsValid(lv_hero) && UnitIsAlive(lv_hero)) {
        UnitIssueOrder(lv_hero, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
    }
    gv_sCOBAAutoOrder[lp_player] = false;
}

void gf_CombatBeginMove (int lp_player) {
    gf_CombatSetRoot(lp_player, false);
    gf_CombatCancelAuto(lp_player);
    gv_sCOBAManualOrder[lp_player] = false;
    gv_sCOBAFSM[lp_player] = c_SCOBA_FSM_MOVING;
}

void gf_CombatSetStance (int lp_player, bool lp_stand) {
    unit lv_hero;

    lv_hero = gv_tPSUNIT[lp_player];
    if (!UnitIsValid(lv_hero)) {
        return;
    }
    gf_CombatCancelAuto(lp_player);
    gv_sCOBAManualOrder[lp_player] = false;
    gf_CombatSyncRoot(lp_player);
    if (!gf_CombatAutoOn(lp_player)) {
        if (gf_CombatStandOn(lp_player)) {
            UnitIssueOrder(lv_hero, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
        }
        gv_sCOBAFSM[lp_player] = c_SCOBA_FSM_IDLE;
        return;
    }
    gf_CombatStep(lp_player);
}

void gf_CombatManualAttack (int lp_player, unit lp_unit) {
    unit lv_hero;

    lv_hero = gv_tPSUNIT[lp_player];
    if (!UnitIsValid(lv_hero) || !UnitIsAlive(lv_hero) || !UnitIsValid(lp_unit) || !UnitIsAlive(lp_unit)) {
        return;
    }
    gf_CombatCancelAuto(lp_player);
    gf_CombatSyncRoot(lp_player);
    gv_sCOBAManualOrder[lp_player] = true;
    gv_sCOBAFSM[lp_player] = c_SCOBA_FSM_MANUAL;
    UnitIssueOrder(lv_hero, OrderTargetingUnit(AbilityCommand("attack", 0), lp_unit), c_orderQueueReplace);
}

void gf_CombatStand (int lp_player) {
    unit lv_hero;
    unit lv_target;
    unitgroup lv_group;

    gf_CombatSetRoot(lp_player, true);
    lv_hero = gv_tPSUNIT[lp_player];
    lv_group = UnitGroupAlliance(lp_player, c_unitAllianceEnemy, RegionCircle(UnitGetPosition(lv_hero), c_SCOBA_KEEP_RADIUS), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    if (UnitGroupCount(lv_group, c_unitCountAlive) == 0) {
        gv_sCOBAAutoTarget[lp_player] = null;
        if (gv_sCOBAAutoOrder[lp_player]) {
            UnitIssueOrder(lv_hero, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
            gv_sCOBAAutoOrder[lp_player] = false;
        }
        gv_sCOBAFSM[lp_player] = c_SCOBA_FSM_HOLD;
        return;
    }
    lv_target = UnitGroupClosestToPoint(lv_group, UnitGetPosition(lv_hero));
    if (!UnitIsValid(lv_target)) {
        gv_sCOBAFSM[lp_player] = c_SCOBA_FSM_HOLD;
        return;
    }
    gv_sCOBAAutoTarget[lp_player] = lv_target;
    if (UnitOrderCount(lv_hero) == 0 || UnitOrderHasAbil(lv_hero, "attack") == false || OrderGetTargetUnit(UnitOrder(lv_hero, 0)) != lv_target) {
        UnitIssueOrder(lv_hero, OrderTargetingUnit(AbilityCommand("attack", 0), lv_target), c_orderQueueReplace);
        gv_sCOBAAutoOrder[lp_player] = true;
    }
    gv_sCOBAFSM[lp_player] = c_SCOBA_FSM_ATTACK;
}

void gf_CombatWalk (int lp_player) {
    unit lv_hero;
    unit lv_target;
    unitgroup lv_group;
    bool lv_chasing;

    gf_CombatSetRoot(lp_player, false);
    lv_hero = gv_tPSUNIT[lp_player];
    lv_target = gv_sCOBAAutoTarget[lp_player];
    lv_chasing = lv_target != null && UnitIsValid(lv_target) && UnitIsAlive(lv_target) && (DistanceBetweenPoints(UnitGetPosition(lv_hero), UnitGetPosition(lv_target)) <= c_SCOBA_KEEP_RADIUS);
    if (lv_chasing) {
        if (UnitOrderCount(lv_hero) == 0 || UnitOrderHasAbil(lv_hero, "attack") == false || OrderGetTargetUnit(UnitOrder(lv_hero, 0)) != lv_target) {
            UnitIssueOrder(lv_hero, OrderTargetingUnit(AbilityCommand("attack", 0), lv_target), c_orderQueueReplace);
            gv_sCOBAAutoOrder[lp_player] = true;
        }
        gv_sCOBAFSM[lp_player] = c_SCOBA_FSM_CHASE;
        return;
    }
    lv_chasing = lv_target != null && UnitIsValid(lv_target) && UnitIsAlive(lv_target) && (DistanceBetweenPoints(UnitGetPosition(lv_hero), UnitGetPosition(lv_target)) <= c_SCOBA_CHASE_RADIUS);
    if (lv_chasing) {
        if (UnitOrderCount(lv_hero) == 0 || UnitOrderHasAbil(lv_hero, "attack") == false || OrderGetTargetUnit(UnitOrder(lv_hero, 0)) != lv_target) {
            UnitIssueOrder(lv_hero, OrderTargetingUnit(AbilityCommand("attack", 0), lv_target), c_orderQueueReplace);
            gv_sCOBAAutoOrder[lp_player] = true;
        }
        gv_sCOBAFSM[lp_player] = c_SCOBA_FSM_CHASE;
        return;
    }
    gv_sCOBAAutoTarget[lp_player] = null;
    lv_group = UnitGroupAlliance(lp_player, c_unitAllianceEnemy, RegionCircle(UnitGetPosition(lv_hero), c_SCOBA_CHASE_RADIUS), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    if (UnitGroupCount(lv_group, c_unitCountAlive) == 0) {
        if (gv_sCOBAAutoOrder[lp_player]) {
            UnitIssueOrder(lv_hero, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
            gv_sCOBAAutoOrder[lp_player] = false;
        }
        gv_sCOBAFSM[lp_player] = c_SCOBA_FSM_IDLE;
        return;
    }
    lv_target = UnitGroupClosestToPoint(lv_group, UnitGetPosition(lv_hero));
    if (!UnitIsValid(lv_target)) {
        gv_sCOBAFSM[lp_player] = c_SCOBA_FSM_IDLE;
        return;
    }
    UnitIssueOrder(lv_hero, OrderTargetingUnit(AbilityCommand("attack", 0), lv_target), c_orderQueueReplace);
    gv_sCOBAAutoTarget[lp_player] = lv_target;
    gv_sCOBAAutoOrder[lp_player] = true;
    gv_sCOBAFSM[lp_player] = c_SCOBA_FSM_CHASE;
}

void gf_CombatStep (int lp_player) {
    unit lv_hero;

    if (lp_player < c_SCOBA_HERO_FIRST || lp_player > c_SCOBA_HERO_LAST) {
        return;
    }
    lv_hero = gv_tPSUNIT[lp_player];
    if (!UnitIsValid(lv_hero) || !UnitIsAlive(lv_hero)) {
        gf_CombatReset(lp_player);
        return;
    }
    if (gv_sCOBAFSM[lp_player] == c_SCOBA_FSM_MOVING) {
        if (gv_sCOBAOrderMode[lp_player] || gf_MovementKeyHeld(lp_player)) {
            return;
        }
        gv_sCOBAFSM[lp_player] = c_SCOBA_FSM_IDLE;
    }
    if (gv_sCOBAOrderMode[lp_player] || gf_MovementKeyHeld(lp_player)) {
        gf_CombatBeginMove(lp_player);
        return;
    }
    gf_CombatSyncRoot(lp_player);
    if (gv_sCOBAManualOrder[lp_player]) {
        if (UnitOrderCount(lv_hero) > 0) {
            return;
        }
        gv_sCOBAManualOrder[lp_player] = false;
        gv_sCOBAFSM[lp_player] = c_SCOBA_FSM_IDLE;
    }
    if (!gf_CombatAutoOn(lp_player)) {
        gf_CombatCancelAuto(lp_player);
        gv_sCOBAFSM[lp_player] = c_SCOBA_FSM_IDLE;
        return;
    }
    if (gf_CombatStandOn(lp_player)) {
        gf_CombatStand(lp_player);
    }
    else {
        gf_CombatWalk(lp_player);
    }
}