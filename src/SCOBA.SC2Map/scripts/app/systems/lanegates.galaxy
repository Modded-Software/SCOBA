// Lane gates: waves walk spawn -> gate -> X region -> other gate -> enemy spawn.
// One gate per half-lane, on the painted dirt (data/lane_gates, generated by
// scripts/flora/gates.py). Every unit picks its own random point inside the
// gate circle and inside the target region, so units spread over the lane.
// Sides: 0 Zerg, 1 Terran. Lanes: 1 center, 2 bottom, 3 top (gv_xLOCATIONS).

int gv_gateOrders;  // units sent through a gate (read by the lanegates test)

// Random point inside the gate circle (uniform over its area); null without a gate.
point gf_GatePick (int lp_side, int lp_lane) {
    fixed lv_r = gv_gateRadius[lp_side][lp_lane];

    if (lv_r <= 0.0) {
        return null;
    }
    return PointWithOffsetPolar(gv_gateAt[lp_side][lp_lane], SquareRoot(RandomFixed(0.0, 1.0)) * lv_r, RandomFixed(0.0, 360.0));
}

// Attack-move through the gate of lp_side on lp_lane, then into lp_dest.
void gf_GateSend (unit lp_unit, int lp_side, int lp_lane, region lp_dest) {
    point lv_gate = gf_GatePick(lp_side, lp_lane);

    if (lv_gate == null) {
        UnitIssueOrder(lp_unit, OrderTargetingPoint(AbilityCommand("attack", 0), RegionRandomPoint(lp_dest)), c_orderQueueReplace);
        return;
    }
    gv_gateOrders += 1;
    UnitIssueOrder(lp_unit, OrderTargetingPoint(AbilityCommand("attack", 0), lv_gate), c_orderQueueReplace);
    UnitIssueOrder(lp_unit, OrderTargetingPoint(AbilityCommand("attack", 0), RegionRandomPoint(lp_dest)), c_orderQueueAddToEnd);
}

void gf_GateSendGroup (unitgroup lp_group, int lp_side, int lp_lane, region lp_dest) {
    UnitGroupLoopBegin(lp_group);
    for ( ; !UnitGroupLoopDone() ; UnitGroupLoopStep() ) {
        gf_GateSend(UnitGroupLoopCurrent(), lp_side, lp_lane, lp_dest);
    }
    UnitGroupLoopEnd();
}

// A unit entered the X region of lp_lane: on to the enemy spawn through the
// gate on the enemy's half. Air creeps keep their patrol (REQ-AIR-CREEP).
void gf_GateFromX (unit lp_unit, int lp_lane) {
    if (gf_AirCreepIs(lp_unit)) {
        return;
    }
    // The AI's units and hired units take no lane orders (REQ-BASE-AI).
    if (gf_BaseAiUnitIsAi(lp_unit) || gf_HireIsHired(lp_unit)) {
        return;
    }
    if (gf_RosterTerranPlayer(UnitGetOwner(lp_unit))) {
        gf_GateSend(lp_unit, 0, lp_lane, gv_sPAWNLOCATIONS[lp_lane + 3]);
    }
    else {
        gf_GateSend(lp_unit, 1, lp_lane, gv_sPAWNLOCATIONS[lp_lane]);
    }
}
