            libNtve_gf_SetBossBarCurrentValue(lv_localXPBar, gv_xP[lv_localPlayer], true);
            libNtve_gf_MoveBossBar(lv_localXPBar, c_anchorTopLeft, 0, 0);
            libNtve_gf_ShowHideBossBar(false, lv_localHPBar);
