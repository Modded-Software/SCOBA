            UnitAbilityShow(gv_tPSUNIT[lv_localPlayer], "ArtanisVortex", false);
            UnitAbilityEnable(gv_tPSUNIT[lv_localPlayer], "ZHybridPsionicShockwave", false);
            UnitAbilityShow(gv_tPSUNIT[lv_localPlayer], "ZHybridPsionicShockwave", false);
            Wait(0.01, c_timeGame);
            CameraSetValue(1, c_cameraValueShadowClip, 25.0, 0.0, -1, 10.0);
            CameraSetValue(1, c_cameraValueFarClip, 16000.0, 0.0, -1, 10.0);
            CameraSetValue(lv_localPlayer, c_cameraValueFieldOfView, 65.0, 4.0, -1, 10);
            if (((UnitGetType(gv_tPSUNIT[lv_localPlayer]) == "Tosh"))) {
                CameraSetValue(lv_localPlayer, c_cameraValueDistance, 1.5, 0.5, -1, 10);
                CameraSetValue(lv_localPlayer, c_cameraValueHeightOffset, gv_mARINE, 0.5, -1, 10);
                CameraUseHeightSmoothing(lv_localPlayer, false);
            }

            if (((UnitGetType(gv_tPSUNIT[lv_localPlayer]) == "Kerrigan"))) {
                CameraSetValue(lv_localPlayer, c_cameraValueDistance, 2.5, 0.5, -1, 10);
                CameraSetValue(lv_localPlayer, c_cameraValueHeightOffset, gv_iMMORTAL, 0.5, -1, 10);
