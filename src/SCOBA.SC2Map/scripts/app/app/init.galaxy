    libVCMI_InitLib();
}

bool gt_MapInit_Func (bool testConds, bool runActions) {
    int auto5832FA5B_ae;
    int auto5832FA5B_ai;

    // Variable Declarations
    int lv_localPlayer;
    bank lv_bank;
    int lv_localHPBar;
    int lv_localNRGBar;
    int lv_localXPBar;

    // Variable Initialization
    lv_localPlayer = 1;
    lv_localHPBar = ((lv_localPlayer * 10) + 1);
    lv_localNRGBar = ((lv_localPlayer * 10) + 2);
    lv_localXPBar = ((lv_localPlayer * 10) + 3);

    // Actions
    if (!runActions) {
        return true;
    }

    gv_sPAWNLOCATIONS[1] = RegionFromId(1);
    gv_sPAWNLOCATIONS[2] = RegionFromId(3);
    gv_sPAWNLOCATIONS[3] = RegionFromId(4);
    gv_sPAWNLOCATIONS[4] = RegionFromId(2);
    gv_sPAWNLOCATIONS[5] = RegionFromId(5);
    gv_sPAWNLOCATIONS[6] = RegionFromId(6);
    gv_xLOCATIONS[1] = RegionFromId(8);
    gv_xLOCATIONS[2] = RegionFromId(7);
    gv_xLOCATIONS[3] = RegionFromId(9);
    UnitSelect(UnitFromId(622754155), 1, true);
    UnitSelect(UnitFromId(649131550), 2, true);
    Wait(0.5, c_timeReal);
    auto5832FA5B_ae = 6;
    auto5832FA5B_ai = 1;
    lv_localPlayer = 1;
    for ( ; ( (auto5832FA5B_ai >= 0 && lv_localPlayer <= auto5832FA5B_ae) || (auto5832FA5B_ai <= 0 && lv_localPlayer >= auto5832FA5B_ae) ) ; lv_localPlayer += auto5832FA5B_ai ) {
        libNtve_gf_SetUpgradeLevelForPlayer(lv_localPlayer, "K5Apocalypse", 1);
        libNtve_gf_SetUpgradeLevelForPlayer(lv_localPlayer, "HotSHydraliskFrenzy", 1);
        libNtve_gf_SetUpgradeLevelForPlayer(lv_localPlayer, "BansheeCloak", 1);
        lv_localHPBar = ((lv_localPlayer * 10) + 1);
        lv_localNRGBar = ((lv_localPlayer * 10) + 2);
        lv_localXPBar = ((lv_localPlayer * 10) + 3);
        if ((UnitHasBehavior(UnitGroupUnit(UnitGroupSelected(lv_localPlayer), 1), "UnitDirectControl") == false) && (UnitHasBehavior(UnitGroupUnit(UnitGroupSelected(lv_localPlayer), 1), "NeuralParasite") == false) && (UnitGroupCount(UnitGroupSelected(lv_localPlayer), c_unitCountAlive) == 1) && (UnitGetOwner(UnitGroupUnit(UnitGroupSelected(lv_localPlayer), 1)) <= 15) && (UnitGroupUnit(UnitGroupSelected(lv_localPlayer), 1) == UnitGroupUnit(UnitGroupFilterAlliance(UnitGroupSelected(lv_localPlayer), lv_localPlayer, c_unitAllianceAlly, 0), 1)) && (UnitIsSelected(UnitGroupUnit(UnitGroupFilter(null, c_playerAny, UnitGroupSelected(lv_localPlayer), UnitFilter(0, 0, (1 << c_targetFilterStructure), 0), 0), 1), lv_localPlayer) == true)) {
            gv_tPSUNIT[lv_localPlayer] = UnitGroupUnit(UnitGroupSelected(lv_localPlayer), 1);
            CameraApplyInfo(lv_localPlayer, CameraInfoDefault(), 1.0, 100.0, 0.0, true);
            CameraFollowUnitGroup(lv_localPlayer, UnitGroupSelected(lv_localPlayer), true, false);
            CameraSetValue(lv_localPlayer, c_cameraValuePitch, -30.0, 1.0, -1, 10);
            CameraSetValue(lv_localPlayer, c_cameraValueFarClip, 500.0, 1.0, -1, 10);
            CameraLockInput(lv_localPlayer, true);
            UnitBehaviorAddPlayer(gv_tPSUNIT[lv_localPlayer], "UnitDirectControl", lv_localPlayer, 1);
            UnitXPGainEnable(gv_tPSUNIT[lv_localPlayer], null, true);
            UnitSetState(gv_tPSUNIT[lv_localPlayer], c_unitStateStatusBar, false);
            libNtve_gf_StoreUnitSelection(lv_localPlayer, libNtve_ge_UnitSelectionStoreOption_DoNotClearUnitSelection);
            UnitAbilityEnable(gv_tPSUNIT[lv_localPlayer], "SCOBAAutoAttackStatus", true);
            UnitAbilityShow(gv_tPSUNIT[lv_localPlayer], "SCOBAAutoAttackStatus", true);
            UnitAbilityEnable(gv_tPSUNIT[lv_localPlayer], "SCOBAAutoAttackToggle", true);
            UnitAbilityShow(gv_tPSUNIT[lv_localPlayer], "SCOBAAutoAttackToggle", true);
            UnitAbilityEnable(gv_tPSUNIT[lv_localPlayer], "SCOBARightClickToggle", true);
            UnitAbilityShow(gv_tPSUNIT[lv_localPlayer], "SCOBARightClickToggle", true);
            if (lv_localPlayer <= 3) {
                libNtve_gf_CreateUnitsAtPoint2(2, "Zergling", 0, (lv_localPlayer + 3), PointWithOffsetPolar(UnitGetPosition(gv_tPSUNIT[lv_localPlayer]), 8.0, 45.0));
                libNtve_gf_CreateUnitsAtPoint2(2, "Zergling", 0, (lv_localPlayer + 3), PointWithOffsetPolar(UnitGetPosition(gv_tPSUNIT[lv_localPlayer]), 8.0, 225.0));
            }
            UnitAbilityEnable(gv_tPSUNIT[lv_localPlayer], "heal", false);
            UnitAbilityShow(gv_tPSUNIT[lv_localPlayer], "heal", false);
            UnitAbilityEnable(gv_tPSUNIT[lv_localPlayer], "GuardianShield", false);
            UnitAbilityShow(gv_tPSUNIT[lv_localPlayer], "GuardianShield", false);
            UnitAbilityEnable(gv_tPSUNIT[lv_localPlayer], "InvulnerabilityShield", false);
            UnitAbilityShow(gv_tPSUNIT[lv_localPlayer], "InvulnerabilityShield", false);
            UnitAbilityEnable(gv_tPSUNIT[lv_localPlayer], "BuildingStasis", false);
            UnitAbilityShow(gv_tPSUNIT[lv_localPlayer], "BuildingStasis", false);
            UnitAbilityEnable(gv_tPSUNIT[lv_localPlayer], "Frenzy", false);
            UnitAbilityShow(gv_tPSUNIT[lv_localPlayer], "Frenzy", false);
            UnitAbilityEnable(gv_tPSUNIT[lv_localPlayer], "SummonCompanion", false);
            UnitAbilityShow(gv_tPSUNIT[lv_localPlayer], "SummonCompanion", false);
            UnitAbilityEnable(gv_tPSUNIT[lv_localPlayer], "VoodooShield", false);
            UnitAbilityShow(gv_tPSUNIT[lv_localPlayer], "VoodooShield", false);
            UnitAbilityEnable(gv_tPSUNIT[lv_localPlayer], "BlindingCloud", false);
            UnitAbilityShow(gv_tPSUNIT[lv_localPlayer], "BlindingCloud", false);
            UnitAbilityEnable(gv_tPSUNIT[lv_localPlayer], "DisablingCloud", false);
            UnitAbilityShow(gv_tPSUNIT[lv_localPlayer], "DisablingCloud", false);
            UnitAbilityEnable(gv_tPSUNIT[lv_localPlayer], "ZeratulBlink", false);
            UnitAbilityShow(gv_tPSUNIT[lv_localPlayer], "ZeratulBlink", false);
            UnitAbilityEnable(gv_tPSUNIT[lv_localPlayer], "RogueGhostCloak", false);
