// Module: ui/hud_buttons

void gf_SBDialogCreateStatsButton () {
    int lv_localAnchor;
    string lv_localIcon;
    text lv_localTooltip;

    lv_localIcon = "Assets\\Textures\\btn-ability-terran-liftoff.dds";
    lv_localTooltip = StringExternal("Param/Value/8B0DE8A0");
    lv_localAnchor = c_anchorBottomRight;
    DialogCreate(64, 64, lv_localAnchor, 429, 35, true);
    gv_singleButtonDialog = DialogLastCreated();
    libNtve_gf_CreateDialogItemButton(DialogLastCreated(), gv_singleButtonConstantButtonSize, gv_singleButtonConstantButtonSize, c_anchorCenter, 0, 0, lv_localTooltip, StringToText(""), "");
    gv_singleButtonButton = DialogControlLastCreated();
    libNtve_gf_SetDialogItemBackgroundVisible(gv_singleButtonButton, false, PlayerGroupAll());
    libNtve_gf_SetDialogItemBorderVisible(gv_singleButtonButton, false, PlayerGroupAll());
    libNtve_gf_CreateDialogItemImage(DialogLastCreated(), gv_singleButtonConstantIconSize, gv_singleButtonConstantIconSize, c_anchorCenter, 0, 0, StringToText(""), lv_localIcon, c_triggerImageTypeNormal, false, Color(100,100,100), c_triggerBlendModeNormal);
    DialogControlFadeTransparency(DialogControlLastCreated(), PlayerGroupAll(), 1.0, 50.0);
    gv_singleButtonIcon = DialogControlLastCreated();
    libNtve_gf_CreateDialogItemLabel(gv_singleButtonDialog, 24, 20, c_anchorTopLeft, 40, 40, StringToText(""), Color(100,100,100), false, 1.5);
    gv_singleButtonLabel = DialogControlLastCreated();
}

