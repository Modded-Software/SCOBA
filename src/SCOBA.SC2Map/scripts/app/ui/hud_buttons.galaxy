void gf_SBDialogCreateInventoryButton () {
    text lv_tooltip;

    lv_tooltip = StringToText("Inventory");
    DialogCreate(64, 64, c_anchorBottomRight, 429, 189, true);
    gv_singleButtonDialogInventory = DialogLastCreated();
    libNtve_gf_CreateDialogItemButton(DialogLastCreated(), gv_singleButtonConstantButtonSizeAbilities, gv_singleButtonConstantButtonSizeAbilities, c_anchorCenter, 0, 0, lv_tooltip, StringToText(""), "");
    gv_singleButtonButtonInventory = DialogControlLastCreated();
    libNtve_gf_SetDialogItemBackgroundVisible(gv_singleButtonButtonInventory, false, PlayerGroupAll());
    libNtve_gf_SetDialogItemBorderVisible(gv_singleButtonButtonInventory, false, PlayerGroupAll());
    libNtve_gf_CreateDialogItemImage(DialogLastCreated(), gv_singleButtonConstantIconSizeAbilities, gv_singleButtonConstantIconSizeAbilities, c_anchorCenter, 0, 0, StringToText(""), "Assets\\Textures\\btn-unit-terran-predator.dds", c_triggerImageTypeNormal, false, Color(100,100,100), c_triggerBlendModeNormal);
    gv_singleButtonIconInventory = DialogControlLastCreated();
    libNtve_gf_CreateDialogItemLabel(gv_singleButtonDialogInventory, 24, 20, c_anchorTopLeft, 40, 40, StringToText(""), Color(100,100,100), false, 1.5);
    gv_singleButtonLabelInventory = DialogControlLastCreated();
    DialogSetVisible(gv_singleButtonDialogInventory, PlayerGroupAll(), true);
}
