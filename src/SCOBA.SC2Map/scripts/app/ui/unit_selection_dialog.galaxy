            libNtve_gf_SetDialogItemTooltip(gv_userSelectionButtons[lv_iButton], lv_uHPREGEN, PlayerGroupSingle(lp_iPlayer));
        }
        else if (auto6617BAFF_val == 2) {
            libNtve_gf_SetDialogItemTooltip(gv_userSelectionButtons[lv_iButton], lv_uNRG, PlayerGroupSingle(lp_iPlayer));
