    // Variable Initialization
    lv_hpAmount = (gf_GetToolTipLifeandEnergyFormula(lp_iPlayer, 0) - gf_GetLifeandEnergyStatFormula(lp_iPlayer, 0));
    lv_hpAmount2 = ((300.0 + Pow(2.0, (1.0 + gv_sTATLEVEL[lp_iPlayer][0]))) - (300.0 + Pow(2.0, gv_sTATLEVEL[lp_iPlayer][0])));
    lv_uHP = (StringExternal("Param/Value/1EFA9A4F") + IntToText(FixedToInt(lv_hpAmount)));
    lv_nrgAmount = (gf_GetToolTipLifeandEnergyFormula(lp_iPlayer, 2) - gf_GetLifeandEnergyStatFormula(lp_iPlayer, 2));
    lv_nrgAmount2 = ((300.0 + Pow(2.0, (1.0 + gv_sTATLEVEL[lp_iPlayer][2]))) - (300.0 + Pow(2.0, gv_sTATLEVEL[lp_iPlayer][2])));
    lv_uNRG = (StringExternal("Param/Value/0A5F7310") + IntToText(FixedToInt(lv_nrgAmount)));
    lv_hpregenAmount = ((UnitGetPropertyFixed(gv_tPSUNIT[lp_iPlayer], c_unitPropLifeRegen, c_unitPropCurrent) + 0.1) + (UnitGetPropertyFixed(gv_tPSUNIT[lp_iPlayer], c_unitPropLifeRegen, c_unitPropCurrent) + 0.1));
