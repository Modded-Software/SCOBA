        auto6617BAFF_val = lv_iButton;
        if (auto6617BAFF_val == 0) {
            libNtve_gf_SetDialogItemTooltip(gv_userSelectionButtons[lv_iButton], lv_uHP, PlayerGroupSingle(lp_iPlayer));
