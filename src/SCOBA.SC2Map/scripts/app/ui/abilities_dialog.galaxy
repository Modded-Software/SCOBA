void gf_AbilitiesSelectionDialogCreate () {
    int auto5387B8BF_ae;
    int auto5387B8BF_ai;
    int auto0B066007_ae;
    int auto0B066007_ai;

    // Variable Declarations
    int lv_zRender;
    text lv_dialogLabel;
    int lv_bAnchor;
    int lv_nRows;
    int lv_cDialogWidth;
    int lv_cDialogHeight;
    int lv_headerWidth;
    int lv_x;
    int lv_y;
    int lv_iRow;
    int lv_iCol;
    int lv_iButton;

    // Variable Initialization
    lv_zRender = 514;
    lv_dialogLabel = StringToText("");
    lv_bAnchor = c_anchorCenter;
    lv_nRows = CeilingI((IntToFixed(gv_nAbilitiesButtons) / IntToFixed(gv_abilitiesnCols)));
    lv_cDialogWidth = (gv_cDialogExtraAbilities + (gv_cButtonSizeAbilities * gv_abilitiesnCols) + (gv_cButtonGapAbilities * (gv_abilitiesnCols - 1)));
    lv_cDialogHeight = (gv_cDialogExtraAbilities + (gv_cButtonSizeAbilities * lv_nRows) + (gv_cButtonGapAbilities * (lv_nRows - 1)) + gv_cHeaderHeightAbilities + gv_cRowGapAbilities);
    lv_headerWidth = (lv_cDialogWidth + gv_cDialogExtraAbilities);
    lv_x = gv_cDialogBorderAbilities;
    lv_y = (gv_cDialogBorderAbilities + gv_cHeaderHeightAbilities + gv_cRowGapAbilities);

    // Implementation
    gf_AbilitiesSelectionDialogAddKeyColumn();
    DialogCreate(lv_cDialogWidth, lv_cDialogHeight, lv_bAnchor, 70, -140, true);
    DialogSetRenderPriority(DialogLastCreated(), 512);
    gv_abilitiesSelectionDialog = DialogLastCreated();
    gf_AbilitiesSelectionDialogAddButtonstoDialog(gv_abilitiesSelectionDialog);
    libNtve_gf_CreateDialogItemLabel(DialogLastCreated(), lv_headerWidth, gv_cHeaderHeightAbilities, c_anchorTopLeft, gv_cDialogBorderAbilities, gv_cDialogBorderAbilities, lv_dialogLabel, Color(100,100,100), false, 2.0);
    libNtve_gf_SetDialogItemRenderPriority(DialogControlLastCreated(), lv_zRender, PlayerGroupAll());
    gv_abilitiesSelectionLabel = DialogControlLastCreated();
    auto5387B8BF_ae = lv_nRows;
    auto5387B8BF_ai = 1;
    lv_iRow = 1;
    for ( ; ( (auto5387B8BF_ai >= 0 && lv_iRow <= auto5387B8BF_ae) || (auto5387B8BF_ai <= 0 && lv_iRow >= auto5387B8BF_ae) ) ; lv_iRow += auto5387B8BF_ai ) {
        lv_x = gv_cDialogBorderAbilities;
        auto0B066007_ae = gv_abilitiesnCols;
        auto0B066007_ai = 1;
        lv_iCol = 1;
        for ( ; ( (auto0B066007_ai >= 0 && lv_iCol <= auto0B066007_ae) || (auto0B066007_ai <= 0 && lv_iCol >= auto0B066007_ae) ) ; lv_iCol += auto0B066007_ai ) {
            if ((lv_iButton < gv_nAbilitiesButtons)) {
                libNtve_gf_CreateDialogItemButton(DialogLastCreated(), gv_cButtonSizeAbilities, gv_cButtonSizeAbilities, c_anchorTopLeft, lv_x, lv_y, gv_abilitiesButtons[lv_iButton].lv_tooltip, StringToText(""), "");
                libNtve_gf_SetDialogItemRenderPriority(DialogControlLastCreated(), lv_zRender, PlayerGroupAll());
                gv_abilitiesSelectionButtons[lv_iButton] = DialogControlLastCreated();
                libNtve_gf_CreateDialogItemImage(DialogLastCreated(), gv_cIconSizeAbilities, gv_cIconSizeAbilities, c_anchorTopLeft, (lv_x + gv_cButtonInlayAbilities), (lv_y + gv_cButtonInlayAbilities), StringToText(""), gv_abilitiesButtons[lv_iButton].lv_icon, c_triggerImageTypeNormal, false, Color(100,100,100), c_triggerBlendModeNormal);
                libNtve_gf_SetDialogItemRenderPriority(DialogControlLastCreated(), lv_zRender, PlayerGroupAll());
                gv_abilitiesSelectionIcons[lv_iButton] = DialogControlLastCreated();
            }

            lv_x += (gv_cButtonSizeAbilities + gv_cButtonGapAbilities);
            lv_iButton += 1;
        }
        lv_y += (gv_cButtonSizeAbilities + gv_cButtonGapAbilities);
    }
}

