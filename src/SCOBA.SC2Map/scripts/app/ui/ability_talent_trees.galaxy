// Module: ui/ability_talent_trees

void gf_UnlockSupportTalentTree (int lp_iPlayer) {
    // Variable Declarations
    int lv_localPlayer;

    // Variable Initialization
    lv_localPlayer = lp_iPlayer;

    // Implementation
    UnitAbilityEnable(gv_tPSUNIT[lv_localPlayer], "heal", true);
