const int c_ANIM_LOWER_HOLD_TICKS = 3;
const int c_ANIM_AIM_TURN_HOLD_TICKS = 3;
// Attack clip speed and hold follow the weapon period (operator 2026-11-16):
// the values below are for a c_ANIM_ATTACK_PERIOD_REF period and scale by
// c_ANIM_ATTACK_PERIOD_REF / weapon Period (gf_AnimAttackSpeed).
const fixed c_ANIM_ATTACK_PERIOD_REF = 1.0;
const fixed c_ANIM_ATTACK_SPEED_MIN = 0.25;
const fixed c_ANIM_ATTACK_DURATION = 0.5;
const fixed c_ANIM_ATTACK_TIME_SCALE = 2.0;
const fixed c_ANIM_ATTACK_START_TIME = 0.35;
const fixed c_ANIM_AIM_ATTACK_BLEND = 0.1;
const fixed c_ANIM_MOVE_EPSILON = 0.05;
// Strafe and backpedal walk clips play this much faster than the stock walk
// rate (operator 2026-11-16: +25%). All heroes.
const fixed c_ANIM_STRAFE_RATE = 1.25;

const string c_ANIM_BRACKET_UPPER = "SCOBAUp";
const string c_ANIM_BRACKET_LOWER = "SCOBALo";
const string c_ANIM_BRACKET_ATTACK = "SCOBAAimAtk";
const string c_ANIM_BRACKET_AIM_ATTACK = "SCOBAAimAtk";

// Head look (R-TPS-13, 16). Steps and ranges match HEAD_TILT_* and HEAD_YAW_*
// in scripts/character_anim_assets.py. The head is level at the level pitch.
// Clip number = (yaw step - 1) * c_ANIM_HEAD_STEPS + pitch step.
const string c_ANIM_BRACKET_HEAD = "SCOBAHead";
const int c_ANIM_HEAD_STEPS = 9;
const fixed c_ANIM_HEAD_MAX = 15.0;
const int c_ANIM_HEAD_YAW_STEPS = 11;
const fixed c_ANIM_HEAD_YAW_MAX = 25.0;
const fixed c_ANIM_HEAD_SCALE = 0.4;
const fixed c_ANIM_HEAD_LEVEL_PITCH = 20.0;
// The head tick runs once a game loop (0.0625 s). A blend of one loop lets
// the engine interpolate between steps on every rendered frame, so the head
// moves smoothly instead of jumping once per loop.
const fixed c_ANIM_HEAD_BLEND = 0.0625;
// Head lead: a virtual body eases toward the crosshair with this time
// constant; the head shows the gap, so it swings ahead and settles back.
const fixed c_ANIM_HEAD_LEAD_TAU = 0.2;
const fixed c_ANIM_HEAD_LEAD_GAIN = 1.0;

const int c_PROBE_ATTACHMENT_COUNT = 6;
const int c_PROBE_BUFFER_ROWS = 64;
const fixed c_PROBE_FLUSH_INTERVAL = 0.25;
const fixed c_PROBE_TICK_INTERVAL = 0.01;
const fixed c_PROBE_LOWER_INTERVAL = 0.1;
const int c_PROBE_LOWER_QUERY_LIMIT = 250;

