// Module: core/intro
// Intro loop and deploy (REQ-INTRO, SPEC-INTRO). Constants and state.
// Shot table: data/intro_shots (generated). Logic: systems/intro.

// The test map builder writes false here for every profile but intro
// (SPEC-INTRO 3.11). Read it through a variable: Galaxy rejects constant
// conditions.
const bool c_INTRO_ENABLED = true;

// States (SPEC-INTRO 3.2).
const int c_INTRO_OFF = 0;
const int c_INTRO_LOOP = 1;
const int c_INTRO_DROP = 2;   // the hero drop runs (systems/hero_drop)
const int c_INTRO_DONE = 3;

const fixed c_INTRO_TICK = 0.0625;          // one game loop
const fixed c_INTRO_FADE_IN = 4.0;   // operator 2026-11-18: was 1.5
// Intro theme: a SoundData sound, played per seat with SoundPlay (operator
// 2026-11-18: the soundtrack did not play). File res/audio/SCOBA_IntroTheme.wav.
const string c_INTRO_MUSIC = "SCOBAIntroTheme";
// S9 (row 8): the Psi Destroyer hum plays for the whole shot (operator 2026-11-18).
const string c_INTRO_PSI_HUM = "SCOBAPsiHum";
const int c_INTRO_ROW_PSI = 8;
// S4 (row 3): the caged Ultralisk's idle sounds (stock
// Doodad_HybridUltraliskShackled_*, category Doodad) way down (operator
// 2026-11-18). The seat's Doodad channel volume, percent.
const int c_INTRO_ROW_CAGED = 3;
const fixed c_INTRO_CAGED_VOLUME = 15.0;
const fixed c_INTRO_CAGED_FADE = 0.25;
const string c_INTRO_SILENCE = "Music_Silence";   // default music after touchdown: none

// Prompt (SPEC-INTRO 3.10).
const int c_INTRO_PROMPT_W = 900;
const int c_INTRO_PROMPT_H = 48;
const int c_INTRO_PROMPT_OFFSET = 24;
const int c_INTRO_COUNT = 3;   // SPACE countdown, seconds
// One beep on every countdown number, 3, 2 and 1 (operator 2026-11-20):
// the stock Battle.net match countdown beep (liberty.sc2mod SoundData).
const string c_INTRO_COUNT_BEEP = "UI_BnetCountdownBeep";
const fixed c_INTRO_PULSE = 0.8;
const fixed c_INTRO_PULSE_LOW = 0.0;        // transparency, percent
const fixed c_INTRO_PULSE_HIGH = 55.0;

// Depth of field in S2 (SPEC-INTRO 3.6). Dflt values: core/scene.
const fixed c_INTRO_DOF_ON = 1.0;
const fixed c_INTRO_DOF_FOCUS = 16.0;
const fixed c_INTRO_DOF_FAR_START = 4.0;
const fixed c_INTRO_DOF_FAR_END = 18.0;
const fixed c_INTRO_DOF_NEAR_START = 1.0;
const fixed c_INTRO_DOF_NEAR_END = 6.0;
const fixed c_INTRO_SCENE_NEAR_SCALE = 0.5;  // intro scene near DOF: lower = weaker

// Creep seed at the center X (SPEC-INTRO 3.7).
const fixed c_INTRO_SEED_OFFSET = 3.5;
const fixed c_INTRO_SEED_BACK = 50.0;  // seed groups start this far back toward their spawns

trigger gt_IntroPrepare;
trigger gt_IntroTick;
trigger gt_IntroDeploy;
trigger gt_IntroPulse;

int[16] gv_introState;
bool[16] gv_introActive;          // LOOP, DROP
int[16] gv_introShot;             // row of the shot on screen
int[16] gv_introPass;
fixed[16] gv_introShotStart;      // gv_sCOBA_Clock at the cut
int gv_introPrompt;           // dialog
int gv_introPromptLabel;
bool[16] gv_introPromptLow;       // pulse direction
// Script state for tests: the values last written to the camera.
point[16] gv_introTarget;
fixed[16] gv_introYaw;
fixed[16] gv_introPitch;
fixed[16] gv_introDist;
fixed[16] gv_introFov;
fixed[16] gv_introHeight;         // height offset written
fixed[16] gv_introGround;         // ground under the target (U3)
bool[16] gv_introDof;
// Engine target, read at each tick: the loop after the last pan, the one
// loop CameraGetTarget reads right (SPEC-HERO-DROP F6). Gap to what was sent.
point[16] gv_introSent;
point[16] gv_introCamRead;
fixed[16] gv_introCamGap;
bool[16] gv_introMusic;
sound[16] gv_introMusicSound;
bool[16] gv_introHumOn;       // the S9 hum is playing (tests)
bool[16] gv_introQuiet;       // the S4 Doodad channel is down (tests)
sound[16] gv_introHum;
bool gv_introHumValid;        // the hum sound id resolves (tests)
bool gv_introMusicValid;      // the music sound id resolves in the loaded catalogs (U5)
bool gv_introSilenceValid;
int[16] gv_introCuts;
int gv_introSeeded;
unitgroup gv_introSeedTerran;
unitgroup gv_introSeedZerg;
int[16] gv_introDeploys;
fixed[16] gv_introCountAt;  // countdown start (clock); -1: not counting
int[16] gv_introCountShown;        // the number on the prompt line
string[16] gv_introCountTrace;     // numbers shown, in order (tests)
int[16] gv_introCountBeeps;        // countdown beeps played (tests)
bool gv_introBeepValid;            // the beep sound id resolves (tests)
// Deploy until the drop's zoom: the intro shot keeps moving (no frozen
// frame before the pod births); the drop releases it (gf_IntroCameraRelease).
bool[16] gv_introCamHeld;
actor gv_introTree;  // the S2 Zerus tree (systems/visual_tuning)
actor gv_introTree2; // the second, smaller one next to it
int[16] gv_introSpaceIgnored;
