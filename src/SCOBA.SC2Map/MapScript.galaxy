                gf_AbilitiesSelectionDialogUpdateButtonsandIcons(lv_localPlayer);
                gv_allocatedAbilityPoints[gf_GetTalentTreeType(lv_iButton)][lv_localPlayer] += 1;
                gf_AbilitiesSelectionDialogUpdateKeyColumn(lv_localPlayer, gv_abilitiesButtons[lv_iButton].lv_icon, gv_abilitiesButtons[lv_iButton].lv_tooltip);
            }
            else {
                if ((gv_availableAbilityPoints[lv_localPlayer] == 0)) {
                    UIClearMessages(PlayerGroupSingle(lv_localPlayer), c_messageAreaAll);
                    UIDisplayMessage(PlayerGroupSingle(lv_localPlayer), c_messageAreaSubtitle, StringExternal("Param/Value/CE73F468"));
                }
                else {
                    if ((gv_abilitiesButtons[lv_iButton].lv_enabled == true) && (gv_abilitiesButtons[lv_iButton].lv_learned == false) && (gv_availableAbilityPoints[lv_localPlayer] > 0) && (lv_iButton >= 20)) {
                        autoF1950733_val = lv_iButton;
                        if (autoF1950733_val == 20) {
                            if ((gv_allocatedAbilityPoints[0][lv_localPlayer] >= 3)) {
                                gv_abilitiesButtons[lv_iButton].lv_enabled = false;
                                gv_abilitiesButtons[lv_iButton].lv_learned = true;
                                gv_availableAbilityPoints[lv_localPlayer] -= 1;
                                gf_AbilitiesSelectionDialogLockAbilities(lv_iButton, lv_localPlayer);
                                gf_AbilitiesSelectionDialogUnlockAbilities(lv_iButton, lv_localPlayer);
                                gf_AbilitiesSelectionDialogUpdateButtonsandIcons(lv_localPlayer);
                                gv_allocatedAbilityPoints[gf_GetTalentTreeType(lv_iButton)][lv_localPlayer] += 1;
                                gf_AbilitiesSelectionDialogUpdateKeyColumn(lv_localPlayer, gv_abilitiesButtons[lv_iButton].lv_icon, gv_abilitiesButtons[lv_iButton].lv_tooltip);
                            }

                        }
                        else if (autoF1950733_val == 21) {
                            if ((gv_allocatedAbilityPoints[1][lv_localPlayer] >= 3)) {
                                gv_abilitiesButtons[lv_iButton].lv_enabled = false;
                                gv_abilitiesButtons[lv_iButton].lv_learned = true;
                                gv_availableAbilityPoints[lv_localPlayer] -= 1;
                                gf_AbilitiesSelectionDialogLockAbilities(lv_iButton, lv_localPlayer);
                                gf_AbilitiesSelectionDialogUnlockAbilities(lv_iButton, lv_localPlayer);
                                gf_AbilitiesSelectionDialogUpdateButtonsandIcons(lv_localPlayer);
                                gv_allocatedAbilityPoints[gf_GetTalentTreeType(lv_iButton)][lv_localPlayer] += 1;
                                gf_AbilitiesSelectionDialogUpdateKeyColumn(lv_localPlayer, gv_abilitiesButtons[lv_iButton].lv_icon, gv_abilitiesButtons[lv_iButton].lv_tooltip);
                            }

                        }
                        else if (autoF1950733_val == 22) {
                            if ((gv_allocatedAbilityPoints[2][lv_localPlayer] >= 3)) {
                                gv_abilitiesButtons[lv_iButton].lv_enabled = false;
                                gv_abilitiesButtons[lv_iButton].lv_learned = true;
                                gv_availableAbilityPoints[lv_localPlayer] -= 1;
                                gf_AbilitiesSelectionDialogLockAbilities(lv_iButton, lv_localPlayer);
                                gf_AbilitiesSelectionDialogUnlockAbilities(lv_iButton, lv_localPlayer);
                                gf_AbilitiesSelectionDialogUpdateButtonsandIcons(lv_localPlayer);
                                gv_allocatedAbilityPoints[gf_GetTalentTreeType(lv_iButton)][lv_localPlayer] += 1;
                                gf_AbilitiesSelectionDialogUpdateKeyColumn(lv_localPlayer, gv_abilitiesButtons[lv_iButton].lv_icon, gv_abilitiesButtons[lv_iButton].lv_tooltip);
                            }

                        }
                        else if (autoF1950733_val == 23) {
                            if ((gv_allocatedAbilityPoints[3][lv_localPlayer] >= 3)) {
                                gv_abilitiesButtons[lv_iButton].lv_enabled = false;
                                gv_abilitiesButtons[lv_iButton].lv_learned = true;
                                gv_availableAbilityPoints[lv_localPlayer] -= 1;
                                gf_AbilitiesSelectionDialogLockAbilities(lv_iButton, lv_localPlayer);
                                gf_AbilitiesSelectionDialogUnlockAbilities(lv_iButton, lv_localPlayer);
                                gf_AbilitiesSelectionDialogUpdateButtonsandIcons(lv_localPlayer);
                                gv_allocatedAbilityPoints[gf_GetTalentTreeType(lv_iButton)][lv_localPlayer] += 1;
                                gf_AbilitiesSelectionDialogUpdateKeyColumn(lv_localPlayer, gv_abilitiesButtons[lv_iButton].lv_icon, gv_abilitiesButtons[lv_iButton].lv_tooltip);
                            }

                        }
                        else {
                        }
                    }

                }
            }
        }

    }
    return true;
}

