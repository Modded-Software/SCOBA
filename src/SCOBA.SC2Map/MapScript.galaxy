void gf_InitializeLevelingInterface () {
    // Implementation
    gf_SBDialogCreateStatsButton();
    gf_InitializeUnitButtons();
    gf_UnitSelectionDialogCreate();
    gf_SBDialogCreateAbilitiesButton();
    gf_InitializeAbilitiesButtons();
    gf_AbilitiesSelectionDialogCreate();
}

void gf_ShowStasLevelingInterface (int lp_iPlayer) {
    // Implementation
    if ((DialogIsVisible(gv_userSelectionDialog, lp_iPlayer) == true)) {
        DialogSetVisible(gv_userSelectionDialog, PlayerGroupAll(), false);
        gf_SBDialogShowStatsButton(lp_iPlayer);
    }
    else {
        gf_SBDialogShowStatsButton(lp_iPlayer);
    }
}

