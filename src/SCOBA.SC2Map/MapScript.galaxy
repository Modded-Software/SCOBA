void gf_AddUnitButton (int lp_statGet, int lp_statSet, string lp_icon, text lp_tooltip) {
    // Implementation
    gv_unitButtons[gv_nUnitButtons].lv_statGet = lp_statGet;
    gv_unitButtons[gv_nUnitButtons].lv_statSet = lp_statSet;
    gv_unitButtons[gv_nUnitButtons].lv_icon = lp_icon;
    gv_unitButtons[gv_nUnitButtons].lv_tooltip = lp_tooltip;
    gv_nUnitButtons += 1;
}

void gf_Createalinefordialog (int lp_dialog, int lp_x1, int lp_y1, int lp_x2, int lp_y2, int lp_thick, color lp_color) {
    // Variable Declarations
    fixed lv_dx;
    fixed lv_dy;
    int lv_xm;
    int lv_ym;
    fixed lv_length;
    int lv_angle;

    // Variable Initialization

    // Implementation
    lv_dx = IntToFixed((lp_x2 - lp_x1));
    lv_dy = IntToFixed((lp_y2 - lp_y1));
    lv_length = SquareRoot((Pow(lv_dx, 2.0) + Pow(lv_dy, 2.0)));
    lv_xm = FixedToInt(((IntToFixed(lp_x1) + IntToFixed(lp_x2)) / 2.0));
    lv_ym = FixedToInt(((IntToFixed(lp_y1) + IntToFixed(lp_y2)) / 2.0));
    lv_angle = FixedToInt(ATan2(lv_dy, lv_dx));
    libNtve_gf_CreateDialogItemImage(lp_dialog, FixedToInt(lv_length), lp_thick, c_anchorTopLeft, (lv_xm - (FixedToInt(lv_length) / 2)), (lv_ym - (lp_thick / 2)), StringToText(""), "Assets\\Textures\\white.dds", c_triggerImageTypeNormal, false, lp_color, c_triggerBlendModeNormal);
    libNtve_gf_SetDialogItemRotation(DialogControlLastCreated(), lv_angle, PlayerGroupAll());
    libNtve_gf_SetDialogItemRenderPriority(DialogControlLastCreated(), 513, PlayerGroupAll());
}

int gf_GetTalentTreeType (int lp_clickedButton) {
    int auto56AC2C60_ae;
    int auto56AC2C60_ai;

    // Variable Declarations
    int lv_i;
    const int lv_maxColumn = 5;
    const int lv_maxSkillTree = 3;
    const int lv_supportSkillTree = 0;
    const int lv_defenseSkillTree = 1;
    const int lv_offenseSkillTree = 2;
    const int lv_specialistSkillTree = 3;
    const int lv_columnAddition = 4;

    // Variable Initialization

    // Implementation
    auto56AC2C60_ae = lv_maxColumn;
    auto56AC2C60_ai = 1;
    lv_i = 0;
    for ( ; ( (auto56AC2C60_ai >= 0 && lv_i <= auto56AC2C60_ae) || (auto56AC2C60_ai <= 0 && lv_i >= auto56AC2C60_ae) ) ; lv_i += auto56AC2C60_ai ) {
        if ((lp_clickedButton == (0 + (lv_columnAddition * lv_i)))) {
            return 0;
        }

        if ((lp_clickedButton == (1 + (lv_columnAddition * lv_i)))) {
            return 1;
        }

        if ((lp_clickedButton == (2 + (lv_columnAddition * lv_i)))) {
            return 2;
        }

        if ((lp_clickedButton == (3 + (lv_columnAddition * lv_i)))) {
            return 3;
        }

    }
    return 0;
}

int gf_GetNextRow (int lp_clickedButton) {
    // Variable Declarations
    int lv_buttonClicked;

    // Variable Initialization
    lv_buttonClicked = lp_clickedButton;

    // Implementation
    if ((lv_buttonClicked >= 0) && (lv_buttonClicked <= 3)) {
        return 4;
    }
    else {
        if ((lv_buttonClicked >= 4) && (lv_buttonClicked <= 7)) {
            return 8;
        }
        else {
            if ((lv_buttonClicked >= 8) && (lv_buttonClicked <= 11)) {
                return 12;
            }
            else {
                if ((lv_buttonClicked >= 12) && (lv_buttonClicked <= 15)) {
                    return 16;
                }
                else {
                    if ((lv_buttonClicked >= 16) && (lv_buttonClicked <= 19)) {
                        return 20;
                    }
                    else {
                        if ((lv_buttonClicked >= 20) && (lv_buttonClicked <= 23)) {
                            return 24;
                        }
                        else {
                            return 24;
                        }
                    }
                }
            }
        }
    }
}

bool gf_CanLevelAbility (int lp_numberToCheck) {
    // Implementation
    if ((ModI(lp_numberToCheck, 3) == 0)) {
        return true;
    }
    else {
        return false;
    }
}

void gf_ShowAbilityLevelingInterface (int lp_iPlayer) {
    // Implementation
    if ((DialogIsVisible(gv_abilitiesSelectionDialog, lp_iPlayer) == true)) {
        gf_AbilitiesSelectionDialogHide();
        gf_SBDialogShowAbilitiesButton(lp_iPlayer);
    }
    else {
        gf_SBDialogShowAbilitiesButton(lp_iPlayer);
    }
}

void gf_SBDialogShowAbilitiesButton (int lp_iPlayer) {
    // Implementation
    libNtve_gf_SetDialogItemText(gv_singleButtonLabelAbilities, IntToText(gv_availableAbilityPoints[lp_iPlayer]), PlayerGroupSingle(lp_iPlayer));
