//--------------------------------------------------------------------------------------------------
// Trigger: Target
//--------------------------------------------------------------------------------------------------
bool gt_Target_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_triggeringUnit;
    unit lv_targetUnit;
    int lv_localPlayer;
    int lv_localBar;

    // Variable Initialization
    lv_triggeringUnit = EventUnit();
    lv_targetUnit = EventUnitTarget();
    lv_localPlayer = -1;
    if (UnitIsValid(lv_targetUnit)) {
        lv_localPlayer = UnitGetOwner(lv_targetUnit);
    }
    lv_localBar = ((lv_localPlayer * 10) + 4);

    // Conditions
    if (testConds) {
        if (lv_localPlayer < 1 || lv_localPlayer > 6) {
            return false;
        }

        if (!UnitIsValid(lv_triggeringUnit) || !UnitIsValid(lv_targetUnit) || !UnitIsValid(gv_tPSUNIT[lv_localPlayer])) {
            return false;
        }

        if (!((lv_targetUnit == gv_tPSUNIT[lv_localPlayer]))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    gv_tARGET[lv_localPlayer] = lv_triggeringUnit;
    libNtve_gf_DisplayBossBar(lv_localBar, "Assets\\Textures\\btn-command-attack.dds", UnitTypeGetName(UnitGetType(lv_triggeringUnit)), 100, PlayerGroupSingle(lv_localPlayer));
    libNtve_gf_SetBossBarRace(lv_localBar, libNtve_ge_BossBarRace_Terran, true);
    libNtve_gf_SetBossBarBoss(lv_localBar, lv_triggeringUnit, true);
    libNtve_gf_MoveBossBar(lv_localBar, c_anchorTop, 0, 50);
    UnitStatusBarOverride(lv_triggeringUnit, -1);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_Target_Init () {
    gt_Target = TriggerCreate("gt_Target_Func");
    TriggerAddEventUnitAttacked2(gt_Target, null, null);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Clear Target
//--------------------------------------------------------------------------------------------------
bool gt_ClearTarget_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_triggeringUnit;
    int lv_localPlayer;
    int lv_localBar;

    // Variable Initialization
    lv_triggeringUnit = EventUnit();
    lv_localPlayer = EventPlayer();
    lv_localBar = ((lv_localPlayer * 10) + 4);

    // Conditions
    if (testConds) {
        if (lv_localPlayer < 1 || lv_localPlayer > 6) {
            return false;
        }

        if (!UnitIsValid(lv_triggeringUnit) || !UnitIsValid(gv_tPSUNIT[lv_localPlayer])) {
            return false;
        }

        if (!((lv_triggeringUnit == gv_tPSUNIT[lv_localPlayer]))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if (UnitIsValid(gv_tARGET[lv_localPlayer])) {
        UnitStatusBarOverride(gv_tARGET[lv_localPlayer], -1);
    }

    gv_tARGET[lv_localPlayer] = null;
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_ClearTarget_Init () {
    gt_ClearTarget = TriggerCreate("gt_ClearTarget_Func");
    TriggerAddEventUnitBecomesIdle(gt_ClearTarget, UnitRefFromVariable("gv_tPSUNIT[1]"), true);
    TriggerAddEventUnitOrder(gt_ClearTarget, UnitRefFromVariable("gv_tPSUNIT[1]"), AbilityCommand("move", 2));
    TriggerAddEventUnitBecomesIdle(gt_ClearTarget, UnitRefFromVariable("gv_tPSUNIT[2]"), true);
    TriggerAddEventUnitOrder(gt_ClearTarget, UnitRefFromVariable("gv_tPSUNIT[2]"), AbilityCommand("move", 2));
    TriggerAddEventUnitBecomesIdle(gt_ClearTarget, UnitRefFromVariable("gv_tPSUNIT[3]"), true);
    TriggerAddEventUnitOrder(gt_ClearTarget, UnitRefFromVariable("gv_tPSUNIT[3]"), AbilityCommand("move", 2));
    TriggerAddEventUnitBecomesIdle(gt_ClearTarget, UnitRefFromVariable("gv_tPSUNIT[4]"), true);
    TriggerAddEventUnitOrder(gt_ClearTarget, UnitRefFromVariable("gv_tPSUNIT[4]"), AbilityCommand("move", 2));
    TriggerAddEventUnitBecomesIdle(gt_ClearTarget, UnitRefFromVariable("gv_tPSUNIT[5]"), true);
    TriggerAddEventUnitOrder(gt_ClearTarget, UnitRefFromVariable("gv_tPSUNIT[5]"), AbilityCommand("move", 2));
    TriggerAddEventUnitBecomesIdle(gt_ClearTarget, UnitRefFromVariable("gv_tPSUNIT[6]"), true);
    TriggerAddEventUnitOrder(gt_ClearTarget, UnitRefFromVariable("gv_tPSUNIT[6]"), AbilityCommand("move", 2));
}

