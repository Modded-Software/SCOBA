}

//--------------------------------------------------------------------------------------------------
// Trigger: Disable Click Move
//--------------------------------------------------------------------------------------------------
bool gt_DisableClickMove_Func (bool testConds, bool runActions) {
    // Conditions
    if (testConds) {
        if (!((((EventUnit() == gv_tPSUNIT[1]) && (gv_fORWARD[1] == false) && (gv_bACKWARD[1] == false) && (gv_lEFT[1] == false) && (gv_rIGHT[1] == false)) || ((EventUnit() == gv_tPSUNIT[2]) && (gv_fORWARD[2] == false) && (gv_bACKWARD[2] == false) && (gv_lEFT[2] == false) && (gv_rIGHT[2] == false))))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitIssueOrder(EventUnit(), Order(AbilityCommand("move", 2)), c_orderQueueReplace);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_DisableClickMove_Init () {
    gt_DisableClickMove = TriggerCreate("gt_DisableClickMove_Func");
    TriggerAddEventUnitOrder(gt_DisableClickMove, null, AbilityCommand("move", 0));
}

//--------------------------------------------------------------------------------------------------
// Trigger: Forward Start
//--------------------------------------------------------------------------------------------------
bool gt_ForwardStart_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_localPlayer;
    fixed lv_angle;

    // Variable Initialization
    lv_localPlayer = EventPlayer();

    // Actions
    if (!runActions) {
        return true;
    }

    gv_fORWARD[lv_localPlayer] = true;
    while ((gv_fORWARD[lv_localPlayer] == true) && (gv_bACKWARD[lv_localPlayer] == false)) {
        if (((gv_rOTATEUNIT[lv_localPlayer] == true) || (gv_rOTATECAMERA[lv_localPlayer] == false))) {
            lv_angle = CameraGetYaw(lv_localPlayer);
        }
        else {
            lv_angle = UnitGetFacing(gv_tPSUNIT[lv_localPlayer]);
        }
        if ((gv_lEFT[lv_localPlayer] == true)) {
            lv_angle = (lv_angle + 45.0);
        }

        if ((gv_rIGHT[lv_localPlayer] == true)) {
            lv_angle = (lv_angle - 45.0);
        }

        UnitIssueOrder(gv_tPSUNIT[lv_localPlayer], OrderTargetingPoint(AbilityCommand("move", 0), PointWithOffsetPolar(UnitGetPosition(gv_tPSUNIT[lv_localPlayer]), 0.5, lv_angle)), c_orderQueueReplace);
        UnitSetFacing(gv_tPSUNIT[lv_localPlayer], lv_angle, 0.01);
        Wait(0.01, c_timeGame);
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_ForwardStart_Init () {
    gt_ForwardStart = TriggerCreate("gt_ForwardStart_Func");
    TriggerAddEventKeyPressed(gt_ForwardStart, c_playerAny, gv_mOVEFORWARD, true, c_keyModifierStateIgnore, c_keyModifierStateIgnore, c_keyModifierStateIgnore);
}

