void gf_AddAbilitiesButton (string lp_ability, bool lp_enabled, bool lp_learned, string lp_icon, string lp_grayIcon, text lp_tooltip) {
    // Implementation
    gv_abilitiesButtons[gv_nAbilitiesButtons].lv_ability = lp_ability;
    gv_abilitiesButtons[gv_nAbilitiesButtons].lv_enabled = lp_enabled;
    gv_abilitiesButtons[gv_nAbilitiesButtons].lv_learned = lp_learned;
    gv_abilitiesButtons[gv_nAbilitiesButtons].lv_icon = lp_icon;
    gv_abilitiesButtons[gv_nAbilitiesButtons].lv_grayIcon = lp_grayIcon;
    gv_abilitiesButtons[gv_nAbilitiesButtons].lv_tooltip = lp_tooltip;
    gv_nAbilitiesButtons += 1;
}

