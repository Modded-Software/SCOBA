bool gt_ZerusSpawn_Func (bool testConds, bool runActions) {
    int auto58D71E67_ae;
    int auto58D71E67_ai;

    // Variable Declarations
    int lv_playerIndex;

    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    auto58D71E67_ae = 6;
    auto58D71E67_ai = 1;
    lv_playerIndex = 4;
    for ( ; ( (auto58D71E67_ai >= 0 && lv_playerIndex <= auto58D71E67_ae) || (auto58D71E67_ai <= 0 && lv_playerIndex >= auto58D71E67_ae) ) ; lv_playerIndex += auto58D71E67_ai ) {
        libSwaC_gf_CreateDropPod(libSwaC_ge_DropPodRace_Zerg, RegionRandomPoint(gv_sPAWNLOCATIONS[lv_playerIndex]), UnitGroupEmpty(), false, lv_playerIndex);
        Wait((RandomInt(1, 10) / 10.0), c_timeGame);
        libSwaC_gf_CreateDropPod(libSwaC_ge_DropPodRace_Zerg, RegionRandomPoint(gv_sPAWNLOCATIONS[lv_playerIndex]), UnitGroupEmpty(), false, lv_playerIndex);
        Wait((RandomInt(1, 10) / 10.0), c_timeGame);
        libSwaC_gf_CreateDropPod(libSwaC_ge_DropPodRace_Zerg, RegionRandomPoint(gv_sPAWNLOCATIONS[lv_playerIndex]), UnitGroupEmpty(), false, lv_playerIndex);
        Wait(4.0, c_timeGame);
        libNtve_gf_CreateUnitsAtPoint2(8, "Zergling", 0, lv_playerIndex, RegionGetCenter(gv_sPAWNLOCATIONS[lv_playerIndex]));
        UnitGroupLoopBegin(UnitLastCreatedGroup());
        for ( ; !UnitGroupLoopDone() ; UnitGroupLoopStep() ) {
            UnitSetState(UnitGroupLoopCurrent(), c_unitStateHighlightable, true);
        }
        UnitGroupLoopEnd();
        UnitGroupIssueOrder(UnitLastCreatedGroup(), OrderTargetingPoint(AbilityCommand("attack", 0), RegionGetCenter(gv_xLOCATIONS[(lv_playerIndex - 3)])), c_orderQueueReplace);
        libNtve_gf_CreateUnitsAtPoint2(1, "RoachCorpser", 0, lv_playerIndex, RegionGetCenter(gv_sPAWNLOCATIONS[lv_playerIndex]));
        UnitGroupLoopBegin(UnitLastCreatedGroup());
        for ( ; !UnitGroupLoopDone() ; UnitGroupLoopStep() ) {
            UnitSetState(UnitGroupLoopCurrent(), c_unitStateHighlightable, true);
        }
        UnitGroupLoopEnd();
        UnitGroupIssueOrder(UnitLastCreatedGroup(), OrderTargetingPoint(AbilityCommand("attack", 0), RegionGetCenter(gv_xLOCATIONS[(lv_playerIndex - 3)])), c_orderQueueReplace);
        libNtve_gf_CreateUnitsAtPoint2(2, "Roach", 0, lv_playerIndex, RegionGetCenter(gv_sPAWNLOCATIONS[lv_playerIndex]));
        UnitGroupLoopBegin(UnitLastCreatedGroup());
        for ( ; !UnitGroupLoopDone() ; UnitGroupLoopStep() ) {
            UnitSetState(UnitGroupLoopCurrent(), c_unitStateHighlightable, true);
        }
        UnitGroupLoopEnd();
        UnitGroupIssueOrder(UnitLastCreatedGroup(), OrderTargetingPoint(AbilityCommand("attack", 0), RegionGetCenter(gv_xLOCATIONS[(lv_playerIndex - 3)])), c_orderQueueReplace);
        if ((TechTreeUnitCount(lv_playerIndex, "Queen", c_techCountQueuedOrBetter) == 0)) {
            libNtve_gf_CreateUnitsAtPoint2(1, "Queen", 0, lv_playerIndex, RegionGetCenter(gv_sPAWNLOCATIONS[lv_playerIndex]));
            UnitGroupLoopBegin(UnitLastCreatedGroup());
            for ( ; !UnitGroupLoopDone() ; UnitGroupLoopStep() ) {
                UnitSetState(UnitGroupLoopCurrent(), c_unitStateHighlightable, true);
            }
            UnitGroupLoopEnd();
            UnitGroupIssueOrder(UnitLastCreatedGroup(), OrderTargetingPoint(AbilityCommand("attack", 0), RegionGetCenter(gv_xLOCATIONS[(lv_playerIndex - 3)])), c_orderQueueReplace);
        }

    }
    return true;
}

