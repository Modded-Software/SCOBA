//--------------------------------------------------------------------------------------------------
// Trigger: Unit Selection
//--------------------------------------------------------------------------------------------------
bool gt_UnitSelection_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    UnitGroupLoopBegin(UnitGroup(null, c_playerAny, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
    for ( ; !UnitGroupLoopDone() ; UnitGroupLoopStep() ) {
        UnitSetState(UnitGroupLoopCurrent(), c_unitStateHighlightable, true);
        UnitSetState(UnitGroupLoopCurrent(), c_unitStateSelectable, false);
    }
    UnitGroupLoopEnd();
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_UnitSelection_Init () {
    gt_UnitSelection = TriggerCreate("gt_UnitSelection_Func");
    TriggerAddEventTimeElapsed(gt_UnitSelection, 1.0, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// Trigger: New Unit Selection
//--------------------------------------------------------------------------------------------------
bool gt_NewUnitSelection_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    UnitGroupLoopBegin(UnitGroup(null, c_playerAny, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
    for ( ; !UnitGroupLoopDone() ; UnitGroupLoopStep() ) {
        if (true) {
            UnitSetState(UnitGroupLoopCurrent(), c_unitStateHighlightable, true);
            UnitSetState(UnitGroupLoopCurrent(), c_unitStateSelectable, false);
        }

    }
    UnitGroupLoopEnd();
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_NewUnitSelection_Init () {
    gt_NewUnitSelection = TriggerCreate("gt_NewUnitSelection_Func");
    TriggerAddEventUnitCreated(gt_NewUnitSelection, null, null, null);
}

