{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2017",
    "lib": ["es2020", "dom"],
    "moduleResolution": "bundler",
    "typeRoots": ["./ref/mdx-m3-viewer/types", "./node_modules/@types"],
    "types": ["node"],
    "strict": true,
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "./ref/mdx-m3-viewer/src",
    "outDir": "./build/lib-types"
  },
  "files": [
    "ref/mdx-m3-viewer/src/viewer/viewer.ts",
    "ref/mdx-m3-viewer/src/viewer/handlers/m3/handler.ts",
    "ref/mdx-m3-viewer/src/viewer/handlers/dds/handler.ts",
    "ref/mdx-m3-viewer/src/viewer/handlers/tga/handler.ts",
    "ref/mdx-m3-viewer/src/parsers/dds/image.ts",
    "ref/mdx-m3-viewer/src/parsers/m3/model.ts"
  ],
  "include": ["ref/mdx-m3-viewer/types/**/*"]
}
