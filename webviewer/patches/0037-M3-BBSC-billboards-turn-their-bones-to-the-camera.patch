@@ -0,0 +1,38 @@
+import BinaryStream from '../../common/binarystream';
+import IndexEntry from './indexentry';
+import Reference from './reference';
+
+/**
+ * A billboard behaviour (BBSC, version 0, 48 bytes): which bone turns to
+ * the camera, and how. Layout from m3addon structures.xml; the meaning of
+ * the type, the look-at flag and the two correction quaternions from
+ * WhiteoutFlakes m3_billboard.h. SC2 billboards come only from here: the
+ * BONE billboard flags are set on no bone in the game data.
+ */
+export default class BillboardBehavior {
+  version = -1;
+  /** Dependent bones (U16_); empty in every record of the game data. */
+  dependents = new Reference();
+  boneIndex = 0;
+  /**
+   * 0, 1, 2: locked to world X, Y, Z; 3, 5: locked to the bone's own X, Y;
+   * 4: never applied; 6: free, the camera's up as the roll hint.
+   */
+  billboardType = 6;
+  /** 1: aim from the eye to the bone; 0: along the camera's view direction. */
+  cameraLookAt = 1;
+  /** Correction quaternion (x, y, z, w) of the axis-locked types 0 to 2. */
+  up = new Float32Array([0, 0, 0, 1]);
+  /** Correction quaternion (x, y, z, w) of type 6 on a bone with a bone parent. */
+  forward = new Float32Array([0, 0, 0, 1]);
+
+  load(stream: BinaryStream, version: number, index: IndexEntry[]): void {
+    this.version = version;
+    this.dependents.load(stream, index);
+    this.boneIndex = stream.readUint16();
+    this.billboardType = stream.readUint8();
+    this.cameraLookAt = stream.readUint8();
+    stream.readFloat32Array(this.up);
+    stream.readFloat32Array(this.forward);
+  }
+}
