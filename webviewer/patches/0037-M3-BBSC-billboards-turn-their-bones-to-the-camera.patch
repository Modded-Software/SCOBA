diff --git a/src/viewer/handlers/m3/billboard.ts b/src/viewer/handlers/m3/billboard.ts
new file mode 100644
index 00000000..f9a67ca9
--- /dev/null
+++ b/src/viewer/handlers/m3/billboard.ts
@@ -0,0 +1,211 @@
+import { mat3, mat4, quat, vec3 } from 'gl-matrix';
+import BillboardBehavior from '../../../parsers/m3/billboardbehavior';
+
+/**
+ * SC2 billboards (BBSC), ported from WhiteoutFlakes io/m3/m3_billboard.cpp
+ * (CBBSolver::ApplyBillboard). Run per frame against the camera, in world
+ * space as the game does: the bone's world rotation is replaced by one that
+ * faces the camera, then divided back through its parent so its children
+ * follow. A gl-matrix 4x4 keeps the bone's axes in its first three columns,
+ * which is the same memory as the row-vector rows WhiteoutFlakes reads.
+ */
+
+/** The constants the engine tests against. */
+const AXIS_EPSILON = 2.384185791015625e-7;
+const DEGENERATE_LEN_SQ = 1e-4;
+const UNIT_TOLERANCE = 1e-3;
+
+/** The camera as a billboard sees it, in world space. */
+export interface BillboardCamera {
+  position: vec3;
+  /** The camera's x (right) axis: type 0's fallback. */
+  axisX: vec3;
+  /** Into the scene. */
+  forward: vec3;
+  /** Roll hint of type 6; fallback of types 1 and 2. */
+  up: vec3;
+}
+
+type V3 = [number, number, number];
+
+const len2 = (v: V3): number => v[0] * v[0] + v[1] * v[1] + v[2] * v[2];
+const cross = (a: V3, b: V3): V3 => [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]];
+const scaled = (v: V3, s: number): V3 => [v[0] * s, v[1] * s, v[2] * s];
+/** Unit length; a zero vector is left as it is. */
+const unit = (v: V3): V3 => (len2(v) > 0 ? scaled(v, 1 / Math.sqrt(len2(v))) : v);
+/** The aim turned a quarter inside its plane, renormalised in 2-D. */
+const quarter = (a: number, b: number): [number, number] => {
+  const l = a * a + b * b;
+
+  return l > 0 ? [a / Math.sqrt(l), b / Math.sqrt(l)] : [a, b];
+};
+const axis = (m: mat4 | Float32Array, r: number): V3 => [m[r * 4], m[r * 4 + 1], m[r * 4 + 2]];
+
+/**
+ * The basis a billboard gives one bone: rows 0 to 2 are its axes, written
+ * to `out` (9 numbers). False when the engine leaves the bone alone.
+ */
+export function billboardBasis(type: number, lookAt: boolean, cam: BillboardCamera, bone: mat4, out: Float32Array): boolean {
+  // The aim points away from the eye in both branches.
+  const d: V3 = lookAt ? unit([bone[12] - cam.position[0], bone[13] - cam.position[1], bone[14] - cam.position[2]]) : [cam.forward[0], cam.forward[1], cam.forward[2]];
+
+  if (Math.abs(d[0]) < AXIS_EPSILON && Math.abs(d[1]) < AXIS_EPSILON && Math.abs(d[2]) < AXIS_EPSILON) {
+    return false;
+  }
+
+  let rows: V3[] = [[1, 0, 0], [0, 1, 0], [0, 0, 1]];
+
+  if (type === 0) {
+    // Locked to world X: local +Y aims along the direction in the YZ plane.
+    let v: V3 = [0, d[1], d[2]];
+
+    if (d[1] * d[1] + d[2] * d[2] < DEGENERATE_LEN_SQ) {
+      v = [cam.axisX[0], cam.axisX[1], cam.axisX[2]];
+    }
+
+    v = unit(v);
+    const p = quarter(-v[2], v[1]);
+
+    rows = [[1, 0, 0], v, [0, p[0], p[1]]];
+  } else if (type === 1) {
+    // Locked to world Y: local +X aims.
+    let v: V3 = [d[0], 0, d[2]];
+
+    if (d[2] * d[2] + d[0] * d[0] < DEGENERATE_LEN_SQ) {
+      v = [cam.up[0], cam.up[1], cam.up[2]];
+    }
+
+    v = unit(v);
+    const p = quarter(-v[2], v[0]);
+
+    rows = [v, [0, 1, 0], [p[0], 0, p[1]]];
+  } else if (type === 2) {
+    // Locked to world Z: the upright poster.
+    let v: V3 = [d[0], d[1], 0];
+
+    if (d[1] * d[1] + d[0] * d[0] < DEGENERATE_LEN_SQ) {
+      v = [cam.up[0], cam.up[1], cam.up[2]];
+    }
+
+    v = unit(v);
+    const p = quarter(v[1], -v[0]);
+
+    rows = [[p[0], p[1], 0], v, [0, 0, 1]];
+  } else if (type === 3 || type === 5) {
+    // Locked to the bone's own current X (3) or Y (5).
+    const a = unit(axis(bone, type === 3 ? 0 : 1));
+    const c = cross(a, d);
+
+    if (len2(c) < DEGENERATE_LEN_SQ) {
+      return false;
+    }
+
+    const cn = unit(c);
+
+    rows = type === 3 ? [a, cn, cross(a, cn)] : [cn, cross(a, cn), a];
+  } else if (type === 4) {
+    // Parsed by the game, never applied.
+    return false;
+  } else if (type === 6) {
+    // Free, the camera's up as the roll hint; parallel leaves identity.
+    const e = cross(d, [cam.up[0], cam.up[1], cam.up[2]]);
+
+    if (len2(e) >= DEGENERATE_LEN_SQ) {
+      const en = unit(e);
+
+      rows = [en, d, unit(cross(en, d))];
+    }
+  }
+
+  // The engine's gate: every row of unit length.
+  if (rows.some((r) => Math.abs(len2(r) - 1) >= UNIT_TOLERANCE)) {
+    return false;
+  }
+
+  for (let r = 0; r < 3; r++) {
+    out.set(rows[r], r * 3);
+  }
+
+  return true;
+}
+
+const basisHeap = new Float32Array(9);
+const q = quat.create();
+const parentQ = quat.create();
+const local = mat4.create();
+const m3Heap = mat3.create();
+
+/** A rotation from rows: normalised first two, the third rebuilt (M3Node_GetWorldRotationQuat). */
+function rotationOf(out: quat, m: mat4 | Float32Array): quat {
+  const x = unit(axis(m, 0));
+  const y = unit(axis(m, 1));
+  const z = unit(cross(x, y));
+
+  m3Heap.set([...x, ...y, ...z]);
+  quat.fromMat3(out, m3Heap);
+
+  return quat.normalize(out, out);
+}
+
+/**
+ * Apply one BBSC record to a bone's world matrix, in place.
+ * `spin`: the bone's own local rotation, for a bone whose parent is not a
+ * bone (it keeps spinning in the screen plane); null otherwise.
+ * `scale`: the bone's local scale. `parent`: the parent's world matrix (the
+ * instance's for a root bone). The bone's position is left as it is.
+ */
+export function applyBillboard(record: BillboardBehavior, cam: BillboardCamera, spin: quat | null, scale: vec3, parent: mat4, bone: mat4): boolean {
+  const type = record.billboardType;
+
+  if (!billboardBasis(type, record.cameraLookAt !== 0, cam, bone, basisHeap)) {
+    return false;
+  }
+
+  // Through a quaternion, as the engine does: it squares a skewed basis.
+  m3Heap.set(basisHeap);
+  quat.fromMat3(q, m3Heap);
+  quat.normalize(q, q);
+
+  if (spin) {
+    quat.mul(q, q, spin);
+  }
+
+  if (type <= 2) {
+    quat.mul(q, q, <quat>record.up);
+  } else if (type === 6 && !spin) {
+    quat.mul(q, q, <quat>record.forward);
+  }
+
+  // Into the parent's frame, then back out through the local scale and the parent.
+  quat.conjugate(parentQ, rotationOf(parentQ, parent));
+  quat.mul(q, parentQ, q);
+  quat.normalize(q, q);
+  mat4.fromQuat(local, q);
+
+  for (let r = 0; r < 3; r++) {
+    const s = scale[r];
+
+    for (let c = 0; c < 3; c++) {
+      let sum = 0;
+
+      for (let k = 0; k < 3; k++) {
+        sum += parent[k * 4 + c] * local[r * 4 + k];
+      }
+
+      bone[r * 4 + c] = sum * s;
+    }
+  }
+
+  return true;
+}
+
+/** The billboard camera of a scene camera: its eye and axes in world space. */
+export function billboardCamera(out: BillboardCamera, location: vec3, right: vec3, up: vec3, back: vec3): BillboardCamera {
+  vec3.copy(out.position, location);
+  vec3.normalize(out.axisX, right);
+  vec3.normalize(out.up, up);
+  vec3.scale(out.forward, back, -1);
+  vec3.normalize(out.forward, out.forward);
+
+  return out;
+}
