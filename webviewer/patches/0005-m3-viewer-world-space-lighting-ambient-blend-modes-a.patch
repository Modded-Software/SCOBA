@@ -261,7 +264,7 @@ vec4 computeSpecular(sampler2D specularMap, LayerSettings layerSettings, float s
     color = vec4(0);
   }
 
-  float factor = pow(max(-dot(v_halfVec, normal), 0.0), specularity) * specMult;
+  float factor = pow(max(dot(normalize(v_halfVec), normal), 0.0), specularity) * specMult;
 
   return color * factor;
 }
