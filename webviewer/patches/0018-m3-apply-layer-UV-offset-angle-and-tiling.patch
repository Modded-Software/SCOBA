--- /dev/null
+++ b/src/viewer/handlers/m3/uvtransform.ts
@@ -0,0 +1,39 @@
+/**
+ * The LAYR UV transform as two rows of a 2x3 matrix, applied to (u, v, 1).
+ *
+ * Source: WhiteoutFlakes `M3ComposeUvTransform` (src/io/m3/m3_model_adapter.cpp),
+ * which cites the SC2 client function sub_102ABBDE0:
+ *   uv' = 0.5 + S(tiling) * R(angle.z) * (uv - 0.5 - offset)
+ * The angle is in radians. Only angle.z acts on a 2D texture coordinate.
+ *
+ * `out` holds row 0 in [0..2] and row 1 in [3..5].
+ */
+export function composeUvTransform(out: Float32Array, offset: ArrayLike<number>, angle: ArrayLike<number>, tiling: ArrayLike<number>): Float32Array {
+  const c = Math.cos(angle[2]);
+  const s = Math.sin(angle[2]);
+  const cx = 0.5 + offset[0];
+  const cy = 0.5 + offset[1];
+  const tx = tiling[0];
+  const ty = tiling[1];
+
+  out[0] = tx * c;
+  out[1] = -tx * s;
+  out[2] = tx * (s * cy - c * cx) + 0.5;
+  out[3] = ty * s;
+  out[4] = ty * c;
+  out[5] = ty * (-s * cx - c * cy) + 0.5;
+
+  return out;
+}
+
+/**
+ * Tiling read from a track nothing drives can be (0, 0), which would squash
+ * the surface onto one texel. An undriven zero means 1. A driven value is
+ * used as it is.
+ */
+export function neutralTiling(out: Float32Array, tiling: ArrayLike<number>, driven: boolean): Float32Array {
+  out[0] = driven || tiling[0] !== 0 ? tiling[0] : 1;
+  out[1] = driven || tiling[1] !== 0 ? tiling[1] : 1;
+
+  return out;
+}
