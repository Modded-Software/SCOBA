+  /** Called by the model once its STCs exist: which UV tracks a sequence drives. */
+  resolveUvTracks(): void {
+    const layer = this.layer;
+
+    if (!layer) {
+      return;
+    }
+
+    const stcs = this.model.stc;
+    const driven = (animId: number): boolean => stcs.some((stc) => stc.animRefs[animId] !== undefined);
+
+    this.uvTilingDriven = driven(layer.uvTiling.animId);
+    this.uvDriven = this.uvTilingDriven || driven(layer.uvOffset.animId) || driven(layer.uvAngle.animId);
+  }
+
+  /** Evaluates offset, angle and tiling for the instance's current frame. */
+  updateUvTransform(instance: M3ModelInstance | undefined): Float32Array {
+    const layer = <Layer>this.layer;
+    const skeleton = instance ? instance.skeleton : null;
+    let offset: ArrayLike<number> = <Float32Array>layer.uvOffset.initValue;
+    let angle: ArrayLike<number> = <Float32Array>layer.uvAngle.initValue;
+    let tiling: ArrayLike<number> = <Float32Array>layer.uvTiling.initValue;
+
+    if (this.uvDriven && skeleton && instance) {
+      offset = skeleton.getValue2(uvOffsetHeap, layer.uvOffset, instance);
+      angle = skeleton.getValue3(uvAngleHeap, layer.uvAngle, instance);
+      tiling = skeleton.getValue2(uvTilingHeap, layer.uvTiling, instance);
+    }
+
+    const used = neutralTiling(uvTilingUsed, tiling, this.uvTilingDriven);
+    const inputs = this.uvInputs;
+
+    inputs[0] = offset[0];
+    inputs[1] = offset[1];
+    inputs[2] = angle[0];
+    inputs[3] = angle[1];
+    inputs[4] = angle[2];
+    inputs[5] = used[0];
+    inputs[6] = used[1];
+
+    return composeUvTransform(this.uvTransform, offset, angle, used);
+  }
