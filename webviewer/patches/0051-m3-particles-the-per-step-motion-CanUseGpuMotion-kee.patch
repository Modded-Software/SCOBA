+/** Below this drag over mass the motion counts as free: no drag at all. */
+const FREE = 1e-6;
+
+/**
+ * The drag and its inverse the motion uses. The closed form (GPU motion)
+ * floors the drag; the per-step path (Euler, WhiteoutFlakes StepEuler)
+ * takes it as authored, so a drag of 0 there is no drag.
+ */
+function dragLanes(drag: number, euler: boolean): [number, number] {
+  if (euler) {
+    return [drag, 1 / drag];
+  }
+
+  return [Math.max(DRAG_FLOOR, drag), drag < DRAG_FLOOR ? INV_DRAG_UNDER_FLOOR : 1 / drag];
+}
+
 /**
  * How far a particle has moved after `t` seconds, per axis, from its start
  * velocity, with drag and a vertical acceleration `accelZ`
- * (CalculateDisplacementAndVelocity). Writes into `out`.
