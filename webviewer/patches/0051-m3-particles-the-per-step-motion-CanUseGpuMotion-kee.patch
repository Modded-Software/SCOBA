+ * emitter runs the per-step path, whose drag has no floor (StepEuler is
+ * this closed form, stepped).
  */
-export function displacement(out: Float32Array, t: number, vx: number, vy: number, vz: number, mass: number, drag: number, accelZ: number): Float32Array {
