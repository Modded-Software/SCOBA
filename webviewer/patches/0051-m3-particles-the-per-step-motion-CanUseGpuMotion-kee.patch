+++ b/src/viewer/handlers/m3/particlesystem.ts
@@ -13,6 +13,35 @@ const RANDOM_MASS = 0x4;
 const WORLD_SPACE = 0x8;
 /** flags bit: the emission area has a hollow middle. */
 const CUTOUT = 0x10;
+/**
+ * flags that move an emitter off the closed-form motion: sort, collide
+ * terrain, trailing particles, model particles, 0x10000000, and bit 31
+ * (WhiteoutFlakes CanUseGpuMotion, 0x10480003).
+ */
+const EULER_FLAGS = 0x10480003;
+const CPU_BOUNDS = 0x80000000;
+/** Particle types that read the ground every step: terrain, terrain direction. */
+const TERRAIN_TYPES = [5, 6];
+/** CanUseGpuMotion: wind, kill sphere and noise at or above this need steps. */
+const MOTION_GATE = 0.001;
+
+/**
+ * Whether the game moves this emitter's particles with the closed form
+ * (WhiteoutFlakes CanUseGpuMotion), decided once per emitter. Otherwise it
+ * steps them each frame, with the authored drag.
+ */
+export function canUseGpuMotion(e: ParticleEmitter): boolean {
+  return (
+    !TERRAIN_TYPES.includes(e.particleType) &&
+    e.forcesFallback === 0 &&
+    (e.flags & EULER_FLAGS) === 0 &&
+    (e.flags & CPU_BOUNDS) === 0 &&
+    e.windMultiplier < MOTION_GATE &&
+    e.killSphere < MOTION_GATE &&
+    e.noiseAmplitude < MOTION_GATE
+  );
+}
