+export function displacement(out: Float32Array, t: number, vx: number, vy: number, vz: number, mass: number, drag: number, accelZ: number, euler = false): Float32Array {
+  if (euler && drag / mass < FREE) {
+    out[0] = vx * t;
+    out[1] = vy * t;
+    out[2] = vz * t + 0.5 * accelZ * t * t;
+
+    return out;
+  }
+
+  const [d, invDrag] = dragLanes(drag, euler);
   const k = mass * invDrag;
   // Gravity enters negated: g = -accelZ, so a positive acceleration pulls up.
   const mgod = -accelZ * mass * invDrag;
@@ -103,9 +128,16 @@ export function displacement(out: Float32Array, t: number, vx: number, vy: numbe
  * A particle's velocity after `t` seconds: the other half of
  * CalculateDisplacementAndVelocity, (v0·drag + m·g)·invDrag·e − m·g·invDrag.
  */
-export function velocityAt(out: Float32Array, t: number, vx: number, vy: number, vz: number, mass: number, drag: number, accelZ: number): Float32Array {
-  const d = Math.max(DRAG_FLOOR, drag);
