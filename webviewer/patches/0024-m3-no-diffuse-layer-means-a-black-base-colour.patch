From ff5a4944809304f3c0e8d3e714bb0d6cf01f4684 Mon Sep 17 00:00:00 2001
From: workspace-agent <workspace.vm.agent@gmail.com>
Date: Sat, 21 Nov 2026 19:54:54 +0200
Subject: [PATCH 24/51] m3: no diffuse layer means a black base colour

A material without a diffuse layer shows only its specular and emissive, as WhiteoutFlakes m3_standard.slang (albedo starts at 0). The white base from the lighting patch lit such surfaces white and hid additive glows.
---
 src/viewer/handlers/m3/shaders/standard.frag.ts | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/src/viewer/handlers/m3/shaders/standard.frag.ts b/src/viewer/handlers/m3/shaders/standard.frag.ts
index 76939841..95193d98 100644
--- a/src/viewer/handlers/m3/shaders/standard.frag.ts
+++ b/src/viewer/handlers/m3/shaders/standard.frag.ts
@@ -20,8 +20,10 @@ void main() {
 
   float lambertFactor = max(dot(normal, normalize(v_lightDir)), 0.0);
 
-  // The diffuse is the base colour; with no diffuse layer the surface is white.
-  vec3 color = vec3(1.0);
+  // The diffuse is the base colour; with no diffuse layer it is black, so
+  // such a surface shows only its specular and emissive (WhiteoutFlakes
+  // m3_standard.slang: albedo starts at 0, an absent layer branches off).
+  vec3 color = vec3(0.0);
 
   if (u_diffuseLayerSettings.enabled) {
     color = computeLayerColor(u_diffuseMap, u_diffuseLayerSettings).rgb;
