+/** The displacement material an emitter draws with, or null. */
+export function particleDisplacement(model: M3Model, materialReferenceIndex: number): M3DisplacementMaterial | null {
+  const map = model.materialMaps[materialReferenceIndex];
+
+  if (!map || map.materialType !== MATERIAL_DISPLACEMENT) {
+    return null;
+  }
+
+  return model.displacementMaterials[map.materialIndex] || null;
+}
+
 /** Flipbook cell of a particle at `age`, as u, v offset and cell size (ParticleUv). */
 function cell(system: M3ParticleSystem, age: number, out: Float32Array): void {
   const e = system.emitter;
@@ -344,3 +357,48 @@ export function renderParticles(gl: WebGLRenderingContext, shader: Shader, buffe
     gl.depthMask(true);
   }
 }
+
+/**
+ * Draw the particles of emitters with a displacement material: each quad
+ * shows `sceneMap` (the frame so far, `width` x `height`) shifted along the
+ * material's normal map, the shift scaled by the particle's alpha.
+ * Call after everything else in the frame. Records the quads drawn.
+ */
+export function renderDisplacementParticles(gl: WebGLRenderingContext, shader: Shader, buffers: ParticleBuffers, camera: Camera, model: M3Model, systems: M3ParticleSystem[], instance: M3ModelInstance, sceneMap: WebGLTexture, width: number, height: number): void {
+  const attribs = shader.attribs;
+  const uniforms = shader.uniforms;
+  let ready = false;
+
+  for (const system of systems) {
+    const material = particleDisplacement(model, system.emitter.materialReferenceIndex);
+
+    if (!material || !system.live) {
+      continue;
+    }
+
+    if (!ready) {
+      shader.use();
+      gl.uniformMatrix4fv(uniforms['u_VP'], false, camera.viewProjectionMatrix);
+      gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, buffers.elementBuffer);
+      ready = true;
+    }
+
+    const quads = buildQuads(system, camera);
+
+    gl.bindBuffer(gl.ARRAY_BUFFER, buffers.vertexBuffer);
+    gl.bufferData(gl.ARRAY_BUFFER, vertices.subarray(0, quads * 4 * STRIDE), gl.DYNAMIC_DRAW);
+    gl.vertexAttribPointer(attribs['a_position'], 3, gl.FLOAT, false, STRIDE * 4, 0);
+    gl.vertexAttribPointer(attribs['a_uv'], 2, gl.FLOAT, false, STRIDE * 4, 12);
+    gl.vertexAttribPointer(attribs['a_color'], 4, gl.FLOAT, false, STRIDE * 4, 20);
+
+    // The layers take units 9 and 11; the frame copy takes unit 0.
+    material.bind(shader, instance.textureOverrides, instance);
+    gl.activeTexture(gl.TEXTURE0);
+    gl.bindTexture(gl.TEXTURE_2D, sceneMap);
+    gl.uniform1i(uniforms['u_sceneMap'], 0);
+    gl.uniform2f(uniforms['u_viewSize'], width, height);
+    gl.drawElements(gl.TRIANGLES, quads * 6, gl.UNSIGNED_SHORT, 0);
+    material.unbind(shader);
+    system.quads = quads;
+  }
+}
diff --git a/src/viewer/handlers/m3/shaders/particledisplacement.frag.ts b/src/viewer/handlers/m3/shaders/particledisplacement.frag.ts
new file mode 100644
index 00000000..de0041fe
--- /dev/null
+++ b/src/viewer/handlers/m3/shaders/particledisplacement.frag.ts
@@ -0,0 +1,40 @@
+import precision from '../../shaders/precision.glsl';
+import layers from './layers.glsl';
+
+// A displacement particle (heat haze, shock rings): like displacement.frag,
+// the quad shows the frame behind it shifted along the normal map, and the
+// shift fades with the particle's alpha (its colour curve over the life).
+const shader = `
+${precision}
+
+${layers}
+
+uniform sampler2D u_sceneMap;
+uniform vec2 u_viewSize;
+uniform float u_strength;
+
+void main() {
+  vec2 bend = vec2(0.0);
+
+  if (u_normalLayerSettings.enabled) {
+    vec4 texel = texture2D(u_normalMap, getUV(u_normalLayerSettings));
+
+    bend = 2.0 * texel.wy - 1.0;
+  }
+
+  float strength = u_strength * v_vertexColor.a;
+
+  if (u_alphaMaskLayerSettings.enabled) {
+    vec4 s = computeLayerColor(u_alphaMaskMap, u_alphaMaskLayerSettings);
+
+    strength *= u_alphaMaskLayerSettings.channels == CHANNELSELECT_RGB ? s.r : s.a;
+  }
+
+  vec2 shift = bend * strength * (u_viewSize.y / 1080.0) / u_viewSize;
+  vec2 uv = gl_FragCoord.xy / u_viewSize + shift;
+
+  gl_FragColor = vec4(texture2D(u_sceneMap, uv).rgb, 1.0);
+}
+`;
+
+export default shader;
