 /** Corner offsets: x, y (the billboard axes), in triangle-strip order of the quad. */
 const CORNERS = [[-1, -1], [-1, 1], [1, 1], [1, -1]];
 const MATERIAL_STANDARD = 1;
+const MATERIAL_DISPLACEMENT = 2;
 /** Layers a particle draws with: diffuse, emissive, emissive 2, alpha mask, alpha mask 2. */
