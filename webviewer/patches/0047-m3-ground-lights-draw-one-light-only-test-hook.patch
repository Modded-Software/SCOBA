   /** Draw spot lights on the ground (tests compare frames with and without). */
   groundLightsEnabled: boolean;
+  /** Draw only this light (index into model.lights); -1 draws all. For the tests. */
+  groundLightOnly: number;
   /** One light's state now (for the tests). */
   groundLight: typeof groundLight;
 }
@@ -77,7 +79,7 @@ export default {
     const particleBuffers = createParticleBuffers(gl);
     const groundLightShader = webgl.createShader(groundLightVert, groundLightFrag);
     const groundLightBuffer = <WebGLBuffer>gl.createBuffer();
-    const handlerData: M3HandlerObject = { standardShaders, displacementShaders, particleShader, particleDisplacementShader, particleBuffers, particleQuad, particleMotion, particlesEnabled: true, groundLightShader, groundLightBuffer, groundLightsEnabled: true, groundLight };
+    const handlerData: M3HandlerObject = { standardShaders, displacementShaders, particleShader, particleDisplacementShader, particleBuffers, particleQuad, particleMotion, particlesEnabled: true, groundLightShader, groundLightBuffer, groundLightsEnabled: true, groundLightOnly: -1, groundLight };
 
     viewer.sharedCache.set('m3', handlerData);
   },
