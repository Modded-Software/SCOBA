From: workspace-agent <workspace.vm.agent@gmail.com>
Date: Mon, 23 Nov 2026 09:24:31 +0200
Subject: [PATCH 47/51] m3 ground lights: draw one light only (test hook)

groundLightOnly: an index into model.lights, -1 for all.

Known defects:
- None new.
---
 src/viewer/handlers/m3/groundlight.ts   | 4 ++--
 src/viewer/handlers/m3/handler.ts       | 4 +++-
 src/viewer/handlers/m3/modelinstance.ts | 2 +-
 3 files changed, 6 insertions(+), 4 deletions(-)

diff --git a/src/viewer/handlers/m3/groundlight.ts b/src/viewer/handlers/m3/groundlight.ts
index 9831c242..8a65d634 100644
--- a/src/viewer/handlers/m3/groundlight.ts
+++ b/src/viewer/handlers/m3/groundlight.ts
@@ -80,9 +80,9 @@ export function groundLight(instance: M3ModelInstance, light: Light): GroundLigh
 const quad = new Float32Array(12);
 
 /** Add each spot light of the instance onto the ground plane. */
-export function renderGroundLights(gl: WebGLRenderingContext, shader: Shader, buffer: WebGLBuffer, camera: Camera, instance: M3ModelInstance): void {
+export function renderGroundLights(gl: WebGLRenderingContext, shader: Shader, buffer: WebGLBuffer, camera: Camera, instance: M3ModelInstance, only = -1): void {
   const model = <M3Model>instance.model;
-  const spots = model.lights.filter((l) => l.lightType === SPOT);
+  const spots = model.lights.filter((l, i) => l.lightType === SPOT && (only < 0 || i === only));
 
   if (!spots.length) {
     return;
