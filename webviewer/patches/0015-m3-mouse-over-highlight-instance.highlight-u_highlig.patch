From 70e92ffcdb90c428fd3b3c7d8ebae50f38331739 Mon Sep 17 00:00:00 2001
From: workspace-agent <workspace.vm.agent@gmail.com>
Date: Sat, 21 Nov 2026 14:33:28 +0200
Subject: [PATCH 15/17] m3: mouse-over highlight (instance.highlight,
 u_highlight)

---
 src/viewer/handlers/m3/modelinstance.ts         | 3 +++
 src/viewer/handlers/m3/shaders/standard.frag.ts | 5 +++++
 2 files changed, 8 insertions(+)

diff --git a/src/viewer/handlers/m3/modelinstance.ts b/src/viewer/handlers/m3/modelinstance.ts
index 3889de73..788e590a 100644
--- a/src/viewer/handlers/m3/modelinstance.ts
+++ b/src/viewer/handlers/m3/modelinstance.ts
@@ -18,6 +18,8 @@ export default class M3ModelInstance extends ModelInstance {
   skeleton: M3Skeleton | null = null;
   teamColor = 0;
   vertexColor = new Float32Array([1, 1, 1, 1]);
+  /** Mouse-over highlight, 0 (none) to 1. */
+  highlight = 0;
   sequence = -1;
   frame = 0;
   sequenceLoopMode = 0;
@@ -124,6 +126,7 @@ export default class M3ModelInstance extends ModelInstance {
 
       gl.uniform1f(uniforms['u_teamColor'], this.teamColor);
       gl.uniform4fv(uniforms['u_vertexColor'], this.vertexColor);
+      gl.uniform1f(uniforms['u_highlight'], this.highlight);
 
       gl.uniformMatrix4fv(uniforms['u_VP'], false, camera.viewProjectionMatrix);
 
diff --git a/src/viewer/handlers/m3/shaders/standard.frag.ts b/src/viewer/handlers/m3/shaders/standard.frag.ts
index 1d02021c..ebff9082 100644
--- a/src/viewer/handlers/m3/shaders/standard.frag.ts
+++ b/src/viewer/handlers/m3/shaders/standard.frag.ts
@@ -6,6 +6,9 @@ ${precision}
 
 ${layers}
 
+// Mouse-over highlight, 0 to 1: the lit colour is brightened.
+uniform float u_highlight;
+
 void main() {
   // Lighting runs in tangent space: v_lightDir and v_halfVec are in it, and
   // a surface with no normal map faces straight out, (0, 0, 1).
@@ -84,6 +87,8 @@ void main() {
     alpha *= computeLayerColor(u_alphaMask2Map, u_alphaMask2LayerSettings).a;
   }
 
+  final += (final * 0.5 + vec3(0.06)) * u_highlight;
+
   gl_FragColor = vec4(final, alpha) * v_vertexColor;
 }
 `;
