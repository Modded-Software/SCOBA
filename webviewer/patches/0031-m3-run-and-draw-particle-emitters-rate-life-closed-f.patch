diff --git a/src/viewer/handlers/m3/particlemath.ts b/src/viewer/handlers/m3/particlemath.ts
new file mode 100644
index 00000000..72c257bd
--- /dev/null
+++ b/src/viewer/handlers/m3/particlemath.ts
@@ -0,0 +1,100 @@
+/**
+ * Particle math of the game, as WhiteoutFlakes has it
+ * (renderer/sc2/sc2_element_math.h): the value of a life curve, and the
+ * closed-form motion under drag and a vertical acceleration.
+ */
+
+/** Below this drag the game uses this drag, and 100 for its inverse (sc2_constants.h). */
+export const DRAG_FLOOR = 0.01;
+const INV_DRAG_UNDER_FLOOR = 100;
+
+const lerp = (a: number, b: number, t: number): number => a + (b - a) * t;
+const bezier = (a: number, b: number, c: number, t: number): number => {
+  const u = 1 - t;
+
+  return a * u * u + b * 2 * t * u + c * t * t;
+};
+const saturate = (x: number): number => Math.min(1, Math.max(0, x));
+const smooth = (a: number, b: number, s: number): number => (b - a) * (s * s) * (s * -2 + 3) + a;
+
+/**
+ * One scalar life curve: start, middle and end value, at `age` 0 to 1.
+ * `mode`: 0 linear, 1 smooth, 2 Bezier, 3 linear hold, 4 Bezier hold
+ * (InterpolateValue, the scalar form: size, alpha, rotation).
+ */
+export function curve(age: number, v0: number, v1: number, v2: number, mid: number, hold: number, mode: number): number {
+  if (mode === 2) {
+    return bezier(v0, v1, v2, age);
+  }
+
+  if (mode === 1) {
+    return age < mid ? smooth(v0, v1, age / mid) : smooth(v1, v2, (age - mid) / (1 - mid));
+  }
+
+  if (mode === 3) {
+    const t0 = mid - hold;
+    const t1 = mid + hold;
+
+    if (age < t0) {
+      return lerp(v0, v1, age / t0);
+    }
+
+    return age < t1 ? v1 : lerp(v1, v2, (age - t1) / (1 - t1));
+  }
+
+  if (mode === 4) {
+    const t0 = mid - hold;
+    const t1 = mid + hold;
+
+    return age < t0 ? bezier(v0, v1, v1, age / t0) : bezier(v1, v1, v2, saturate((age - t1) / (1 - t1)));
+  }
+
+  return age < mid ? lerp(v0, v1, age / mid) : lerp(v1, v2, (age - mid) / (1 - mid));
+}
+
+/**
+ * The colour form of the curve (InterpolateValue3): the same, except mode
+ * 1 smooths the lerp factor, and mode 4 bends towards the lerped keys with
+ * a flat middle.
+ */
+export function curve3(age: number, v0: number, v1: number, v2: number, mid: number, hold: number, mode: number): number {
+  if (mode === 1) {
+    const s = (x: number): number => x * x * (3 - 2 * x);
+
+    return age < mid ? lerp(v0, v1, s(saturate(age / mid))) : lerp(v1, v2, s(saturate((age - mid) / (1 - mid))));
+  }
+
+  if (mode === 4) {
+    const t0 = mid - hold;
+    const t1 = mid + hold;
+
+    if (age < t0) {
+      return bezier(v0, lerp(v0, v1, hold), v1, age / t0);
+    }
+
+    return age < t1 ? v1 : bezier(v1, lerp(v1, v2, hold), v2, (age - t1) / (1 - t1));
+  }
+
+  return curve(age, v0, v1, v2, mid, hold, mode);
+}
+
+/**
+ * How far a particle has moved after `t` seconds, per axis, from its start
+ * velocity, with drag and a vertical acceleration `accelZ`
+ * (CalculateDisplacementAndVelocity). Writes into `out`.
+ */
+export function displacement(out: Float32Array, t: number, vx: number, vy: number, vz: number, mass: number, drag: number, accelZ: number): Float32Array {
+  const d = Math.max(DRAG_FLOOR, drag);
+  const invDrag = drag < DRAG_FLOOR ? INV_DRAG_UNDER_FLOOR : 1 / drag;
+  const k = mass * invDrag;
+  // Gravity enters negated: g = -accelZ, so a positive acceleration pulls up.
+  const mgod = -accelZ * mass * invDrag;
+  const e = Math.exp((-d / mass) * t);
+  const reach = k * (1 - e);
+
+  out[0] = vx * reach;
+  out[1] = vy * reach;
+  out[2] = (vz + mgod) * reach - mgod * t;
+
+  return out;
+}
diff --git a/src/viewer/handlers/m3/particlerender.ts b/src/viewer/handlers/m3/particlerender.ts
new file mode 100644
index 00000000..96b307e2
--- /dev/null
+++ b/src/viewer/handlers/m3/particlerender.ts
@@ -0,0 +1,190 @@
+import Shader from '../../gl/shader';
+import Camera from '../../camera';
+import Texture from '../../texture';
+import type M3Model from './model';
+import type M3ParticleSystem from './particlesystem';
+import { M3StandardMaterial, STANDARD_MATERIAL_OFFSET } from './standardmaterial';
+
+/** Floats per vertex: position 3, uv 2, colour 4. */
+const STRIDE = 9;
+/** Quads per draw: the 16-bit element limit. */
+export const MAX_QUADS = 16384;
+/** Corner offsets: x, y (the billboard axes), in triangle-strip order of the quad. */
+const CORNERS = [[-1, -1], [-1, 1], [1, 1], [1, -1]];
+const MATERIAL_STANDARD = 1;
+
+const heap = new Float32Array(3);
+const look = new Float32Array(6);
+let vertices = new Float32Array(0);
+
+/** The GL objects all particle draws share. */
+export interface ParticleBuffers {
+  vertexBuffer: WebGLBuffer;
+  elementBuffer: WebGLBuffer;
+}
+
+export function createParticleBuffers(gl: WebGLRenderingContext): ParticleBuffers {
+  const elements = new Uint16Array(MAX_QUADS * 6);
+
+  for (let q = 0; q < MAX_QUADS; q++) {
+    const v = q * 4;
+
+    elements.set([v, v + 1, v + 2, v, v + 2, v + 3], q * 6);
+  }
+
+  const elementBuffer = <WebGLBuffer>gl.createBuffer();
+
+  gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, elementBuffer);
+  gl.bufferData(gl.ELEMENT_ARRAY_BUFFER, elements, gl.STATIC_DRAW);
+
+  return { vertexBuffer: <WebGLBuffer>gl.createBuffer(), elementBuffer };
+}
+
+/** The standard material an emitter draws with, or null. */
+export function particleMaterial(model: M3Model, materialReferenceIndex: number): M3StandardMaterial | null {
+  const map = model.materialMaps[materialReferenceIndex];
+
+  if (!map || map.materialType !== MATERIAL_STANDARD) {
+    return null;
+  }
+
+  return model.materials[1][map.materialIndex] || null;
+}
+
+/** Flipbook cell of a particle at `age`, as u, v offset and cell size (ParticleUv). */
+function cell(system: M3ParticleSystem, age: number, out: Float32Array): void {
+  const e = system.emitter;
+  const cols = e.numberOfColumns || 1;
+  const rows = e.numberOfRows || 1;
+
+  out[0] = 0;
+  out[1] = 0;
+
+  if (cols * rows <= 1) {
+    return;
+  }
+
+  const mid = e.relativePhase1Length;
+  let index;
+
+  if (age <= mid) {
+    index = e.phase1StartImageIndex + Math.floor((e.phase1EndImageIndex - e.phase1StartImageIndex) * (age / mid) + 0.5);
+  } else {
+    index = e.phase1EndImageIndex + Math.floor((e.phase2EndImageIndex - e.phase1EndImageIndex) * ((age - mid) / (1 - mid)) + 0.5);
+  }
+
+  out[0] = (index % cols) / cols;
+  out[1] = Math.floor(index / cols) / rows;
+}
+
+/**
+ * Write the quads of one emitter into the vertex array: camera-facing,
+ * turned by the particle's rotation about the view direction. Returns how
+ * many were written.
+ */
+function buildQuads(system: M3ParticleSystem, camera: Camera): number {
+  const n = Math.min(system.live, MAX_QUADS);
+
+  if (vertices.length < n * 4 * STRIDE) {
+    vertices = new Float32Array(Math.max(n, 64) * 4 * STRIDE * 2);
+  }
+
+  const e = system.emitter;
+  const right = camera.directionX;
+  const up = camera.directionY;
+  const scale = system.scale();
+  const cols = e.numberOfColumns || 1;
+  const rows = e.numberOfRows || 1;
+  const uv = new Float32Array(2);
+  let at = 0;
+
+  for (let i = 0; i < n; i++) {
+    const p = system.position(heap, i);
+
+    system.look(i, look);
+    cell(system, system.age(i), uv);
+
+    const half = look[0] * scale;
+    const c = Math.cos(look[1]);
+    const s = Math.sin(look[1]);
+
+    for (const [ox, oy] of CORNERS) {
+      // The corner on the camera axes, turned by the rotation.
+      const x = ox * c - oy * s;
+      const y = ox * s + oy * c;
+
+      vertices[at++] = p[0] + (right[0] * x + up[0] * y) * half;
+      vertices[at++] = p[1] + (right[1] * x + up[1] * y) * half;
+      vertices[at++] = p[2] + (right[2] * x + up[2] * y) * half;
+      vertices[at++] = uv[0] + (ox * 0.5 + 0.5) / cols;
+      vertices[at++] = uv[1] + (oy * -0.5 + 0.5) / rows;
+      vertices[at++] = look[2];
+      vertices[at++] = look[3];
+      vertices[at++] = look[4];
+      vertices[at++] = look[5];
+    }
+  }
+
+  return n;
+}
+
+/**
+ * Draw the particles of an instance's emitters, each in its material's
+ * blend mode. Records on each system how many quads it drew.
+ */
+export function renderParticles(gl: WebGLRenderingContext, shader: Shader, buffers: ParticleBuffers, camera: Camera, model: M3Model, systems: M3ParticleSystem[], textureOverrides: Map<number, Texture>): void {
+  const attribs = shader.attribs;
+  const uniforms = shader.uniforms;
+  let ready = false;
+
+  for (const system of systems) {
+    system.quads = 0;
+
+    const material = particleMaterial(model, system.emitter.materialReferenceIndex);
+
+    if (!material || !system.live) {
+      continue;
+    }
+
+    if (!ready) {
+      shader.use();
+      gl.uniformMatrix4fv(uniforms['u_VP'], false, camera.viewProjectionMatrix);
+      gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, buffers.elementBuffer);
+      ready = true;
+    }
+
+    const quads = buildQuads(system, camera);
+
+    gl.bindBuffer(gl.ARRAY_BUFFER, buffers.vertexBuffer);
+    gl.bufferData(gl.ARRAY_BUFFER, vertices.subarray(0, quads * 4 * STRIDE), gl.DYNAMIC_DRAW);
+    gl.vertexAttribPointer(attribs['a_position'], 3, gl.FLOAT, false, STRIDE * 4, 0);
+    gl.vertexAttribPointer(attribs['a_uv'], 2, gl.FLOAT, false, STRIDE * 4, 12);
+    gl.vertexAttribPointer(attribs['a_color'], 4, gl.FLOAT, false, STRIDE * 4, 20);
+
+    // The diffuse layer gives the picture; without one, the emissive layer.
+    const layer = [material.layers[0], material.layers[4]].find((l) => l.active && !l.constant && l.texture);
+    const texture = layer ? textureOverrides.get(material.index * STANDARD_MATERIAL_OFFSET + layer.index) || (<NonNullable<typeof layer.texture>>layer.texture).texture : null;
+
+    gl.uniform1f(uniforms['u_hasMap'], layer ? 1 : 0);
+    gl.uniform1f(uniforms['u_channels'], layer ? layer.colorChannels : 1);
+
+    if (layer) {
+      const m3Texture = <NonNullable<typeof layer.texture>>layer.texture;
+
+      model.viewer.webgl.bindTextureAndWrap(texture, 0, m3Texture.wrapS, m3Texture.wrapT);
+      gl.uniform1i(uniforms['u_map'], 0);
+    }
+
+    material.bindCommon();
+    // A quad faces the camera: no side to cull.
+    gl.disable(gl.CULL_FACE);
+    gl.drawElements(gl.TRIANGLES, quads * 6, gl.UNSIGNED_SHORT, 0);
+    system.quads = quads;
+  }
+
+  if (ready) {
+    gl.disable(gl.BLEND);
+    gl.enable(gl.CULL_FACE);
+    gl.depthMask(true);
+  }
+}
