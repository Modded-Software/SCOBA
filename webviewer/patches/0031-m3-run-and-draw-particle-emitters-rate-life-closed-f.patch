index 00000000..e3c9c030
--- /dev/null
+++ b/src/viewer/handlers/m3/particlesystem.ts
@@ -0,0 +1,484 @@
+import { mat4, vec3 } from 'gl-matrix';
+import ParticleEmitter from '../../../parsers/m3/particleemitter';
+import { AnimationReference } from '../../../parsers/m3/animationreference';
+import type M3ModelInstance from './modelinstance';
+import { curve, curve3, displacement } from './particlemath';
+
+/** additionalFlags bits (m3addon structures.xml, PAR_). */
+const RANDOM_SPEED = 0x1;
+const RANDOM_LIFESPAN = 0x2;
+const RANDOM_MASS = 0x4;
+const WORLD_SPACE = 0x8;
+/** flags bit: the emission area has a hollow middle. */
+const CUTOUT = 0x10;
+/** Emitters that hold no count of their own get this many. */
+const DEFAULT_MAX = 1000;
+const DEG = Math.PI / 180;
+
+/** Emission area shapes (WhiteoutFlakes SpawnShape). */
+const SHAPE = { point: 0, plane: 1, sphere: 2, box: 3, cylinder: 4, disc: 5 };
+
+const rand = (a: number, b: number): number => a + Math.random() * (b - a);
+const heap = new Float32Array(3);
+const heap3 = new Float32Array(3);
+const colorHeap = new Uint8Array(4);
+
+/**
+ * One particle emitter of one instance: its particles and their life.
+ * Particles of a world-space emitter keep world positions; the others
+ * keep emitter positions and follow the emitter.
+ */
+export default class M3ParticleSystem {
+  instance: M3ModelInstance;
+  emitter: ParticleEmitter;
+  index: number;
+  max: number;
+  worldSpace: boolean;
+  /** The emitter's world matrix, from its bone, at the last update. */
+  matrix = mat4.create();
+  /** Where the emitter was at the update before, for births spread over a frame. */
+  lastOrigin = vec3.create();
+  hasLast = false;
+  /** Emitter clock, seconds. */
+  time = 0;
+  carry = 0;
+  live = 0;
+  spawned = 0;
+  dropped = 0;
+  rateMin = Infinity;
+  rateMax = -Infinity;
+  /** Sampled this update. */
+  rate = 0;
+  lifeMin = 0;
+  lifeMax = 0;
+  /** Quads built at the last render. */
+  quads = 0;
+  // Per particle, by slot.
+  serial: Int32Array;
+  birth: Float32Array;
+  life: Float32Array;
+  mass: Float32Array;
+  /** Start position and start velocity, 3 each. */
+  start: Float32Array;
+  velocity: Float32Array;
+  /** Start, middle, end size; start, middle, end rotation (radians). */
+  sizes: Float32Array;
+  rotations: Float32Array;
+  /** Start, middle, end colour, rgba 0 to 255. */
+  colors: Float32Array;
+  nextSerial = 0;
+
+  constructor(instance: M3ModelInstance, emitter: ParticleEmitter, index: number) {
+    this.instance = instance;
+    this.emitter = emitter;
+    this.index = index;
+    this.max = emitter.maxParticles > 0 ? emitter.maxParticles : DEFAULT_MAX;
+    this.worldSpace = !!(emitter.additionalFlags & WORLD_SPACE);
+
+    const n = this.max;
+
+    this.serial = new Int32Array(n);
+    this.birth = new Float32Array(n);
+    this.life = new Float32Array(n);
+    this.mass = new Float32Array(n);
+    this.start = new Float32Array(n * 3);
+    this.velocity = new Float32Array(n * 3);
+    this.sizes = new Float32Array(n * 3);
+    this.rotations = new Float32Array(n * 3);
+    this.colors = new Float32Array(n * 12);
+  }
+
+  value(ref: AnimationReference): number {
+    return (<NonNullable<M3ModelInstance['skeleton']>>this.instance.skeleton).getValue(ref, this.instance);
+  }
+
+  vector(ref: AnimationReference, out: Float32Array): Float32Array {
+    return (<NonNullable<M3ModelInstance['skeleton']>>this.instance.skeleton).getValue3(out, ref, this.instance);
+  }
+
+  color(ref: AnimationReference): Uint8Array {
+    const c = <Uint8Array>(<NonNullable<M3ModelInstance['skeleton']>>this.instance.skeleton).getValueUnsafe(ref, this.instance);
+
+    colorHeap.set(c);
+
+    return colorHeap;
+  }
+
+  /** The emitter's world matrix: its bone's, or the rest pose's when nothing plays. */
+  updateMatrix(): void {
+    const instance = this.instance;
+    const bone = this.emitter.boneIndex;
+    const nodes = (<NonNullable<M3ModelInstance['skeleton']>>instance.skeleton).nodes;
+
+    if (instance.sequence !== -1 && nodes[bone]) {
+      mat4.copy(this.matrix, <mat4>nodes[bone].worldMatrix);
+    } else {
+      instance.restBoneMatrix(this.matrix, bone);
+    }
+  }
+
+  /** The uniform scale of the emitter matrix: the length of its first column. */
+  scale(): number {
+    const m = this.matrix;
+
+    return Math.hypot(m[0], m[1], m[2]) || 1;
+  }
+
+  /** Lifespan range, sampled. */
+  updateLife(): void {
+    const e = this.emitter;
+    const l1 = this.value(e.lifespan1);
+
+    if (e.additionalFlags & RANDOM_LIFESPAN) {
+      const l2 = this.value(e.lifespan2);
+
+      this.lifeMin = Math.min(l1, l2);
+      this.lifeMax = Math.max(l1, l2);
+    } else {
+      this.lifeMin = this.lifeMax = l1;
+    }
+  }
+
+  /** Run the emitter for `dt` seconds: retire, then emit. */
+  update(dt: number): void {
+    const origin = heap3;
+
+    this.updateMatrix();
+    mat4.getTranslation(<vec3>origin, this.matrix);
+
+    if (!this.hasLast) {
+      vec3.copy(this.lastOrigin, <vec3>origin);
+      this.hasLast = true;
+    }
+
+    const t0 = this.time;
+
+    this.time += dt;
+    this.retire();
+    this.updateLife();
+
+    const rate = Math.max(0, this.value(this.emitter.emissionRate));
+
+    this.rate = rate;
+    this.rateMin = Math.min(this.rateMin, rate);
+    this.rateMax = Math.max(this.rateMax, rate);
+
+    this.carry += rate * dt;
+
+    const count = Math.floor(this.carry);
+
+    this.carry -= count;
+
+    for (let k = 1; k <= count; k++) {
+      this.spawn(t0 + (dt * k) / count, k / count, origin);
+    }
+
+    vec3.copy(this.lastOrigin, <vec3>origin);
+  }
+
+  /** Drop the particles past their life, keeping the living packed at the front. */
+  retire(): void {
+    const time = this.time;
+    let n = 0;
+
+    for (let i = 0; i < this.live; i++) {
+      if (time - this.birth[i] <= this.life[i]) {
+        if (n !== i) {
+          this.move(i, n);
+        }
+
+        n++;
+      }
+    }
+
+    this.live = n;
+  }
+
+  move(from: number, to: number): void {
+    this.serial[to] = this.serial[from];
+    this.birth[to] = this.birth[from];
+    this.life[to] = this.life[from];
+    this.mass[to] = this.mass[from];
+    this.start.copyWithin(to * 3, from * 3, from * 3 + 3);
+    this.velocity.copyWithin(to * 3, from * 3, from * 3 + 3);
+    this.sizes.copyWithin(to * 3, from * 3, from * 3 + 3);
+    this.rotations.copyWithin(to * 3, from * 3, from * 3 + 3);
+    this.colors.copyWithin(to * 12, from * 12, from * 12 + 12);
+  }
+
+  /** A start position in the emission area, in emitter space (SampleSpawnPosition). */
+  spawnPosition(out: Float32Array): void {
+    const e = this.emitter;
+    const shape = e.emissionAreaType;
+    const size = this.vector(e.emissionAreaSize, heap);
+    const sx = size[0];
+    const sy = size[1];
+    const sz = size[2];
+    const cutout = !!(e.flags & CUTOUT);
+    const radius = (): number => (cutout ? rand(this.value(e.emissionAreaCutoutRadius), this.value(e.emissionAreaRadius)) : Math.random() * this.value(e.emissionAreaRadius));
+
+    out[0] = out[1] = out[2] = 0;
+
+    if (shape === SHAPE.plane) {
+      out[0] = rand(-sx / 2, sx / 2);
+      out[1] = rand(-sy / 2, sy / 2);
+    } else if (shape === SHAPE.sphere) {
+      const r = radius();
+      const w = rand(-1, 1);
+      const az = Math.random() * 2 * Math.PI;
+      const ring = r * Math.sqrt(1 - w * w);
+
+      out[0] = ring * Math.sin(az);
+      out[1] = ring * Math.cos(az);
+      out[2] = r * w;
+    } else if (shape === SHAPE.box) {
+      out[0] = rand(-sx / 2, sx / 2);
+      out[1] = rand(-sy / 2, sy / 2);
+      out[2] = rand(-sz / 2, sz / 2);
+
+      if (cutout) {
+        const inner = this.vector(e.emissionAreaCutoutSize, heap);
+        const axis = Math.floor(Math.random() * 3);
+        const outer = [sx, sy, sz][axis];
+        const v = rand(-(outer - inner[axis]) / 2, (outer - inner[axis]) / 2);
+
+        out[axis] = v >= 0 ? v + inner[axis] / 2 : v - inner[axis] / 2;
+      }
+    } else if (shape === SHAPE.cylinder || shape === SHAPE.disc) {
+      const r = radius();
+      const z = shape === SHAPE.cylinder ? sz * (Math.random() - 0.5) : 0;
+      const th = Math.random() * 2 * Math.PI;
+
+      out[0] = r * Math.cos(th);
+      out[1] = r * Math.sin(th);
+      out[2] = z;
+    }
+  }
+
+  /** The farthest a start position can be from the emitter, in emitter units. */
+  areaReach(): number {
+    const e = this.emitter;
+    const s = this.vector(e.emissionAreaSize, heap);
+    const r = this.value(e.emissionAreaRadius);
+
+    switch (e.emissionAreaType) {
+      case SHAPE.plane: return Math.hypot(s[0], s[1]) / 2;
+      case SHAPE.sphere: case SHAPE.disc: return r;
+      case SHAPE.box: return Math.hypot(s[0], s[1], s[2]) / 2;
+      case SHAPE.cylinder: return Math.hypot(r, s[2] / 2);
+      default: return 0;
+    }
+  }
+
+  /** The farthest speed a particle can start with. */
+  topSpeed(): number {
+    const e = this.emitter;
+    const s1 = Math.abs(this.value(e.emissionSpeed1));
+
+    return e.additionalFlags & RANDOM_SPEED ? Math.max(s1, Math.abs(this.value(e.emissionSpeed2))) : s1;
+  }
+
+  /** A start velocity, in emitter space (SampleSpawnVelocity). */
+  spawnVelocity(out: Float32Array, position: Float32Array): void {
+    const e = this.emitter;
+    const s1 = this.value(e.emissionSpeed1);
+    const speed = e.additionalFlags & RANDOM_SPEED ? rand(s1, this.value(e.emissionSpeed2)) : s1;
+    const type = e.emissionType;
+
+    if (type === 1 || type === 2) {
+      // Radial: away from the centre; axis: up or down the z axis.
+      const len = Math.hypot(position[0], position[1], position[2]);
+
+      if (type === 2) {
+        out[0] = out[1] = 0;
+        out[2] = position[2] >= 0 ? 1 : -1;
+      } else if (len > 0) {
+        out[0] = position[0] / len;
+        out[1] = position[1] / len;
+        out[2] = position[2] / len;
+      } else {
+        out[0] = out[1] = out[2] = 0;
+      }
+    } else if (type === 3) {
+      const w = rand(-1, 1);
+      const az = Math.random() * 2 * Math.PI;
+      const ring = Math.sqrt(1 - w * w);
+
+      out[0] = ring * Math.sin(az);
+      out[1] = ring * Math.cos(az);
+      out[2] = w;
+    } else {
+      // The cone: yaw and pitch in degrees, spreads in radians.
+      const a = this.value(e.emissionAngleX) * DEG;
+      const b = this.value(e.emissionAngleY) * DEG;
+      const horizontal = this.value(e.emissionSpreadX);
+      const vertical = this.value(e.emissionSpreadY);
+      const h = rand(Math.PI - horizontal, Math.PI + horizontal);
+      const v = rand(-vertical, vertical);
+      const cv = Math.cos(v);
+      const sv = Math.sin(v);
+
+      out[0] = cv * Math.sin(h - b);
+      out[1] = Math.sin(a) * cv * Math.cos(h - b) + Math.cos(a) * sv;
+      out[2] = Math.sin(a) * sv - Math.cos(a) * cv * Math.cos(h - b);
+    }
+
+    out[0] *= speed;
+    out[1] *= speed;
+    out[2] *= speed;
+  }
+
+  /** One birth at emitter time `birth`, `along` (0 to 1) the way from the last origin. */
+  spawn(birth: number, along: number, origin: Float32Array): void {
+    if (this.live >= this.max) {
+      this.dropped++;
+
+      return;
+    }
+
+    const e = this.emitter;
+    const i = this.live++;
+    const p = this.start.subarray(i * 3, i * 3 + 3);
+    const v = this.velocity.subarray(i * 3, i * 3 + 3);
+
+    this.spawned++;
+    this.serial[i] = this.nextSerial++;
+    this.birth[i] = birth;
+    this.life[i] = rand(this.lifeMin, this.lifeMax);
+    this.mass[i] = e.additionalFlags & RANDOM_MASS ? rand(e.mass, e.mass2) : e.mass;
+
+    this.spawnPosition(p);
+    this.spawnVelocity(v, p);
+
+    if (this.worldSpace) {
+      const m = this.matrix;
+      const last = this.lastOrigin;
+
+      vec3.transformMat3(<vec3>p, <vec3>p, mat3Of(m));
+      vec3.transformMat3(<vec3>v, <vec3>v, mat3Of(m));
+
+      for (let k = 0; k < 3; k++) {
+        p[k] += last[k] + (origin[k] - last[k]) * along;
+      }
+    }
+
+    this.sampleLook(i);
+  }
+
+  /** Size, rotation and colour keys of a new particle (SampleSize, SampleRotation, SampleColor). */
+  sampleLook(i: number): void {
+    const e = this.emitter;
+    const sizes = this.sizes;
+    const s1 = this.vector(e.particleSizes1, heap);
+    const t = Math.random();
+
+    sizes.set(s1, i * 3);
+
+    if (e.randomizeWithParticleSizes2) {
+      const s2 = this.vector(e.particleSizes2, heap);
+
+      for (let k = 0; k < 3; k++) {
+        sizes[i * 3 + k] += t * (s2[k] - sizes[i * 3 + k]);
+      }
+    }
+
+    const rotations = this.rotations;
+
+    rotations.set(this.vector(e.rotationValues1, heap), i * 3);
+
+    if (e.randomizeWithRotationValues2) {
+      const r2 = this.vector(e.rotationValues2, heap);
+
+      for (let k = 0; k < 3; k++) {
+        rotations[i * 3 + k] = rand(rotations[i * 3 + k], r2[k]);
+      }
+    }
+
+    const keys = [e.initialColor1, e.middleColor1, e.finalColor1];
+    const randomKeys = [e.initialColor2, e.middleColor2, e.finalColor2];
+    const colors = this.colors;
+
+    for (let n = 0; n < 3; n++) {
+      // Stored b, g, r, a. One integer lerp factor per key, 0 to 255.
+      const c = this.color(keys[n]);
+      const base = [c[2], c[1], c[0], c[3]];
+
+      if (e.randomizeWithColor2) {
+        const r = this.color(randomKeys[n]);
+        const other = [r[2], r[1], r[0], r[3]];
+        const f = Math.floor(Math.random() * 256);
+
+        for (let k = 0; k < 4; k++) {
+          base[k] += (f * (other[k] - base[k])) >> 8;
+        }
+      }
+
+      colors.set(base, i * 12 + n * 4);
+    }
+  }
+
+  /**
+   * A particle's world position now. For the tests and the quads.
+   * `out` gets x, y, z.
+   */
+  position(out: Float32Array, i: number): Float32Array {
+    const e = this.emitter;
+    const v = this.velocity;
+    const age = this.time - this.birth[i];
+
+    displacement(out, age, v[i * 3], v[i * 3 + 1], v[i * 3 + 2], this.mass[i], e.drag, e.zAcceleration);
+
+    for (let k = 0; k < 3; k++) {
+      out[k] += this.start[i * 3 + k];
+    }
+
+    if (!this.worldSpace) {
+      vec3.transformMat4(<vec3>out, <vec3>out, this.matrix);
+    }
+
+    return out;
+  }
+
+  /** Age 0 to 1 of particle `i`. */
+  age(i: number): number {
+    return Math.min(1, Math.max(0, (this.time - this.birth[i]) / this.life[i]));
+  }
+
+  /** Half size, rotation and rgba (0 to 1) of particle `i` now. */
+  look(i: number, out: Float32Array): void {
+    const e = this.emitter;
+    const age = this.age(i);
+    const s = this.sizes;
+    const r = this.rotations;
+    const c = this.colors;
+    const m = e.middles;
+    const h = e.holds;
+    const o = i * 12;
+
+    out[0] = curve(age, s[i * 3], s[i * 3 + 1], s[i * 3 + 2], m[0], h[0], e.sizeSmoothingType) * 0.5;
+    out[1] = curve(age, r[i * 3], r[i * 3 + 1], r[i * 3 + 2], m[3], h[3], e.rotationSmoothingType);
+
+    for (let k = 0; k < 3; k++) {
+      out[2 + k] = curve3(age, c[o + k], c[o + 4 + k], c[o + 8 + k], m[1], h[1], e.colorSmoothingType) / 255;
+    }
+
+    out[5] = curve(age, c[o + 3], c[o + 7], c[o + 11], m[2], h[2], e.colorSmoothingType) / 255;
+  }
+}
+
+const mat3Heap = new Float32Array(9);
+
+/** The upper 3x3 of a 4x4 matrix. */
+function mat3Of(m: mat4): Float32Array {
+  mat3Heap[0] = m[0];
+  mat3Heap[1] = m[1];
+  mat3Heap[2] = m[2];
+  mat3Heap[3] = m[4];
+  mat3Heap[4] = m[5];
+  mat3Heap[5] = m[6];
+  mat3Heap[6] = m[8];
+  mat3Heap[7] = m[9];
+  mat3Heap[8] = m[10];
+
+  return mat3Heap;
+}
diff --git a/src/viewer/handlers/m3/shaders/particle.frag.ts b/src/viewer/handlers/m3/shaders/particle.frag.ts
new file mode 100644
index 00000000..cbb4a220
--- /dev/null
+++ b/src/viewer/handlers/m3/shaders/particle.frag.ts
@@ -0,0 +1,31 @@
+import precision from '../../shaders/precision.glsl';
+
+// A particle: its material's colour texture times the particle colour.
+// A material without a texture layer draws the particle colour alone.
+// u_channels 1: the texture has alpha (RGBA); otherwise its alpha is 1.
+const shader = `
+${precision}
+
+uniform sampler2D u_map;
+uniform float u_hasMap;
+uniform float u_channels;
+
+varying vec2 v_uv;
+varying vec4 v_color;
+
+void main() {
+  vec4 texel = vec4(1.0);
+
+  if (u_hasMap > 0.5) {
+    texel = texture2D(u_map, v_uv);
+
+    if (u_channels != 1.0) {
+      texel.a = 1.0;
+    }
+  }
+
+  gl_FragColor = texel * v_color;
+}
+`;
+
+export default shader;
diff --git a/src/viewer/handlers/m3/shaders/particle.vert.ts b/src/viewer/handlers/m3/shaders/particle.vert.ts
new file mode 100644
index 00000000..910e10c0
--- /dev/null
+++ b/src/viewer/handlers/m3/shaders/particle.vert.ts
@@ -0,0 +1,19 @@
+// Particle quads: built on the CPU in world space (particlerender.ts).
+const shader = `
+uniform mat4 u_VP;
+
+attribute vec3 a_position;
+attribute vec2 a_uv;
+attribute vec4 a_color;
+
+varying vec2 v_uv;
+varying vec4 v_color;
+
+void main() {
+  v_uv = a_uv;
+  v_color = a_color;
+  gl_Position = u_VP * vec4(a_position, 1.0);
+}
+`;
+
+export default shader;
