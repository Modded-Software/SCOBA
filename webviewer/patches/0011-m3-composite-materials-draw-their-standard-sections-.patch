+    // section order. Their alpha factors are not applied.
+    const composites = model.materials[2].list(<CompositeMaterial[]>[]);
+
     for (const batch of div.batches.list(<Batch[]>[])) {
-      const regionId = batch.regionIndex;
+      const region = this.regions[batch.regionIndex];
