diff --git a/src/parsers/m3/compositematerial.ts b/src/parsers/m3/compositematerial.ts
new file mode 100644
index 00000000..88d0adcb
--- /dev/null
+++ b/src/parsers/m3/compositematerial.ts
@@ -0,0 +1,38 @@
+import BinaryStream from '../../common/binarystream';
+import IndexEntry from './indexentry';
+import Reference from './reference';
+import { Float32AnimationReference } from './animationreference';
+
+/**
+ * A section of a composite material (CMS_ version 0, 24 bytes): one
+ * material, drawn with an alpha factor.
+ */
+export class CompositeMaterialSection {
+  version = -1;
+  materialReferenceIndex = -1;
+  alphaFactor = new Float32AnimationReference();
+
+  load(stream: BinaryStream, version: number, _index: IndexEntry[]): void {
+    this.version = version;
+    this.materialReferenceIndex = stream.readUint32();
+    this.alphaFactor.load(stream);
+  }
+}
+
+/**
+ * A composite material (CMP_ version 2, 28 bytes): materials drawn one over
+ * the other, in section order.
+ */
+export default class CompositeMaterial {
+  version = -1;
+  name = new Reference();
+  unknown0 = 0;
+  sections = new Reference();
+
+  load(stream: BinaryStream, version: number, index: IndexEntry[]): void {
+    this.version = version;
+    this.name.load(stream, index);
+    this.unknown0 = stream.readUint32();
+    this.sections.load(stream, index);
+  }
+}
