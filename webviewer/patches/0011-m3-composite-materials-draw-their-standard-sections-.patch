-      if (materialMap.materialType === 1) {
-        this.batches.push(new M3Batch(this.regions[regionId], this.materials[1][materialMap.materialIndex]));
+      if (materialMap.materialType === MATERIAL_STANDARD) {
+        this.batches.push(new M3Batch(region, this.materials[1][materialMap.materialIndex]));
+      } else if (materialMap.materialType === MATERIAL_COMPOSITE) {
