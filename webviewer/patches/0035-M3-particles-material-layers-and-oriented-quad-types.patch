-    if (u_channels != 1.0) {
-      texel.a = 1.0;
+    if (u_emissiveLayerSettings.op == LAYEROP_MOD || u_emissiveLayerSettings.op == LAYEROP_MOD2X || u_emissiveLayerSettings.op == LAYEROP_LERP) {
+      final = combineLayerColor(tempColor, final, u_emissiveLayerSettings);
