+/** Particle types (WhiteoutFlakes InstanceType). The others draw as billboards. */
+const TYPE = { tail: 1, terrain: 5, emitter: 7, pinned: 9, trail: 10 };
+/** PAR_ flags bit: the tail keeps its authored length (fixLengthTailParts). */
+const FIXED_TAIL = 0x100000;
