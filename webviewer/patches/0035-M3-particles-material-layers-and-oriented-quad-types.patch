- * Write the quads of one emitter into the vertex array: camera-facing,
- * turned by the particle's rotation about the view direction. Returns how
- * many were written.
+ * The quad's two axes and its half extents along them, by particle type
+ * (WhiteoutFlakes BuildQuad). `right` and `up` get unit axes; `out` gets
+ * the half width, the half length, and 1 if the quad turns by the rotation.
+ * Trail and Pinned move the centre `p`.
  */
+function frame(system: M3ParticleSystem, i: number, camera: Camera, p: Float32Array, half: number, right: Float32Array, up: Float32Array, out: Float32Array): void {
+  const e = system.emitter;
+  const type = e.particleType;
+  const view = camera.directionZ;
+
+  out[0] = half;
+  out[1] = half;
+  out[2] = 1;
+
+  if (type === TYPE.tail || type === TYPE.trail) {
+    // Along the travel: the length is the tail times the speed, at least the tail.
+    const speed = worldVelocity(system, i, up);
+    const tail = e.lengthWidthRatio;
+
+    normalize(up);
+    normalize(cross(right, view, up));
+    out[1] = half * (e.flags & FIXED_TAIL ? tail : Math.max(tail, speed * tail));
+    out[2] = 0;
+
+    // A trail starts at the particle and reaches back.
+    if (type === TYPE.trail) {
+      for (let k = 0; k < 3; k++) {
+        p[k] -= up[k] * out[1];
+      }
+    }
+  } else if (type === TYPE.pinned) {
+    // From the birth point to the particle, its width the size.
+    const origin = worldStart(system, i, axisA);
+
+    for (let k = 0; k < 3; k++) {
+      up[k] = p[k] - origin[k];
+    }
+
+    const length = Math.hypot(up[0], up[1], up[2]);
+
+    if (length > 0) {
+      normalize(up);
+    } else {
+      up.set([1, 0, 0]);
+    }
+
+    normalize(cross(right, view, up));
+
+    for (let k = 0; k < 3; k++) {
+      p[k] = (p[k] + origin[k]) * 0.5;
+    }
+
+    out[0] = half / system.scale();
+    out[1] = length * 0.5;
+    out[2] = 0;
+  } else if (type === TYPE.terrain) {
+    // Flat on the ground plane.
+    right.set([0, -1, 0]);
+    up.set([1, 0, 0]);
+  } else if (type === TYPE.emitter) {
+    // On the emitter's own x and y axes.
+    const m = system.matrix;
+
+    right.set([m[0], m[1], m[2]]);
+    up.set([m[4], m[5], m[6]]);
+    normalize(right);
+    normalize(up);
+  } else {
+    right.set(camera.directionX);
+    up.set(camera.directionY);
+  }
+}
