+/** A particle's velocity now, in world space, and its length before the turn into world space. */
+function worldVelocity(system: M3ParticleSystem, i: number, out: Float32Array): number {
+  const e = system.emitter;
+  const v = system.velocity;
+
+  velocityAt(out, system.time - system.birth[i], v[i * 3], v[i * 3 + 1], v[i * 3 + 2], system.mass[i], e.drag, e.zAcceleration);
+
+  const speed = Math.hypot(out[0], out[1], out[2]);
+
+  if (!system.worldSpace) {
+    const m = system.matrix;
+    const [x, y, z] = out;
+
+    out[0] = m[0] * x + m[4] * y + m[8] * z;
+    out[1] = m[1] * x + m[5] * y + m[9] * z;
+    out[2] = m[2] * x + m[6] * y + m[10] * z;
+  }
+
+  return speed;
+}
+
+/** Where particle `i` was born, in world space. */
+function worldStart(system: M3ParticleSystem, i: number, out: Float32Array): Float32Array {
+  out.set(system.start.subarray(i * 3, i * 3 + 3));
+
+  if (!system.worldSpace) {
+    vec3.transformMat4(<vec3>out, <vec3>out, system.matrix);
+  }
