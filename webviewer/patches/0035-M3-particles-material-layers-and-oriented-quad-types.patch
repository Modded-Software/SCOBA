+  // The tail types do not turn.
+  const angle = extent[2] ? look[1] : 0;
+  const c = Math.cos(angle);
+  const s = Math.sin(angle);
+
+  for (let k = 0; k < 4; k++) {
+    const [ox, oy] = CORNERS[k];
+    const x = (ox * c - oy * s) * extent[0];
+    const y = (ox * s + oy * c) * extent[1];
