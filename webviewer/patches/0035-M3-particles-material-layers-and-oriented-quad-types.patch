+/**
+ * The four corners of particle `i` (x, y, z each, in CORNERS order), laid
+ * out by its particle type and turned by its rotation. Also fills `look`.
+ */
+export function particleQuad(system: M3ParticleSystem, i: number, camera: Camera, out: Float32Array): Float32Array {
+  const p = system.position(heap, i);
