+/**
+ * Particle `i`'s birth point in world space into `start`, and its speed
+ * before the turn into world space (what the tail rules read).
+ */
+export function particleMotion(system: M3ParticleSystem, i: number, start: Float32Array): number {
+  worldStart(system, i, start);
+
+  return worldVelocity(system, i, vel);
+}
