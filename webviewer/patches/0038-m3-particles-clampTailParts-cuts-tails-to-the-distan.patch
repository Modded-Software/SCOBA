+    const handlerData: M3HandlerObject = { standardShaders, displacementShaders, particleShader, particleDisplacementShader, particleBuffers, particleQuad, particleMotion, particlesEnabled: true };
 
     viewer.sharedCache.set('m3', handlerData);
