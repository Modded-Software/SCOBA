@@ -0,0 +1,65 @@
+import DisplacementMaterial from '../../../parsers/m3/displacementmaterial';
+import { Float32AnimationReference } from '../../../parsers/m3/animationreference';
+import Shader from '../../gl/shader';
+import Texture from '../../texture';
+import M3Model from './model';
+import M3Layer from './layer';
+import type M3ModelInstance from './modelinstance';
+
+/**
+ * Texture override keys: displacement materials come after every standard
+ * material (index * STANDARD_MATERIAL_OFFSET + layer stays unique).
+ */
+export const DISPLACEMENT_INDEX_BASE = 10000;
+
+/**
+ * An M3 displacement material: the surface shows the picture behind it,
+ * shifted along its normal map. The normal layer binds to the shader's
+ * normal uniforms; the strength layer to the alpha mask uniforms.
+ */
+export class M3DisplacementMaterial {
+  model: M3Model;
+  gl: WebGLRenderingContext;
+  index: number;
+  name: string;
+  priority: number;
+  strengthFactor: Float32AnimationReference;
+  normalLayer: M3Layer;
+  strengthLayer: M3Layer;
+
+  constructor(model: M3Model, index: number, material: DisplacementMaterial) {
+    this.model = model;
+    this.gl = model.viewer.gl;
+    this.index = DISPLACEMENT_INDEX_BASE + index;
+    this.name = <string>material.name.get();
+    this.priority = material.priority;
+    this.strengthFactor = material.strengthFactor;
+    this.normalLayer = new M3Layer(this, 0, material.normalLayer, 'normal', 2);
+    this.strengthLayer = new M3Layer(this, 1, material.strengthLayer, 'alphaMask', 2);
+  }
+
+  bind(shader: Shader, textureOverrides: Map<number, Texture>, instance: M3ModelInstance): void {
+    const gl = this.gl;
+    const skeleton = instance.skeleton;
+    const strength = skeleton ? skeleton.getValue(this.strengthFactor, instance) : <number>this.strengthFactor.initValue;
+
+    gl.uniform1f(shader.uniforms['u_strength'], strength);
+    // Two-sided, like the effects that use it; tested against depth, not written.
+    gl.disable(gl.BLEND);
+    gl.disable(gl.CULL_FACE);
+    gl.enable(gl.DEPTH_TEST);
+    gl.depthMask(false);
+
+    this.normalLayer.bind(shader, textureOverrides);
+    this.strengthLayer.bind(shader, textureOverrides);
+  }
+
+  unbind(shader: Shader): void {
+    const gl = this.gl;
+
+    gl.enable(gl.CULL_FACE);
+    gl.depthMask(true);
+    this.normalLayer.unbind(shader);
+    this.strengthLayer.unbind(shader);
+  }
+}
