diff --git a/src/viewer/handlers/m3/shaders/displacement.frag.ts b/src/viewer/handlers/m3/shaders/displacement.frag.ts
new file mode 100644
index 00000000..6f7df046
--- /dev/null
+++ b/src/viewer/handlers/m3/shaders/displacement.frag.ts
@@ -0,0 +1,42 @@
+import precision from '../../shaders/precision.glsl';
+import layers from './layers.glsl';
+
+// Displacement: the surface shows the picture behind it (u_sceneMap, a
+// copy of the frame drawn so far), shifted along the normal map. The shift
+// is u_strength pixels at a 1080 pixel high view, times the strength layer,
+// in the direction of the normal's tangent-space x and y.
+const shader = `
+${precision}
+
+${layers}
+
+uniform sampler2D u_sceneMap;
+uniform vec2 u_viewSize;
+uniform float u_strength;
+
+void main() {
+  vec2 bend = vec2(0.0);
+
+  if (u_normalLayerSettings.enabled) {
+    vec4 texel = texture2D(u_normalMap, getUV(u_normalLayerSettings));
+
+    bend = 2.0 * texel.wy - 1.0;
+  }
+
+  float strength = u_strength;
+
+  if (u_alphaMaskLayerSettings.enabled) {
+    vec4 s = computeLayerColor(u_alphaMaskMap, u_alphaMaskLayerSettings);
+
+    // One channel is spread over all four; RGB has no alpha.
+    strength *= u_alphaMaskLayerSettings.channels == CHANNELSELECT_RGB ? s.r : s.a;
+  }
+
+  vec2 shift = bend * strength * (u_viewSize.y / 1080.0) / u_viewSize;
+  vec2 uv = gl_FragCoord.xy / u_viewSize + shift;
+
+  gl_FragColor = vec4(texture2D(u_sceneMap, uv).rgb, 1.0);
+}
+`;
+
+export default shader;
