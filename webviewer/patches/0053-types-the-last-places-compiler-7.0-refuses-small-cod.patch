 import BillboardBehavior from '../../../parsers/m3/billboardbehavior';
 
 /**
@@ -133,7 +133,8 @@ const basisHeap = new Float32Array(9);
 const q = quat.create();
 const parentQ = quat.create();
 const local = mat4.create();
-const m3Heap = mat3.create();
+// A 3x3 matrix as nine floats. Every use fills all nine first.
+const m3Heap = new Float32Array(9);
 
 /** A rotation from rows: normalised first two, the third rebuilt (M3Node_GetWorldRotationQuat). */
 function rotationOf(out: quat, m: mat4 | Float32Array): quat {
diff --git a/src/viewer/skeletalnode.ts b/src/viewer/skeletalnode.ts
index 8f09470c..155ccb2a 100644
--- a/src/viewer/skeletalnode.ts
+++ b/src/viewer/skeletalnode.ts
@@ -64,7 +64,7 @@ export class SkeletalNode {
 
     this.localRotation[3] = 1;
 
-    this.localScale.fill(1);
+    vec3.set(this.localScale, 1, 1, 1);
 
     this.localMatrix[0] = 1;
     this.localMatrix[5] = 1;
diff --git a/src/viewer/viewer.ts b/src/viewer/viewer.ts
index fb1d397b..473db81f 100644
--- a/src/viewer/viewer.ts
+++ b/src/viewer/viewer.ts
@@ -299,7 +299,14 @@ export default class ModelViewer extends EventEmitter {
             const type = detectMime(actualSrc);
 
             if (type.length) {
-              return new ImageTexture(await blobToImage(new Blob([actualSrc.buffer], { type })), { viewer: this, fetchUrl, pathSolver });
+              const buffer = actualSrc.buffer;
+
+              // A Blob takes no shared memory.
+              if (!(buffer instanceof ArrayBuffer)) {
+                throw new Error('An image held in shared memory cannot be loaded');
+              }
+
+              return new ImageTexture(await blobToImage(new Blob([buffer], { type })), { viewer: this, fetchUrl, pathSolver });
             }
           }
 
