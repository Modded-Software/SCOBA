@@ -0,0 +1,128 @@
+import { mat4 } from 'gl-matrix';
+import Shader from '../../gl/shader';
+import Camera from '../../camera';
+import type Light from '../../../parsers/m3/light';
+import type M3ModelInstance from './modelinstance';
+import type M3Model from './model';
+
+/**
+ * Spot lights (LITE type 2) lighting the viewer's ground plane, z = 0. The
+ * scene has no terrain; the plane stands in for it, with one albedo. The
+ * light shines along its bone's -z axis; the hot spot and falloff are
+ * angles from that axis, in radians.
+ */
+export const SPOT = 2;
+/** The ground's diffuse reflectance (a viewer choice: there is no terrain texture). */
+export const GROUND_ALBEDO = 0.5;
+
+export interface GroundLight {
+  position: Float32Array;
+  direction: Float32Array;
+  color: Float32Array;
+  near: number;
+  far: number;
+  hotSpot: number;
+  falloff: number;
+  /** Where the axis meets the ground, or null when it points up. */
+  hit: Float32Array | null;
+}
+
+const matrix = mat4.create();
+
+/** One light's state now, in world space. */
+export function groundLight(instance: M3ModelInstance, light: Light): GroundLight {
+  const skeleton = <NonNullable<M3ModelInstance['skeleton']>>instance.skeleton;
+  const node = skeleton.nodes[light.boneIndex];
+
+  if (instance.sequence !== -1 && node) {
+    mat4.copy(matrix, <mat4>node.worldMatrix);
+  } else {
+    instance.restBoneMatrix(matrix, light.boneIndex);
+  }
+
+  const position = new Float32Array([matrix[12], matrix[13], matrix[14]]);
+  const direction = new Float32Array([-matrix[8], -matrix[9], -matrix[10]]);
+  const length = Math.hypot(direction[0], direction[1], direction[2]) || 1;
+
+  for (let k = 0; k < 3; k++) {
+    direction[k] /= length;
+  }
+
+  const color = new Float32Array(3);
+  const intensity = skeleton.getValue(light.lightIntensity, instance);
+
+  skeleton.getValue3(color, light.lightColor, instance);
+
+  for (let k = 0; k < 3; k++) {
+    color[k] *= intensity;
+  }
+
+  let hit = null;
+
+  if (direction[2] < 0 && position[2] > 0) {
+    const t = -position[2] / direction[2];
+
+    hit = new Float32Array([position[0] + direction[0] * t, position[1] + direction[1] * t, 0]);
+  }
+
+  return {
+    position,
+    direction,
+    color,
+    near: skeleton.getValue(light.attenuationNear, instance),
+    far: skeleton.getValue(light.attenuationFar, instance),
+    hotSpot: skeleton.getValue(light.hotSpot, instance),
+    falloff: skeleton.getValue(light.falloff, instance),
+    hit,
+  };
+}
+
+const quad = new Float32Array(12);
+
+/** Add each spot light of the instance onto the ground plane. */
+export function renderGroundLights(gl: WebGLRenderingContext, shader: Shader, buffer: WebGLBuffer, camera: Camera, instance: M3ModelInstance): void {
+  const model = <M3Model>instance.model;
+  const spots = model.lights.filter((l) => l.lightType === SPOT);
+
+  if (!spots.length) {
+    return;
+  }
+
+  const uniforms = shader.uniforms;
+
+  shader.use();
+  gl.uniformMatrix4fv(uniforms['u_VP'], false, camera.viewProjectionMatrix);
+  gl.uniform1f(uniforms['u_albedo'], GROUND_ALBEDO);
+  gl.enable(gl.DEPTH_TEST);
+  gl.depthFunc(gl.LEQUAL);
+  gl.depthMask(false);
+  gl.disable(gl.CULL_FACE);
+  gl.enable(gl.BLEND);
+  gl.blendFunc(gl.ONE, gl.ONE);
+  gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
+  gl.vertexAttribPointer(shader.attribs['a_position'], 3, gl.FLOAT, false, 12, 0);
+
+  for (const light of spots) {
+    const s = groundLight(instance, light);
+
+    // Nothing reaches the ground: above the far distance, or no colour.
+    if (s.position[2] >= s.far || s.far <= 0 || s.color[0] + s.color[1] + s.color[2] <= 0) {
+      continue;
+    }
+
+    // The plane within the far distance of the light, as one square.
+    const r = s.far;
+    const [x, y] = s.position;
+
+    quad.set([x - r, y - r, 0, x + r, y - r, 0, x - r, y + r, 0, x + r, y + r, 0]);
+    gl.bufferData(gl.ARRAY_BUFFER, quad, gl.DYNAMIC_DRAW);
+    gl.uniform3fv(uniforms['u_lightPos'], s.position);
+    gl.uniform3fv(uniforms['u_lightDir'], s.direction);
+    gl.uniform3fv(uniforms['u_lightColor'], s.color);
+    gl.uniform2f(uniforms['u_atten'], s.near, s.far);
+    gl.uniform2f(uniforms['u_cone'], Math.cos(s.hotSpot), Math.cos(Math.max(s.falloff, s.hotSpot + 1e-3)));
+    gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
+  }
+
+  gl.depthMask(true);
+}
