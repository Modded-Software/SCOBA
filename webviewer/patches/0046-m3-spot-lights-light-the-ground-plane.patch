diff --git a/src/viewer/handlers/m3/shaders/groundlight.frag.ts b/src/viewer/handlers/m3/shaders/groundlight.frag.ts
new file mode 100644
index 00000000..f99ce475
--- /dev/null
+++ b/src/viewer/handlers/m3/shaders/groundlight.frag.ts
@@ -0,0 +1,35 @@
+import precision from '../../shaders/precision.glsl';
+
+// One spot light on the ground plane (normal +z), added to the frame.
+// Distance: the squared window from attenuationNear to attenuationFar
+// (WhiteoutFlakes m3_deferred_light.slang, lighttypes.fx
+// ComputeLightAttenuation). Cone: full inside the hot spot, none past the
+// falloff, smooth between (angles from the axis). Times the ground albedo.
+const shader = `
+${precision}
+
+uniform vec3 u_lightPos;
+uniform vec3 u_lightDir;
+uniform vec3 u_lightColor;
+// near, far
+uniform vec2 u_atten;
+// cos(hot spot), cos(falloff)
+uniform vec2 u_cone;
+uniform float u_albedo;
+
+varying vec3 v_world;
+
+void main() {
+  vec3 toLight = u_lightPos - v_world;
+  float d = length(toLight);
+  float window = clamp((u_atten.y - d) / max(u_atten.y - u_atten.x, 1e-4), 0.0, 1.0);
+  vec3 l = toLight / max(d, 1e-4);
+  float ndl = max(l.z, 0.0);
+  float c = dot(-l, u_lightDir);
+  float spot = smoothstep(u_cone.y, u_cone.x, c);
+
+  gl_FragColor = vec4(u_lightColor * (u_albedo * ndl * window * window * spot), 1.0);
+}
+`;
+
+export default shader;
diff --git a/src/viewer/handlers/m3/shaders/groundlight.vert.ts b/src/viewer/handlers/m3/shaders/groundlight.vert.ts
new file mode 100644
index 00000000..5dd178de
--- /dev/null
+++ b/src/viewer/handlers/m3/shaders/groundlight.vert.ts
@@ -0,0 +1,15 @@
+// The ground under one light: world positions on the plane z = 0.
+const shader = `
+uniform mat4 u_VP;
+
+attribute vec3 a_position;
+
+varying vec3 v_world;
+
+void main() {
+  v_world = a_position;
+  gl_Position = u_VP * vec4(a_position, 1.0);
+}
+`;
+
+export default shader;
