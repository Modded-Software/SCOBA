index 8a65d634..c47ee32d 100644
--- a/src/viewer/handlers/m3/groundlight.ts
+++ b/src/viewer/handlers/m3/groundlight.ts
@@ -13,7 +13,7 @@ import type M3Model from './model';
  */
 export const SPOT = 2;
