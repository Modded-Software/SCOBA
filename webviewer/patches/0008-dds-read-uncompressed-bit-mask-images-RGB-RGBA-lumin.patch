@@ -101,6 +110,91 @@ export class DdsImage {
     }
   }
 
+  /**
+   * An uncompressed image: pixels of 8 to 32 bits with a bit mask per
+   * channel (DDPF_RGB, DDPF_LUMINANCE, DDPF_ALPHA). Every mipmap is decoded
+   * to 8-bit RGBA here. A channel without a mask reads 0, alpha reads 255.
+   */
+  loadUncompressed(bytes: Uint8Array, header: Int32Array): void {
+    const flags = header[20];
+
+    if (!(flags & (DDPF_RGB | DDPF_LUMINANCE | DDPF_ALPHA))) {
+      throw new Error(`Unsupported pixel format flags: 0x${(flags >>> 0).toString(16)}`);
+    }
+
+    const bitCount = header[22];
+
+    if (bitCount < 8 || bitCount > 32 || bitCount % 8 !== 0) {
+      throw new Error(`Unsupported bit count: ${bitCount}`);
+    }
+
+    const pixelBytes = bitCount / 8;
+    const luminance = (flags & DDPF_LUMINANCE) !== 0;
+    const hasAlpha = (flags & (DDPF_ALPHAPIXELS | DDPF_ALPHA)) !== 0;
+    const masks = [header[23] >>> 0, header[24] >>> 0, header[25] >>> 0, hasAlpha ? header[26] >>> 0 : 0];
+    const channels = masks.map((mask) => {
+      let shift = 0;
+
+      while (mask && !((mask >>> shift) & 1)) {
+        shift += 1;
+      }
+
+      return { mask, shift, max: mask ? mask >>> shift : 0 };
+    });
+
+    let mipmaps = 1;
+
+    if (header[2] & DDSD_MIPMAPCOUNT) {
+      mipmaps = Math.max(1, header[7]);
+    }
+
+    let width = header[4];
+    let height = header[3];
+    let offset = 128;
+
+    this.format = FORMAT_RGBA8;
+    this.width = width;
+    this.height = height;
+
+    for (let i = 0; i < mipmaps; i++) {
+      const count = width * height;
+      const end = offset + count * pixelBytes;
+
+      if (end > bytes.byteLength) {
+        throw new Error(`Mipmap ${i} (${width}x${height}) runs past the end of the file`);
+      }
+
+      const rgba = new Uint8Array(count * 4);
+
+      for (let p = 0, at = offset; p < count; p++, at += pixelBytes) {
+        let pixel = 0;
+
+        for (let b = pixelBytes - 1; b >= 0; b--) {
+          pixel = pixel * 256 + bytes[at + b];
+        }
+
+        for (let c = 0; c < 4; c++) {
+          const { mask, shift, max } = channels[c];
+
+          rgba[p * 4 + c] = mask ? Math.round((((pixel & mask) >>> shift) * 255) / max) : c === 3 ? 255 : 0;
+        }
+
+        if (luminance) {
+          rgba[p * 4 + 1] = rgba[p * 4];
+          rgba[p * 4 + 2] = rgba[p * 4];
+        }
+      }
+
+      this.mipmapWidths[i] = width;
+      this.mipmapHeights[i] = height;
+      this.mipmapDatas[i] = rgba;
+
+      offset = end;
+      width = Math.max(Math.floor(width / 2), 1);
+      height = Math.max(Math.floor(height / 2), 1);
+    }
+  }
+
   mipmaps(): number {
     return this.mipmapDatas.length;
   }
@@ -111,7 +205,7 @@ export class DdsImage {
     const data = this.mipmapDatas[level];
     let mipmap: Uint16Array | Uint8Array;
 
