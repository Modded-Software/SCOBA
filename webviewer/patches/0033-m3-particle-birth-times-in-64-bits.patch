From a473c30648625cd5041121fa48498afd1ffebc22 Mon Sep 17 00:00:00 2001
From: workspace-agent <workspace.vm.agent@gmail.com>
Date: Sun, 22 Nov 2026 21:40:32 +0200
Subject: [PATCH 33/56] m3: particle birth times in 64 bits

---
 src/viewer/handlers/m3/particlesystem.ts | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/src/viewer/handlers/m3/particlesystem.ts b/src/viewer/handlers/m3/particlesystem.ts
index e3c9c030..8105b6fb 100644
--- a/src/viewer/handlers/m3/particlesystem.ts
+++ b/src/viewer/handlers/m3/particlesystem.ts
@@ -55,7 +55,8 @@ export default class M3ParticleSystem {
   quads = 0;
   // Per particle, by slot.
   serial: Int32Array;
-  birth: Float32Array;
+  /** Birth times on the emitter clock: 64-bit like the clock, so a new particle's age is never below 0. */
+  birth: Float64Array;
   life: Float32Array;
   mass: Float32Array;
   /** Start position and start velocity, 3 each. */
@@ -78,7 +79,7 @@ export default class M3ParticleSystem {
     const n = this.max;
 
     this.serial = new Int32Array(n);
-    this.birth = new Float32Array(n);
+    this.birth = new Float64Array(n);
     this.life = new Float32Array(n);
     this.mass = new Float32Array(n);
     this.start = new Float32Array(n * 3);
