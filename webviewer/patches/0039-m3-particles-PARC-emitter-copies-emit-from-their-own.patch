+import BinaryStream from '../../common/binarystream';
+import IndexEntry from './indexentry';
+import { Float32AnimationReference, Uint16AnimationReference } from './animationreference';
+
+/**
+ * A particle emitter copy (PARC, version 0, 40 bytes): one more place an
+ * emitter emits from, on its own bone at its own rate. Layout from m3addon
+ * structures.xml. WhiteoutFlakes m3_model_adapter: copies are emission
+ * slots of their emitter, not emitters; they share its particles.
+ */
+export default class ParticleCopy {
+  version = -1;
+  emissionRate = new Float32AnimationReference();
+  partEmit = new Uint16AnimationReference();
+  boneIndex = 0;
+
+  load(stream: BinaryStream, version: number, _index: IndexEntry[]): void {
+    this.version = version;
+    stream.seek(0);
+    this.emissionRate.load(stream);
+    stream.seek(20);
+    this.partEmit.load(stream);
+    stream.seek(36);
+    this.boneIndex = stream.readUint32();
+  }
+}
