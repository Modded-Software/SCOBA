diff --git a/src/viewer/handlers/m3/draworder.ts b/src/viewer/handlers/m3/draworder.ts
new file mode 100644
index 00000000..11ca59c9
--- /dev/null
+++ b/src/viewer/handlers/m3/draworder.ts
@@ -0,0 +1,28 @@
+import M3Batch from './batch';
+
+/**
+ * The order a model's batches are drawn in.
+ *
+ * Opaque batches (blend mode 0) come first, in file order: they write depth,
+ * so their order does not change the picture. Blended batches follow, by
+ * material priority ascending, so a higher priority is drawn later and lies
+ * on top; equal priorities keep file order (the sort is stable).
+ *
+ * Source: WhiteoutFlakes `TransparentOrder` (src/renderer/core/draw_list.h),
+ * after the client's CTransparentObject::HasHigherPriority, with the M3
+ * material priority as its priority plane (model_loader.cpp BuildM3Surfaces).
+ * Its next key, camera distance, is not applied: within one model it is the
+ * same for every batch here.
+ */
+export function sortBatches(batches: M3Batch[]): M3Batch[] {
+  batches.forEach((b, i) => {
+    b.fileOrder = i;
+  });
+
+  const opaque = batches.filter((b) => b.material.blendMode === 0);
+  const blended = batches.filter((b) => b.material.blendMode !== 0);
+
+  blended.sort((a, b) => a.material.priority - b.material.priority);
+
+  return opaque.concat(blended);
+}
