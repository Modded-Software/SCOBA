+  /**
+   * The playhead's move since the last update, in ms: [from, to], `from`
+   * excluded. Null when it did not move. After a sequence change the
+   * window opens before 0, so a key at the start fires.
+   */
+  frameWindow(dt: number): [number, number] | null {
+    const instance = this.instance;
+    const sequence = instance.sequence;
+    const to = instance.frame;
+    let from = this.lastFrame;
+
+    if (sequence !== this.lastSequence) {
+      from = to - dt * 1000;
+
+      if (from <= 0) {
+        from = -1;
+      }
+    }
+
+    this.lastSequence = sequence;
+    this.lastFrame = to;
+
+    return sequence === -1 || from === to ? null : [from, to];
+  }
+
+  /** The particles a partEmit track owes for this window (WhiteoutFlakes SquirtBurst). */
+  burst(ref: AnimationReference, window: [number, number] | null): number {
+    if (!window) {
+      return 0;
+    }
+
+    const skeleton = <NonNullable<M3ModelInstance['skeleton']>>this.instance.skeleton;
+
+    return Math.floor(skeleton.crossed(ref, this.instance, window[0], window[1]));
+  }
+
   /** Drop the particles past their life, keeping the living packed at the front. */
   retire(): void {
     const time = this.time;
diff --git a/src/viewer/handlers/m3/sd.ts b/src/viewer/handlers/m3/sd.ts
index 13490054..45e9078d 100644
--- a/src/viewer/handlers/m3/sd.ts
+++ b/src/viewer/handlers/m3/sd.ts
@@ -36,6 +36,37 @@ export default class M3SdContainer {
     }
   }
 
+  /**
+   * The sum of the positive key values the playhead stepped over going from
+   * `from` (excluded) to `to` (included), in ms. `to` below `from` is a wrap:
+   * the keys after `from`, then those up to `to`. Values read signed
+   * (WhiteoutFlakes SquirtBurst: a negative key owes nothing).
+   */
+  crossed(index: number, from: number, to: number, runsConcurrent: number): number {
+    const sd = this.sd[index];
+
+    if (runsConcurrent && sd.biggestKey > 0) {
+      from = from % sd.biggestKey;
+      to = to % sd.biggestKey;
+    }
+
+    const keys = sd.keys;
+    const values = <number[]>sd.values;
+    let sum = 0;
+
+    for (let i = 0; i < keys.length; i++) {
+      const t = keys[i];
+      const hit = to >= from ? t > from && t <= to : t > from || t <= to;
+      const v = values[i];
+
+      if (hit && typeof v === 'number' && v > 0) {
+        sum += v;
+      }
+    }
+
+    return sum;
+  }
+
   getValueUnsafe(index: number, animationReference: AnimationReference, frame: number, runsConcurrent: number): number | vec3 | quat | Uint8Array | null {
     const sd = this.sd[index];
 
diff --git a/src/viewer/handlers/m3/skeleton.ts b/src/viewer/handlers/m3/skeleton.ts
index eeba7630..40a163b0 100644
--- a/src/viewer/handlers/m3/skeleton.ts
+++ b/src/viewer/handlers/m3/skeleton.ts
@@ -111,6 +111,21 @@ export default class M3Skeleton {
     return animRef.initValue;
   }
 
+  /**
+   * Positive key values of `animRef` the playing sequence crossed from
+   * `from` to `to` (ms). 0 at rest, and for a reference that does not
+   * animate (animFlags bit 2, as WhiteoutFlakes reads it).
+   */
+  crossed(animRef: AnimationReference, instance: M3ModelInstance, from: number, to: number): number {
+    const sequence = instance.sequence;
+
+    if (sequence === -1 || !(animRef.animFlags & 0x2)) {
+      return 0;
+    }
+
+    return this.stg[sequence].crossed(animRef, from, to);
+  }
+
   getValue(animRef: AnimationReference, instance: M3ModelInstance): number {
     return <number>this.getValueUnsafe(animRef, instance);
   }
