@@ -275,6 +278,7 @@ export default class M3Model extends Model {
 
     this.allParticleEmitters = reference.list(<ParticleEmitter[]>[]);
     this.particleCopies = model.particleEmitterCopies.list(<ParticleCopy[]>[]);
+    this.lights = model.ligts.list(<Light[]>[]);
 
     // A version the index entry does not know is skipped there, entries and all.
     if (this.allParticleEmitters.length < reference.entries && reference.index) {
