@@ -0,0 +1,139 @@
+import { mat4, vec3 } from 'gl-matrix';
+import { velocityAt } from './particlemath';
+import type M3ParticleSystem from './particlesystem';
+
+/**
+ * The viewer's ground: a flat, invisible plane at world z = 0, which
+ * particles with `collideTerrain` hit (WhiteoutFlakes CollideElement on a
+ * terrain query). The scene has no terrain mesh; this plane stands in.
+ */
+export const GROUND_Z = 0;
+
+/** PAR_ flags bit: the particles collide with the terrain. */
+export const COLLIDE_TERRAIN = 0x2;
+/** The terrain push-out along the normal (kParticleCollideRadius). */
+const COLLIDE_RADIUS = 0.05;
+/** The tangential (friction) term needs |v|² above this (kFrictionSpeedSq). */
+const FRICTION_SPEED_SQ = 0.01;
+/** A landed particle rests when |v|² < this x dt (kRestPerDt). */
+const REST_PER_DT = 3;
+
+const now = new Float32Array(3);
+const before = new Float32Array(3);
+const vel = new Float32Array(3);
+const inverse = mat4.create();
+
+/**
+ * Collide the live particles of `system` with the ground over the last
+ * `dt` seconds. A particle that crossed the plane downwards restarts its
+ * closed-form motion at the contact, pushed out by the collide radius, with
+ * the response velocity: the normal part times -bounce, plus the tangent
+ * part times friction when the particle moves; below the rest speed it
+ * stays put. WhiteoutFlakes steps with Euler and sweeps the segment; this
+ * finds the crossing on the closed-form path between the two times.
+ */
+export function collideGround(system: M3ParticleSystem, dt: number): void {
+  const e = system.emitter;
+
+  if (!(e.flags & COLLIDE_TERRAIN) || dt <= 0) {
+    return;
+  }
+
+  const local = !system.worldSpace;
+
+  if (local && !mat4.invert(inverse, system.matrix)) {
+    return;
+  }
+
+  const time = system.time;
+
+  for (let i = 0; i < system.live; i++) {
+    if (system.rest[i]) {
+      continue;
+    }
+
+    system.positionAt(now, i, time);
+
+    if (now[2] >= GROUND_Z) {
+      continue;
+    }
+
+    const from = Math.max(system.kick[i], time - dt);
+
+    system.positionAt(before, i, from);
+
+    // Born under the ground, or already below at the step's start: no crossing.
+    if (before[2] < GROUND_Z) {
+      continue;
+    }
+
+    // The contact: where the step's segment meets the plane.
+    const f = (before[2] - GROUND_Z) / (before[2] - now[2]);
+    const hit = now;
+
+    for (let k = 0; k < 3; k++) {
+      hit[k] = before[k] + (now[k] - before[k]) * f;
+    }
+
+    hit[2] = GROUND_Z + COLLIDE_RADIUS;
+
+    // The velocity at the contact, in world space.
+    const v = system.velocity;
+    const at = from + (time - from) * f - system.kick[i];
+
+    velocityAt(vel, at, v[i * 3], v[i * 3 + 1], v[i * 3 + 2], system.mass[i], e.drag, e.zAcceleration);
+
+    if (local) {
+      vec3.transformMat3(<vec3>vel, <vec3>vel, mat3(system.matrix));
+    }
+
+    const d = vel[2];
+
+    if (d >= 0) {
+      continue;
+    }
+
+    // Normal (0, 0, 1): vn = (0, 0, d).
+    const r = [0, 0, -e.bounce * d];
+
+    if (vel[0] * vel[0] + vel[1] * vel[1] + vel[2] * vel[2] > FRICTION_SPEED_SQ) {
+      r[0] += e.friction * vel[0];
+      r[1] += e.friction * vel[1];
+    }
+
+    system.bounces[i]++;
+    system.kick[i] = time;
+
+    if (r[0] * r[0] + r[1] * r[1] + r[2] * r[2] < REST_PER_DT * dt) {
+      r.fill(0);
+      system.rest[i] = 1;
+    }
+
+    if (local) {
+      vec3.transformMat4(<vec3>hit, <vec3>hit, inverse);
+      vec3.transformMat3(<vec3>vel, <vec3>r, mat3(inverse));
+    } else {
+      vel.set(r);
+    }
+
+    system.start.set(hit, i * 3);
+    v.set(vel, i * 3);
+  }
+}
+
+const m3 = new Float32Array(9);
+
+/** The upper 3x3 of a 4x4 matrix. */
+function mat3(m: mat4): Float32Array {
+  m3[0] = m[0];
+  m3[1] = m[1];
+  m3[2] = m[2];
+  m3[3] = m[4];
+  m3[4] = m[5];
+  m3[5] = m[6];
+  m3[6] = m[8];
+  m3[7] = m[9];
+  m3[8] = m[10];
+
+  return m3;
+}
