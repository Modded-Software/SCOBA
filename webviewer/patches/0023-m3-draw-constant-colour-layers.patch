   /** Rows of the UV transform last uploaded: row 0 in [0..2], row 1 in [3..5]. */
   uvTransform = new Float32Array([1, 0, 0, 0, 1, 0]);
   /** The inputs of the last transform: offset u, v; angle x, y, z; tiling u, v (after the neutral rule). */
@@ -92,6 +96,8 @@ export default class M3Layer {
       uvCoordinate: settings + 'uvCoordinate',
       uvRow0: settings + 'uvRow0',
       uvRow1: settings + 'uvRow1',
+      useConstantColor: settings + 'useConstantColor',
+      constantColor: settings + 'constantColor',
     };
 
     // Since Gloss doesn't exist in all versions
@@ -104,7 +110,9 @@ export default class M3Layer {
 
       const path = layer.imagePath.get();
 
-      if (path) {
+      if (!path && (layer.flags & 0x400)) {
+        this.initConstant(layer, type, op);
+      } else if (path) {
         const source = (<string>path).toLowerCase();
 
         if (source.length) {
@@ -160,6 +168,41 @@ export default class M3Layer {
     }
   }
 
+  /**
+   * A constant colour layer: flag 0x400 and no texture. Its value is the
+   * layer colour, not a sample (WhiteoutFlakes m3_standard.slang
+   * M3LayerValue mode 2, then LayerTint). The colour is stored b, g, r, a.
+   * Rest values, as WhiteoutFlakes' bind-pose tint. Two exporter defaults
+   * read as "unset": an all-zero colour is white, a multiply <= 0 is 1.
+   */
+  initConstant(layer: Layer, type: string, op: number): void {
+    const c = <Uint8Array>layer.color.initValue;
+    const unset = c[0] === 0 && c[1] === 0 && c[2] === 0 && c[3] === 0;
+    let mul = <number>layer.brightMult.initValue;
+
+    if (!(mul > 0)) {
+      mul = 1;
+    }
+
+    const out = this.constantColor;
+
+    if (unset) {
+      out.set([mul, mul, mul, 1]);
+    } else {
+      out.set([c[2] / 255 * mul, c[1] / 255 * mul, c[0] / 255 * mul, c[3] / 255 * mul]);
+    }
+
+    this.constant = 1;
+    this.active = 1;
+    this.flags = layer.flags;
+    this.colorChannels = layer.colorChannelSetting;
+    this.type = type;
+    this.op = op;
+    this.textureUnit = layerTypeToTextureUnit[type];
+    this.invert = layer.flags & 0x10;
+    this.clampResult = layer.flags & 0x20;
+  }
+
   /** Called by the model once its STCs exist: which UV tracks a sequence drives. */
   resolveUvTracks(): void {
     const layer = this.layer;
@@ -219,13 +262,21 @@ export default class M3Layer {
       gl.uniform3f(uniforms[uniformMap.uvRow0], t[0], t[1], t[2]);
       gl.uniform3f(uniforms[uniformMap.uvRow1], t[3], t[4], t[5]);
 
-      const m3Texture = <M3Texture>this.texture;
-      const texture = textureOverrides.get(this.material.index * STANDARD_MATERIAL_OFFSET + this.index) || m3Texture.texture;
       const textureUnit = this.textureUnit;
 
       gl.uniform1i(uniforms[uniformMap.map], textureUnit);
+      gl.uniform1f(uniforms[uniformMap.useConstantColor], this.constant);
+
+      if (this.constant) {
+        const c = this.constantColor;
 
-      this.model.viewer.webgl.bindTextureAndWrap(texture, textureUnit, m3Texture.wrapS, m3Texture.wrapT);
+        gl.uniform4f(uniforms[uniformMap.constantColor], c[0], c[1], c[2], c[3]);
+      } else {
+        const m3Texture = <M3Texture>this.texture;
+        const texture = textureOverrides.get(this.material.index * STANDARD_MATERIAL_OFFSET + this.index) || m3Texture.texture;
+
+        this.model.viewer.webgl.bindTextureAndWrap(texture, textureUnit, m3Texture.wrapS, m3Texture.wrapT);
+      }
 
       gl.uniform1f(uniforms[uniformMap.op], this.op);
       gl.uniform1f(uniforms[uniformMap.channels], this.colorChannels);
@@ -243,9 +294,6 @@ export default class M3Layer {
 
       gl.uniform1f(uniforms[uniformMap.clampResult], this.clampResult);
 
-      // gl.setParameter(uniform + 'useConstantColor', this.flags && 0x400);
-      // gl.setParameter(uniform + 'constantColor', this.model.getValue(this.color, sequence, frame));
-      // gl.setParameter(settings + 'uvSource', this.uvSource);
 
       gl.uniform1f(uniforms[uniformMap.uvCoordinate], this.uvCoordinate);
     }
