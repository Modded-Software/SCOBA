-  // }
+  // No team colour on a constant layer.
+  bool team = !layerSettings.useConstantColor;
 
-  if (layerSettings.teamColorMode == TEAMCOLOR_DIFFUSE) {
+  if (team && layerSettings.teamColorMode == TEAMCOLOR_DIFFUSE) {
     result = vec4(mix(v_teamColor, result.rgb, color.a), 1.0);
-  } else if (layerSettings.teamColorMode == TEAMCOLOR_EMISSIVE) {
+  } else if (team && layerSettings.teamColorMode == TEAMCOLOR_EMISSIVE) {
     result = vec4(mix(v_teamColor, result.rgb, color.a), 1.0);
   }
 
