+  if (layerSettings.useConstantColor) {
+    color = layerSettings.constantColor;
+    result = color;
+  } else {
+    color = sampleLayer(layer, layerSettings);
+    result = chooseChannel(layerSettings.channels, color);
+  }
 
-  // if (layerSettings.useAlphaFactor) {
