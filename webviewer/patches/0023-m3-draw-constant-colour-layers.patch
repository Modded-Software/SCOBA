   gl: WebGLRenderingContext;
-  uniformMap: { map: string; enabled: string; op: string; channels: string; teamColorMode: string; invert: string; clampResult: string; uvCoordinate: string; uvRow0: string; uvRow1: string; };
+  uniformMap: { map: string; enabled: string; op: string; channels: string; teamColorMode: string; invert: string; clampResult: string; uvCoordinate: string; uvRow0: string; uvRow1: string; useConstantColor: string; constantColor: string; };
   source = '';
   texture: M3Texture | null = null;
   flags = 0;
@@ -60,6 +60,10 @@ export default class M3Layer {
