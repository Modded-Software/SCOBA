       this.bones.push(new M3Bone(bone));
     }
 
-    this.boneLookup = <Uint16Array>model.boneLookup.get();
+    this.boneLookup = model.boneLookup.list(new Uint16Array(0));
 
     const sequences = model.sequences.get();
     if (sequences) {
@@ -242,7 +243,8 @@ export default class M3Model extends Model {
     // tangent bytes: still inside the vertex, and no layer has a texture to map.
     const uvSetCount = Math.max(1, Math.min(fileUvSets, 4));
 
-    const regions = <Region[]>div.regions.get();
+    // A model with no mesh has no regions, triangles or vertices.
+    const regions = div.regions.list(<Region[]>[]);
     let totalElements = 0;
     const offsets = [];
 
@@ -253,13 +255,13 @@ export default class M3Model extends Model {
 
     const elementArray = new Uint16Array(totalElements);
 
-    const triangles = <Uint16Array>div.triangles.get();
+    const triangles = div.triangles.list(new Uint16Array(0));
 
     for (let i = 0, l = regions.length; i < l; i++) {
       this.regions.push(new M3Region(this, regions[i], triangles, elementArray, offsets[i]));
     }
 
-    const vertices = <Uint8Array>parser.vertices.get();
+    const vertices = parser.vertices.list(new Uint8Array(0));
 
     this.elementBuffer = gl.createBuffer();
