From 40e3d0b38fc324aac5827e5bb88f502a0610084b Mon Sep 17 00:00:00 2001
From: workspace-agent <workspace.vm.agent@gmail.com>
Date: Sat, 21 Nov 2026 13:55:20 +0200
Subject: [PATCH 09/59] m3 viewer: empty references (no mesh, no bones, STS
 without animations) load as empty lists

---
 src/parsers/m3/reference.ts     | 19 +++++++++++++++++++
 src/viewer/handlers/m3/model.ts | 20 +++++++++++---------
 src/viewer/handlers/m3/sts.ts   |  2 +-
 3 files changed, 31 insertions(+), 10 deletions(-)

diff --git a/src/parsers/m3/reference.ts b/src/parsers/m3/reference.ts
index 9871e5e2..2d251690 100644
--- a/src/parsers/m3/reference.ts
+++ b/src/parsers/m3/reference.ts
@@ -28,6 +28,25 @@ export default class Reference {
     return;
   }
 
+  /**
+   * Get the entries, or `empty` when the reference holds none (a model with
+   * no mesh, an animation validator with no animations).
+   * A reference that counts entries but points at none is an error.
+   */
+  list<T>(empty: T): T {
+    if (this.entries === 0) {
+      return empty;
+    }
+
+    const entries = this.get();
+
+    if (entries === undefined) {
+      throw new Error(`Reference to index entry ${this.id} with ${this.entries} entries has no data`);
+    }
+
+    return <T><unknown>entries;
+  }
+
   /**
    * Get the first entry this index entry references.
    */
