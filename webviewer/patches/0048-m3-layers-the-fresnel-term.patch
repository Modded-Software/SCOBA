+      fresnelExponentBiasScale: settings + 'fresnelExponentBiasScale',
     };
 
     // Since Gloss doesn't exist in all versions
@@ -305,6 +311,15 @@ export default class M3Layer {
 
       gl.uniform2f(uniforms[uniformMap.multiplyAdd], ma[0], ma[1]);
 
+      // The fresnel term (layers.glsl fresnelTerm): mode, then exponent,
+      // fresnelMin and fresnelMaxOffset (max = min + offset, m3addon).
+      const l = this.layer;
+
+      gl.uniform1f(uniforms[uniformMap.fresnelMode], layerOptions.fresnel && l ? l.fresnelType : 0);
+
+      if (l) {
+        gl.uniform3f(uniforms[uniformMap.fresnelExponentBiasScale], l.fresnelExponent, l.fresnelMin, l.fresnelMaxOffset);
