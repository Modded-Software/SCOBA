 src/viewer/handlers/m3/model.ts         | 46 ++++++++++++++++++++++
 src/viewer/handlers/m3/modelinstance.ts | 37 ++++++++++++++++++
 src/viewer/handlers/m3/region.ts        | 19 +++++++++
 4 files changed, 153 insertions(+)
 create mode 100644 src/viewer/edges.ts

diff --git a/src/viewer/edges.ts b/src/viewer/edges.ts
new file mode 100644
index 00000000..98360beb
--- /dev/null
+++ b/src/viewer/edges.ts
@@ -0,0 +1,51 @@
+/**
+ * The edges of a triangle list, each once: pairs of element indices, the
+ * lower index first, in the order the triangles first name them.
+ * `elements` holds three indices a triangle; the range read is
+ * [start, start + count). A trailing part of a triangle is left out, and
+ * so is an edge from a vertex to itself.
+ */
+export function edgePairs(elements: ArrayLike<number>, start: number, count: number): number[] {
+  const end = start + count - (count % 3);
+  let top = 0;
+
+  for (let i = start; i < end; i++) {
+    top = Math.max(top, elements[i] ?? 0);
+  }
+
+  // lo * span + hi is one number per edge while span * span stays under 2^53.
+  const span = top + 1;
+
+  if (span > 94_000_000) {
+    throw new Error(`edgePairs: index ${top} is too large`);
+  }
+
+  const seen = new Set<number>();
+  const pairs: number[] = [];
+  const add = (a: number, b: number): void => {
+    if (a === b) {
+      return;
+    }
+
+    const lo = Math.min(a, b);
+    const hi = Math.max(a, b);
+    const key = lo * span + hi;
+
+    if (!seen.has(key)) {
+      seen.add(key);
+      pairs.push(lo, hi);
+    }
+  };
+
+  for (let i = start; i < end; i += 3) {
+    const a = elements[i] ?? 0;
+    const b = elements[i + 1] ?? 0;
+    const c = elements[i + 2] ?? 0;
+
+    add(a, b);
+    add(b, c);
+    add(c, a);
+  }
+
+  return pairs;
+}
