@@ -474,6 +482,44 @@ export default class M3Model extends Model {
     return this.materials[1][materialMap.materialIndex];
   }
 
+  /**
+   * The edge buffer: every region's triangle edges, each once, as line
+   * element pairs (region.edgeOffset, region.edgeCount). Made on the first
+   * call, so a model never drawn with edges never pays for them.
+   */
+  edges(): WebGLBuffer | null {
+    if (this.edgeBuffer || !this.regions.length) {
+      return this.edgeBuffer;
+    }
+
+    const gl = this.viewer.gl;
+    const lists = this.regions.map((region) => edgePairs(this.elementArray, region.offset / this.elementBytes, region.elements));
+    let total = 0;
+
+    for (const list of lists) {
+      total += list.length;
+    }
+
+    const array = this.elementType === gl.UNSIGNED_INT ? new Uint32Array(total) : new Uint16Array(total);
+    let at = 0;
+
+    this.regions.forEach((region, i) => {
+      const list = lists[i] ?? [];
+
+      region.edgeOffset = at * this.elementBytes;
+      region.edgeCount = list.length / 2;
+      array.set(list, at);
+      at += list.length;
+    });
+
+    this.edgeCount = total / 2;
+    this.edgeBuffer = gl.createBuffer();
+    gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, this.edgeBuffer);
+    gl.bufferData(gl.ELEMENT_ARRAY_BUFFER, array, gl.STATIC_DRAW);
+
+    return this.edgeBuffer;
+  }
