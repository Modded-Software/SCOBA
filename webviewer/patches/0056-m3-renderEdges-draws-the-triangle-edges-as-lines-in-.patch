diff --git a/src/viewer/handlers/m3/modelinstance.ts b/src/viewer/handlers/m3/modelinstance.ts
index c77db500..a92b6fba 100644
--- a/src/viewer/handlers/m3/modelinstance.ts
+++ b/src/viewer/handlers/m3/modelinstance.ts
@@ -316,6 +316,43 @@ export default class M3ModelInstance extends ModelInstance {
     gl.uniform4f(shader.uniforms['u_pick'], 0, 0, 0, 0);
   }
 
+  /**
+   * Draw the triangle edges of the drawn batches as lines in one flat
+   * colour, posed like the triangles (the same vertex shader). The depth
+   * and blend state are the caller's. Returns how many lines it drew.
+   */
+  renderEdges(r: number, g: number, b: number): number {
+    const model = <M3Model>this.model;
+    const regions = new Set(model.batches.filter((batch) => !this.solidOnly || batch.material.blendMode === 0).map((batch) => batch.region));
+    const buffer = regions.size ? model.edges() : null;
+
+    if (!buffer) {
+      return 0;
+    }
+
+    const gl = model.viewer.gl;
+    const m3Cache = <M3HandlerObject>model.viewer.sharedCache.get('m3');
+    const shader = m3Cache.standardShaders[model.uvSetCount - 1];
+
+    this.useShader(shader);
+
+    gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, buffer);
+    gl.uniform4f(shader.uniforms['u_pick'], r, g, b, 1);
+    // No material is bound: no cut-out, so every line pixel is drawn.
+    gl.uniform1f(shader.uniforms['u_alphaTest'], 0);
+
+    let lines = 0;
+
+    for (const region of regions) {
+      region.renderEdges(shader);
+      lines += region.edgeCount;
+    }
+
+    gl.uniform4f(shader.uniforms['u_pick'], 0, 0, 0, 0);
+
+    return lines;
+  }
+
   override updateAnimations(dt: number): void {
     const sequenceId = this.sequence;
 
