Subject: [PATCH 16/51] m3: parse displacement materials (DIS_ v4)

---
 src/parsers/m3/displacementmaterial.ts | 32 ++++++++++++++++++++++++++
 src/parsers/m3/indexentry.ts           |  7 +++---
 2 files changed, 36 insertions(+), 3 deletions(-)
 create mode 100644 src/parsers/m3/displacementmaterial.ts

diff --git a/src/parsers/m3/displacementmaterial.ts b/src/parsers/m3/displacementmaterial.ts
new file mode 100644
index 00000000..cce635a0
--- /dev/null
+++ b/src/parsers/m3/displacementmaterial.ts
@@ -0,0 +1,32 @@
+import BinaryStream from '../../common/binarystream';
+import IndexEntry from './indexentry';
+import Reference from './reference';
+import { Float32AnimationReference } from './animationreference';
+
+/**
+ * A displacement material (DIS_ version 4, 68 bytes; m3addon
+ * structures.xml): the surface bends the picture behind it. A normal layer
+ * gives the direction, a strength layer and an animated strength factor how
+ * far.
+ */
+export default class DisplacementMaterial {
+  version = -1;
+  name = new Reference();
+  unknown0 = 0;
+  strengthFactor = new Float32AnimationReference();
+  normalLayer = new Reference();
+  strengthLayer = new Reference();
+  flags = 0;
+  priority = 0;
+
+  load(stream: BinaryStream, version: number, index: IndexEntry[]): void {
+    this.version = version;
+    this.name.load(stream, index);
+    this.unknown0 = stream.readUint32();
+    this.strengthFactor.load(stream);
+    this.normalLayer.load(stream, index);
+    this.strengthLayer.load(stream, index);
+    this.flags = stream.readUint32();
+    this.priority = stream.readInt32();
+  }
+}
