+/** Floats per vertex: position 3, flipbook cell uv 2, quad uv 2, colour 4. */
+const STRIDE = 11;
+/** Layer uvSource of the particle flipbook: such a layer reads the cell (UV coordinate 3, particle.vert). */
+const FLIPBOOK_UV_SOURCE = 6;
+const CELL_UV_COORDINATE = 3;
+
+/** After a layer bind: a flipbook layer reads the cell, every other the whole quad. */
+function bindParticleUv(gl: WebGLRenderingContext, shader: Shader, layer: M3Layer): void {
+  if (layer.active && layer.layer && layer.layer.uvSource === FLIPBOOK_UV_SOURCE) {
+    gl.uniform1f(shader.uniforms[layer.uniformMap.uvCoordinate], CELL_UV_COORDINATE);
+  }
+}
 
