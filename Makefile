PATHS := ROOT_DIR="$(REPO_ROOT)" && source "$(REPO_ROOT)/scripts/paths.sh" && paths_check_device &&
# A Python module of scripts/, as the project's tools run it.
PYMOD := cd "$(REPO_ROOT)/scripts" && PYTHONPATH="$(REPO_ROOT)/scripts" uv --project "$(REPO_ROOT)" run python -m

# =============================================================================
# Setup
# =============================================================================
DEPS := $(PATHS) SC2_PROJECT_ROOT="$(REPO_ROOT)" $(SCRIPT_BASH) $(REPO_ROOT)/scripts/setup/deps.sh

.PHONY: preflight init deps-check install install-ci install-deps install-hdtex install-photocraft install-hooks sync
preflight: ## Verify environment
	test -d "$(CI_DIR)" || { echo "ERROR: CI directory not found at $(CI_DIR)" >&2; exit 1; }
	test -f "$(CI_DIR)/scripts/reinstall-hooks" || { echo "ERROR: reinstall-hooks missing" >&2; exit 1; }
	echo "Preflight OK"

# System packages: libglm-dev, the GLM headers the nodsdk parser library needs.
SYSTEM_PACKAGES := libglm-dev

init: ## Root steps only, run first: sudo make init. Installs the system packages (apt)
	test "$$(id -u)" -eq 0 || { echo "ERROR: make init holds only root steps; run: sudo make init" >&2; exit 1; }
	apt-get install -y $(SYSTEM_PACKAGES)

deps-check: ## Report every dependency (tools, StarCraft II, GE-Proton, lsfg-vk, GLM, nodsdk, launch dialog); installs nothing
	$(DEPS) check

install: install-deps ## Full install: deps (hooks install separately, root-only: sudo make install-hooks)
	:

install-ci: install-deps ## CI install: deps only, no hooks
	:

install-deps: ## Install project dependencies: uv env, stormex (built from source), model viewer, nodsdk parsers, then check
	$(DEPS) venv
	$(DEPS) stormex
	$(MAKE) -C "$(REPO_ROOT)" viewer-install
	$(DEPS) nodsdk
	$(DEPS) check

install-hdtex: ## Clone ../upscale-on-arc (if absent) and install it, for texture requests
	$(DEPS) upscale

install-photocraft: ## Build PhotoCraft from source at its pin (editor site and renderer), for texture editing; a long build
	$(DEPS) photocraft

install-hooks: ## Install native git hooks (root-only: root-owned, immutable)
	$(SCRIPT_BASH) $(CI_DIR)/scripts/reinstall-hooks

sync: install-deps ## Sync deps (hooks install separately, root-only: sudo make install-hooks)
	:

