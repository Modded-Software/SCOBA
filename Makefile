# =============================================================================
# SCOBA map entrypoints
# =============================================================================
PLAYTEST := $(REPO_ROOT)/scripts/playtest.sh

.PHONY: map-build map-launch combat aim motion controls pitch
map-build: ## Rebuild the map fresh and stop
	$(SCRIPT_BASH) $(PLAYTEST) build

map-launch: ## Rebuild the map fresh, then launch it
	$(SCRIPT_BASH) $(PLAYTEST) launch

combat: ## Rebuild and run the combat profile
	$(SCRIPT_BASH) $(PLAYTEST) combat

aim: ## Rebuild and run the aim profile
	$(SCRIPT_BASH) $(PLAYTEST) aim

motion: ## Rebuild and run the motion profile
	$(SCRIPT_BASH) $(PLAYTEST) motion

controls: ## Rebuild and run the controls profile
	$(SCRIPT_BASH) $(PLAYTEST) controls

pitch: ## Rebuild and run the 10-second pitch profile
	$(SCRIPT_BASH) $(PLAYTEST) pitch

.PHONY: map-stage host-tests measure-hit-volumes measure-footprints measure-rim-falls measure-water-features classic-skins
map-stage: ## Expand the map into OUT=<folder> without checks or publish (for measuring a changed map)
	test -n "$(OUT)" || { echo "ERROR: name the folder: make map-stage OUT=<folder>" >&2; exit 1; }
	$(PATHS) uv --project "$(REPO_ROOT)" run python "$(REPO_ROOT)/scripts/expand_map.py" --out "$(OUT)"

host-tests: ## Rebuild, then run the Python unittest suite for the tooling
	$(SCRIPT_BASH) $(PLAYTEST) host-tests

.PHONY: host-test
host-test: ## Run the named host test modules, no map rebuild (ARGS="testkit.tests.textures.test_edits ...")
	test -n "$(ARGS)" || { echo "ERROR: name the test modules: make host-test ARGS=<module>" >&2; exit 1; }
	$(PATHS) $(PYMOD) unittest -v $(ARGS)

.PHONY: key-log
key-log: ## Host key log for play: game keys, mouse buttons and focus while the game window has the focus (ARGS="--minutes 120"; Ctrl+C stops)
	$(PATHS) $(PYMOD) testkit.host_keys $(ARGS)

# The measuring tools read the built map: run make map-build first. ARGS
# passes options on, such as ARGS="--map <folder>" or ARGS=--print.
measure-hit-volumes: ## Measure hit volumes, then write their galaxy and camera heights (ARGS for hitvolumes.measure)
	$(PATHS) $(PYMOD) hitvolumes.measure $(ARGS)
	$(PATHS) $(PYMOD) hitvolumes.galaxy
	$(PATHS) $(PYMOD) hitvolumes.camera_heights

measure-footprints: ## Measure the footprint slices of the sliced models (ARGS=--print)
	$(PATHS) $(PYMOD) mapgen.footprints.measure $(ARGS)

measure-rim-falls: ## Measure the rim fall models
	$(PATHS) $(PYMOD) mapgen.rimfalls.measure $(ARGS)

measure-water-features: ## Measure the water feature models (ARGS=--print)
	$(PATHS) $(PYMOD) mapgen.waterfeatures.measure $(ARGS)

classic-skins: ## Rewrite the classic skin data from the game storage (ARGS=--list)
	$(PATHS) $(PYMOD) hdtex.sc2.classic_skins $(ARGS)

.PHONY: texture-store-migrate
texture-store-migrate: ## Bring the texture store from layout 2 to 3: each entry names its edge rule (ARGS=--dry-run)
	$(PATHS) $(PYMOD) hdtex.core.storemigrate $(ARGS)

.PHONY: game-res
game-res: ## Search or extract the game's own files (ARGS="list LoadingScreen --ext SC2Layout" or "extract <pattern>")
	test -n "$(ARGS)" || { echo "ERROR: name the command: make game-res ARGS=\"list <pattern>\"" >&2; exit 1; }
	$(PATHS) cd "$(REPO_ROOT)" && uv --project "$(REPO_ROOT)" run python "$(REPO_ROOT)/scripts/sc2res.py" $(ARGS)

.PHONY: hd-textures
hd-textures: ## Run one command of the texture pipeline (ARGS="status --game sc2 --dataset scoba --layer src/SCOBA.SC2Map")
	test -n "$(ARGS)" || { echo "ERROR: name the command: make hd-textures ARGS=\"<command> --game G --dataset D\"" >&2; exit 1; }
	$(PATHS) cd "$(REPO_ROOT)" && uv --project "$(REPO_ROOT)" run python "$(REPO_ROOT)/scripts/hd_textures.py" $(ARGS)

# =============================================================================
# SC2 model web viewer (webviewer/). Machine paths go in webviewer/local.env.
# =============================================================================
WEBVIEWER_DIR := $(REPO_ROOT)/webviewer
WEBVIEWER := WEBVIEWER_DIR="$(WEBVIEWER_DIR)" $(SCRIPT_BASH) $(WEBVIEWER_DIR)/scripts

VIEWER_ANSIBLE := cd "$(REPO_ROOT)/deploy/ansible" && ansible-playbook viewer-dev.yml

.PHONY: viewer-install viewer-build viewer-catalog viewer-dataset viewer-survey viewer-ghost-survey viewer-ghost-export-check viewer-serve viewer-provision viewer-unprovision viewer-start viewer-stop viewer-restart viewer-status viewer-logs viewer-test viewer-test-e2e viewer-gpu-check viewer-test-all
viewer-install: ## Model viewer: install node deps and the test browser, build the renderer
	$(WEBVIEWER)/setup.sh

viewer-build: ## Model viewer: bundle the renderer with the M3 parser patches
	$(WEBVIEWER)/build.sh

viewer-catalog: ## Model viewer: extract the stock data again and rebuild every dataset's unit and doodad catalogs and icons
	REPO_ROOT="$(REPO_ROOT)" $(WEBVIEWER)/catalog.sh --extract

viewer-dataset: ## Model viewer: make a new dataset from the full stock data (NAME=id, WITH_MAP=1 to copy the SCOBA map layer in)
	REPO_ROOT="$(REPO_ROOT)" $(WEBVIEWER)/dataset-new.sh "$(NAME)" $(if $(WITH_MAP),--with-map,)

viewer-survey: ## Model viewer: report which unit models the parser can read
	REPO_ROOT="$(REPO_ROOT)" $(WEBVIEWER)/m3-survey.sh

viewer-ghost-survey: ## Model viewer: read every StarCraft: Ghost model, clip, material, motion set, template and texture (NODSurvey) and assert SPEC-VIEWER-GHOST 4
	REPO_ROOT="$(REPO_ROOT)" $(WEBVIEWER)/ghost-survey.sh

viewer-ghost-export-check: ## Model viewer: export every StarCraft: Ghost model, clip and material (NODExport) and assert SPEC-VIEWER-GHOST 7
	REPO_ROOT="$(REPO_ROOT)" $(WEBVIEWER)/ghost-export-check.sh

viewer-serve: ## Model viewer: run the server in the foreground (PORT=n beside the service)
	$(WEBVIEWER)/start.sh

viewer-provision: ## Model viewer: install or update the dev server as a systemd user service (Ansible), start it, check it (RESTART=1; PHOTOCRAFT=1 also builds PhotoCraft)
	$(VIEWER_ANSIBLE) $(if $(RESTART),-e viewer_restart=true,) $(if $(PHOTOCRAFT),-e viewer_photocraft=true,)

viewer-unprovision: ## Model viewer: stop the dev server service and remove its units
	$(VIEWER_ANSIBLE) -e viewer_state=absent

viewer-start: ## Model viewer: start the dev server service (Ansible) and check it
	$(VIEWER_ANSIBLE)

viewer-stop: ## Model viewer: stop the dev server service and its health check (Ansible)
	$(VIEWER_ANSIBLE) -e viewer_state=stopped

viewer-restart: ## Model viewer: restart the dev server service (Ansible; rebuilds from the checkout)
	$(VIEWER_ANSIBLE) -e viewer_restart=true

viewer-status: ## Model viewer: show the dev server service and its health answer
	$(WEBVIEWER)/service.sh status

viewer-logs: ## Model viewer: show the last log lines of the dev server service (LINES=n)
	$(WEBVIEWER)/service.sh logs

viewer-test: ## Model viewer: run the unit tests (no browser: the tools, the server's routes; ARGS=spec filter)
	$(WEBVIEWER)/test.sh --project=unit $(ARGS)

viewer-test-e2e: ## Model viewer: run the end-to-end tests (the page in a browser; not the @slow surveys; ARGS=spec filter)
	$(WEBVIEWER)/test.sh --project=e2e $(ARGS)

viewer-gpu-check: ## Model viewer: check that the test browser renders WebGL on the GPU (tests/e2e/gpu.spec.mjs only)
	$(WEBVIEWER)/test.sh --project=e2e gpu.spec

viewer-test-all: ## Model viewer: run every test, unit and end-to-end, the @slow surveys too
	WEBVIEWER_TEST_ALL=1 $(WEBVIEWER)/test.sh
