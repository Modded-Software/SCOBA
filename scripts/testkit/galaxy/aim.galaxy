// Aim test profile

trigger gt_AimTest;

void gf_AimTestSnap (string lp_section, string lp_tag, int lp_active) {
    unit lv_target;

    gf_DbgSnap(lp_section, lp_tag);
    lv_target = gf_ResolvePointEnemy(1, CameraGetTarget(1));
    BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "AimActive", lp_active);
    BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "UpperState", gv_animUpperState[1]);
    BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "LowerState", gv_animLowerState[1]);
    BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "UpperClip", gv_animUpperClipIndex[1]);
    BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "LowerClip", gv_animLowerClipIndex[1]);
    BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "AimDir", gv_animAimDir[1]);
    BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "FullDir", gv_animFullDir[1]);
    BankValueSetFromString(gv_dbgBank, lp_section, lp_tag + "AimClip", gv_animAimClip[gf_AnimHeroProfile(gv_tPSUNIT[1])][gv_animLowerState[1]][gv_animAimDir[1]]);
    
    BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "CameraYaw", FixedToInt(CameraGetYaw(1)));
    BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "UnitFacing", FixedToInt(UnitGetFacing(gv_tPSUNIT[1])));
    BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "CursorVisible", 1);
    if (gf_IsClickEnemy(1, lv_target)) {
        BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "AimCursorTarget", 1);
    }
    else {
        BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "AimCursorTarget", 0);
    }
    BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "AimFov", FixedToInt(gv_cAMERAFOV[1]));
    BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "AimDistance", FixedToInt(CameraGetDistance(1)));
    if (gv_animHasMoveTarget[1]) {
        BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "MoveTarget", 1);
    }
    else {
        BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "MoveTarget", 0);
    }
    BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "Orders", UnitOrderCount(gv_tPSUNIT[1]));
    if (UnitOrderHasAbil(gv_tPSUNIT[1], "move")) {
        BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "MoveOrder", 1);
    }
    else {
        BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "MoveOrder", 0);
    }
    if (gv_fORWARD[1]) {
        BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "Forward", 1);
    }
    else {
        BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "Forward", 0);
    }
    BankSave(gv_dbgBank);
}

void gf_AimTestWalkBegin () {
    gf_AimTestSnap("aim_walk", "t0000", 1);
    BankValueSetFromInt(gv_dbgBank, "aim_walk", "AimVisualReady", 1);
    BankSave(gv_dbgBank);
}

void gf_AimTestWalkEnd () {
    gv_fORWARD[1] = false;
    gv_bACKWARD[1] = false;
    gv_lEFT[1] = false;
    gv_rIGHT[1] = false;
    Wait(0.2, c_timeGame);
    gf_AimTestSnap("aim_walk", "t2500", 1);
    gf_AimTestSnap("aim_stop", "t2500", 1);
    Wait(0.25, c_timeGame);
    gf_AimTestSnap("aim_stop", "t2750", 1);
    BankValueSetFromInt(gv_dbgBank, "aim_stop", "AimVisualReady", 0);
    BankSave(gv_dbgBank);
}

void gf_AimTestDirection (string lp_tag, bool lp_forward, bool lp_backward, bool lp_left, bool lp_right, fixed lp_angle) {
    int lv_i;

    gv_fORWARD[1] = lp_forward;
    gv_bACKWARD[1] = lp_backward;
    gv_lEFT[1] = lp_left;
    gv_rIGHT[1] = lp_right;
    gf_AimTestSnap("aim_dir_start", lp_tag, 1);
    for (lv_i = 0; lv_i < 80; lv_i += 1) {
        Wait(c_ANIM_MOVE_TICK, c_timeGame);
    }
    gf_AimTestSnap("aim_dir", lp_tag, 1);
}

void gf_AimTestRealKey (string lp_tag) {
    gf_AimTestSnap("aim_realkeys_start", lp_tag, 1);
    Wait(1.0, c_timeGame);
    gf_AimTestSnap("aim_realkeys", lp_tag, 1);
    Wait(0.2, c_timeGame);
}


void gf_AimTestEnemy () {
    gv_dbgEnemy = gf_DbgSpawnOne("aim_enemy", 0.5, 500.0);
    UnitSetPosition(gv_dbgEnemy, CameraGetTarget(1), false);
}

bool gt_AimTest_Func (bool testConds, bool runActions) {
    int lv_i;
    fixed lv_yaw;

    if (!runActions) {
        return true;
    }
    Wait(3.0, c_timeGame);
    gv_dbgBank = BankLoad("SCOBAAIMTEST", 1);
    gv_bINPUTLOG = false;
    gv_bANIMLOG = true;
    gf_ProbeEnable(1);
    gv_animLogIndex[1] = 0;
    gv_animMoveHold[1] = 0;
    gv_dbgAnchor = UnitGetPosition(gv_tPSUNIT[1]);
    BankValueSetFromString(gv_dbgBank, "meta", "profile", "aim");
    
    BankValueSetFromInt(gv_dbgBank, "meta", "done", 0);
    BankValueSetFromInt(gv_dbgBank, "meta", "anchorX", FixedToInt(PointGetX(gv_dbgAnchor)));
    BankValueSetFromInt(gv_dbgBank, "meta", "anchorY", FixedToInt(PointGetY(gv_dbgAnchor)));
    BankSave(gv_dbgBank);

    gf_DbgReset("aim_enter", false, true);
    gf_AimBegin(1);
    Wait(0.2, c_timeGame);
    gf_AimTestSnap("aim_enter", "t0200", 1);
    Wait(0.5, c_timeGame);
    gf_AimTestSnap("aim_idle", "t0700", 1);
    Wait(1.0, c_timeGame);
    gf_AimTestSnap("aim_hold", "t1700", 1);

    gf_AimTestEnemy();
    Wait(0.1, c_timeGame);
    gf_AimTestSnap("aim_enemy", "t0000", 1);

    gf_AimTestWalkBegin();
    Wait(2.0, c_timeGame);
    gv_fORWARD[1] = true;
    for (lv_i = 0; lv_i < 267; lv_i += 1) {
        Wait(c_ANIM_MOVE_TICK, c_timeGame);
    }
    gf_AimTestSnap("aim_walk", "t1500", 1);
    Wait(0.2, c_timeGame);
    gf_AimTestSnap("aim_walk", "t1800", 1);
    Wait(0.7, c_timeGame);
    gf_AimTestWalkEnd();
    Wait(1.5, c_timeGame);
    gf_AimTestSnap("aim_settle", "t1500", 1);

    lv_yaw = CameraGetYaw(1);
    gf_AimTestDirection("d0", true, false, false, false, lv_yaw);
    gf_AimTestDirection("d1", true, false, true, false, lv_yaw + 45.0);
    gf_AimTestDirection("d2", false, false, true, false, lv_yaw + 90.0);
    gf_AimTestDirection("d3", false, true, true, false, lv_yaw + 135.0);
    gf_AimTestDirection("d4", false, true, false, false, lv_yaw + 180.0);
    gf_AimTestDirection("d5", false, true, false, true, lv_yaw - 135.0);
    gf_AimTestDirection("d6", false, false, false, true, lv_yaw - 90.0);
    gf_AimTestDirection("d7", true, false, false, true, lv_yaw - 45.0);
    gv_fORWARD[1] = false;
    gv_bACKWARD[1] = false;
    gv_lEFT[1] = false;
    gv_rIGHT[1] = false;
    Wait(0.5, c_timeGame);

    BankValueSetFromInt(gv_dbgBank, "aim_realkeys", "Ready", 1);
    BankSave(gv_dbgBank);
    Wait(3.0, c_timeGame);
    gf_AimTestRealKey("k0");
    gf_AimTestRealKey("k1");
    gf_AimTestRealKey("k2");
    gf_AimTestRealKey("k3");
    gf_AimTestRealKey("k4");
    gf_AimTestRealKey("k5");
    gf_AimTestRealKey("k6");
    gf_AimTestRealKey("k7");
    Wait(0.2, c_timeGame);

    gf_AimEnd(1);
    Wait(0.5, c_timeGame);
    gf_AimTestSnap("aim_release", "t0500", 0);

    gf_ProbeDisable(1);
    BankValueSetFromInt(gv_dbgBank, "meta", "done", 1);
    BankSave(gv_dbgBank);
    return true;
}

void gt_AimTest_Init () {
    gt_AimTest = TriggerCreate("gt_AimTest_Func");
    TriggerAddEventMapInit(gt_AimTest);
}
