// Shot clocks of the tps shot scenarios, read inside one weapon period by
// gf_DbgClockRead (common.galaxy). lp_shots: gv_aimShotEffectEvents before
// the click. With lp_again it clicks again in that loop, on cooldown
// (R-TPS-58), and records the cooldown left at that click. Then it
// snapshots 0.25 s after the shot. Called from tps.galaxy; declared there.
void gf_DbgTpsShotClocks (string lp_section, string lp_tag, int lp_shots, bool lp_again) {
    gf_DbgClockRead(lp_section, lp_tag, lp_shots);
    if (lp_again) {
        BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "AgainCdMs", FixedToInt(UnitGetCooldown(gv_tPSUNIT[1], c_SCOBA_ATTACK_COOLDOWN) * 1000.0));
        gf_AimShotPress(1);
    }
    Wait(0.1875, c_timeGame);
    gf_DbgSnap(lp_section, lp_tag);
}
