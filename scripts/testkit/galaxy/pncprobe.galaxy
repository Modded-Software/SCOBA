// Engine probes for WASD / Point & Click.
// Each scenario records raw engine values. The profile prints them.
trigger gt_PncProbe;

bool gt_PncProbe_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    Wait(3.0, c_timeGame);
    gv_dbgBank = BankLoad("SCOBAPNCPROBE", 1);
    BankValueSetFromInt(gv_dbgBank, "meta", "done", 0);
    gv_dbgAnchor = UnitGetPosition(gv_tPSUNIT[1]);
    BankSave(gv_dbgBank);
    // The pick log runs no scenario: the operator plays, the log records.
    if (gv_dbgGroup == "picklog") {
        gf_PickLogStart();
        return true;
    }
    gf_DbgProbeInit();
    // The hover probe runs alone, on request.
    if (gv_dbgGroup == "hover") {
        gf_ProbeHover("hover");
    }
    else if (gv_dbgGroup == "recenter") {
        gf_ProbeRecenter("hover");
    }
    else if (gv_dbgGroup == "click") {
        gf_ProbeClick("hover");
    }
    else if (gv_dbgGroup == "warp") {
        gf_ProbeWarp("hover");
    }
    else if (gv_dbgGroup == "inrange") {
        gf_ProbeInRange("inrange");
    }
    else if (gv_dbgGroup == "roach") {
        gf_ProbeRoach("roach");
    }
    else if (gv_dbgGroup == "point") {
        gf_ProbePoint("hover");
    }
    else if (gv_dbgGroup == "look") {
        gf_ProbeLook("hover");
    }
    else if (gv_dbgGroup == "ray") {
        gf_ProbeRay("hover");
    }
    else if (gv_dbgGroup == "scale") {
        gf_ProbeScale("hover");
    }
    else if (gv_dbgGroup == "recentre") {
        gf_ProbeRecentre("hover");
    }
    else if (gv_dbgGroup == "rotate") {
        gf_ProbeRotate("hover");
    }
    else if (gv_dbgGroup == "hit") {
        gf_ProbeHit("hit");
    }
    else if (gv_dbgGroup == "attach") {
        gf_ProbeAttach("attach");
    }
    else {
        gf_ProbeAll();
    }
    gf_DbgReset("done", false, true);
    gf_DbgSnap("done", "tend");
    BankValueSetFromInt(gv_dbgBank, "meta", "ready", 1);
    BankValueSetFromInt(gv_dbgBank, "meta", "done", 1);
    BankSave(gv_dbgBank);
    return true;
}

void gt_PncProbe_Init () {
    gt_PncProbe = TriggerCreate("gt_PncProbe_Func");
    TriggerAddEventMapInit(gt_PncProbe);
}
