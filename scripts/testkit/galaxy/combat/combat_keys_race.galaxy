// Keys against fast clicks (R-PNC-57, SPEC-POINT-AND-CLICK 5.8b). In TPS the
// host holds the right button, clicks the left button and sends key downs in
// the gap between two clicks (profiles/combat_parts/combat_keys_race.py).
// Included after
// combat_keys_real.galaxy, whose recorder counts what the game saw, and
// before combat.galaxy, which calls gf_DbgKeysRaceGroup.
const fixed c_DBG_RACE_WAIT = 40.0;  // game seconds to wait for the host
const int c_DBG_RACE_MAX = 1600;     // loops: 100 game seconds
const int c_DBG_RACE_IDLE = 48;      // loops with no edge: the end

// Key and button edges the recorder saw since gf_DbgRawReset.
int gf_DbgRaceEdges () {
    int lv_n = gv_dbgRawBtn[0] + gv_dbgRawBtn[1] + gv_dbgRawBtn[2] + gv_dbgRawRepeats;
    int lv_i;

    for (lv_i = 0; lv_i < 4; lv_i += 1) {
        lv_n += gv_dbgRawDowns[lv_i] + gv_dbgRawUps[lv_i];
    }
    return lv_n;
}

// One row each game loop until no edge came for c_DBG_RACE_IDLE loops.
// heldRows: loops with a key down by the key events. path100: the hero's
// path. scriptOff: loops in which the script key state was not the keys.
// turn10: the camera yaw change, summed (the host moves the mouse).
void gf_DbgRaceWatch (string lp_s) {
    unit lv_hero = gv_tPSUNIT[1];
    point lv_p = UnitGetPosition(lv_hero);
    point lv_q;
    fixed lv_path = 0.0;
    fixed lv_yaw = CameraGetYaw(1);
    fixed lv_turn = 0.0;
    int lv_edges = gf_DbgRaceEdges();
    int lv_n = 0;
    int lv_idle = 0;
    int lv_held = 0;
    int lv_off = 0;

    while (lv_n < c_DBG_RACE_MAX && lv_idle < c_DBG_RACE_IDLE) {
        Wait(0.0625, c_timeGame);
        lv_n += 1;
        lv_q = UnitGetPosition(lv_hero);
        lv_path += DistanceBetweenPoints(lv_p, lv_q);
        lv_p = lv_q;
        lv_turn += AbsF(gf_AnimYawDelta(CameraGetYaw(1), lv_yaw));
        lv_yaw = CameraGetYaw(1);
        if (gv_dbgRaw != 0) {
            lv_held += 1;
        }
        if (gf_DbgKeyBits(gv_kEYFORWARD[1], gv_kEYBACKWARD[1], gv_kEYLEFT[1], gv_kEYRIGHT[1]) != gv_dbgRaw) {
            lv_off += 1;
        }
        if (gf_DbgRaceEdges() == lv_edges) {
            lv_idle += 1;
        }
        else {
            lv_idle = 0;
            lv_edges = gf_DbgRaceEdges();
        }
    }
    BankValueSetFromInt(gv_dbgBank, lp_s, "rows", lv_n);
    BankValueSetFromInt(gv_dbgBank, lp_s, "heldRows", lv_held);
    BankValueSetFromInt(gv_dbgBank, lp_s, "scriptOff", lv_off);
    BankValueSetFromInt(gv_dbgBank, lp_s, "path100", FixedToInt(lv_path * 100.0));
    BankValueSetFromInt(gv_dbgBank, lp_s, "turn10", FixedToInt(lv_turn * 10.0));
}

void gf_DbgKeyRace () {
    string lv_s = "key_race";
    fixed lv_end;
    int lv_i;
    int lv_key0;
    int lv_any0;
    int lv_btn0;

    gf_DbgKeysReset(lv_s, true);
    UnitIssueOrder(gv_tPSUNIT[1], Order(AbilityCommand("SCOBATPSToggle", 0)), c_orderQueueReplace);
    Wait(0.5, c_timeGame);
    BankValueSetFromFlag(gv_dbgBank, lv_s, "tpsOn", gf_TpsActive(1));
    gf_DbgRawReset();
    // The triggers of the map (systems/recorders/move_log_keys) hear the
    // same edges.
    lv_key0 = gv_moveLogKeyEdges;
    lv_any0 = gv_moveLogAnyEdges;
    lv_btn0 = gv_moveLogBtnEdges;
    gf_DbgSnap(lv_s, "r0");
    BankValueSetFromInt(gv_dbgBank, lv_s, "armed", 1);
    BankSave(gv_dbgBank);
    // The host starts with the right button.
    lv_end = TimerGetElapsed(gv_sCOBA_Clock) + c_DBG_RACE_WAIT;
    while (gv_dbgRawBtn[2] == 0 && TimerGetElapsed(gv_sCOBA_Clock) < lv_end) {
        Wait(0.0625, c_timeGame);
    }
    BankValueSetFromFlag(gv_dbgBank, lv_s, "started", gv_dbgRawBtn[2] != 0);
    gf_DbgRaceWatch(lv_s);
    for (lv_i = 0; lv_i < 4; lv_i += 1) {
        BankValueSetFromInt(gv_dbgBank, lv_s, "downs" + IntToString(lv_i), gv_dbgRawDowns[lv_i]);
        BankValueSetFromInt(gv_dbgBank, lv_s, "ups" + IntToString(lv_i), gv_dbgRawUps[lv_i]);
    }
    BankValueSetFromInt(gv_dbgBank, lv_s, "repeats", gv_dbgRawRepeats);
    BankValueSetFromInt(gv_dbgBank, lv_s, "looseUps", gv_dbgRawLoose);
    BankValueSetFromString(gv_dbgBank, lv_s, "edgeLog", gv_dbgRawLog);
    BankValueSetFromInt(gv_dbgBank, lv_s, "rawEnd", gv_dbgRaw);
    BankValueSetFromInt(gv_dbgBank, lv_s, "scriptEnd", gf_DbgKeyBits(gv_kEYFORWARD[1], gv_kEYBACKWARD[1], gv_kEYLEFT[1], gv_kEYRIGHT[1]));
    BankValueSetFromInt(gv_dbgBank, lv_s, "btnLeft", gv_dbgRawBtn[0]);
    BankValueSetFromInt(gv_dbgBank, lv_s, "btnMiddle", gv_dbgRawBtn[1]);
    BankValueSetFromInt(gv_dbgBank, lv_s, "btnRight", gv_dbgRawBtn[2]);
    BankValueSetFromInt(gv_dbgBank, lv_s, "mapKeyEdges", gv_moveLogKeyEdges - lv_key0);
    BankValueSetFromInt(gv_dbgBank, lv_s, "mapAnyEdges", gv_moveLogAnyEdges - lv_any0);
    BankValueSetFromInt(gv_dbgBank, lv_s, "mapBtnEdges", gv_moveLogBtnEdges - lv_btn0);
    gf_DbgSnap(lv_s, "rend");
    if (gv_aIMACTIVE[1]) {
        gf_AimEnd(1);
    }
    UnitIssueOrder(gv_tPSUNIT[1], Order(AbilityCommand("SCOBATPSToggle", 1)), c_orderQueueReplace);
    Wait(0.5, c_timeGame);
    BankValueSetFromFlag(gv_dbgBank, lv_s, "tpsAfter", gf_TpsActive(1));
    BankSave(gv_dbgBank);
}

void gf_DbgKeysRaceGroup () {
    point lv_anchor = gv_dbgAnchor;

    gv_dbgAnchor = gf_DbgKeySpot();
    gf_DbgKeyRace();
    gv_dbgAnchor = lv_anchor;
}
