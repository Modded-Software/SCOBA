// Operator view (profiles/dropview.py), not a pass/fail test: the game as
// played. The intro deploy runs through the real Space path
// (gf_IntroDeployPress); after the first pod lands the hero is killed and
// the revive pod comes down on its own timer. Subtitles mark each step; raw
// times go to SCOBADROPVIEW.

trigger gt_DropView;

void gf_DwSay (string lp_s) {
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText(lp_s));
}

void gf_DwMark (bank lp_b, string lp_k) {
    BankValueSetFromFixed(lp_b, "dw", lp_k, TimerGetElapsed(gv_sCOBA_Clock));
    BankSave(lp_b);
}

// Waits until lp_pod is the pod state (a pod exists or not), at most lp_max s.
bool gf_DwWaitPod (bool lp_pod, fixed lp_max) {
    fixed lv_t = 0.0;

    while (UnitIsValid(gv_dropPod[1]) != lp_pod && lv_t < lp_max) {
        Wait(0.0625, c_timeGame);
        lv_t += 0.0625;
    }
    return UnitIsValid(gv_dropPod[1]) == lp_pod;
}

bool gt_DropView_Func (bool testConds, bool runActions) {
    bank lv_b;
    fixed lv_t = 0.0;
    unit lv_hero;

    if (!runActions) {
        return true;
    }
    lv_b = BankLoad("SCOBADROPVIEW", 1);
    // 1. The intro loop, as in game; then the deploy as Space does it.
    while ((gv_introState[1] != c_INTRO_LOOP || gv_introCuts[1] == 0) && lv_t < 20.0) {
        Wait(0.25, c_timeGame);
        lv_t += 0.25;
    }
    gf_DwMark(lv_b, "introLoop");
    BankValueSetFromInt(lv_b, "dw", "introState", gv_introState[1]);
    if (gv_introState[1] != c_INTRO_LOOP) {
        gf_DwSay("POD WATCH: intro is off in this map. Stopped.");
        return true;
    }
    Wait(3.0, c_timeGame);
    gf_DwSay("POD WATCH 1/3: initial deploy (as Space).");
    gf_IntroDeployPress(1);
    BankValueSetFromFlag(lv_b, "dw", "firstPod", gf_DwWaitPod(true, 30.0));
    gf_DwMark(lv_b, "firstPodAt");
    BankValueSetFromFlag(lv_b, "dw", "firstLanded", gf_DwWaitPod(false, 30.0));
    gf_DwMark(lv_b, "firstLandAt");
    // 2. Kill the hero a few seconds after touchdown.
    Wait(5.0, c_timeGame);
    lv_hero = gv_heroActive;
    BankValueSetFromString(lv_b, "dw", "hero", UnitGetType(lv_hero));
    gf_DwSay("POD WATCH 2/3: killing the hero. Revive pod comes on its timer.");
    gf_DwMark(lv_b, "killAt");
    UnitKill(lv_hero);
    // 3. The revive pod (its own timer), then its touchdown.
    BankValueSetFromFlag(lv_b, "dw", "revivePod", gf_DwWaitPod(true, 120.0));
    gf_DwMark(lv_b, "revivePodAt");
    gf_DwSay("POD WATCH 3/3: revive pod.");
    BankValueSetFromFlag(lv_b, "dw", "reviveLanded", gf_DwWaitPod(false, 30.0));
    gf_DwMark(lv_b, "reviveLandAt");
    Wait(5.0, c_timeGame);
    BankValueSetFromInt(lv_b, "dw", "done", 1);
    BankSave(lv_b);
    gf_DwSay("POD WATCH done.");
    return true;
}

void gt_DropView_Init () {
    gt_DropView = TriggerCreate("gt_DropView_Func");
    TriggerAddEventMapInit(gt_DropView);
}
