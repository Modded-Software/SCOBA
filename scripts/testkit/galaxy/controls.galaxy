// Controls test profile

trigger gt_ControlsTest;

void gf_ControlsTargetKey (string lp_section, string lp_tag) {
    unit lv_target;

    lv_target = gv_unitTarget[1];
    if (gf_IsClickEnemy(1, lv_target)) {
        BankValueSetFromString(gv_dbgBank, lp_section, lp_tag + "TargetType", "hostile");
    }
    else {
        BankValueSetFromString(gv_dbgBank, lp_section, lp_tag + "TargetType", "none");
    }
}

void gf_ControlsSnap (string lp_section, string lp_tag) {
    unit lv_hero;

    lv_hero = gv_tPSUNIT[1];
    gf_DbgSnap(lp_section, lp_tag);
    if (gf_TpsActive(1)) {
        BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "TpsMode", 1);
    }
    else {
        BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "TpsMode", 0);
    }
    BankValueSetFromFlag(gv_dbgBank, lp_section, lp_tag + "MiddleHold", gv_mOUSEMIDDLE[1]);
    if (gv_aIMACTIVE[1]) {
        BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "AimActive", 1);
    }
    else {
        BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "AimActive", 0);
    }
    BankValueSetFromFlag(gv_dbgBank, lp_section, lp_tag + "CursorVisible", gv_controlCursor[1]);
    if (gv_cONTROLRELATIVE[1]) {
        BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "ControlRelative", 1);
    }
    else {
        BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "ControlRelative", 0);
    }
    if (gv_rOTATEUNIT[1]) {
        BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "RotateUnit", 1);
    }
    else {
        BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "RotateUnit", 0);
    }
    if (gv_rOTATECAMERA[1]) {
        BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "RotateCamera", 1);
    }
    else {
        BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "RotateCamera", 0);
    }
    BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "CameraYaw", FixedToInt(CameraGetYaw(1)));
    BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "CamTargetX", FixedToInt(PointGetX(CameraGetTarget(1))));
    BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "CamTargetY", FixedToInt(PointGetY(CameraGetTarget(1))));
    BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "CamTargetXM", FixedToInt(PointGetX(CameraGetTarget(1)) * 1000.0));
    BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "CamTargetYM", FixedToInt(PointGetY(CameraGetTarget(1)) * 1000.0));
    BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "HeroXM", FixedToInt(PointGetX(UnitGetPosition(lv_hero)) * 1000.0));
    BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "HeroYM", FixedToInt(PointGetY(UnitGetPosition(lv_hero)) * 1000.0));
    BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "UnitFacing", FixedToInt(UnitGetFacing(lv_hero)));
    BankValueSetFromFlag(gv_dbgBank, lp_section, lp_tag + "AttackOrder", UnitOrderHasAbil(lv_hero, "attack"));
    BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "Fov", FixedToInt(gv_cAMERAFOV[1]));
    BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "Distance", FixedToInt(CameraGetDistance(1)));
    BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "UpperState", gv_animUpperState[1]);
    BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "LowerState", gv_animLowerState[1]);
    BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "MoveTarget", FixedToInt(c_ANIM_MOVE_TARGET * 100.0 + 0.5));
    BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "MoveRetarget", FixedToInt(c_ANIM_MOVE_RETARGET * 100.0 + 0.5));
    BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "MoveTick", FixedToInt(c_ANIM_MOVE_TICK * 1000.0 + 0.5));
    gf_ControlsTargetKey(lp_section, lp_tag);
    BankSave(gv_dbgBank);
}

void gf_ControlsToggle (int lp_command) {
    UnitIssueOrder(gv_tPSUNIT[1], Order(AbilityCommand("SCOBATPSToggle", lp_command)), c_orderQueueReplace);
}

bool gt_ControlsTest_Func (bool testConds, bool runActions) {
    unit lv_enemy;
    point lv_point;
    fixed lv_dist;

    if (!runActions) {
        return true;
    }
    Wait(3.0, c_timeGame);
    gv_dbgBank = BankLoad("SCOBACONTROLSTEST", 1);
    gv_bINPUTLOG = false;
    gv_bANIMLOG = true;
    gf_ProbeEnable(1);
    gv_animLogIndex[1] = 0;
    gv_animMoveHold[1] = 0;
    gv_dbgAnchor = UnitGetPosition(gv_tPSUNIT[1]);
    BankValueSetFromString(gv_dbgBank, "meta", "profile", "controls");
    BankValueSetFromInt(gv_dbgBank, "meta", "done", 0);
    BankValueSetFromInt(gv_dbgBank, "meta", "anchorX", FixedToInt(PointGetX(gv_dbgAnchor)));
    BankValueSetFromInt(gv_dbgBank, "meta", "anchorY", FixedToInt(PointGetY(gv_dbgAnchor)));
    BankSave(gv_dbgBank);

    gf_DbgReset("controls_default", false, true);
    gf_ControlsSnap("controls_default", "t0000");
    BankValueSetFromInt(gv_dbgBank, "controls_default", "ControlsReady", 1);
    BankSave(gv_dbgBank);

    UnitIssueOrder(gv_tPSUNIT[1], Order(AbilityCommand("SCOBARightClickToggle", 1)), c_orderQueueReplace);
    Wait(0.8, c_timeGame);
    gf_ControlsSnap("controls_pnc_hold", "t0800");
    UnitIssueOrder(gv_tPSUNIT[1], OrderTargetingPoint(AbilityCommand("move", 0), PointWithOffsetPolar(UnitGetPosition(gv_tPSUNIT[1]), 3.0, CameraGetYaw(1))), c_orderQueueReplace);
    Wait(0.7, c_timeGame);
    gf_ControlsSnap("controls_pnc_move", "t1500");
    Wait(2.5, c_timeGame);
    UnitIssueOrder(gv_tPSUNIT[1], Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
    Wait(1.5, c_timeGame);
    gf_ControlsSnap("controls_pnc_stop", "t3000");
    Wait(0.5, c_timeGame);

    lv_enemy = gf_DbgSpawnOne("controls_pnc_select", 5.0, 500.0);
    gf_UnitTargetSet(1, lv_enemy);
    Wait(0.1, c_timeGame);
    gf_ControlsSnap("controls_pnc_select", "t0100");
    UnitIssueOrder(gv_tPSUNIT[1], Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
    Wait(0.3, c_timeGame);
    gf_ControlsSnap("controls_pnc_target_idle", "t0300");

    gv_mOUSERIGHTCANCEL[1] = false;
    lv_point = UnitGetPosition(gv_tPSUNIT[1]);
    gf_RightClickExecute(1, lv_point, null);
    Wait(0.1, c_timeGame);
    gf_ControlsSnap("controls_pnc_cancel", "t0100");
    gf_UnitTargetSet(1, null);

    gf_ControlsToggle(0);
    Wait(0.5, c_timeGame);
    gf_ControlsSnap("controls_tps", "t0500");

    CameraSetValue(1, c_cameraValueYaw, (CameraGetYaw(1) + 40.0), 0.0, -1, 10);
    Wait(0.2, c_timeGame);
    gf_ControlsSnap("controls_turn", "t0100");
    Wait(0.3, c_timeGame);
    gf_ControlsSnap("controls_mouselook", "t0200");

    gf_ControlsSnap("controls_move", "t0000");
    UnitSetPosition(gv_tPSUNIT[1], PointWithOffsetPolar(UnitGetPosition(gv_tPSUNIT[1]), 0.5, CameraGetYaw(1)), true);
    UnitSetFacing(gv_tPSUNIT[1], CameraGetYaw(1), 0.01);
    Wait(0.05, c_timeGame);
    UnitSetPosition(gv_tPSUNIT[1], PointWithOffsetPolar(UnitGetPosition(gv_tPSUNIT[1]), 0.5, CameraGetYaw(1)), true);
    UnitSetFacing(gv_tPSUNIT[1], CameraGetYaw(1), 0.01);
    Wait(0.05, c_timeGame);
    UnitSetPosition(gv_tPSUNIT[1], PointWithOffsetPolar(UnitGetPosition(gv_tPSUNIT[1]), 0.5, CameraGetYaw(1)), true);
    UnitSetFacing(gv_tPSUNIT[1], CameraGetYaw(1), 0.01);
    Wait(0.05, c_timeGame);
    UnitSetPosition(gv_tPSUNIT[1], PointWithOffsetPolar(UnitGetPosition(gv_tPSUNIT[1]), 0.5, CameraGetYaw(1)), true);
    UnitSetFacing(gv_tPSUNIT[1], CameraGetYaw(1), 0.01);
    Wait(0.05, c_timeGame);
    UnitSetPosition(gv_tPSUNIT[1], PointWithOffsetPolar(UnitGetPosition(gv_tPSUNIT[1]), 0.5, CameraGetYaw(1)), true);
    UnitSetFacing(gv_tPSUNIT[1], CameraGetYaw(1), 0.01);
    Wait(0.05, c_timeGame);
    UnitSetPosition(gv_tPSUNIT[1], PointWithOffsetPolar(UnitGetPosition(gv_tPSUNIT[1]), 0.5, CameraGetYaw(1)), true);
    UnitSetFacing(gv_tPSUNIT[1], CameraGetYaw(1), 0.01);
    Wait(0.05, c_timeGame);
    UnitSetPosition(gv_tPSUNIT[1], PointWithOffsetPolar(UnitGetPosition(gv_tPSUNIT[1]), 0.5, CameraGetYaw(1)), true);
    UnitSetFacing(gv_tPSUNIT[1], CameraGetYaw(1), 0.01);
    Wait(0.05, c_timeGame);
    UnitSetPosition(gv_tPSUNIT[1], PointWithOffsetPolar(UnitGetPosition(gv_tPSUNIT[1]), 0.5, CameraGetYaw(1)), true);
    UnitSetFacing(gv_tPSUNIT[1], CameraGetYaw(1), 0.01);
    Wait(0.05, c_timeGame);
    UnitSetPosition(gv_tPSUNIT[1], PointWithOffsetPolar(UnitGetPosition(gv_tPSUNIT[1]), 0.5, CameraGetYaw(1)), true);
    UnitSetFacing(gv_tPSUNIT[1], CameraGetYaw(1), 0.01);
    Wait(0.05, c_timeGame);
    UnitSetPosition(gv_tPSUNIT[1], PointWithOffsetPolar(UnitGetPosition(gv_tPSUNIT[1]), 0.5, CameraGetYaw(1)), true);
    UnitSetFacing(gv_tPSUNIT[1], CameraGetYaw(1), 0.01);
    Wait(0.05, c_timeGame);
    gf_ControlsSnap("controls_move", "t0600");

    gf_ControlsSnap("controls_cursor", "t0000");

    // A middle click frees the cursor; the release keeps it; a second click
    // ends it.
    gf_TpsMouseDown(1, gv_aBILITYCAMERA);
    gf_TpsMouseUp(1, gv_aBILITYCAMERA);
    gf_ControlsSnap("controls_middle", "t0000");
    gf_TpsMouseDown(1, gv_aBILITYCAMERA);
    gf_TpsMouseUp(1, gv_aBILITYCAMERA);
    gf_ControlsSnap("controls_middle_release", "t0000");

    // R-PNC-45 with R-TPS-81: a middle click frees the cursor, and the
    // Weapon Attack command then acts as in PNC. The enemy stands in range,
    // straight ahead of the hero.
    lv_enemy = gf_DbgSpawnOne("controls_attack", 0.0, 500.0);
    UnitSetPosition(lv_enemy, PointWithOffsetPolar(UnitGetPosition(gv_tPSUNIT[1]), 3.0, CameraGetYaw(1)), false);
    gf_TpsMouseDown(1, gv_aBILITYCAMERA);
    gf_TpsMouseUp(1, gv_aBILITYCAMERA);
    Wait(0.2, c_timeGame);
    gf_ControlsSnap("controls_attack", "t0000");
    gf_PncAttack(1, lv_enemy);
    gf_DbgSnapAfterShot("controls_attack", "tshot");
    gf_ControlsSnap("controls_attack", "tshot");
    gf_TpsMouseDown(1, gv_aBILITYCAMERA);
    gf_TpsMouseUp(1, gv_aBILITYCAMERA);
    gf_UnitTargetSet(1, null);
    gf_DbgClearEnemies();
    Wait(0.2, c_timeGame);

    gf_AimBegin(1);
    Wait(0.2, c_timeGame);
    gf_ControlsSnap("controls_aim", "t0200");
    Wait(1.0, c_timeGame);
    gf_ControlsSnap("controls_aim", "t1200");

    gf_ControlsSnap("controls_ground", "t0000");
    Wait(0.1, c_timeGame);
    gf_ControlsSnap("controls_ground", "t0100");

    gf_ControlsSnap("controls_middle_click", "t0000");
    gf_TpsMouseDown(1, gv_aBILITYCAMERA);
    gf_TpsMouseUp(1, gv_aBILITYCAMERA);
    gf_ControlsSnap("controls_middle_click", "t0100");
    gf_TpsMouseDown(1, gv_aBILITYCAMERA);
    gf_TpsMouseUp(1, gv_aBILITYCAMERA);

    gf_ControlsToggle(1);
    Wait(0.5, c_timeGame);
    gf_ControlsSnap("controls_pnc", "t0500");

    lv_dist = CameraGetDistance(1);
    gv_cameraCollisionOff[1] = true;
    gv_cameraDistanceDesired[1] = lv_dist + 1.5;
    gf_CameraZoomApply(1);
    Wait(0.35, c_timeGame);
    gf_ControlsSnap("controls_zoom", "t0100");
    gv_cameraDistanceDesired[1] = lv_dist;
    gf_CameraZoomApply(1);
    Wait(0.35, c_timeGame);
    gv_cameraCollisionOff[1] = false;
    Wait(0.15, c_timeGame);
    gf_ControlsSnap("controls_collision", "t0200");
    CameraSetValue(1, c_cameraValuePitch, -60.0, 0.1, -1, 10);
    Wait(0.5, c_timeGame);
    gf_ControlsSnap("controls_collision_clamp", "t0500");
    CameraSetValue(1, c_cameraValuePitch, 30.0, 0.1, -1, 10);
    Wait(0.8, c_timeGame);
    gf_ControlsSnap("controls_collision_restore", "t0800");

    gf_ProbeDisable(1);
    BankValueSetFromInt(gv_dbgBank, "meta", "done", 1);
    BankSave(gv_dbgBank);
    return true;
}

void gt_ControlsTest_Init () {
    gt_ControlsTest = TriggerCreate("gt_ControlsTest_Func");
    TriggerAddEventMapInit(gt_ControlsTest);
}
