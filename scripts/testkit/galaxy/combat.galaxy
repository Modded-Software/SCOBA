// WASD / Point & Click combat profile.
// Every value is written to the bank. Nothing here needs visual inspection.
trigger gt_DbgTest;

void gf_DbgWalk (int lp_steps, fixed lp_angle) {
    int lv_i;

    gv_fORWARD[1] = true;
    gf_CombatSetRoot(1, false);
    for (lv_i = 0; lv_i < lp_steps; lv_i += 1) {
        gf_CombatMoveStep(1, lp_angle);
        Wait(0.0625, c_timeGame);
    }
    gv_fORWARD[1] = false;
    gf_CombatSyncRoot(1);
}

void gf_DbgSingleShots (string lp_section, fixed lp_dx) {
    gf_DbgSpawnOne(lp_section, lp_dx, 500.0);
    gf_DbgSnap(lp_section, "t0000");
    gf_PncAttack(1, gv_dbgEnemy);
    Wait(0.1, c_timeGame);
    gf_DbgSnap(lp_section, "t0100");
    Wait(0.4, c_timeGame);
    gf_DbgSnap(lp_section, "t0500");
    Wait(1.0, c_timeGame);
    gf_DbgSnap(lp_section, "t1500");
    Wait(2.5, c_timeGame);
    gf_DbgSnap(lp_section, "t4000");
    gf_PncAttack(1, gv_dbgEnemy);
    Wait(2.0, c_timeGame);
    gf_PncAttack(1, gv_dbgEnemy);
    Wait(2.0, c_timeGame);
    gf_DbgSnap(lp_section, "t8000");
}

void gf_DbgAutoRun (string lp_section, fixed lp_dx, fixed lp_wait) {
    gf_DbgSpawnOne(lp_section, lp_dx, 500.0);
    gf_DbgSnap(lp_section, "t0000");
    Wait(lp_wait, c_timeGame);
    gf_DbgSnap(lp_section, "tend");
}

// Switch to Kerrigan after a reset. The switch copies both toggles.
void gf_DbgUseKerrigan () {
    gf_HeroSwitchTo(gv_heroKerrigan);
    Wait(0.5, c_timeGame);
}

// One right hold with one movement key. The hero starts turned away from
// the camera yaw, so the lock is visible in the facing.
void gf_DbgHoldMove (string lp_section, bool lp_back, bool lp_left) {
    gf_DbgReset(lp_section, false, true);
    UnitSetFacing(gv_tPSUNIT[1], CameraGetYaw(1) + 120.0, 0.0);
    Wait(0.2, c_timeGame);
    gf_DbgSnap(lp_section, "t0000");
    gf_DbgHold(true, false);
    Wait(0.5, c_timeGame);
    gf_DbgSnap(lp_section, "thold");
    gv_bACKWARD[1] = lp_back;
    gv_lEFT[1] = lp_left;
    Wait(1.5, c_timeGame);
    gf_DbgSnap(lp_section, "tmove");
    gv_bACKWARD[1] = false;
    gv_lEFT[1] = false;
    Wait(0.4, c_timeGame);
    gf_CombatSyncRoot(1);
    gf_DbgSnap(lp_section, "tstop");
    gf_DbgHold(false, false);
    Wait(0.3, c_timeGame);
    gf_DbgSnap(lp_section, "tend");
}

// Runs the real W key loop beside the test thread.
trigger gt_DbgForward;
bool gt_DbgForward_Func (bool testConds, bool runActions) {
    gf_ForwardBegin(1);
    return true;
}

// A hold walking while the camera turns 90 degrees in small steps. Forward
// uses the W loop, else A strafes. Records the straight distance, the worst
// facing lag and the smallest position step.
void gf_DbgHoldTurn (string lp_section, bool lp_right, bool lp_forward) {
    int lv_i;
    fixed lv_yaw;
    fixed lv_start;
    fixed lv_off;
    fixed lv_step;
    fixed lv_maxOff;
    fixed lv_minStep;
    point lv_last;

    gf_DbgReset(lp_section, false, true);
    gf_DbgHold(lp_right, !lp_right);
    Wait(0.3, c_timeGame);
    if (lp_forward) {
        TriggerExecute(gt_DbgForward, false, false);
    }
    else {
        gv_lEFT[1] = true;
    }
    Wait(0.5, c_timeGame);
    lv_last = UnitGetPosition(gv_tPSUNIT[1]);
    Wait(1.0, c_timeGame);
    BankValueSetFromInt(gv_dbgBank, lp_section, "Dist1000", FixedToInt(DistanceBetweenPoints(lv_last, UnitGetPosition(gv_tPSUNIT[1])) * 1000.0));
    gf_DbgSnap(lp_section, "t0000");
    lv_start = CameraGetYaw(1);
    lv_yaw = lv_start;
    lv_minStep = 100.0;
    lv_last = UnitGetPosition(gv_tPSUNIT[1]);
    for (lv_i = 0; lv_i < 30; lv_i += 1) {
        lv_yaw = lv_yaw + 3.0;
        CameraSetValue(1, c_cameraValueYaw, lv_yaw, 0.0, -1, 10);
        Wait(0.0625, c_timeGame);
        lv_off = AbsF(gf_AnimYawDelta(UnitGetFacing(gv_tPSUNIT[1]), CameraGetYaw(1)));
        lv_step = DistanceBetweenPoints(lv_last, UnitGetPosition(gv_tPSUNIT[1]));
        lv_last = UnitGetPosition(gv_tPSUNIT[1]);
        if (lv_off > lv_maxOff) {
            lv_maxOff = lv_off;
        }
        if (lv_step < lv_minStep) {
            lv_minStep = lv_step;
        }
    }
    BankValueSetFromInt(gv_dbgBank, lp_section, "MaxOff10", FixedToInt(lv_maxOff * 10.0));
    BankValueSetFromInt(gv_dbgBank, lp_section, "MinStep1000", FixedToInt(lv_minStep * 1000.0));
    BankValueSetFromInt(gv_dbgBank, lp_section, "YawTurned", FixedToInt(AbsF(gf_AnimYawDelta(lv_start, CameraGetYaw(1)))));
    gf_DbgSnap(lp_section, "tturn");
    gv_lEFT[1] = false;
    gv_fORWARD[1] = false;
    Wait(0.1, c_timeGame);
    gf_AimMoveStop(1);
    gf_CombatSyncRoot(1);
    CameraSetValue(1, c_cameraValueYaw, lv_start, 0.0, -1, 10);
    gf_DbgHold(false, false);
    Wait(0.3, c_timeGame);
    gf_DbgSnap(lp_section, "tend");
}

bool gt_DbgTest_Func (bool testConds, bool runActions) {
    int lv_i;
    int lv_seen;

    if (!runActions) {
        return true;
    }
    Wait(3.0, c_timeGame);
    gv_dbgBank = BankLoad("SCOBATEST", 1);
    gv_bINPUTLOG = true;
    BankValueSetFromInt(gv_dbgBank, "meta", "done", 0);
    gv_dbgAnchor = UnitGetPosition(gv_tPSUNIT[1]);
    gf_DbgProbeInit();
    BankSave(gv_dbgBank);

    // Defaults at map start.
    gf_DbgSnap("startup", "t0000");

    if (gf_DbgGroup("idle")) {
        // Single: no acquisition of an idle enemy in range.
        gf_DbgReset("single_idle", false, true);
        gf_DbgAutoRun("single_idle", 3.0, 3.0);

        // Single: no retaliation. The attacker becomes the UI target.
        gf_DbgReset("single_attacked", false, false);
        gf_DbgSpawnOne("single_attacked", 1.0, 500.0);
        UnitSetState(gv_dbgEnemy, c_unitStateStunned, false);
        UnitIssueOrder(gv_dbgEnemy, OrderTargetingUnit(AbilityCommand("attack", 0), gv_tPSUNIT[1]), c_orderQueueReplace);
        gf_DbgSnap("single_attacked", "t0000");
        Wait(3.0, c_timeGame);
        gf_DbgSnap("single_attacked", "tend");
    }
    if (gf_DbgGroup("single")) {
        // Single: one shot per command, three commands give three shots.
        gf_DbgReset("single_shot", false, true);
        gf_DbgSingleShots("single_shot", 3.0);

        // Single, stand, out of range: no order and no movement.
        gf_DbgReset("single_out_stand", false, true);
        gf_DbgSpawnOne("single_out_stand", 11.0, 500.0);
        gf_DbgSnap("single_out_stand", "t0000");
        gf_PncAttack(1, gv_dbgEnemy);
        Wait(1.5, c_timeGame);
        gf_DbgSnap("single_out_stand", "tend");

        // Single, move, out of range: walk in, one shot, then idle.
        gf_DbgReset("single_out_move", false, false);
        gf_DbgSpawnOne("single_out_move", 10.0, 500.0);
        gf_DbgSnap("single_out_move", "t0000");
        gf_PncAttack(1, gv_dbgEnemy);
        Wait(5.0, c_timeGame);
        gf_DbgSnap("single_out_move", "t5000");
        Wait(2.5, c_timeGame);
        gf_DbgSnap("single_out_move", "tend");
    }
    if (gf_DbgGroup("auto")) {
        // Auto: a commanded attack repeats.
        gf_DbgReset("auto_click", true, true);
        gf_DbgSpawnOne("auto_click", 3.0, 500.0);
        gf_DbgSnap("auto_click", "t0000");
        gf_PncAttack(1, gv_dbgEnemy);
        Wait(4.0, c_timeGame);
        gf_DbgSnap("auto_click", "tend");
        gf_DbgSnapAfterShot("auto_click", "tshot");

        // Auto, stand: engine acquires in range, never moves.
        gf_DbgReset("auto_stand_in", true, true);
        gf_DbgAutoRun("auto_stand_in", 3.0, 3.0);
        gf_DbgSnapAfterShot("auto_stand_in", "tshot");
        gf_DbgReset("auto_stand_out", true, true);
        gf_DbgAutoRun("auto_stand_out", 11.0, 3.0);

        // Auto, move: engine walks into range and attacks.
        gf_DbgReset("auto_move_near", true, false);
        gf_DbgAutoRun("auto_move_near", 9.0, 5.0);
        gf_DbgReset("auto_move_far", true, false);
        gf_DbgAutoRun("auto_move_far", 12.0, 5.0);

        // Auto to single through the toggle ability stops the attack.
        gf_DbgReset("auto_to_single", true, true);
        gf_DbgSpawnOne("auto_to_single", 3.0, 500.0);
        Wait(1.5, c_timeGame);
        gf_DbgSnap("auto_to_single", "t0000");
        UnitIssueOrder(gv_tPSUNIT[1], Order(AbilityCommand("SCOBAAutoAttackToggle", 0)), c_orderQueueReplace);
        // Raw: ticks in which the attack-end behavior is on the hero.
        lv_seen = 0;
        for (lv_i = 0; lv_i < 4; lv_i += 1) {
            Wait(0.0625, c_timeGame);
            lv_seen += UnitBehaviorCount(gv_tPSUNIT[1], c_SCOBA_ATTACK_END_BEHAVIOR);
        }
        BankValueSetFromInt(gv_dbgBank, "auto_to_single", "endSeenTicks", lv_seen);
        BankValueSetFromInt(gv_dbgBank, "auto_to_single", "endOrderCount", UnitOrderCount(gv_tPSUNIT[1]));
        Wait(0.75, c_timeGame);
        gf_DbgSnap("auto_to_single", "t1000");
        Wait(2.5, c_timeGame);
        gf_DbgSnap("auto_to_single", "tend");
        UnitIssueOrder(gv_tPSUNIT[1], Order(AbilityCommand("SCOBAAutoAttackToggle", 1)), c_orderQueueReplace);
        Wait(0.5, c_timeGame);
        gf_DbgSnap("auto_to_single", "tback");
    }
    if (gf_DbgGroup("cancel")) {
        // Cancel clears the UI target and the pending attack.
        gf_DbgReset("cancel", false, false);
        gf_DbgSpawnOne("cancel", 9.0, 500.0);
        gf_PncAttack(1, gv_dbgEnemy);
        Wait(0.3, c_timeGame);
        gf_DbgSnap("cancel", "t0000");
        gf_PncCancel(1);
        Wait(2.5, c_timeGame);
        gf_DbgSnap("cancel", "tend");

        // Right click on the ground: cancel, then move in Chase move only.
        gf_DbgReset("ground_move", false, false);
        gf_DbgSpawnOne("ground_move", 9.0, 500.0);
        gf_UnitTargetSet(1, gv_dbgEnemy);
        gf_DbgSnap("ground_move", "t0000");
        gf_RightClickExecute(1, PointWithOffset(gv_dbgAnchor, -5.0, 0.0), null);
        Wait(1.0, c_timeGame);
        gf_DbgSnap("ground_move", "tend");
        gf_DbgReset("ground_stand", false, true);
        gf_DbgSpawnOne("ground_stand", 9.0, 500.0);
        gf_UnitTargetSet(1, gv_dbgEnemy);
        gf_DbgSnap("ground_stand", "t0000");
        gf_RightClickExecute(1, PointWithOffset(gv_dbgAnchor, -5.0, 0.0), null);
        Wait(1.0, c_timeGame);
        gf_DbgSnap("ground_stand", "tend");
    }
    if (gf_DbgGroup("wasd")) {
        // WASD: moves in stand, restores the root on release.
        gf_DbgReset("wasd_stand", false, true);
        gf_DbgSnap("wasd_stand", "t0000");
        gf_DbgWalk(16, 270.0);
        Wait(0.3, c_timeGame);
        gf_DbgSnap("wasd_stand", "tend");

        // Auto: the weapon fires while WASD moves the hero.
        gf_DbgReset("move_fire_auto", true, false);
        gf_DbgSpawnOne("move_fire_auto", 3.0, 500.0);
        gf_DbgSnap("move_fire_auto", "t0000");
        gf_DbgWalk(32, 270.0);
        gf_DbgSnap("move_fire_auto", "tend");

        // Single: no fire while WASD moves the hero.
        gf_DbgReset("move_fire_single", false, false);
        gf_DbgSpawnOne("move_fire_single", 3.0, 500.0);
        gf_DbgSnap("move_fire_single", "t0000");
        gf_DbgWalk(32, 270.0);
        gf_DbgSnap("move_fire_single", "tend");
    }
    if (gf_DbgGroup("hold")) {
        // Right hold: facing locked to the camera yaw. S backpedals.
        gf_DbgHoldMove("hold_right_back", true, false);
        // Right hold: A strafes left.
        gf_DbgHoldMove("hold_right_left", false, true);
        gf_DbgHoldTurn("hold_right_turn", true, false);
        // The same forward walk under each hold. The suite compares them.
        gf_DbgHoldTurn("hold_middle_fwd", false, true);
        gf_DbgHoldTurn("hold_right_fwd", true, true);

        // Middle hold steers. It is not a strafe hold, alone or with right.
        gf_DbgReset("hold_middle", false, true);
        gf_DbgHold(false, true);
        Wait(0.3, c_timeGame);
        gf_DbgSnap("hold_middle", "tmiddle");
        gf_DbgHold(true, true);
        Wait(0.3, c_timeGame);
        gf_DbgSnap("hold_middle", "tboth");
        gf_DbgHold(false, false);
        Wait(0.3, c_timeGame);
        gf_DbgSnap("hold_middle", "tend");
    }
    if (gf_DbgGroup("button")) {
        // Weapon Attack button: attacks like a right click and shows the cooldown.
        gf_DbgReset("weapon_button", false, true);
        gf_DbgSpawnOne("weapon_button", 3.0, 500.0);
        gf_DbgSnap("weapon_button", "t0000");
        UnitIssueOrder(gv_tPSUNIT[1], OrderTargetingUnit(AbilityCommand("SCOBAAutoAttackStatus", 0), gv_dbgEnemy), c_orderQueueReplace);
        Wait(0.5, c_timeGame);
        gf_DbgSnap("weapon_button", "t0500");
        Wait(2.5, c_timeGame);
        gf_DbgSnap("weapon_button", "tend");

        // A press that fires no shot starts no cooldown.
        gf_DbgReset("button_out", false, true);
        gf_DbgSpawnOne("button_out", 11.0, 500.0);
        gf_DbgSnap("button_out", "t0000");
        UnitIssueOrder(gv_tPSUNIT[1], OrderTargetingUnit(AbilityCommand("SCOBAAutoAttackStatus", 0), gv_dbgEnemy), c_orderQueueReplace);
        Wait(0.5, c_timeGame);
        gf_DbgSnap("button_out", "tend");
    }
    if (gf_DbgGroup("switch")) {
        // Hero switch keeps both toggles.
        gf_DbgReset("switch_single_stand", false, true);
        gf_DbgUseKerrigan();
        gf_DbgSnap("switch_single_stand", "tend");
        gf_DbgReset("switch_auto_move", true, false);
        gf_DbgUseKerrigan();
        gf_DbgSnap("switch_auto_move", "tend");
    }
    if (gf_DbgGroup("kerrigan")) {
        // Kerrigan weapons: one full shot per command.
        gf_DbgReset("talons_single", false, true);
        gf_DbgUseKerrigan();
        gf_DbgSingleShots("talons_single", 1.2);
        gf_DbgReset("talons_auto", true, true);
        gf_DbgUseKerrigan();
        gf_DbgAutoRun("talons_auto", 1.2, 4.0);
        gf_DbgSnapAfterShot("talons_auto", "tshot");
        gf_DbgReset("psiblast_single", false, true);
        gf_DbgUseKerrigan();
        gf_DbgSingleShots("psiblast_single", 3.0);
    }

    gf_DbgReset("done", false, true);
    gf_DbgSnap("done", "tend");
    BankValueSetFromInt(gv_dbgBank, "meta", "ready", 1);
    BankValueSetFromInt(gv_dbgBank, "meta", "done", 1);
    BankSave(gv_dbgBank);
    return true;
}

void gt_DbgTest_Init () {
    gt_DbgForward = TriggerCreate("gt_DbgForward_Func");
    gt_DbgTest = TriggerCreate("gt_DbgTest_Func");
    TriggerAddEventMapInit(gt_DbgTest);
}
