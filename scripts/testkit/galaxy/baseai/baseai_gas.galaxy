// Test harness: baseai group "gas" (R-BASE-35, R-BASE-36, SPEC-BASE-AI 6).
// 6x6 geysers and gas buildings. Core: the shared constants and state, the
// lookups, the AI snapshot and the base facts. The modules, in include
// order (scripts/testkit/profiles/baseai.py):
//   baseai_gas_build  direct builds by a script worker, lanes 1 and 4,
//                     no base, no AI (R-BASE-35)
//   baseai_gas_probe  stock-AI probes: watch, town, extra, scan, ring,
//                     reach (SPEC-BASE-AI 8)
//   baseai_gas_help   the help probe (SC2_BA_GAS_HELP)
//   baseai_gas_map    the map's gas orders: read-out and cases (R-BASE-36)
//   baseai_gas_main   the sequence, gf_BgGas
// Raw engine values only; scripts/testkit/profiles/baseai_gas.py decides.

const int c_BG_COLLECTOR = 0x10008800;  // buildai.galaxy c_makeCollector: c_onVespeneGas | c_nearCloseDropoff | c_nearFarDropoff
const fixed c_BG_NEAR = 1.5;          // a gas building stands on its geyser
const fixed c_BG_TOWN = 20.0;         // geysers this near a start count as its own
const int c_BG_EXTRAS = 2;            // 0 the stock 3x3 RichVespeneGeyser, 1 a 6x6 VespeneGeyser
const fixed c_BG_CLEAR_MAX = 8.0;     // open-ground scan: this far from a geyser point

point[16][2] gv_bgExtraAt;            // the probe geysers of an AI lane owner
bool gv_bgHelp;                       // the help probe (SC2_BA_GAS_HELP=1), set by the map init
bool gv_bgExtraOn;                    // the stock baseline probes (SC2_BA_GAS_EXTRA=1), set by the map init
point[16][2] gv_bgGeyserAt;           // the placed geysers of a base, as found at the start
bool gv_bgRing;                       // the ring probe (SC2_BA_GAS_RING=1), set by the map init
bool gv_bgTown;                       // the town probe (SC2_BA_GAS_TOWN=1), set by the map init

string gf_BgGasType (int lp_player) {
    if (PlayerRace(lp_player) == "Terr") {
        return "Refinery";
    }
    return "Extractor";
}

// Build3 of TerranBuild / ZergBuild / ProtossBuild (liberty AbilData).
string gf_BgAbil (string lp_gas) {
    if (lp_gas == "Refinery") {
        return "TerranBuild";
    }
    if (lp_gas == "Extractor") {
        return "ZergBuild";
    }
    return "ProtossBuild";
}

abilcmd gf_BgCmd (string lp_gas) {
    return AbilityCommand(gf_BgAbil(lp_gas), 2);
}

string gf_BgWorker (string lp_gas) {
    if (lp_gas == "Refinery") {
        return "SCV";
    }
    if (lp_gas == "Extractor") {
        return "Drone";
    }
    return "Probe";
}

// The gather ability of lp_player's workers.
string gf_BgHarvest (int lp_player) {
    if (PlayerRace(lp_player) == "Terr") {
        return "SCVHarvest";
    }
    return "DroneHarvest";
}

string gf_BgFormName (int lp_form) {
    if (lp_form == 0) {
        return "Point";
    }
    if (lp_form == 1) {
        return "Place";
    }
    return "Unit";
}

// lp_gas buildings of any state of lp_player in a circle.
int gf_BgCount (string lp_gas, int lp_player, point lp_at, fixed lp_r) {
    return UnitGroupCount(UnitGroup(lp_gas, lp_player, RegionCircle(lp_at, lp_r), UnitFilter(0, 0, 0, 0), 0), c_unitCountAlive);
}

int gf_BgCountAll (int lp_player) {
    return UnitGroupCount(UnitGroup(gf_BgGasType(lp_player), lp_player, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0), c_unitCountAlive);
}

// The geysers the map placed for the base at lp_at: the probe geysers
// (gf_BgExtra) are left out.
unitgroup gf_BgPlaced (point lp_at) {
    unitgroup lv_g = UnitGroup("VespeneGeyser", c_playerAny, RegionCircle(lp_at, c_BG_TOWN), UnitFilter(0, 0, 0, 0), 0);
    int lv_p;
    int lv_n;

    for (lv_p = 0; lv_p < 16; lv_p += 1) {
        for (lv_n = 0; lv_n < c_BG_EXTRAS; lv_n += 1) {
            if (gv_bgExtraAt[lv_p][lv_n] != null) {
                UnitGroupRemoveUnitGroup(lv_g, UnitGroup("VespeneGeyser", c_playerAny, RegionCircle(gv_bgExtraAt[lv_p][lv_n], 0.1), UnitFilter(0, 0, 0, 0), 0));
            }
        }
    }
    return lv_g;
}

// The placed geysers of the base at lp_at: 0 the nearest, 1 the other.
unit gf_BgGeyser (point lp_at, int lp_n) {
    unitgroup lv_g = gf_BgPlaced(lp_at);
    unit lv_u = UnitGroupClosestToPoint(lv_g, lp_at);

    if (lp_n == 0 || !UnitIsValid(lv_u)) {
        return lv_u;
    }
    UnitGroupRemove(lv_g, lv_u);
    return UnitGroupClosestToPoint(lv_g, lp_at);
}

// Engine pathing and state of the lp_gas building at lp_at, under lp_k
// (Grid rows: baseai_hall gf_BaHallGrid, 9 cells each way).
void gf_BgGasGrid (string lp_s, string lp_k, string lp_gas, int lp_player, point lp_at) {
    unit lv_b = UnitGroupClosestToPoint(UnitGroup(lp_gas, lp_player, RegionCircle(lp_at, c_BG_NEAR), UnitFilter(0, 0, 0, 0), 0), lp_at);

    gf_BaHallGrid(lp_s, lp_k, lp_at);
    BankValueSetFromInt(gv_dbgBank, lp_s, lp_k + "Found", gf_BaFlagInt(UnitIsValid(lv_b)));
    if (UnitIsValid(lv_b)) {
        BankValueSetFromInt(gv_dbgBank, lp_s, lp_k + "Building", gf_BaFlagInt(UnitTestState(lv_b, c_unitStateUnderConstruction)));
        BankValueSetFromInt(gv_dbgBank, lp_s, lp_k + "Radius100", gf_Ba100(UnitGetPropertyFixed(lv_b, c_unitPropRadius, c_unitPropCurrent)));
    }
}

// What the AI of lp_player sees and has, under key p<player><tag>.
void gf_BgAiSnap (string lp_s, string lp_tag, int lp_player) {
    string lv_k = "p" + IntToString(lp_player) + lp_tag;
    point lv_h = PlayerStartLocation(lp_player);

    BankValueSetFromInt(gv_dbgBank, lp_s, lv_k + "Gas", gf_BgCountAll(lp_player));
    BankValueSetFromInt(gv_dbgBank, lp_s, lv_k + "RawSpots", AIGetRawGasNumSpots(lp_player, c_townOne));
    BankValueSetFromInt(gv_dbgBank, lp_s, lv_k + "HarvestSpots", AIGetHarvestableGasNumSpots(lp_player, c_townOne));
    BankValueSetFromString(gv_dbgBank, lp_s, lv_k + "Place100", gf_BaXY100(AIGetBuildingPlacement(lp_player, lv_h, gf_BgGasType(lp_player), c_BG_COLLECTOR)));
    BankValueSetFromInt(gv_dbgBank, lp_s, lv_k + "TownState", AIGetTownState(lp_player, c_townOne));
    BankValueSetFromString(gv_dbgBank, lp_s, lv_k + "TownAt100", gf_BaXY100(AIGetTownLocation(lp_player, c_townOne)));
    BankValueSetFromInt(gv_dbgBank, lp_s, lv_k + "Minerals", PlayerGetPropertyInt(lp_player, c_playerPropMinerals));
    BankValueSetFromInt(gv_dbgBank, lp_s, lv_k + "GasCollected", PlayerGetPropertyInt(lp_player, c_playerPropVespeneCollected));
    BankValueSetFromInt(gv_dbgBank, lp_s, lv_k + "Workers", UnitGroupCount(UnitGroup(gf_BaWorkerType(lp_player), lp_player, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0), c_unitCountAlive));
    BankValueSetFromInt(gv_dbgBank, lp_s, lv_k + "Allowed", gf_BaFlagInt(TechTreeUnitIsAllowed(lp_player, gf_BgGasType(lp_player))));
    BankValueSetFromInt(gv_dbgBank, lp_s, lv_k + "Started", gf_BaFlagInt(gv_baseAiStarted[lp_player]));
    // The map's gas orders so far (R-BASE-36).
    BankValueSetFromInt(gv_dbgBank, lp_s, lv_k + "MapBuilds", gv_baseGasBuilds[lp_player]);
    BankValueSetFromInt(gv_dbgBank, lp_s, lv_k + "MapGathers", gv_baseGasGathers[lp_player]);
    // Raw: the AI's own count of its gas buildings, queued or better.
    BankValueSetFromInt(gv_dbgBank, lp_s, lv_k + "TechQueued", AITechCount(lp_player, gf_BgGasType(lp_player), c_techCountQueuedOrBetter));
    BankValueSetFromInt(gv_dbgBank, lp_s, lv_k + "Structures", UnitGroupCount(UnitGroup(null, lp_player, RegionEntireMap(), UnitFilter((1 << c_targetFilterStructure), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))), 0), c_unitCountAlive));
    if (gv_baseAiStarted[lp_player]) {
        // Raw: what the workers are doing, and the first build order's target.
        BankValueSetFromString(gv_dbgBank, lp_s, lv_k + "WorkerOrders", gf_BaAllWorkerOrders(lp_player));
        BankValueSetFromString(gv_dbgBank, lp_s, lv_k + "BuildOrder", gf_BaBuildOrder(lp_player));
    }
}

// The game's lane start for an AI lane: base, then the stock AI
// (gf_BaseAiCreateLane). Map init does not do it in a test map.
void gf_BgStart (string lp_s, int lp_lane) {
    int lv_p = gf_BaseAiLaneOwner(lp_lane);

    gf_BaseAiCreateLane(lp_lane);
    BankValueSetFromInt(gv_dbgBank, lp_s, "p" + IntToString(lv_p) + "HallValid", gf_BaFlagInt(UnitIsValid(gv_baseAiHall[lv_p])));
    if (UnitIsValid(gv_baseAiHall[lv_p])) {
        gv_baAt[lv_p] = UnitGetPosition(gv_baseAiHall[lv_p]);
    }
}

// Raw: distance x100 from lp_at to the nearest blocked 0.5 sub-cell outside
// its own square of half side lp_own, within c_BG_CLEAR_MAX (that value
// x100 if none): how much open ground lies around a geyser.
int gf_BgClear100 (point lp_at, fixed lp_own) {
    fixed lv_best = c_BG_CLEAR_MAX;
    int lv_n = FixedToInt(c_BG_CLEAR_MAX * 2.0);
    point lv_p;
    fixed lv_d;
    int lv_i;
    int lv_j;

    for (lv_j = -lv_n; lv_j < lv_n; lv_j += 1) {
        for (lv_i = -lv_n; lv_i < lv_n; lv_i += 1) {
            lv_p = gf_BaHallSub(lp_at, lv_i, lv_j);
            if (AbsF(PointGetX(lv_p) - PointGetX(lp_at)) < lp_own && AbsF(PointGetY(lv_p) - PointGetY(lp_at)) < lp_own) {
                continue;
            }
            lv_d = DistanceBetweenPoints(lv_p, lp_at);
            if (lv_d < lv_best && !PointPathingPassable(lv_p)) {
                lv_best = lv_d;
            }
        }
    }
    return gf_Ba100(lv_best);
}

// Static facts of the base of lp_player, under key p<player>: both placed
// geysers, their distance from the start and from the AI's town point.
void gf_BgFacts (string lp_s, int lp_player) {
    string lv_k = "p" + IntToString(lp_player);
    point lv_h = PlayerStartLocation(lp_player);
    point lv_town = AIGetTownLocation(lp_player, c_townOne);
    unit lv_g;
    int lv_n;

    BankValueSetFromString(gv_dbgBank, lp_s, lv_k + "Race", PlayerRace(lp_player));
    BankValueSetFromString(gv_dbgBank, lp_s, lv_k + "Start100", gf_BaXY100(lv_h));
    if (UnitIsValid(gv_baseAiHall[lp_player])) {
        BankValueSetFromString(gv_dbgBank, lp_s, lv_k + "Hall100", gf_BaXY100(UnitGetPosition(gv_baseAiHall[lp_player])));
    }
    BankValueSetFromInt(gv_dbgBank, lp_s, lv_k + "Geysers", UnitGroupCount(gf_BgPlaced(lv_h), c_unitCountAlive));
    for (lv_n = 0; lv_n < 2; lv_n += 1) {
        lv_g = gf_BgGeyser(lv_h, lv_n);
        if (!UnitIsValid(lv_g)) {
            continue;
        }
        gv_bgGeyserAt[lp_player][lv_n] = UnitGetPosition(lv_g);
        BankValueSetFromString(gv_dbgBank, lp_s, lv_k + "G" + IntToString(lv_n) + "At100", gf_BaXY100(UnitGetPosition(lv_g)));
        BankValueSetFromInt(gv_dbgBank, lp_s, lv_k + "G" + IntToString(lv_n) + "Start100", gf_Ba100(DistanceBetweenPoints(lv_h, UnitGetPosition(lv_g))));
        if (lv_town != null) {
            BankValueSetFromInt(gv_dbgBank, lp_s, lv_k + "G" + IntToString(lv_n) + "Town100", gf_Ba100(DistanceBetweenPoints(lv_town, UnitGetPosition(lv_g))));
            // Raw: where the AI places the gas building when asked at the geyser itself.
            BankValueSetFromString(gv_dbgBank, lp_s, lv_k + "G" + IntToString(lv_n) + "Place100", gf_BaXY100(AIGetBuildingPlacement(lp_player, UnitGetPosition(lv_g), gf_BgGasType(lp_player), c_BG_COLLECTOR)));
        }
        BankValueSetFromInt(gv_dbgBank, lp_s, lv_k + "G" + IntToString(lv_n) + "Res", UnitGetPropertyInt(lv_g, c_unitPropResources, c_unitPropCurrent));
        // Raw: the geyser data this run used (SC2_BA_GEYSER A/B probes change it).
        BankValueSetFromString(gv_dbgBank, lp_s, lv_k + "G" + IntToString(lv_n) + "Radius", CatalogFieldValueGet(c_gameCatalogUnit, UnitGetType(lv_g), "Radius", 0));
        BankValueSetFromString(gv_dbgBank, lp_s, lv_k + "G" + IntToString(lv_n) + "Foot", CatalogFieldValueGet(c_gameCatalogUnit, UnitGetType(lv_g), "Footprint", 0));
        // Raw: the open ground around the geyser, outside its own 6x6.
        BankValueSetFromInt(gv_dbgBank, lp_s, lv_k + "G" + IntToString(lv_n) + "Clear100", gf_BgClear100(UnitGetPosition(lv_g), 3.0));
    }
}

// One order form of the lp_gas build command for worker lp_w: 0 names the
// point, 1 carries a placement (a player's click), 2 names the geyser unit.
order gf_BgOrder (int lp_form, string lp_gas, unit lp_w, unit lp_g, point lp_at) {
    order lv_o;

    if (lp_form == 0) {
        return OrderTargetingPoint(gf_BgCmd(lp_gas), lp_at);
    }
    if (lp_form == 1) {
        lv_o = Order(gf_BgCmd(lp_gas));
        OrderSetTargetPlacement(lv_o, lp_at, lp_w, lp_gas);
        return lv_o;
    }
    return OrderTargetingUnit(gf_BgCmd(lp_gas), lp_g);
}

unit gf_BgMakeWorker (string lp_gas, int lp_player, point lp_at) {
    UnitCreate(1, gf_BgWorker(lp_gas), 0, lp_player, lp_at, 0.0);
    return gf_BhScript(UnitLastCreated());
}
