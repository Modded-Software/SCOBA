// Test harness: baseai group "gas", stock-AI probes (SPEC-BASE-AI 8).
// Does the stock AI build gas, and why not? Raw: the gas build orders the
// AI gives (watch, issued), its town point (town), probe geysers near it
// (extra, scan, ring) and how far it reaches for gas (reach). Each probe
// mode turns the map's gas orders off (baseai_gas_main.galaxy).
// Core: baseai_gas.galaxy.

const int c_BG_ORDERS = 3;            // distinct AI gas build orders kept per player
const int c_BG_REACH_N = 12;          // test towns of the reach probe
const fixed c_BG_REACH_FROM = 7.0;    // nearest test town centre to the geyser
const fixed c_BG_REACH_STEP = 0.5;
const fixed c_BG_EXTRA_R = 7.0;       // probe geysers: this far from the AI town point (stock melee distance)
const fixed c_BG_EXTRA_TURN = 40.0;   // degrees either side of the line from the town to the map centre
const fixed c_BG_OPEN_FROM = 7.0;     // the 6x6 probe geyser: rings this far from the AI town point,
const fixed c_BG_OPEN_TO = 8.0;       // well inside the AI's gas reach of about 10 (run 20261122-083512)
const int c_BG_OPEN_ANGLES = 16;
fixed[16][2] gv_bgExtraOwn;           // half side of each probe geyser (gv_bgExtraAt)
int gv_bgOpenClear;                   // gf_BgOpenSpot: open ground x100 around the point it chose, before the probe
trigger gt_BgWatch;
trigger gt_BgIssued;
int[16] gv_bgIssued;                  // gas build orders issued, per player (order event)
int[16] gv_bgOrderTicks;
int[16] gv_bgOrderSeen;
string[16] gv_bgOrderLast;

// The town probe (SC2_BA_GAS_TOWN=1): town one of lp_player is declared
// again, at its hall. Raw under p<player>: the town point before and right
// after. The snapshots show whether it stays.
void gf_BgTown (string lp_s, int lp_player) {
    string lv_k = "p" + IntToString(lp_player);

    if (!UnitIsValid(gv_baseAiHall[lp_player])) {
        return;
    }
    BankValueSetFromString(gv_dbgBank, lp_s, lv_k + "TownWas100", gf_BaXY100(AIGetTownLocation(lp_player, c_townOne)));
    AIDeclareTown(lp_player, c_townOne, UnitGetPosition(gv_baseAiHall[lp_player]));
    BankValueSetFromString(gv_dbgBank, lp_s, lv_k + "TownSet100", gf_BaXY100(AIGetTownLocation(lp_player, c_townOne)));
    BankValueSetFromInt(gv_dbgBank, lp_s, lv_k + "TownHarvest", gf_BaFlagInt(AIIsTownHarvestRunning(lp_player, c_townOne)));
}

// Raw: one build order, its target kind and place.
string gf_BgOrderText (order lp_o) {
    int lv_t = OrderGetTargetType(lp_o);

    if (lv_t == c_orderTargetUnit) {
        return "unit " + UnitGetType(OrderGetTargetUnit(lp_o)) + "@" + gf_BaXY100(UnitGetPosition(OrderGetTargetUnit(lp_o)));
    }
    if (lv_t == c_orderTargetPoint) {
        return "point@" + gf_BaXY100(OrderGetTargetPoint(lp_o));
    }
    return "type" + IntToString(lv_t) + "@" + gf_BaXY100(OrderGetTargetPosition(lp_o));
}

// The gas build orders the AI of lp_player gives its workers: every game
// loop, any queue slot. Ticks counts worker-loops with one; the first
// c_BG_ORDERS distinct targets are kept with their game time.
void gf_BgWatchPlayer (int lp_player) {
    unitgroup lv_g = UnitGroup(gf_BaWorkerType(lp_player), lp_player, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
    int lv_n = UnitGroupCount(lv_g, c_unitCountAll);
    string lv_text;
    order lv_o;
    unit lv_u;
    int lv_i;
    int lv_q;

    for (lv_i = 1; lv_i <= lv_n; lv_i += 1) {
        lv_u = UnitGroupUnit(lv_g, lv_i);
        for (lv_q = 0; lv_q < UnitOrderCount(lv_u); lv_q += 1) {
            lv_o = UnitOrder(lv_u, lv_q);
            if (lv_o == null) {
                continue;
            }
            if (AbilityCommandGetAbility(OrderGetAbilityCommand(lv_o)) != gf_BgAbil(gf_BgGasType(lp_player)) || AbilityCommandGetCommand(OrderGetAbilityCommand(lv_o)) != 2) {
                continue;
            }
            gv_bgOrderTicks[lp_player] += 1;
            lv_text = gf_BgOrderText(lv_o);
            if (lv_text != gv_bgOrderLast[lp_player] && gv_bgOrderSeen[lp_player] < c_BG_ORDERS) {
                BankValueSetFromString(gv_dbgBank, "ba_gas", "p" + IntToString(lp_player) + "GasOrder" + IntToString(gv_bgOrderSeen[lp_player]), lv_text + " t" + IntToString(FixedToInt(GameGetMissionTime())) + " worker@" + gf_BaXY100(UnitGetPosition(lv_u)));
                gv_bgOrderSeen[lp_player] += 1;
                gv_bgOrderLast[lp_player] = lv_text;
            }
        }
    }
}

bool gt_BgWatch_Func (bool testConds, bool runActions) {
    if (runActions) {
        gf_BgWatchPlayer(gf_BaseAiLaneOwner(2));
        gf_BgWatchPlayer(gf_BaseAiLaneOwner(3));
        gf_BgWatchPlayer(gf_BaseAiLaneOwner(5));
        gf_BgWatchPlayer(gf_BaseAiLaneOwner(6));
    }
    return true;
}

// A gas build order was issued to a unit of an AI lane owner (any issuer).
bool gt_BgIssued_Func (bool testConds, bool runActions) {
    int lv_p = UnitGetOwner(EventUnit());

    if (!runActions || lv_p < 0 || lv_p >= 16 || !gv_baseAiStarted[lv_p]) {
        return true;
    }
    if (gv_bgIssued[lv_p] < c_BG_ORDERS) {
        BankValueSetFromString(gv_dbgBank, "ba_gas", "p" + IntToString(lv_p) + "GasIssued" + IntToString(gv_bgIssued[lv_p]), gf_BgOrderText(EventUnitOrder()) + " t" + IntToString(FixedToInt(GameGetMissionTime())));
    }
    gv_bgIssued[lv_p] += 1;
    return true;
}

// The most open whole-cell point c_BG_OPEN_FROM to c_BG_OPEN_TO from
// lp_town: rings 1 apart, c_BG_OPEN_ANGLES directions from the one to the
// map centre; the candidate with the most open ground around it
// (gf_BgClear100, own 0). Waits between candidates.
point gf_BgOpenSpot (point lp_town) {
    fixed lv_a = AngleBetweenPoints(lp_town, RegionGetCenter(RegionPlayableMap()));
    point lv_best = null;
    int lv_bestClear = -1;
    point lv_p;
    fixed lv_r;
    int lv_c;
    int lv_i;

    for (lv_r = c_BG_OPEN_FROM; lv_r <= c_BG_OPEN_TO; lv_r += 1.0) {
        for (lv_i = 0; lv_i < c_BG_OPEN_ANGLES; lv_i += 1) {
            lv_p = PointWithOffsetPolar(lp_town, lv_r, lv_a + IntToFixed(lv_i) * 360.0 / IntToFixed(c_BG_OPEN_ANGLES));
            lv_p = Point(Round(PointGetX(lv_p)), Round(PointGetY(lv_p)));
            lv_c = gf_BgClear100(lv_p, 0.0);
            if (lv_c > lv_bestClear) {
                lv_bestClear = lv_c;
                lv_best = lv_p;
            }
            Wait(0.0625, c_timeGame);
        }
    }
    gv_bgOpenClear = lv_bestClear;
    return lv_best;
}

// One probe geyser lp_n of AI lane owner lp_player: type lp_type at lp_p
// (null: none), half side lp_own. Raw under p<player>X<n>: where it stands,
// how far that is from the town point, its engine radius and how much open
// ground lies around it.
void gf_BgExtraMake (string lp_s, int lp_player, int lp_n, string lp_type, point lp_p, int lp_flags, fixed lp_own) {
    string lv_k = "p" + IntToString(lp_player) + "X" + IntToString(lp_n);
    point lv_town = AIGetTownLocation(lp_player, c_townOne);
    unit lv_u;

    BankValueSetFromString(gv_dbgBank, lp_s, lv_k + "Asked100", gf_BaXY100(lp_p));
    if (lp_p == null) {
        return;
    }
    UnitCreate(1, lp_type, lp_flags, 0, lp_p, 0.0);
    lv_u = UnitLastCreated();
    BankValueSetFromInt(gv_dbgBank, lp_s, lv_k + "Made", gf_BaFlagInt(UnitIsValid(lv_u)));
    if (!UnitIsValid(lv_u)) {
        return;
    }
    gv_bgExtraAt[lp_player][lp_n] = UnitGetPosition(lv_u);
    gv_bgExtraOwn[lp_player][lp_n] = lp_own;
    BankValueSetFromString(gv_dbgBank, lp_s, lv_k + "Type", UnitGetType(lv_u));
    BankValueSetFromString(gv_dbgBank, lp_s, lv_k + "At100", gf_BaXY100(UnitGetPosition(lv_u)));
    BankValueSetFromInt(gv_dbgBank, lp_s, lv_k + "Town100", gf_Ba100(DistanceBetweenPoints(lv_town, UnitGetPosition(lv_u))));
    BankValueSetFromInt(gv_dbgBank, lp_s, lv_k + "Res", UnitGetPropertyInt(lv_u, c_unitPropResources, c_unitPropCurrent));
    BankValueSetFromInt(gv_dbgBank, lp_s, lv_k + "Radius100", gf_Ba100(UnitGetPropertyFixed(lv_u, c_unitPropRadius, c_unitPropCurrent)));
    BankValueSetFromInt(gv_dbgBank, lp_s, lv_k + "Clear100", gf_BgClear100(UnitGetPosition(lv_u), lp_own));
}

// The stock baseline. Two probe geysers for AI lane owner lp_player near
// its AI town point: 0 a stock 3x3 RichVespeneGeyser (stock data, on a half
// cell) c_BG_EXTRA_R off on the side of the map centre (the resource line
// lies on the far side); 1 a 6x6 VespeneGeyser (on a whole cell) on the
// most open ground in reach (gf_BgOpenSpot). Which one the AI builds on
// tells size, distance and open ground apart.
void gf_BgExtra (string lp_s, int lp_player) {
    point lv_town = AIGetTownLocation(lp_player, c_townOne);
    fixed lv_a;
    point lv_p;

    if (lv_town == null) {
        return;
    }
    lv_a = AngleBetweenPoints(lv_town, RegionGetCenter(RegionPlayableMap()));
    lv_p = PointWithOffsetPolar(lv_town, c_BG_EXTRA_R, lv_a + c_BG_EXTRA_TURN);
    gf_BgExtraMake(lp_s, lp_player, 0, "RichVespeneGeyser", Point(Floor(PointGetX(lv_p)) + 0.5, Floor(PointGetY(lv_p)) + 0.5), 0, 1.5);
    // The 6x6 probe: on the most open ground in reach, placement rules
    // ignored (its no-hall ring would push it out of reach, run
    // 20261122-084908).
    gf_BgExtraMake(lp_s, lp_player, 1, "VespeneGeyser", gf_BgOpenSpot(lv_town), c_unitCreateIgnorePlacement, 3.0);
}

// At the end: the gas buildings of lp_player on each probe geyser.
void gf_BgExtraBuilt (string lp_s, int lp_player) {
    int lv_n;

    for (lv_n = 0; lv_n < c_BG_EXTRAS; lv_n += 1) {
        if (gv_bgExtraAt[lp_player][lv_n] == null) {
            continue;
        }
        BankValueSetFromInt(gv_dbgBank, lp_s, "p" + IntToString(lp_player) + "X" + IntToString(lv_n) + "Built", gf_BgCount(gf_BgGasType(lp_player), lp_player, gv_bgExtraAt[lp_player][lv_n], c_BG_NEAR));
        BankValueSetFromInt(gv_dbgBank, lp_s, "p" + IntToString(lp_player) + "X" + IntToString(lv_n) + "ClearEnd100", gf_BgClear100(gv_bgExtraAt[lp_player][lv_n], gv_bgExtraOwn[lp_player][lv_n]));
    }
}

// The radius scan (SC2_BA_GAS_SCAN, scripts/testkit/profiles/baseai_scan.py): the
// probe map then has the probe geyser types BgGeyserA and BgGeyserB, each a
// 6x6 geyser with its own Shape radius, and the Refinery and the Extractor
// have theirs.
bool gf_BgScan () {
    return CatalogEntryIsValid(c_gameCatalogUnit, "BgGeyserA");
}

// Stock PathingBlocker1x1 units (player 0) on every whole cell of the 6x6
// square around lp_at but the inner 2x2. Returns how many were made (32).
int gf_BgRing (point lp_at) {
    int lv_made = 0;
    int lv_i;
    int lv_j;

    for (lv_j = -3; lv_j < 3; lv_j += 1) {
        for (lv_i = -3; lv_i < 3; lv_i += 1) {
            if (lv_i >= -1 && lv_i <= 0 && lv_j >= -1 && lv_j <= 0) {
                continue;
            }
            UnitCreate(1, "PathingBlocker1x1", c_unitCreateIgnorePlacement, 0, PointWithOffset(lp_at, IntToFixed(lv_i) + 0.5, IntToFixed(lv_j) + 0.5), 0.0);
            if (UnitIsValid(UnitLastCreated())) {
                lv_made += 1;
            }
        }
    }
    return lv_made;
}

// A script worker of lp_player is ordered to build on the ringed probe
// geyser at lp_at, by the order that names the geyser. Raw: X0RingIssued.
void gf_BgRingOrder (string lp_s, int lp_player, point lp_at) {
    string lv_gas = gf_BgGasType(lp_player);
    unit lv_g = UnitGroupClosestToPoint(UnitGroup("BgGeyserA", c_playerAny, RegionCircle(lp_at, 0.5), UnitFilter(0, 0, 0, 0), 0), lp_at);
    unit lv_w;

    if (!UnitIsValid(lv_g)) {
        return;
    }
    PlayerModifyPropertyInt(lp_player, c_playerPropMinerals, c_playerPropOperAdd, 100);
    lv_w = gf_BgMakeWorker(lv_gas, lp_player, PointWithOffsetPolar(lp_at, 6.0, AngleBetweenPoints(lp_at, PlayerStartLocation(lp_player))));
    BankValueSetFromInt(gv_dbgBank, lp_s, "p" + IntToString(lp_player) + "X0RingIssued", gf_BaFlagInt(UnitIssueOrder(lv_w, gf_BgOrder(2, lv_gas, lv_w, lv_g, lp_at), c_orderQueueReplace)));
}

// The scan probe of AI lane lp_lane, the only probe geyser of its owner: A
// on the Terran lanes 2 and 3, B on the Zerg lanes 5 and 6, on the most
// open ground in reach.
// Raw under p<player>X0, and the radius the engine has for the lane's gas
// building.
void gf_BgScanProbe (string lp_s, int lp_lane) {
    int lv_p = gf_BaseAiLaneOwner(lp_lane);
    point lv_town = AIGetTownLocation(lv_p, c_townOne);
    string lv_type = "BgGeyserB";

    if (lv_town == null) {
        return;
    }
    if (lp_lane == 2 || lp_lane == 3) {
        lv_type = "BgGeyserA";
    }
    gf_BgExtraMake(lp_s, lv_p, 0, lv_type, gf_BgOpenSpot(lv_town), c_unitCreateIgnorePlacement, 3.0);
    // The ring probe (SC2_BA_GAS_RING=1), Terran lanes only (the Zerg lanes
    // stay the control): stock 1x1 pathing blockers fill the probe's 6x6.
    // Lane 3 also sends a script worker, to tell an engine refusal from an
    // AI one.
    if (gv_bgRing && gv_bgExtraAt[lv_p][0] != null && (lp_lane == 2 || lp_lane == 3)) {
        BankValueSetFromInt(gv_dbgBank, lp_s, "p" + IntToString(lv_p) + "X0Ring", gf_BgRing(gv_bgExtraAt[lv_p][0]));
        if (lp_lane == 3) {
            gf_BgRingOrder(lp_s, lv_p, gv_bgExtraAt[lv_p][0]);
        }
    }
    // Raw: the sub-cells the probe's Shape (and its ring) blocks.
    if (gv_bgExtraAt[lv_p][0] != null) {
        gf_BaHallGrid(lp_s, "p" + IntToString(lv_p) + "X0", gv_bgExtraAt[lv_p][0]);
    }
    // Under 300: the 6x6 probe overlaps blocked ground.
    BankValueSetFromInt(gv_dbgBank, lp_s, "p" + IntToString(lv_p) + "X0Open100", gv_bgOpenClear);
    BankValueSetFromString(gv_dbgBank, lp_s, "p" + IntToString(lv_p) + "X0GasRadius", CatalogFieldValueGet(c_gameCatalogUnit, gf_BgGasType(lv_p), "Radius", lv_p));
    BankValueSetFromString(gv_dbgBank, lp_s, "p" + IntToString(lv_p) + "X0GasFoot", CatalogFieldValueGet(c_gameCatalogUnit, gf_BgGasType(lv_p), "Footprint", lv_p));
}

// How far the AI reaches for gas, raw. Towns 1..c_BG_REACH_N of lp_player
// are declared on the ray from its start through its nearest geyser, past
// the geyser, c_BG_REACH_FROM + n * c_BG_REACH_STEP from it. Per town: the
// declared centre, the town point the AI reports, the raw gas spots it
// counts, and where it would place the gas building. Run last: it changes
// the AI's towns.
void gf_BgReach (string lp_s, int lp_player) {
    point lv_h = PlayerStartLocation(lp_player);
    unit lv_g = gf_BgGeyser(lv_h, 0);
    point lv_at;
    point lv_c;
    point lv_town;
    string lv_k;
    int lv_n;

    if (!UnitIsValid(lv_g)) {
        return;
    }
    lv_at = UnitGetPosition(lv_g);
    BankValueSetFromString(gv_dbgBank, lp_s, "reachGeyser100", gf_BaXY100(lv_at));
    for (lv_n = 0; lv_n < c_BG_REACH_N; lv_n += 1) {
        lv_c = PointWithOffsetPolar(lv_at, c_BG_REACH_FROM + IntToFixed(lv_n) * c_BG_REACH_STEP, AngleBetweenPoints(lv_h, lv_at));
        AIDeclareTown(lp_player, lv_n + 1, lv_c);
        AIHarvest(lp_player, lv_n + 1);
        BankValueSetFromString(gv_dbgBank, lp_s, "reach" + IntToString(lv_n) + "Centre100", gf_BaXY100(lv_c));
    }
    Wait(2.0, c_timeGame);
    for (lv_n = 0; lv_n < c_BG_REACH_N; lv_n += 1) {
        lv_k = "reach" + IntToString(lv_n);
        lv_town = AIGetTownLocation(lp_player, lv_n + 1);
        BankValueSetFromString(gv_dbgBank, lp_s, lv_k + "Town100", gf_BaXY100(lv_town));
        BankValueSetFromInt(gv_dbgBank, lp_s, lv_k + "State", AIGetTownState(lp_player, lv_n + 1));
        BankValueSetFromInt(gv_dbgBank, lp_s, lv_k + "Raw", AIGetRawGasNumSpots(lp_player, lv_n + 1));
        if (lv_town != null) {
            BankValueSetFromInt(gv_dbgBank, lp_s, lv_k + "D100", gf_Ba100(DistanceBetweenPoints(lv_town, lv_at)));
            BankValueSetFromString(gv_dbgBank, lp_s, lv_k + "Place100", gf_BaXY100(AIGetBuildingPlacement(lp_player, lv_town, gf_BgGasType(lp_player), c_BG_COLLECTOR)));
        }
    }
}
