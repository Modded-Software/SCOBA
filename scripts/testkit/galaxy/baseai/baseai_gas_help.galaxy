// Test harness: baseai group "gas", the help probe (SC2_BA_GAS_HELP,
// SPEC-BASE-AI 8). Workers built and staffed by the harness: does the stock
// AI harvest a gas building it did not place? Turns the map's gas orders
// off (baseai_gas_main.galaxy). Core: baseai_gas.galaxy.

point[16][2] gv_bgHelpAt;             // the geysers a script worker built on for an AI lane owner
bool gv_bgHelpOwn;                    // SC2_BA_GAS_HELP=2: the help workers are the AI's own
unitgroup[16] gv_bgHelpTaken;         // every worker the help probe ordered, per player
unitgroup[16][2] gv_bgHelpCrew;       // the harvesters of that gas building
bool[16][2] gv_bgHelpLate;            // Res200 of that gas building is recorded
const fixed c_BG_LATE = 200.0;        // game s: the late sample of the gas left
bool[16][2] gv_bgHelpStaffed;         // that gas building has its script harvesters
const int c_BG_STAFF = 3;             // script harvesters per help gas building
trigger gt_BgStaff;

// The nearest worker of lp_player to lp_at that the AI plays (not script
// controlled), gathering now, and not in lp_skip. null: none.
unit gf_BgAiWorker (int lp_player, point lp_at, unitgroup lp_skip) {
    unitgroup lv_g = UnitGroup(gf_BaWorkerType(lp_player), lp_player, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
    int lv_n = UnitGroupCount(lv_g, c_unitCountAll);
    unit lv_best = null;
    fixed lv_bestD = 9999.0;
    fixed lv_d;
    order lv_o;
    unit lv_u;
    int lv_i;

    for (lv_i = 1; lv_i <= lv_n; lv_i += 1) {
        lv_u = UnitGroupUnit(lv_g, lv_i);
        if (AIIsScriptControlled(lv_u) || UnitGroupHasUnit(lp_skip, lv_u)) {
            continue;
        }
        lv_o = UnitOrder(lv_u, 0);
        if (lv_o == null || AbilityCommandGetAbility(OrderGetAbilityCommand(lv_o)) != gf_BgHarvest(lp_player)) {
            continue;
        }
        lv_d = DistanceBetweenPoints(UnitGetPosition(lv_u), lp_at);
        if (lv_d < lv_bestD) {
            lv_bestD = lv_d;
            lv_best = lv_u;
        }
    }
    return lv_best;
}

// The help probe (SC2_BA_GAS_HELP=1): does the AI harvest a gas building it
// did not place itself? For AI lane owner lp_player a script worker builds
// on both placed geysers, by the order that names the geyser. Raw under
// p<player>H<n>: how far the geyser is from the AI town point and from the
// hall, and whether the order went out.
// With SC2_BA_GAS_HELP=2 the workers are the AI's own, not script
// controlled: does the AI leave an ordered worker alone?
void gf_BgHelp (string lp_s, int lp_player) {
    string lv_gas = gf_BgGasType(lp_player);
    point lv_h = PlayerStartLocation(lp_player);
    point lv_town = AIGetTownLocation(lp_player, c_townOne);
    string lv_k;
    point lv_at;
    unit lv_g;
    unit lv_w;
    int lv_n;

    gv_bgHelpTaken[lp_player] = UnitGroupEmpty();
    PlayerModifyPropertyInt(lp_player, c_playerPropMinerals, c_playerPropOperAdd, 200);
    for (lv_n = 0; lv_n < 2; lv_n += 1) {
        lv_k = "p" + IntToString(lp_player) + "H" + IntToString(lv_n);
        lv_g = gf_BgGeyser(lv_h, lv_n);
        if (!UnitIsValid(lv_g)) {
            continue;
        }
        lv_at = UnitGetPosition(lv_g);
        gv_bgHelpAt[lp_player][lv_n] = lv_at;
        if (gv_bgHelpOwn) {
            lv_w = gf_BgAiWorker(lp_player, lv_at, gv_bgHelpTaken[lp_player]);
        }
        else {
            lv_w = gf_BgMakeWorker(lv_gas, lp_player, PointWithOffsetPolar(lv_at, UnitGetPropertyFixed(lv_g, c_unitPropRadius, c_unitPropCurrent) + 3.0, AngleBetweenPoints(lv_at, lv_h)));
        }
        BankValueSetFromString(gv_dbgBank, lp_s, lv_k + "At100", gf_BaXY100(lv_at));
        if (lv_town != null) {
            BankValueSetFromInt(gv_dbgBank, lp_s, lv_k + "Town100", gf_Ba100(DistanceBetweenPoints(lv_town, lv_at)));
        }
        if (UnitIsValid(gv_baseAiHall[lp_player])) {
            BankValueSetFromInt(gv_dbgBank, lp_s, lv_k + "Hall100", gf_Ba100(DistanceBetweenPoints(UnitGetPosition(gv_baseAiHall[lp_player]), lv_at)));
        }
        if (!UnitIsValid(lv_w)) {
            BankValueSetFromInt(gv_dbgBank, lp_s, lv_k + "Issued", 0);
            continue;
        }
        UnitGroupAdd(gv_bgHelpTaken[lp_player], lv_w);
        BankValueSetFromInt(gv_dbgBank, lp_s, lv_k + "Issued", gf_BaFlagInt(UnitIssueOrder(lv_w, gf_BgOrder(2, lv_gas, lv_w, lv_g, lv_at), c_orderQueueReplace)));
    }
}

// At the end: the gas building of lp_player on each helped geyser and the
// gas left in it (a placed geyser starts with 10000).
void gf_BgHelpEnd (string lp_s, int lp_player) {
    string lv_gas = gf_BgGasType(lp_player);
    string lv_k;
    order lv_o;
    unit lv_b;
    unit lv_u;
    int lv_n;
    int lv_i;
    int lv_alive;
    int lv_on;

    for (lv_n = 0; lv_n < 2; lv_n += 1) {
        if (gv_bgHelpAt[lp_player][lv_n] == null) {
            continue;
        }
        lv_k = "p" + IntToString(lp_player) + "H" + IntToString(lv_n);
        lv_b = UnitGroupClosestToPoint(UnitGroup(lv_gas, lp_player, RegionCircle(gv_bgHelpAt[lp_player][lv_n], c_BG_NEAR), UnitFilter(0, 0, 0, 0), 0), gv_bgHelpAt[lp_player][lv_n]);
        BankValueSetFromInt(gv_dbgBank, lp_s, lv_k + "Built", gf_BaFlagInt(UnitIsValid(lv_b)));
        if (UnitIsValid(lv_b)) {
            BankValueSetFromInt(gv_dbgBank, lp_s, lv_k + "Building", gf_BaFlagInt(UnitTestState(lv_b, c_unitStateUnderConstruction)));
            BankValueSetFromInt(gv_dbgBank, lp_s, lv_k + "Res", UnitGetPropertyInt(lv_b, c_unitPropResources, c_unitPropCurrent));
        }
        // The crew at the end: alive, and on the way to this building (a
        // worker carrying gas back is not counted: Res against Res200
        // shows the gas flow of the last 40 game s).
        if (gv_bgHelpCrew[lp_player][lv_n] == null) {
            continue;
        }
        lv_alive = 0;
        lv_on = 0;
        for (lv_i = 1; lv_i <= UnitGroupCount(gv_bgHelpCrew[lp_player][lv_n], c_unitCountAll); lv_i += 1) {
            lv_u = UnitGroupUnit(gv_bgHelpCrew[lp_player][lv_n], lv_i);
            if (!UnitIsAlive(lv_u)) {
                continue;
            }
            lv_alive += 1;
            lv_o = UnitOrder(lv_u, 0);
            if (lv_o == null || AbilityCommandGetAbility(OrderGetAbilityCommand(lv_o)) != gf_BgHarvest(lp_player)) {
                continue;
            }
            if (OrderGetTargetUnit(lv_o) == lv_b) {
                lv_on += 1;
            }
        }
        BankValueSetFromInt(gv_dbgBank, lp_s, lv_k + "CrewAlive", lv_alive);
        BankValueSetFromInt(gv_dbgBank, lp_s, lv_k + "CrewOn", lv_on);
    }
}

// The help probe, second half: every finished help building of lp_player
// gets c_BG_STAFF script workers that gather from it, once. The AI does not
// harvest a gas building outside its reach (run 20261122-102102, player
// 13). Raw under p<player>H<n>: gather orders accepted and the game time.
void gf_BgHelpStaff (string lp_s, int lp_player) {
    string lv_gas = gf_BgGasType(lp_player);
    string lv_harvest = "DroneHarvest";
    string lv_k;
    point lv_at;
    unit lv_b;
    unit lv_w;
    int lv_n;
    int lv_i;
    int lv_ok;

    if (lv_gas == "Refinery") {
        lv_harvest = "SCVHarvest";
    }
    for (lv_n = 0; lv_n < 2; lv_n += 1) {
        lv_at = gv_bgHelpAt[lp_player][lv_n];
        if (lv_at == null) {
            continue;
        }
        lv_b = UnitGroupClosestToPoint(UnitGroup(lv_gas, lp_player, RegionCircle(lv_at, c_BG_NEAR), UnitFilter(0, 0, 0, 0), 0), lv_at);
        if (!UnitIsValid(lv_b) || UnitTestState(lv_b, c_unitStateUnderConstruction)) {
            continue;
        }
        lv_k = "p" + IntToString(lp_player) + "H" + IntToString(lv_n);
        // Raw, once: the gas left at c_BG_LATE game s.
        if (!gv_bgHelpLate[lp_player][lv_n] && GameGetMissionTime() >= c_BG_LATE) {
            gv_bgHelpLate[lp_player][lv_n] = true;
            BankValueSetFromInt(gv_dbgBank, lp_s, lv_k + "Res200", UnitGetPropertyInt(lv_b, c_unitPropResources, c_unitPropCurrent));
        }
        if (gv_bgHelpStaffed[lp_player][lv_n]) {
            continue;
        }
        lv_ok = 0;
        gv_bgHelpCrew[lp_player][lv_n] = UnitGroupEmpty();
        for (lv_i = 0; lv_i < c_BG_STAFF; lv_i += 1) {
            if (gv_bgHelpOwn) {
                lv_w = gf_BgAiWorker(lp_player, lv_at, gv_bgHelpTaken[lp_player]);
            }
            else {
                lv_w = gf_BgMakeWorker(lv_gas, lp_player, PointWithOffsetPolar(lv_at, 6.0, AngleBetweenPoints(lv_at, PlayerStartLocation(lp_player)) + 20.0 * IntToFixed(lv_i - 1)));
            }
            if (!UnitIsValid(lv_w)) {
                continue;
            }
            UnitGroupAdd(gv_bgHelpTaken[lp_player], lv_w);
            UnitGroupAdd(gv_bgHelpCrew[lp_player][lv_n], lv_w);
            if (UnitIssueOrder(lv_w, OrderTargetingUnit(AbilityCommand(lv_harvest, 0), lv_b), c_orderQueueReplace)) {
                lv_ok += 1;
            }
        }
        gv_bgHelpStaffed[lp_player][lv_n] = true;
        BankValueSetFromInt(gv_dbgBank, lp_s, lv_k + "Staffed", lv_ok);
        BankValueSetFromInt(gv_dbgBank, lp_s, lv_k + "StaffT", FixedToInt(GameGetMissionTime()));
    }
}

bool gt_BgStaff_Func (bool testConds, bool runActions) {
    if (runActions) {
        gf_BgHelpStaff("ba_gas", gf_BaseAiLaneOwner(2));
        gf_BgHelpStaff("ba_gas", gf_BaseAiLaneOwner(3));
        gf_BgHelpStaff("ba_gas", gf_BaseAiLaneOwner(5));
        gf_BgHelpStaff("ba_gas", gf_BaseAiLaneOwner(6));
    }
    return true;
}
