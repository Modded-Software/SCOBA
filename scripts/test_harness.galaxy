point gv_dbgAnchor;
unit gv_dbgEnemy;
fixed gv_dbgSpawnAt;

void gf_DbgClearEnemies () {
    int lv_i;
    unit lv_unit;
    unitgroup lv_group;

    for (lv_i = 0; lv_i < 50; lv_i += 1) {
        lv_group = UnitGroupAlliance(1, c_unitAllianceEnemy, RegionCircle(gv_dbgAnchor, 30.0), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        if (UnitGroupCount(lv_group, c_unitCountAlive) == 0) {
            break;
        }
        lv_unit = UnitGroupUnit(lv_group, 1);
        if (!UnitIsValid(lv_unit)) {
            break;
        }
        UnitRemove(lv_unit);
    }
    gv_dbgEnemy = null;
}

void gf_DbgReset (string lp_section, bool lp_auto, bool lp_stand) {
    int lv_order;
    unit lv_hero;

    gv_mOUSELEFT[1] = false;
    gv_mOUSERIGHT[1] = false;
    gv_mOUSEFORWARD[1] = false;
    gv_kEYFORWARD[1] = false;
    gv_mOUSERIGHTCANCEL[1] = false;
    gv_mOUSELEFTCANCEL[1] = false;
    gv_sCOBAPRESSUNIT[1] = null;
    gv_sCOBALEFTPRESSUNIT[1] = null;
    gv_sCOBAHover[1] = null;
    gv_tARGET[1] = null;
    gv_fORWARD[1] = false;
    lv_hero = gv_tPSUNIT[1];
    UnitIssueOrder(lv_hero, Order(AbilityCommand("SCOBAAutoAttackToggle", 1)), c_orderQueueReplace);
    UnitIssueOrder(lv_hero, Order(AbilityCommand("SCOBARightClickToggle", 1)), c_orderQueueReplace);
    UnitIssueOrder(lv_hero, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
    Wait(0.2, c_timeGame);
    UnitSetPosition(lv_hero, gv_dbgAnchor, false);
    gf_DbgClearEnemies();
    Wait(0.8, c_timeGame);
    if (lp_stand) {
        lv_order = 0;
    }
    else {
        lv_order = 1;
    }
    UnitIssueOrder(lv_hero, Order(AbilityCommand("SCOBARightClickToggle", lv_order)), c_orderQueueReplace);
    Wait(0.5, c_timeGame);
    if (lp_auto) {
        UnitIssueOrder(lv_hero, Order(AbilityCommand("SCOBAAutoAttackToggle", 0)), c_orderQueueReplace);
        Wait(0.8, c_timeGame);
    }
    gv_dbgSpawnAt = TimerGetElapsed(gv_sCOBA_Clock);
    BankValueSetFromInt(gv_dbgBank, lp_section, "auto", UnitBehaviorCount(lv_hero, "SCOBAAutoAttackBehavior"));
    BankValueSetFromInt(gv_dbgBank, lp_section, "stand", UnitBehaviorCount(lv_hero, "SCOBARightClickStandBehavior"));
    BankValueSetFromInt(gv_dbgBank, lp_section, "root", UnitBehaviorCount(lv_hero, "SCOBAStandRoot"));
    BankValueSetFromFlag(gv_dbgBank, lp_section, "moveSuppressed", UnitTestState(lv_hero, c_unitStateMoveSuppressed));
    BankValueSetFromInt(gv_dbgBank, lp_section, "heroX", FixedToInt(PointGetX(UnitGetPosition(lv_hero))));
    BankValueSetFromInt(gv_dbgBank, lp_section, "heroY", FixedToInt(PointGetY(UnitGetPosition(lv_hero))));
    BankSave(gv_dbgBank);
}

unit gf_DbgSpawnOne (string lp_section, fixed lp_dx, fixed lp_life) {
    unit lv_unit;
    point lv_point;

    gf_DbgClearEnemies();
    lv_point = PointWithOffset(gv_dbgAnchor, lp_dx, 0.0);
    libNtve_gf_CreateUnitsAtPoint2(1, "Zergling", 0, 4, lv_point);
    lv_unit = UnitLastCreated();
    UnitSetState(lv_unit, c_unitStateStunned, true);
    UnitSetPropertyFixed(lv_unit, c_unitPropLifeMax, lp_life);
    UnitSetPropertyFixed(lv_unit, c_unitPropLife, lp_life);
    gv_dbgEnemy = lv_unit;
    gv_dbgSpawnAt = TimerGetElapsed(gv_sCOBA_Clock);
    BankValueSetFromInt(gv_dbgBank, lp_section, "spawnX", FixedToInt(PointGetX(UnitGetPosition(lv_unit))));
    BankValueSetFromInt(gv_dbgBank, lp_section, "spawnY", FixedToInt(PointGetY(UnitGetPosition(lv_unit))));
    BankValueSetFromInt(gv_dbgBank, lp_section, "spawnHp", FixedToInt(UnitGetPropertyFixed(lv_unit, c_unitPropLife, c_unitPropCurrent)));
    BankSave(gv_dbgBank);
    return lv_unit;
}

void gf_DbgSnap (string lp_section, string lp_tag) {
    unit lv_hero;
    unit lv_enemy;

    lv_hero = gv_tPSUNIT[1];
    lv_enemy = gv_dbgEnemy;
    BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "AtMs", FixedToInt((TimerGetElapsed(gv_sCOBA_Clock) - gv_dbgSpawnAt) * 1000.0));
    BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "HeroX", FixedToInt(PointGetX(UnitGetPosition(lv_hero))));
    BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "HeroY", FixedToInt(PointGetY(UnitGetPosition(lv_hero))));
    BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "Auto", UnitBehaviorCount(lv_hero, "SCOBAAutoAttackBehavior"));
    BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "Stand", UnitBehaviorCount(lv_hero, "SCOBARightClickStandBehavior"));
    BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "Root", UnitBehaviorCount(lv_hero, "SCOBAStandRoot"));
    BankValueSetFromFlag(gv_dbgBank, lp_section, lp_tag + "MoveSuppressed", UnitTestState(lv_hero, c_unitStateMoveSuppressed));
    BankValueSetFromFlag(gv_dbgBank, lp_section, lp_tag + "AttackOrder", UnitOrderHasAbil(lv_hero, "attack"));
    BankValueSetFromFlag(gv_dbgBank, lp_section, lp_tag + "TargetEnemy", gv_tARGET[1] == lv_enemy);
    BankValueSetFromFlag(gv_dbgBank, lp_section, lp_tag + "Forward", gv_fORWARD[1]);
    BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "CooldownMs", FixedToInt(UnitAbilityGetCooldown(lv_hero, "SCOBAAutoAttackStatus", "Abil/SCOBAAutoAttackStatus") * 1000.0));
    BankValueSetFromFlag(gv_dbgBank, lp_section, lp_tag + "CmdCooldown", UnitCheckAbilCmdState(lv_hero, AbilityCommand("SCOBAAutoAttackStatus", 0), c_cmdStateCooldown));
    if (UnitIsValid(lv_enemy)) {
        BankValueSetFromFlag(gv_dbgBank, lp_section, lp_tag + "EnemyValid", true);
        BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "EnemyHp", FixedToInt(UnitGetPropertyFixed(lv_enemy, c_unitPropLife, c_unitPropCurrent)));
        BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "Distance", FixedToInt(DistanceBetweenPoints(UnitGetPosition(lv_hero), UnitGetPosition(lv_enemy))));
    }
    else {
        BankValueSetFromFlag(gv_dbgBank, lp_section, lp_tag + "EnemyValid", false);
        BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "EnemyHp", 0);
        BankValueSetFromInt(gv_dbgBank, lp_section, lp_tag + "Distance", -1);
    }
    BankSave(gv_dbgBank);
}

bool gt_DbgTest_Func (bool testConds, bool runActions) {
    int lv_i;

    if (!runActions) {
        return true;
    }
    Wait(3.0, c_timeGame);
    gv_dbgBank = BankLoad("SCOBATEST", 1);
    BankValueSetFromInt(gv_dbgBank, "meta", "done", 0);
    gv_dbgAnchor = UnitGetPosition(gv_tPSUNIT[1]);
    BankValueSetFromInt(gv_dbgBank, "meta", "anchorX", FixedToInt(PointGetX(gv_dbgAnchor)));
    BankValueSetFromInt(gv_dbgBank, "meta", "anchorY", FixedToInt(PointGetY(gv_dbgAnchor)));
    BankSave(gv_dbgBank);

    gf_DbgReset("startup", false, true);
    gf_DbgSnap("startup", "t0000");

    gf_DbgReset("auto_off", false, true);
    gf_DbgSpawnOne("auto_off", 3.0, 500.0);
    gf_DbgSnap("auto_off", "t0000");
    Wait(3.0, c_timeGame);
    gf_DbgSnap("auto_off", "t3000");

    gf_DbgReset("stand_in", true, true);
    gf_DbgSpawnOne("stand_in", 3.0, 500.0);
    gf_DbgSnap("stand_in", "t0000");
    Wait(0.5, c_timeGame);
    gf_DbgSnap("stand_in", "t0500");
    Wait(1.0, c_timeGame);
    gf_DbgSnap("stand_in", "t1500");
    Wait(1.0, c_timeGame);
    gf_DbgSnap("stand_in", "t2500");

    gf_DbgReset("stand_out", true, true);
    gf_DbgSpawnOne("stand_out", 11.0, 500.0);
    gf_DbgSnap("stand_out", "t0000");
    Wait(1.0, c_timeGame);
    gf_DbgSnap("stand_out", "t1000");
    Wait(1.5, c_timeGame);
    gf_DbgSnap("stand_out", "t2500");

    gf_DbgReset("stand_outside", true, true);
    gf_DbgSpawnOne("stand_outside", 13.0, 500.0);
    gf_DbgSnap("stand_outside", "t0000");
    Wait(2.0, c_timeGame);
    gf_DbgSnap("stand_outside", "t2000");

    gf_DbgReset("stand_auto_off", false, true);
    gf_DbgSpawnOne("stand_auto_off", 9.0, 500.0);
    gf_DbgSnap("stand_auto_off", "t0000");
    for (lv_i = 0; lv_i < 5; lv_i += 1) {
        gf_CombatManualAttack(1, gv_dbgEnemy);
        Wait(0.2, c_timeGame);
    }
    gf_DbgSnap("stand_auto_off", "t1000");
    Wait(1.0, c_timeGame);
    gf_DbgSnap("stand_auto_off", "t2000");

    gf_DbgReset("stand_wake_manual", true, true);
    gf_DbgSpawnOne("stand_wake_manual", 9.0, 500.0);
    gf_DbgSnap("stand_wake_manual", "t0000");
    gv_fORWARD[1] = true;
    gf_CombatBeginMove(1);
    Wait(0.2, c_timeGame);
    gf_DbgSnap("stand_wake_manual", "t0200");
    gv_fORWARD[1] = false;
    Wait(0.8, c_timeGame);
    gf_DbgSnap("stand_wake_manual", "t1000");
    gf_CombatManualAttack(1, gv_dbgEnemy);
    Wait(1.0, c_timeGame);
    gf_DbgSnap("stand_wake_manual", "t2000");

    gf_DbgReset("right_click", false, true);
    gf_DbgSpawnOne("right_click", 3.0, 500.0);
    gv_sCOBAHover[1] = gv_dbgEnemy;
    gf_MousePressRight(1, 100, 100, PointGetX(UnitGetPosition(gv_dbgEnemy)), PointGetY(UnitGetPosition(gv_dbgEnemy)));
    BankValueSetFromFlag(gv_dbgBank, "right_click", "ran", gf_MouseReleaseRight(1, 100, 100));
    BankSave(gv_dbgBank);
    Wait(0.2, c_timeGame);
    gf_DbgSnap("right_click", "t0200");

    gf_DbgReset("right_drag", false, true);
    gf_DbgSpawnOne("right_drag", 3.0, 500.0);
    gv_sCOBAHover[1] = gv_dbgEnemy;
    gf_MousePressRight(1, 100, 100, PointGetX(UnitGetPosition(gv_dbgEnemy)), PointGetY(UnitGetPosition(gv_dbgEnemy)));
    BankValueSetFromFlag(gv_dbgBank, "right_drag", "ran", gf_MouseReleaseRight(1, 110, 100));
    BankSave(gv_dbgBank);
    gf_DbgSnap("right_drag", "t0000");
    Wait(0.5, c_timeGame);
    gf_DbgSnap("right_drag", "t0500");

    gf_DbgReset("right_point", false, false);
    gf_DbgSpawnOne("right_point", 3.0, 500.0);
    BankValueSetFromFlag(gv_dbgBank, "right_point", "pickValid", UnitIsValid(gf_ResolveClickEnemy(1, UnitGetPosition(gv_dbgEnemy))));
    BankSave(gv_dbgBank);

    gf_DbgReset("right_ground_walk", false, false);
    gf_MousePressRight(1, 100, 100, PointGetX(PointWithOffset(gv_dbgAnchor, -5.0, 0.0)), PointGetY(PointWithOffset(gv_dbgAnchor, -5.0, 0.0)));
    BankValueSetFromFlag(gv_dbgBank, "right_ground_walk", "ran", gf_MouseReleaseRight(1, 100, 100));
    BankSave(gv_dbgBank);
    gf_DbgSnap("right_ground_walk", "t0000");
    Wait(1.0, c_timeGame);
    gf_DbgSnap("right_ground_walk", "t1000");

    gf_DbgReset("right_ground_stand", false, true);
    gf_MousePressRight(1, 100, 100, PointGetX(PointWithOffset(gv_dbgAnchor, -5.0, 0.0)), PointGetY(PointWithOffset(gv_dbgAnchor, -5.0, 0.0)));
    BankValueSetFromFlag(gv_dbgBank, "right_ground_stand", "ran", gf_MouseReleaseRight(1, 100, 100));
    BankSave(gv_dbgBank);
    gf_DbgSnap("right_ground_stand", "t0000");
    Wait(0.5, c_timeGame);
    gf_DbgSnap("right_ground_stand", "t0500");

    gf_DbgReset("right_target_kept", false, false);
    gf_DbgSpawnOne("right_target_kept", 3.0, 500.0);
    gf_ShowTarget(1, gv_dbgEnemy);
    gv_sCOBAHover[1] = null;
    gf_MousePressRight(1, 100, 100, PointGetX(PointWithOffset(gv_dbgAnchor, -5.0, 0.0)), PointGetY(PointWithOffset(gv_dbgAnchor, -5.0, 0.0)));
    gf_MouseReleaseRight(1, 100, 100);
    Wait(0.2, c_timeGame);
    gf_DbgSnap("right_target_kept", "t0200");

    gf_DbgReset("both_forward", false, false);
    gv_mOUSELEFT[1] = true;
    gv_mOUSERIGHT[1] = true;
    gv_mOUSEFORWARD[1] = true;
    gv_kEYFORWARD[1] = true;
    gv_fORWARD[1] = true;
    gf_MouseForwardStop(1);
    gf_DbgSnap("both_forward", "tkey");
    gv_mOUSEFORWARD[1] = true;
    gv_kEYFORWARD[1] = false;
    gv_fORWARD[1] = true;
    gf_MouseForwardStop(1);
    gf_DbgSnap("both_forward", "tmouse");

    gf_DbgReset("walk_ground", true, false);
    gf_DbgSnap("walk_ground", "t0000");
    UnitIssueOrder(gv_tPSUNIT[1], OrderTargetingPoint(AbilityCommand("move", 0), PointWithOffset(gv_dbgAnchor, -5.0, 0.0)), c_orderQueueReplace);
    Wait(1.0, c_timeGame);
    gf_DbgSnap("walk_ground", "t1000");

    gf_DbgReset("stand_ground", true, true);
    gf_DbgSnap("stand_ground", "t0000");
    UnitIssueOrder(gv_tPSUNIT[1], OrderTargetingPoint(AbilityCommand("move", 0), PointWithOffset(gv_dbgAnchor, -5.0, 0.0)), c_orderQueueReplace);
    Wait(1.0, c_timeGame);
    gf_DbgSnap("stand_ground", "t1000");

    gf_DbgReset("move_wake", true, true);
    gf_DbgSnap("move_wake", "t0000");
    gv_fORWARD[1] = true;
    gf_CombatBeginMove(1);
    Wait(0.2, c_timeGame);
    gf_DbgSnap("move_wake", "t0200");
    UnitIssueOrder(gv_tPSUNIT[1], OrderTargetingPoint(AbilityCommand("move", 0), PointWithOffset(gv_dbgAnchor, 5.0, 0.0)), c_orderQueueReplace);
    Wait(1.0, c_timeGame);
    gf_DbgSnap("move_wake", "t1200");
    gv_fORWARD[1] = false;
    Wait(1.0, c_timeGame);
    gf_DbgSnap("move_wake", "t2200");

    gf_DbgReset("walk_chase", true, false);
    gf_DbgSpawnOne("walk_chase", 9.0, 500.0);
    gf_DbgSnap("walk_chase", "t0000");
    Wait(1.0, c_timeGame);
    gf_DbgSnap("walk_chase", "t1000");
    Wait(2.0, c_timeGame);
    gf_DbgSnap("walk_chase", "t3000");

    gf_DbgReset("walk_idle", true, false);
    gf_DbgSpawnOne("walk_idle", 13.0, 500.0);
    gf_DbgSnap("walk_idle", "t0000");
    Wait(2.0, c_timeGame);
    gf_DbgSnap("walk_idle", "t2000");

    gf_DbgReset("weapon", false, false);
    gf_DbgSpawnOne("weapon", 3.0, 500.0);
    gf_DbgSnap("weapon", "t0000");
    UnitIssueOrder(gv_tPSUNIT[1], OrderTargetingUnit(AbilityCommand("SCOBAAutoAttackStatus", 0), gv_dbgEnemy), c_orderQueueReplace);
    Wait(0.1, c_timeGame);
    gf_DbgSnap("weapon", "t0100");
    Wait(0.1, c_timeGame);
    gf_DbgSnap("weapon", "t0200");
    Wait(0.3, c_timeGame);
    gf_DbgSnap("weapon", "t0500");
    Wait(0.5, c_timeGame);
    gf_DbgSnap("weapon", "t1000");

    BankValueSetFromInt(gv_dbgBank, "meta", "done", 1);
    BankSave(gv_dbgBank);
    return true;
}

void gt_DbgTest_Init () {
    gt_DbgTest = TriggerCreate("gt_DbgTest_Func");
    TriggerAddEventMapInit(gt_DbgTest);
}